<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ShellKrypt</AssemblyName>
    <Title>ShellKrypt</Title>
    <Product>ShellKrypt</Product>
    <Description>ShellKrypt local encrypted vault</Description>
    <ApplicationIcon>Assets\main-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.25.0</Version>
    <AssemblyVersion>0.25.0.0</AssemblyVersion>
    <FileVersion>0.25.0.0</FileVersion>
    <InformationalVersion>0.25.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"
                      Exclude="Assets\Icons\**" />
    <AvaloniaResource Include="Resources\Fonts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShellKrypt.Application\ShellKrypt.Application.csproj" />
    <ProjectReference Include="..\ShellKrypt.Core\ShellKrypt.Core.csproj" />
    <ProjectReference Include="..\ShellKrypt.Infrastructure\ShellKrypt.Infrastructure.csproj" />
    <ProjectReference Include="..\ShellKrypt.UI.Shared\ShellKrypt.UI.Shared.csproj" />
  </ItemGroup>
</Project>
