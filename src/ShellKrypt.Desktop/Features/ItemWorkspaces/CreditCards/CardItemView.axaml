<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:feature="using:ShellKrypt.Desktop.Features.ItemWorkspaces.CreditCards" x:Class="ShellKrypt.Desktop.Features.ItemWorkspaces.CreditCards.CardItemView" x:Name="Root" x:DataType="feature:CardRowVm" x:CompileBindings="False">
  <Border Classes="item-workspace-card" PointerPressed="Card_OnPointerPressed"><Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
    <Button Classes="item-card-open" Command="{Binding ShowDetailsCommand, ElementName=Root}" CommandParameter="{Binding}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource SurfaceElevatedBrush}"><TextBlock Text="{Binding IconLetter}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Title}" Classes="item-card-title"/><TextBlock Text="{Binding Cardholder}" Classes="item-card-secondary"/></StackPanel></Grid></Button>
    <Border Grid.Row="1" Classes="item-secret-row"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{Binding NumberDisplay}" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="sk-icon-ghost" Command="{Binding ToggleSecretCommand, ElementName=Root}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource IconVisibility}" Width="15"/></Button><Button Grid.Column="2" Classes="sk-icon-ghost" Command="{Binding CopySecretCommand, ElementName=Root}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource IconContentCopy}" Width="15"/></Button></Grid></Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="{Binding BankDisplay}" Classes="item-card-secondary"/><TextBlock Text="{Binding IssuerDisplay}" Classes="item-card-secondary"/><TextBlock Text="{Binding ExpiryDisplay}" Classes="item-card-secondary"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource Loc.Common.Details}" Classes="sk-link" Command="{Binding ShowDetailsCommand, ElementName=Root}" CommandParameter="{Binding}"/></Grid>
  </Grid></Border>
</UserControl>
