<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ItemWorkspaces.Shared.ItemDetailRow"
             x:Name="Root"
             x:CompileBindings="False">
  <Border Classes="item-details-row">
    <Grid ColumnDefinitions="180,*" ColumnSpacing="20">
      <TextBlock Text="{Binding Label, ElementName=Root}" Classes="item-details-row-label" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=Root}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </Grid>
  </Border>
</UserControl>
