<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ItemWorkspaces.Shared.ItemWorkspaceHeader"
             x:Name="Root"
             x:CompileBindings="False">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
    <StackPanel Spacing="5">
      <TextBlock Text="{Binding Title, ElementName=Root}" Classes="page-title"/>
      <TextBlock Text="{Binding Subtitle, ElementName=Root}" Classes="page-subtitle" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <TextBlock Text="{Binding ResultText, ElementName=Root}" Classes="item-workspace-result"/>
        <ContentControl Content="{Binding SummaryContent, ElementName=Root}"/>
      </StackPanel>
    </StackPanel>
    <Button Grid.Column="1"
            Classes="sk-primary"
            Command="{Binding AddCommand, ElementName=Root}"
            VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <TextBlock Text="{Binding AddText, ElementName=Root}"/>
        <PathIcon Data="{StaticResource IconAdd}" Width="15" Height="15"/>
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
