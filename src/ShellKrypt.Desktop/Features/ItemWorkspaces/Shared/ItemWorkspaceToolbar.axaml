<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ItemWorkspaces.Shared.ItemWorkspaceToolbar"
             x:Name="Root"
             x:CompileBindings="False">
  <Border Classes="item-workspace-toolbar">
    <Grid ColumnDefinitions="360,*" ColumnSpacing="12">
      <Border Classes="item-workspace-search-shell">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
          <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}"/>
          <TextBox Grid.Column="1"
                   Text="{Binding SearchText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="{Binding SearchPlaceholder, ElementName=Root}"
                   Classes="item-workspace-search"/>
        </Grid>
      </Border>
      <ContentControl Grid.Column="1" Content="{Binding FilterContent, ElementName=Root}" HorizontalAlignment="Left"/>
    </Grid>
  </Border>
</UserControl>
