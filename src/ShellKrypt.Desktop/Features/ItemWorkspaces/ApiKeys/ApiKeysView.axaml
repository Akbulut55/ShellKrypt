<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="using:ShellKrypt.Desktop.Features.ItemWorkspaces.Shared" xmlns:ui="using:ShellKrypt.Desktop.Shell.Dialogs" xmlns:feature="using:ShellKrypt.Desktop.Features.ItemWorkspaces.ApiKeys" x:Class="ShellKrypt.Desktop.Features.ItemWorkspaces.ApiKeys.ApiKeysView" x:DataType="feature:ApiKeysViewModel" x:CompileBindings="False">
  <Grid><Grid Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <shared:ItemWorkspaceHeader Title="{DynamicResource Loc.ApiKeys.Title}" Subtitle="{DynamicResource Loc.ApiKeys.Subtitle}" ResultText="{Binding ResultText}" AddText="{DynamicResource Loc.ApiKeys.Button.Add}" AddCommand="{Binding AddNewCommand}"><shared:ItemWorkspaceHeader.SummaryContent><StackPanel Orientation="Horizontal" Spacing="6"><Border Classes="item-workspace-summary-chip" IsVisible="{Binding HasProviders}"><TextBlock Text="{Binding ProviderSummary}" Classes="item-workspace-summary-text"/></Border><Border Classes="item-workspace-summary-chip" IsVisible="{Binding HasSensitiveFields}"><TextBlock Text="{Binding SensitiveFieldSummary}" Classes="item-workspace-summary-text"/></Border></StackPanel></shared:ItemWorkspaceHeader.SummaryContent></shared:ItemWorkspaceHeader>
    <shared:ItemWorkspaceToolbar Grid.Row="1" SearchText="{Binding SearchText, Mode=TwoWay}" SearchPlaceholder="{DynamicResource Loc.ApiKeys.Search.Placeholder}"><shared:ItemWorkspaceToolbar.FilterContent><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox Classes="sk-combo-filter" Width="140" ItemsSource="{Binding ProviderFilters}" SelectedItem="{Binding SelectedProviderFilter}"/><ComboBox Classes="sk-combo-filter" Width="180" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"/></StackPanel></shared:ItemWorkspaceToolbar.FilterContent></shared:ItemWorkspaceToolbar>
    <Grid Grid.Row="2"><ScrollViewer IsVisible="{Binding ShowRows}" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><shared:ResponsiveItemCardPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="feature:ApiKeyRowVm"><feature:ApiKeyItemView ShowDetailsCommand="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToggleSecretCommand="{Binding DataContext.TogglePrimarySecretCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CopySecretCommand="{Binding DataContext.CopyPrimarySecretCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="{DynamicResource Loc.ItemWorkspace.Loading}" IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="table-empty-subtitle"/><TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/><StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="{Binding EmptyTitle}" Classes="table-empty-title"/><TextBlock Text="{Binding EmptySubtitle}" Classes="table-empty-subtitle"/></StackPanel></Grid>
  </Grid>
  <ui:ModalShell IsOpen="{Binding Editor.IsOpen}" Size="{Binding Editor.ModalSize}" Title="{Binding Editor.ModalTitle}" Subtitle="{Binding Editor.ModalSubtitle}" Error="{Binding Editor.Error}" FooterText="{Binding Editor.FooterText}" CloseCommand="{Binding Editor.CloseCommand}"><ui:ModalShell.HeaderLeadingContent><Border Classes="item-details-header-icon" IsVisible="{Binding Editor.IsDetails}"><PathIcon Data="{StaticResource IconKey}" Width="28" Height="28"/></Border></ui:ModalShell.HeaderLeadingContent><ui:ModalShell.Body><feature:ApiKeyEditorView DataContext="{Binding Editor}"/></ui:ModalShell.Body><ui:ModalShell.FooterContent><shared:ItemEditorFooter Mode="{Binding Editor.Mode}" InfoText="{Binding Editor.FooterText}" CancelText="{DynamicResource Loc.Common.Cancel}" CloseText="{DynamicResource Loc.Common.Close}" SaveText="{DynamicResource Loc.Common.Save}" EditText="{DynamicResource Loc.Common.Edit}" DeleteText="{DynamicResource Loc.Common.Delete}" CancelCommand="{Binding Editor.CancelCommand}" SaveCommand="{Binding Editor.SaveCommand}" EditCommand="{Binding Editor.BeginEditCommand}" DeleteCommand="{Binding Editor.BeginDeleteCommand}" ConfirmDeleteCommand="{Binding Editor.ConfirmDeleteCommand}" CloseCommand="{Binding Editor.CloseCommand}"/></ui:ModalShell.FooterContent></ui:ModalShell>
  </Grid>
</UserControl>
