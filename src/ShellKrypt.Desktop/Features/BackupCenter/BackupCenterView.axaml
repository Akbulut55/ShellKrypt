<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ShellKrypt.Desktop.Features.BackupCenter"
             xmlns:vm="using:ShellKrypt.Desktop.Features.BackupCenter"
             x:Class="ShellKrypt.Desktop.Features.BackupCenter.BackupCenterView"
             x:CompileBindings="False"
             x:DataType="vm:BackupCenterViewModel">
  <ScrollViewer x:Name="BackupCenterScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" MaxWidth="1260" Spacing="14">
      <StackPanel Spacing="6">
        <TextBlock Text="{DynamicResource Loc.BackupCenter.Title}"
                   FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.6"/>
        <TextBlock Text="{DynamicResource Loc.BackupCenter.Subtitle}" Classes="page-subtitle"/>
      </StackPanel>

      <local:BackupHealthView/>

      <Grid ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto,Auto,Auto"
            ColumnSpacing="12"
            RowSpacing="14">
        <local:EncryptedBackupView Grid.Row="0" Grid.Column="0" DataContext="{Binding Encrypted}"/>
        <local:PlaintextExportView Grid.Row="0" Grid.Column="1" DataContext="{Binding Plaintext}"/>

        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Classes="backup-status-message"
                IsVisible="{Binding Operation.HasStatus}">
          <TextBlock Text="{Binding Operation.Status}" Classes="backup-status-message-text"/>
        </Border>

        <local:CsvImportView Grid.Row="2" Grid.Column="0" DataContext="{Binding Csv}"/>
        <local:AutomaticBackupView Grid.Row="2" Grid.Column="1" DataContext="{Binding Automatic}"/>
        <local:BackupHistoryView Grid.Row="3" Grid.ColumnSpan="2" DataContext="{Binding History}"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="Border.backup-block">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Border.backup-block.danger">
      <Setter Property="BorderBrush" Value="{StaticResource DangerMutedBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.backup-health-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="MinHeight" Value="126"/>
    </Style>
    <Style Selector="TextBlock.backup-kicker, TextBlock.backup-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.1"/>
    </Style>
    <Style Selector="TextBlock.backup-section-title">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>
    <Style Selector="TextBlock.backup-status-value">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.backup-muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.backup-status-message">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.backup-status-message-text">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.backup-history-row">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="Border.backup-history-chip">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>
  </UserControl.Styles>
</UserControl>
