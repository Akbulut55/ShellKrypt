<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ProjectSecrets.ProjectSecretSettingsView" x:CompileBindings="False">
  <Grid Margin="0,12" RowDefinitions="Auto,Auto" RowSpacing="14">
    <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="20">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="18">
        <StackPanel Grid.ColumnSpan="2"><TextBlock Text="Project details" Classes="sk-section-title"/><TextBlock Text="Metadata and the local folder used by the scanner." Classes="sk-metadata"/></StackPanel>

        <StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="Name" Classes="sk-label"/><TextBox Text="{Binding Name}" IsReadOnly="{Binding !IsEditing}"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6"><TextBlock Text="Description" Classes="sk-label"/><TextBox Text="{Binding Description}" IsReadOnly="{Binding !IsEditing}"/></StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6"><TextBlock Text="Notes" Classes="sk-label"/><TextBox Text="{Binding Notes}" IsReadOnly="{Binding !IsEditing}" AcceptsReturn="True" MinHeight="100"/></StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="6">
          <TextBlock Text="Project root" Classes="sk-label"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding ProjectRootPath}" IsReadOnly="True"/><Button Grid.Column="1" Content="Choose folder" Classes="sk-secondary" Command="{Binding PickProjectRootCommand}" IsVisible="{Binding IsEditing}"/></Grid>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource DangerMutedBrush}" CornerRadius="8" Padding="16" IsVisible="{Binding HasPersistedProject}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel><TextBlock Text="Delete project" FontWeight="SemiBold"/><TextBlock Text="Permanently removes every environment, profile, variable, and scan result." Classes="sk-metadata" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Delete project" Classes="sk-danger" Command="{Binding DeleteProjectCommand}"/></Grid>
    </Border>
  </Grid>
</UserControl>
