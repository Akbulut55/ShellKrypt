<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ProjectSecrets.ProjectSecretEnvironmentManagerView"
             x:CompileBindings="False">
  <Grid Height="400">
    <Grid ColumnDefinitions="280,*" ColumnSpacing="14" IsVisible="{Binding !IsDeleteConfirmationOpen}">
      <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <StackPanel>
            <TextBlock Text="Environments" Classes="sk-section-title"/>
            <TextBlock Text="Project sections containing one or more profiles." Classes="sk-metadata" TextWrapping="Wrap"/>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Environments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2" Margin="0,0,0,6">
                    <Button Content="{Binding Name}" Classes="sk-chip" Classes.active="{Binding IsSelected}"
                            HorizontalContentAlignment="Left"
                            Command="{Binding $parent[UserControl].DataContext.SelectEnvironmentCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Grid.Column="1" Classes="sk-icon-ghost" ToolTip.Tip="Move environment up"
                            Command="{Binding $parent[UserControl].DataContext.MoveEnvironmentUpCommand}" CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource IconDropUp}" Width="14" Height="14"/>
                    </Button>
                    <Button Grid.Column="2" Classes="sk-icon-ghost" ToolTip.Tip="Move environment down"
                            Command="{Binding $parent[UserControl].DataContext.MoveEnvironmentDownCommand}" CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource IconDropDown}" Width="14" Height="14"/>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding NewEnvironmentName}" PlaceholderText="Environment name"/>
            <Button Grid.Column="1" Content="Add" Classes="sk-primary" Command="{Binding AddEnvironmentCommand}"/>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="14">
        <Grid>
          <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" IsVisible="{Binding HasEnvironment}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding EnvironmentName}"/>
              <Button Grid.Column="1" Content="Rename" Classes="sk-secondary" Command="{Binding RenameEnvironmentCommand}"/>
              <Button Grid.Column="2" Classes="sk-icon-ghost" Foreground="{StaticResource DangerBrush}"
                      Command="{Binding DeleteEnvironmentCommand}" ToolTip.Tip="Delete environment">
                <PathIcon Data="{StaticResource IconTrash}" Width="17" Height="17"/>
              </Button>
            </Grid>

            <TextBlock Grid.Row="1" Text="Profiles" Classes="sk-label"/>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding NewProfileName}" PlaceholderText="Profile name"/>
              <Button Grid.Column="1" Content="Add profile" Classes="sk-primary" Command="{Binding AddProfileCommand}" IsVisible="{Binding !IsRenamingProfile}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRenamingProfile}">
                <Button Content="Cancel" Classes="sk-secondary" Command="{Binding CancelRenameProfileCommand}"/>
                <Button Content="Save name" Classes="sk-primary" Command="{Binding SaveProfileNameCommand}"/>
              </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="2">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Classes="sk-icon-ghost" ToolTip.Tip="Move profile up" Command="{Binding $parent[UserControl].DataContext.MoveProfileUpCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource IconDropUp}" Width="14" Height="14"/></Button>
                        <Button Grid.Column="2" Classes="sk-icon-ghost" ToolTip.Tip="Move profile down" Command="{Binding $parent[UserControl].DataContext.MoveProfileDownCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource IconDropDown}" Width="14" Height="14"/></Button>
                        <Button Grid.Column="3" Classes="sk-icon-ghost" ToolTip.Tip="Rename profile" Command="{Binding $parent[UserControl].DataContext.BeginRenameProfileCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource IconEdit}" Width="16" Height="16"/></Button>
                        <Button Grid.Column="4" Classes="sk-icon-ghost" Foreground="{StaticResource DangerBrush}" ToolTip.Tip="Delete profile" Command="{Binding $parent[UserControl].DataContext.DeleteProfileCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource IconTrash}" Width="16" Height="16"/></Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <StackPanel IsVisible="{Binding !HasEnvironment}" Classes="table-empty">
            <TextBlock Text="No environment selected" Classes="table-empty-title"/>
            <TextBlock Text="Add an environment to begin organizing profiles." Classes="table-empty-subtitle"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource DangerBorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="24" IsVisible="{Binding IsDeleteConfirmationOpen}">
      <StackPanel Spacing="16">
        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource DangerPanelBrush}" HorizontalAlignment="Center">
          <TextBlock Text="!" Foreground="{StaticResource DangerBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding DeleteConfirmationTitle}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding DeleteConfirmationMessage}" Classes="sk-metadata" TextAlignment="Center" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Button Content="Cancel" Classes="sk-secondary" Command="{Binding CancelDeleteCommand}"/>
          <Button Content="Delete" Classes="sk-danger" Command="{Binding ConfirmDeleteCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
