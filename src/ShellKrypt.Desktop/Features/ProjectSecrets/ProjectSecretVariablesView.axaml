<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ProjectSecrets.ProjectSecretVariablesView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" Margin="0,10,0,0" RowSpacing="10">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="12" IsVisible="{Binding HasEnvironment}">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="9">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Text="Environments" Classes="sk-label" VerticalAlignment="Center" Width="92"/>
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Environments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
              <Button Content="{Binding Name}" Classes="sk-chip" Classes.active="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.SelectEnvironmentCommand}" CommandParameter="{Binding}"/>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
          <Button Grid.Column="2" Content="Manage" Classes="sk-secondary" Command="{Binding ManageEnvironmentsCommand}" IsVisible="{Binding IsEditing}"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <TextBlock Text="Profiles" Classes="sk-label" VerticalAlignment="Center" Width="92"/>
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Profiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
              <Button Content="{Binding Name}" Classes="sk-chip" Classes.active="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.SelectProfileCommand}" CommandParameter="{Binding}"/>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="table-shell" MinHeight="280" IsVisible="{Binding HasEnvironment}">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="table-header-row">
          <Grid ColumnDefinitions="2.1*,1.8*,1.3*,2*,Auto" ColumnSpacing="12">
            <TextBlock Text="KEY" Classes="table-header-text"/><TextBlock Grid.Column="1" Text="VALUE" Classes="table-header-text"/><TextBlock Grid.Column="2" Text="SOURCE" Classes="table-header-text"/><TextBlock Grid.Column="3" Text="NOTES" Classes="table-header-text"/><TextBlock Grid.Column="4" Text="ACTIONS" Classes="table-header-text"/>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Variables}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Classes="table-row">
                <Grid ColumnDefinitions="2.1*,1.8*,1.3*,2*,Auto" ColumnSpacing="12" Margin="16,10">
                  <TextBlock Text="{Binding Key}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding ValueDisplay}" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="sk-metadata" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="3" Text="{Binding Notes}" Classes="sk-metadata" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3">
                    <Button Classes="sk-icon-ghost" Command="{Binding $parent[UserControl].DataContext.ToggleVariableCommand}" CommandParameter="{Binding}" ToolTip.Tip="Reveal value"><PathIcon Data="{StaticResource IconEye}" Width="16"/></Button>
                    <Button Classes="sk-icon-ghost" Command="{Binding $parent[UserControl].DataContext.CopyVariableCommand}" CommandParameter="{Binding}" ToolTip.Tip="Copy value"><PathIcon Data="{StaticResource IconCopy}" Width="16"/></Button>
                    <Button Classes="sk-icon-ghost" IsVisible="{Binding $parent[UserControl].DataContext.IsEditing}" Command="{Binding $parent[UserControl].DataContext.EditVariableCommand}" CommandParameter="{Binding}" ToolTip.Tip="Edit variable"><PathIcon Data="{StaticResource IconEdit}" Width="16"/></Button>
                    <Button Classes="sk-icon-ghost" IsVisible="{Binding $parent[UserControl].DataContext.IsEditing}" Command="{Binding $parent[UserControl].DataContext.DeleteVariableCommand}" CommandParameter="{Binding}" ToolTip.Tip="Delete variable"><PathIcon Data="{StaticResource IconTrash}" Width="16"/></Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>

          <StackPanel Classes="table-empty" IsVisible="{Binding ShowNoProfile}"><TextBlock Text="No profiles in this environment" Classes="table-empty-title"/><TextBlock Text="Add a profile before storing variables." Classes="table-empty-subtitle"/><Button Content="Manage profiles" Classes="sk-primary" Command="{Binding ManageEnvironmentsCommand}" IsVisible="{Binding IsEditing}" HorizontalAlignment="Center"/></StackPanel>
          <StackPanel Classes="table-empty" IsVisible="{Binding ShowNoVariables}"><TextBlock Text="No variables in this profile" Classes="table-empty-title"/><TextBlock Text="Add a secret value or reference an existing API Key." Classes="table-empty-subtitle"/></StackPanel>
        </Grid>
        <Border Grid.Row="2" Classes="table-footer-row" IsVisible="{Binding IsEditing}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Reference API Key" Classes="sk-secondary" Command="{Binding ReferenceApiKeyCommand}" IsEnabled="{Binding CanAddVariable}"/><Button Content="Add variable" Classes="sk-primary" Command="{Binding AddVariableCommand}" IsEnabled="{Binding CanAddVariable}"/></StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="28" MinHeight="220" IsVisible="{Binding !HasEnvironment}">
      <StackPanel Classes="table-empty">
        <TextBlock Text="Set up your first environment" Classes="table-empty-title"/>
        <TextBlock Text="Environments group parts of a project. Add profiles inside them before storing variables." Classes="table-empty-subtitle"/>
        <Button Content="Add environment" Classes="sk-primary" Command="{Binding ManageEnvironmentsCommand}" IsVisible="{Binding IsEditing}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
