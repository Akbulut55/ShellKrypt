<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ProjectSecrets.ProjectSecretImportExportView" x:CompileBindings="False">
  <Grid>
  <ScrollViewer IsVisible="{Binding IsEnabled}">
    <StackPanel Margin="0,12" Spacing="14" HorizontalAlignment="Stretch">
      <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="16">
        <Grid ColumnDefinitions="Auto,260,260" ColumnSpacing="12">
          <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="Target" Classes="sk-label"/>
            <TextBlock Text="Choose where variables are read or written." Classes="sk-metadata"/>
          </StackPanel>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" Classes="sk-combo-modal" PlaceholderText="Environment">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Classes="sk-combo-modal" PlaceholderText="Profile">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="12">
            <StackPanel><TextBlock Text="Import .env" Classes="sk-section-title"/><TextBlock Text="Preview keys before modifying the selected profile." Classes="sk-metadata"/></StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding ImportPath}" PlaceholderText="Select .env file"/><Button Grid.Column="1" Content="Browse" Classes="sk-secondary" Command="{Binding PickImportFileCommand}"/></Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Replace conflicts" Classes="sk-chip" Classes.active="{Binding ReplaceExisting}" Command="{Binding UseReplaceExistingCommand}"/>
              <Button Content="Skip conflicts" Classes="sk-chip" Classes.active="{Binding SkipExisting}" Command="{Binding UseSkipExistingCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Preview" Classes="sk-secondary" Command="{Binding PreviewImportCommand}" IsEnabled="{Binding CanOperate}"/><Button Content="Import" Classes="sk-primary" Command="{Binding ApplyImportCommand}" IsEnabled="{Binding CanImport}"/></StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="12">
            <StackPanel><TextBlock Text="Export .env" Classes="sk-section-title"/><TextBlock Text="Templates contain keys only. Value exports write plaintext secrets." Classes="sk-metadata" TextWrapping="Wrap"/></StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding ExportPath}" PlaceholderText="Output file"/><Button Grid.Column="1" Content="Browse" Classes="sk-secondary" Command="{Binding PickExportFileCommand}"/></Grid>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Export template" Classes="sk-secondary" Command="{Binding ExportTemplateCommand}" IsEnabled="{Binding CanOperate}"/><Button Content="Export values" Classes="sk-primary" Command="{Binding ExportValuesCommand}" IsEnabled="{Binding CanOperate}"/></StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="table-shell" IsVisible="{Binding HasPreview}">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="table-header-row"><Grid ColumnDefinitions="60,2*,110,3*"><TextBlock Text="LINE" Classes="table-header-text"/><TextBlock Grid.Column="1" Text="KEY" Classes="table-header-text"/><TextBlock Grid.Column="2" Text="STATUS" Classes="table-header-text"/><TextBlock Grid.Column="3" Text="DETAIL" Classes="table-header-text"/></Grid></Border>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding PreviewRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="table-row" Padding="16,10"><Grid ColumnDefinitions="60,2*,110,3*"><TextBlock Text="{Binding LineNumber}" Classes="sk-metadata"/><TextBlock Grid.Column="1" Text="{Binding Key}" FontFamily="{StaticResource MonoFont}"/><TextBlock Grid.Column="2" Text="{Binding Status}"/><TextBlock Grid.Column="3" Text="{Binding Message}" Classes="sk-metadata" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Grid>
      </Border>
      <TextBlock Text="{Binding Status}" Classes="sk-metadata"/><TextBlock Text="{Binding Error}" Classes="sk-error"/>
    </StackPanel>
  </ScrollViewer>
  <StackPanel Classes="table-empty" IsVisible="{Binding ShowUnavailable}">
    <TextBlock Text="Save the project first" Classes="table-empty-title"/>
    <TextBlock Text="Import and export become available after the project has been saved." Classes="table-empty-subtitle"/>
  </StackPanel>
  </Grid>
</UserControl>
