<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:feature="using:ShellKrypt.Desktop.Features.ProjectSecrets"
             xmlns:ui="using:ShellKrypt.Desktop.Shell.Dialogs"
             x:Class="ShellKrypt.Desktop.Features.ProjectSecrets.ProjectSecretsView"
             x:DataType="feature:ProjectSecretsViewModel"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="TabControl.project-secret-tabs">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabItem.project-secret-tab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="Padding" Value="4,8,4,9"/>
      <Setter Property="Margin" Value="0,0,20,0"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TabItem.project-secret-tab:pointerover">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabItem.project-secret-tab:selected">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="20,12,20,16" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding HeaderName}" Classes="sk-page-title" FontSize="24"/>
          <Button x:Name="ProjectPickerButton" Classes="sk-icon" Command="{Binding ToggleProjectPickerCommand}" IsEnabled="{Binding !IsEditing}" ToolTip.Tip="Select project">
            <PathIcon Data="{StaticResource IconDropDown}" Width="16" Height="16"/>
          </Button>
          <Border Background="{StaticResource WarningMutedBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" IsVisible="{Binding HasPersistedProject}">
            <TextBlock Text="{Binding WarningCount, StringFormat={}{0} warnings}" Foreground="{StaticResource WarningBrush}" FontSize="11"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Project root:" Classes="sk-metadata"/>
          <TextBlock Text="{Binding RootDisplay}" Classes="sk-metadata"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Edit" Classes="sk-secondary" Command="{Binding EditProjectCommand}" IsVisible="{Binding HasPersistedProject}" IsEnabled="{Binding !IsEditing}"/>
        <Button Content="Cancel" Classes="sk-secondary" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}"/>
        <Button Content="Save" Classes="sk-primary" Command="{Binding SaveProjectCommand}" IsVisible="{Binding IsEditing}"/>
      </StackPanel>

      <Popup IsOpen="{Binding IsProjectPickerOpen}" PlacementTarget="{Binding #ProjectPickerButton}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
        <Border Classes="sk-picker-popup" Width="380" MaxHeight="440">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Text="Select project" Classes="sk-section-title"/><TextBlock Text="{Binding ProjectCountText}" Classes="sk-metadata"/></StackPanel>
              <Button Grid.Column="1" Content="+ Add" Classes="sk-primary" Command="{Binding AddProjectCommand}"/>
            </Grid>
            <TextBox Grid.Row="1" Text="{Binding SearchText}" PlaceholderText="Search projects..." Classes="sk-picker-search"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Projects}"><ItemsControl.ItemTemplate><DataTemplate>
                <Button Classes="sk-picker-option" Command="{Binding $parent[UserControl].DataContext.SelectProjectCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Classes="sk-metadata"/><TextBlock Text="{Binding RootDisplay}" Classes="sk-metadata"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding WarningCount, StringFormat={}{0} warnings}" Foreground="{StaticResource WarningBrush}" FontSize="11"/></Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Popup>
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="*,Auto">
      <TabControl Classes="project-secret-tabs">
        <TabItem Header="Variables" Classes="project-secret-tab"><feature:ProjectSecretVariablesView DataContext="{Binding Variables}"/></TabItem>
        <TabItem Header="Import / Export" Classes="project-secret-tab"><feature:ProjectSecretImportExportView DataContext="{Binding ImportExport}"/></TabItem>
        <TabItem Header="Compare" Classes="project-secret-tab"><feature:ProjectSecretCompareView DataContext="{Binding Compare}"/></TabItem>
        <TabItem Header="Scanner" Classes="project-secret-tab"><feature:ProjectSecretScannerView DataContext="{Binding Scanner}"/></TabItem>
        <TabItem Header="Settings" Classes="project-secret-tab"><feature:ProjectSecretSettingsView DataContext="{Binding Settings}"/></TabItem>
      </TabControl>
      <TextBlock Grid.Row="1" Text="{Binding Error}" Classes="sk-error" Margin="8,4"/>
    </Grid>

    <ui:ModalShell Grid.RowSpan="2" ZIndex="1000"
                   IsOpen="{Binding EnvironmentManager.IsOpen}" Title="Environments" Subtitle="Manage environments and their profiles." Size="Wide" Error="{Binding EnvironmentManager.Error}" CloseCommand="{Binding EnvironmentManager.CloseCommand}">
      <ui:ModalShell.Body><feature:ProjectSecretEnvironmentManagerView DataContext="{Binding EnvironmentManager}"/></ui:ModalShell.Body>
    </ui:ModalShell>
    <ui:ModalShell Grid.RowSpan="2" ZIndex="1000"
                   IsOpen="{Binding Variables.Editor.IsOpen}" Title="{Binding Variables.Editor.Title}" Subtitle="Store a value manually or use an existing API Key." Size="Standard" Error="{Binding Variables.Editor.Error}" CloseCommand="{Binding Variables.Editor.CloseCommand}">
      <ui:ModalShell.Body><feature:ProjectSecretVariableEditorView DataContext="{Binding Variables.Editor}"/></ui:ModalShell.Body>
      <ui:ModalShell.FooterActions><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Cancel" Classes="sk-secondary" Command="{Binding Variables.Editor.CloseCommand}"/><Button Content="Save" Classes="sk-primary" Command="{Binding Variables.Editor.SaveCommand}"/></StackPanel></ui:ModalShell.FooterActions>
    </ui:ModalShell>
  </Grid>
</UserControl>
