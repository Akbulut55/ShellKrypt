<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ProjectSecrets.ProjectSecretCompareView" x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12">
    <Grid ColumnDefinitions="Auto,280,*" ColumnSpacing="12">
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Compare profiles" Classes="sk-section-title"/><TextBlock Text="Values remain hidden; only their status is compared." Classes="sk-metadata"/></StackPanel>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" Classes="sk-combo-filter" PlaceholderText="Environment"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    </Grid>
    <Border Grid.Row="1" Classes="table-shell" IsVisible="{Binding HasRows}">
      <ScrollViewer><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Classes="table-row" Padding="16,12"><Grid ColumnDefinitions="220,*" ColumnSpacing="16"><TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" VerticalAlignment="Center"/><ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,4"><StackPanel><TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Classes="sk-metadata"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Border>
    <StackPanel Grid.Row="1" Classes="table-empty" IsVisible="{Binding ShowEmpty}"><TextBlock Text="Nothing to compare" Classes="table-empty-title"/><TextBlock Text="This environment needs profiles with variables before differences can be shown." Classes="table-empty-subtitle"/></StackPanel>
    <StackPanel Grid.Row="1" Classes="table-empty" IsVisible="{Binding !HasEnvironment}"><TextBlock Text="No environment available" Classes="table-empty-title"/><TextBlock Text="Create an environment and profiles in the Variables tab first." Classes="table-empty-subtitle"/></StackPanel>
  </Grid>
</UserControl>
