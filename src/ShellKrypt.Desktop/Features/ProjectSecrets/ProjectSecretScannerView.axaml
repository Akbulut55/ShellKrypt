<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ProjectSecrets.ProjectSecretScannerView" x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="0,12">
    <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding IsEnabled}">
      <Grid ColumnDefinitions="*,220,220,Auto,Auto" ColumnSpacing="8">
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Scan project" Classes="sk-section-title"/><TextBlock Text="{Binding ProjectRootDisplay}" Classes="sk-metadata" TextTrimming="CharacterEllipsis"/></StackPanel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" Classes="sk-combo-filter" PlaceholderText="Environment"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Classes="sk-combo-filter" PlaceholderText="Profile"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <Button Grid.Column="3" Content="Scan" Classes="sk-primary" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}"/>
        <Button Grid.Column="4" Content="Cancel" Classes="sk-secondary" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="1"><TextBlock Text="{Binding Status}" Classes="sk-metadata"/><TextBlock Text="{Binding Error}" Classes="sk-error"/></StackPanel>
    <Border Grid.Row="2" Classes="table-shell" IsVisible="{Binding HasFindings}">
      <ScrollViewer><ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="table-row" Padding="16,12"><Grid ColumnDefinitions="110,*,220" ColumnSpacing="12"><TextBlock Text="{Binding Severity}" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding VariableKey}" Classes="sk-metadata" FontFamily="{StaticResource MonoFont}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Location}" Classes="sk-metadata" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Classes="table-empty" IsVisible="{Binding ShowEmpty}"><TextBlock Text="No scan findings" Classes="table-empty-title"/><TextBlock Text="Run a profile-scoped scan to find used, unused, missing, or exposed variables." Classes="table-empty-subtitle"/></StackPanel>
    <StackPanel Grid.RowSpan="3" Classes="table-empty" IsVisible="{Binding ShowUnavailable}"><TextBlock Text="Save the project first" Classes="table-empty-title"/><TextBlock Text="Project scanning becomes available after the project and its root folder have been saved." Classes="table-empty-subtitle"/></StackPanel>
  </Grid>
</UserControl>
