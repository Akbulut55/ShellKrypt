<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Features.ProjectSecrets.ProjectSecretVariableEditorView"
             x:CompileBindings="False">
  <StackPanel Spacing="14">
    <StackPanel Spacing="6">
      <TextBlock Text="Value source" Classes="sk-label"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Manual" Classes="sk-chip" Classes.active="{Binding IsManualSource}" Command="{Binding UseManualCommand}"/>
        <Button Content="Reference API Key" Classes="sk-chip" Classes.active="{Binding IsReferenceSource}" Command="{Binding UseReferenceCommand}"/>
        <Button Content="Import API Key copy" Classes="sk-chip" Classes.active="{Binding IsImportedCopySource}" Command="{Binding UseImportedCopyCommand}"/>
      </StackPanel>
      <TextBlock Text="References follow the original API Key. Imported copies are independent."
                 Classes="sk-metadata" TextWrapping="Wrap" IsVisible="{Binding IsApiKeySource}"/>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Variable key" Classes="sk-label"/>
      <TextBox Text="{Binding Key}" PlaceholderText="DATABASE_URL"/>
    </StackPanel>

    <StackPanel Spacing="6" IsVisible="{Binding IsApiKeySource}">
      <TextBlock Text="API Key field" Classes="sk-label"/>
      <ComboBox ItemsSource="{Binding ApiKeyFields}" SelectedItem="{Binding SelectedApiKeyField}" Classes="sk-combo-modal">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <StackPanel Spacing="6" IsVisible="{Binding IsManual}">
      <TextBlock Text="Value" Classes="sk-label"/>
      <TextBox Text="{Binding Value}" PlaceholderText="Secret or configuration value"/>
    </StackPanel>

    <CheckBox Content="Mask this value as a secret" IsChecked="{Binding IsSecret}"/>

    <StackPanel Spacing="6">
      <TextBlock Text="Notes" Classes="sk-label"/>
      <TextBox Text="{Binding Notes}" PlaceholderText="Optional context" AcceptsReturn="True" MinHeight="82"/>
    </StackPanel>
  </StackPanel>
</UserControl>
