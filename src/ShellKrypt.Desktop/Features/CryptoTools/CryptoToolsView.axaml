<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.Features.CryptoTools"
             x:Class="ShellKrypt.Desktop.Features.CryptoTools.CryptoToolsView"
             x:CompileBindings="False"
             x:DataType="vm:CryptoToolsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16"
                HorizontalAlignment="Stretch"
                Spacing="14">
      <StackPanel Spacing="8"
                  HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Loc.CryptoTools.Password.Title}"
                   FontSize="30"
                   FontWeight="SemiBold"
                   LetterSpacing="-0.6"/>
        <TextBlock Text="{DynamicResource Loc.CryptoTools.Password.Subtitle}"
                   Classes="page-subtitle"
                   MaxWidth="620"
                   HorizontalAlignment="Left"
                   TextAlignment="Left"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border Classes="stitch-hero-card"
              ClipToBounds="True"
              Padding="16">
        <Grid ColumnDefinitions="*,40"
              ColumnSpacing="12">
          <StackPanel Spacing="12">
            <Border Classes="stitch-output"
                    ClipToBounds="True"
                    Height="78"
                    Padding="14,10">
              <SelectableTextBlock Text="{Binding GeneratedPasswordDisplay}"
                                   Classes="stitch-password-output"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Top"/>
            </Border>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="14"
                  VerticalAlignment="Center">
              <ProgressBar Minimum="0"
                           Maximum="100"
                           Value="{Binding PasswordStrengthScore}"
                           Height="6"
                           Foreground="{Binding PasswordStrengthBrush, Converter={StaticResource ThemeResourceBrushConverter}}"
                           Background="{StaticResource SurfaceBrush}"
                           VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding PasswordStrengthLabel}"
                         Classes="stitch-kicker"
                         Foreground="{Binding PasswordStrengthBrush, Converter={StaticResource ThemeResourceBrushConverter}}"
                         VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Spacing="8"
                      VerticalAlignment="Center">
            <Button Width="40"
                    Height="40"
                    Padding="0"
                    Classes="sk-primary"
                    Command="{Binding CopyGeneratedPasswordCommand}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="{DynamicResource Loc.CryptoTools.Tooltip.CopyPassword}">
              <PathIcon Data="{StaticResource IconContentCopy}"
                        Width="18"
                        Height="18"
                        Foreground="{StaticResource AccentForegroundBrush}"/>
            </Button>
            <Button Width="40"
                    Height="40"
                    Padding="0"
                    Classes="sk-icon"
                    Command="{Binding GeneratePasswordCommand}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="{DynamicResource Loc.CryptoTools.Tooltip.GeneratePassword}">
              <PathIcon Data="{StaticResource IconAutoRenew}"
                        Width="19"
                        Height="19"
                        Foreground="{StaticResource AccentBrush}"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="1.35*,*"
            ColumnSpacing="12">
        <Border Classes="stitch-card"
                Padding="16">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Password.Length}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <Border Grid.Column="1"
                      Classes="stitch-length-badge">
                <TextBlock Text="{Binding PasswordLengthDisplay}"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
              </Border>
            </Grid>

            <Slider Classes="sk-slider"
                    Minimum="1"
                    Maximum="100"
                    Value="{Binding PasswordLength}"/>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource Loc.CryptoTools.Password.Min}"
                         Classes="stitch-kicker"
                         Opacity="0.55"/>
              <TextBlock Grid.Column="1"
                         Text="{DynamicResource Loc.CryptoTools.Password.Max}"
                         Classes="stitch-kicker"
                         Opacity="0.55"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Classes="stitch-card"
                Padding="16">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Password.Uppercase}"
                         FontSize="14"
                         FontWeight="Medium"
                         VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1"
                            Classes="sk-switch"
                            IsChecked="{Binding IncludeUppercase}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Password.Lowercase}"
                         FontSize="14"
                         FontWeight="Medium"
                         VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1"
                            Classes="sk-switch"
                            IsChecked="{Binding IncludeLowercase}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Password.Numbers}"
                         FontSize="14"
                         FontWeight="Medium"
                         VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1"
                            Classes="sk-switch"
                            IsChecked="{Binding IncludeNumbers}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Password.Symbols}"
                         FontSize="14"
                         FontWeight="Medium"
                         VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1"
                            Classes="sk-switch"
                            IsChecked="{Binding IncludeSymbols}"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="Auto,*"
            ColumnSpacing="16"
            VerticalAlignment="Center"
            Margin="0,12,0,0">
        <TextBlock Text="{DynamicResource Loc.CryptoTools.Workbench.Title}"
                   FontSize="20"
                   FontWeight="SemiBold"/>
        <Border Grid.Column="1"
                Height="1"
                Background="{StaticResource BorderBrushSoft}"
                VerticalAlignment="Center"/>
      </Grid>

      <Grid ColumnDefinitions="1.05*,*"
            ColumnSpacing="12">
        <Border Classes="stitch-card"
                Padding="16">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
              <PathIcon Data="{StaticResource IconHash}"
                        Width="18"
                        Height="18"
                        Foreground="{StaticResource AccentBrush}"
                        VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Hash.Title}"
                         Classes="stitch-section-label"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Hash.Input}"
                         Classes="stitch-kicker"/>
              <TextBox Text="{Binding HashInput}"
                       Classes="sk-input sk-textarea"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="80"
                       PlaceholderText="{DynamicResource Loc.CryptoTools.Hash.Placeholder}"
                       FontFamily="{StaticResource MonoFontFamily}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10">
              <Button Content="SHA-256"
                      Classes="sk-button"
                      Command="{Binding Sha256Command}"/>
              <Button Grid.Column="1"
                      Content="SHA-512"
                      Classes="sk-button"
                      Command="{Binding Sha512Command}"/>
            </Grid>

            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Hash.Result}"
                         Classes="stitch-kicker"/>
              <Border Classes="stitch-output"
                      ClipToBounds="True"
                      Height="68"
                      Padding="12">
                <SelectableTextBlock Text="{Binding HashOutputDisplay}"
                                     Classes="stitch-utility-output"
                                     ClipToBounds="True"
                                     HorizontalAlignment="Stretch"
                                     TextWrapping="NoWrap"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Classes="stitch-card"
                Padding="16">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
              <PathIcon Data="{StaticResource IconBase64}"
                        Width="18"
                        Height="18"
                        Foreground="{StaticResource AccentBrush}"
                        VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Base64.Title}"
                         Classes="stitch-section-label"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Base64.Input}"
                         Classes="stitch-kicker"/>
              <TextBox Text="{Binding Base64Input}"
                       Classes="sk-input sk-textarea"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="80"
                       PlaceholderText="{DynamicResource Loc.CryptoTools.Base64.Placeholder}"
                       FontFamily="{StaticResource MonoFontFamily}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="16">
              <Button Content="ENCODE"
                      Classes="sk-primary"
                      Command="{Binding Base64EncodeCommand}"/>
              <Button Grid.Column="1"
                      Content="DECODE"
                      Classes="sk-button"
                      Command="{Binding Base64DecodeCommand}"/>
            </Grid>

            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.CryptoTools.Base64.Output}"
                         Classes="stitch-kicker"/>
              <Border Classes="stitch-output"
                      ClipToBounds="True"
                      Height="68"
                      Padding="12">
                <SelectableTextBlock Text="{Binding Base64OutputDisplay}"
                                     Classes="stitch-utility-output"
                                     ClipToBounds="True"
                                     HorizontalAlignment="Stretch"
                                     TextWrapping="NoWrap"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="Border.stitch-hero-card">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.stitch-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.stitch-output">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Border.stitch-length-badge">
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,5"/>
    </Style>


    <Style Selector="SelectableTextBlock.stitch-password-output">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="LineHeight" Value="26"/>
      <Setter Property="LetterSpacing" Value="0.7"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style Selector="SelectableTextBlock.stitch-utility-output">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="LetterSpacing" Value="0.2"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style Selector="TextBlock.stitch-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="1.6"/>
    </Style>

    <Style Selector="TextBlock.stitch-section-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="1.4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
</UserControl>
