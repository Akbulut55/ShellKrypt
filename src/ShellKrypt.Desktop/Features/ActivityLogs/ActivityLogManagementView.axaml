<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ShellKrypt.Desktop.Features.ActivityLogs"
             x:Class="ShellKrypt.Desktop.Features.ActivityLogs.ActivityLogManagementView"
             x:DataType="local:ActivityLogManagementViewModel">
  <Border Classes="activity-detail-card">
    <StackPanel Spacing="10">
      <TextBlock Text="{DynamicResource Loc.Activity.Management.Title}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Black" LetterSpacing="2.2"/>
      <TextBlock Text="{DynamicResource Loc.Activity.Management.Subtitle}" Classes="page-subtitle" FontSize="11" TextWrapping="Wrap"/>
      <Button Content="{DynamicResource Loc.Activity.Button.ExportAll}" Classes="sk-secondary activity-management-button" Command="{Binding ExportAllCommand}"/>
      <Button Content="{DynamicResource Loc.Activity.Button.ExportFiltered}" Classes="sk-secondary activity-management-button" Command="{Binding ExportFilteredCommand}"/>
      <Button Content="{DynamicResource Loc.Activity.Button.ClearLogs}" Classes="sk-secondary activity-management-button" Command="{Binding ClearCommand}"/>
      <TextBlock Text="{Binding Status}" Foreground="{StaticResource WarningForegroundBrush}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasStatus}"/>
      <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
    </StackPanel>
  </Border>
</UserControl>
