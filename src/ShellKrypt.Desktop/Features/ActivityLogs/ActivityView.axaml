<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ShellKrypt.Desktop.Features.ActivityLogs"
             x:Class="ShellKrypt.Desktop.Features.ActivityLogs.ActivityView"
             x:DataType="local:ActivityViewModel">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
    <StackPanel Spacing="6">
      <TextBlock Text="{DynamicResource Loc.Activity.Title}" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.8"/>
      <TextBlock Text="{DynamicResource Loc.Activity.Subtitle}" Classes="page-subtitle" FontSize="13"/>
    </StackPanel>

    <Border Grid.Row="1" Classes="activity-warning" IsVisible="{Binding HasCorruptionWarning}">
      <TextBlock Text="{Binding CorruptionWarning}" TextWrapping="Wrap"/>
    </Border>
    <Border Grid.Row="1" Classes="activity-error" IsVisible="{Binding HasLoadFailure}">
      <TextBlock Text="{Binding LoadFailureMessage}" TextWrapping="Wrap"/>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <WrapPanel Orientation="Horizontal">
        <Border Classes="activity-search-shell">
          <TextBox Text="{Binding List.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Classes="sk-search-input" PlaceholderText="{DynamicResource Loc.Activity.Search.Placeholder}"/>
        </Border>
        <Button Content="{DynamicResource Loc.Common.All}" Classes="sk-chip activity-filter-chip"
                Classes.active="{Binding List.IsAllFilterActive}" Command="{Binding List.ShowAllCommand}"/>
        <Button Content="{DynamicResource Loc.Activity.Filter.Vault}" Classes="sk-chip activity-filter-chip"
                Classes.active="{Binding List.IsVaultFilterActive}" Command="{Binding List.ShowVaultCommand}"/>
        <Button Content="{DynamicResource Loc.Activity.Filter.Items}" Classes="sk-chip activity-filter-chip"
                Classes.active="{Binding List.IsItemsFilterActive}" Command="{Binding List.ShowItemsCommand}"/>
        <Button Content="{DynamicResource Loc.Activity.Filter.Audit}" Classes="sk-chip activity-filter-chip"
                Classes.active="{Binding List.IsAuditFilterActive}" Command="{Binding List.ShowAuditCommand}"/>
        <Button Content="{DynamicResource Loc.Activity.Filter.Export}" Classes="sk-chip activity-filter-chip"
                Classes.active="{Binding List.IsTransferFilterActive}" Command="{Binding List.ShowTransferCommand}"/>
        <Button Content="{DynamicResource Loc.Activity.Filter.Settings}" Classes="sk-chip activity-filter-chip"
                Classes.active="{Binding List.IsSettingsFilterActive}" Command="{Binding List.ShowSettingsCommand}"/>
      </WrapPanel>
      <Button Grid.Column="1" Content="{DynamicResource Loc.Activity.Button.Refresh}" Classes="sk-secondary" Command="{Binding RefreshCommand}"/>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,280" ColumnSpacing="12" MinWidth="650">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <ComboBox ItemsSource="{Binding List.SeverityOptions}" SelectedItem="{Binding List.SelectedSeverityOption}"
                    DisplayMemberBinding="{Binding Label}" Classes="sk-combo-compact"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding List.DateRangeOptions}" SelectedItem="{Binding List.SelectedDateRangeOption}"
                    DisplayMemberBinding="{Binding Label}" Classes="sk-combo-compact"/>
          <ComboBox Grid.Column="2" ItemsSource="{Binding List.SortOptions}" SelectedItem="{Binding List.SelectedSortOption}"
                    DisplayMemberBinding="{Binding Label}" Classes="sk-combo-compact"/>
        </Grid>
        <local:ActivityLogListView Grid.Row="1" DataContext="{Binding List}"/>
      </Grid>

      <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
        <local:ActivityLogDetailsView DataContext="{Binding Details}"/>
        <local:ActivityLogManagementView Grid.Row="1" DataContext="{Binding Management}"/>
      </Grid>
    </Grid>
  </Grid>
  <UserControl.Styles>
    <StyleInclude Source="avares://ShellKrypt/Features/ActivityLogs/ActivityLogStyles.axaml"/>
  </UserControl.Styles>
</UserControl>
