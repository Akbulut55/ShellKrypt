<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:ShellKrypt.Desktop.Features.MarkdownNotes"
             x:Class="ShellKrypt.Desktop.Features.MarkdownNotes.MarkdownNoteEditorView"
             x:DataType="vm:MarkdownNotesViewModel"
             d:DesignWidth="600" d:DesignHeight="600">
  <UserControl.Styles>
    <StyleInclude Source="avares://ShellKrypt/Features/MarkdownNotes/MarkdownNotesStyles.axaml"/>
  </UserControl.Styles>
  <TextBox Text="{Binding EditorContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
           Classes="notesMarkdownEditor" AcceptsReturn="True" TextWrapping="Wrap"
           PlaceholderText="{DynamicResource Loc.Notes.Editor.Placeholder}"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           ScrollViewer.VerticalScrollBarVisibility="Auto"/>
</UserControl>
