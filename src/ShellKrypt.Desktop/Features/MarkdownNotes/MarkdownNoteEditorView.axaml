<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:ShellKrypt.Desktop.Features.MarkdownNotes"
             xmlns:editor="using:AvaloniaEdit"
             x:Class="ShellKrypt.Desktop.Features.MarkdownNotes.MarkdownNoteEditorView"
             x:DataType="vm:MarkdownNotesViewModel"
             d:DesignWidth="600" d:DesignHeight="600">
  <UserControl.Styles>
    <StyleInclude Source="avares://ShellKrypt/Features/MarkdownNotes/MarkdownNotesStyles.axaml"/>
  </UserControl.Styles>
  <Border Classes="notesDocumentSurface notesEditorSurface">
    <Grid>
      <editor:TextEditor x:Name="Editor" Document="{Binding EditorDocument}"
                         Classes="notesMarkdownEditor"
                         WordWrap="True"
                         IsReadOnly="False"
                         ShowLineNumbers="False"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"/>
      <TextBlock Text="{DynamicResource Loc.Notes.Editor.Placeholder}"
                 IsVisible="{Binding ShowEditorPlaceholder}"
                 IsHitTestVisible="False" Margin="4,2"
                 Foreground="{StaticResource TextMutedBrush}"/>
    </Grid>
  </Border>
</UserControl>
