<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:ShellKrypt.Desktop.Features.MarkdownNotes"
             x:Class="ShellKrypt.Desktop.Features.MarkdownNotes.MarkdownNotesView"
             x:DataType="vm:MarkdownNotesViewModel"
             d:DesignWidth="1200" d:DesignHeight="760">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseNoteLibraryCommand}"/>
  </UserControl.KeyBindings>

  <Grid Background="{StaticResource AppBackgroundBrush}" RowDefinitions="Auto,Auto,*">
    <vm:MarkdownNotesHeaderView/>

    <StackPanel Grid.Row="1" Margin="16,0,16,10" Spacing="8">
      <Border Classes="notesErrorBanner" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}"
                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
      </Border>
      <Border Classes="notesWarningBanner" IsVisible="{Binding HasWarning}">
        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}"
                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>

    <vm:MarkdownNotesWorkspaceView Grid.Row="2"/>

    <Grid Grid.RowSpan="3" IsVisible="{Binding IsNoteLibraryOpen}">
      <Button Classes="notesLibraryBackdrop" Command="{Binding CloseNoteLibraryCommand}"/>
      <vm:MarkdownNotesLibraryView Width="560" MaxWidth="{Binding $parent[Grid].Bounds.Width}"
                                   MaxHeight="620" Margin="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
  </Grid>

  <UserControl.Styles>
    <StyleInclude Source="avares://ShellKrypt/Features/MarkdownNotes/MarkdownNotesStyles.axaml"/>
  </UserControl.Styles>
</UserControl>
