<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Border.notesHeader">
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="16,14"/>
  </Style>

  <Style Selector="Button.notesLibraryButton">
    <Setter Property="MinWidth" Value="108"/>
  </Style>

  <Style Selector="TextBlock.notesDocumentTitle">
    <Setter Property="FontSize" Value="23"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxWidth" Value="560"/>
  </Style>

  <Style Selector="TextBox.notesHeaderTitleInput">
    <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="MinWidth" Value="220"/>
    <Setter Property="MaxWidth" Value="560"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="10,5"/>
  </Style>

  <Style Selector="Border.notesModeGroup">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="3"/>
  </Style>

  <Style Selector="Button.notesModeButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="10,5"/>
  </Style>

  <Style Selector="Button.notesModeButton:pointerover">
    <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
  </Style>

  <Style Selector="Button.notesModeButton.active">
    <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
  </Style>

  <Style Selector="Button.notesActionButton">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinWidth" Value="36"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style Selector="Button.notesDeleteAction">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
  </Style>

  <Style Selector="TextBlock.notesMutedText">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style Selector="TextBlock.notesSaveStatus">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Border.notesPane">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.notesSinglePane">
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <Style Selector="TextBlock.notesPaneTitle">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="LetterSpacing" Value="2.2"/>
    <Setter Property="Margin" Value="18,13,18,11"/>
  </Style>

  <Style Selector="Border.notesDocumentSurface">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Padding" Value="28,24"/>
  </Style>

  <Style Selector="TextBox.notesMarkdownEditor">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="24"/>
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
  </Style>

  <Style Selector="Button.notesLibraryBackdrop">
    <Setter Property="Background" Value="{StaticResource OverlaySoftScrimBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Button.notesLibraryBackdrop:pointerover">
    <Setter Property="Background" Value="{StaticResource OverlaySoftScrimBrush}"/>
  </Style>

  <Style Selector="Border.notesLibraryPanel">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="22"/>
  </Style>

  <Style Selector="Border.notesLibrarySearchShell">
    <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="11,7"/>
  </Style>

  <Style Selector="TextBlock.notesKicker">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="LetterSpacing" Value="2.2"/>
  </Style>

  <Style Selector="TextBlock.notesLibraryCount">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <Style Selector="Border.notesLibraryItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="5"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <Style Selector="Border.notesLibraryItem:pointerover">
    <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
  </Style>

  <Style Selector="Border.notesLibraryItem.active">
    <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
  </Style>

  <Style Selector="Button.notesLibraryItemButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Button.notesLibraryItemButton:pointerover">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="Button.notesLibraryDeleteButton">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="TextBlock.notesLibraryTimestamp">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <Style Selector="Border.notesLibraryEmpty">
    <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="18"/>
  </Style>

  <Style Selector="Border.notesEmptyIcon">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="15"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.notesErrorBanner">
    <Setter Property="Background" Value="{StaticResource DangerPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,9"/>
  </Style>

  <Style Selector="Border.notesWarningBanner">
    <Setter Property="Background" Value="{StaticResource WarningMutedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,9"/>
  </Style>

  <Style Selector="Border.notesPreviewPlaceholder">
    <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="20,18"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <Style Selector="TextBlock.notesMarkdownH1">
    <Setter Property="FontSize" Value="27"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style Selector="TextBlock.notesMarkdownH2">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style Selector="TextBlock.notesMarkdownH3">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style Selector="TextBlock.notesMarkdownParagraph">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="24"/>
  </Style>
  <Style Selector="TextBlock.notesMarkdownListItem">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="24"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="TextBlock.notesMarkdownCode">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="LineHeight" Value="21"/>
  </Style>
</Styles>
