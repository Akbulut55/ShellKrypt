<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShellKrypt.Desktop.Views.PasswordPromptWindow"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Title="Confirm Password"
        TransparencyLevelHint="None"
        Background="{StaticResource SurfaceRaisedBrush}">
  <Border Background="{StaticResource SurfaceRaisedBrush}"
          CornerRadius="18">
    <Grid RowDefinitions="Auto,Auto">
      <StackPanel Spacing="18"
                  Margin="32,30,32,24">
        <StackPanel Spacing="8">
          <TextBlock x:Name="MessageText"
                     FontSize="30"
                     FontWeight="Black"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="DetailText"
                     Classes="page-subtitle"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource Loc.Common.MasterPassword.Label}"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="10"
                     FontWeight="Black"
                     LetterSpacing="2.2"/>
          <TextBox x:Name="PasswordBox"
                   Classes="sk-input sk-input-large"
                   PlaceholderText="{DynamicResource Loc.Common.MasterPassword.Placeholder}"
                   PasswordChar="*"/>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="1"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10"
            Margin="32,0,32,28">
        <TextBlock Text="{DynamicResource Loc.Dialog.DestructiveConfirmation.Detail}"
                   Classes="page-subtitle"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <Button Grid.Column="1"
                Content="{DynamicResource Loc.Common.Cancel}"
                Classes="sk-secondary"
                Click="OnCancelClicked"/>
        <Button x:Name="ConfirmButton"
                Grid.Column="2"
                Content="{DynamicResource Loc.Common.Confirm}"
                Classes="sk-primary"
                IsDefault="True"
                Click="OnConfirmClicked"/>
      </Grid>
    </Grid>
  </Border>

  <Window.Styles>


  </Window.Styles>
</Window>
