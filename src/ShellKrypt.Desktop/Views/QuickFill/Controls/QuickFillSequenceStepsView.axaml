<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.Views.QuickFill.Controls.QuickFillSequenceStepsView"
             x:Name="SequenceRoot"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto"
        RowSpacing="12">
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*,Auto">
      <TextBlock Text="{DynamicResource Loc.QuickFill.Sequence.Title}"
                 Classes="qfe-section-title" />
      <Border Grid.Column="2" Classes="qfe-chip" VerticalAlignment="Center">
        <TextBlock Text="{Binding SequenceStepCountText}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="SemiBold" />
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Classes="qfe-sequence-empty"
            IsVisible="{Binding HasNoSequenceSteps}">
      <StackPanel Spacing="6"
                  VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Loc.QuickFill.Sequence.EmptyTitle}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource Loc.QuickFill.Sequence.EmptyExample}"
                   Foreground="{DynamicResource TextMutedBrush}"/>
      </StackPanel>
    </Border>

    <ItemsControl Grid.Row="1"
                  ItemsSource="{Binding SequenceSteps}"
                  IsVisible="{Binding HasSequenceSteps}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal"
                      Margin="0,0,0,10">
            <Border Classes="qfe-sequence-row"
                    MinWidth="130"
                    MaxWidth="230">
              <Grid RowDefinitions="Auto,Auto"
                    ColumnDefinitions="*,Auto"
                    RowSpacing="4"
                    ColumnSpacing="8">
                <TextBlock Text="{Binding DisplayLabel}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Content="x"
                        Command="{Binding DataContext.RemoveSequenceStepCommand, ElementName=SequenceRoot}"
                        CommandParameter="{Binding}"
                        Classes="sk-icon-ghost"
                        MinWidth="24"
                        MinHeight="24"
                        Padding="4,0"/>
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding DisplaySubLabel}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
            <TextBlock Text="-&gt;"
                       Classes="qfe-sequence-arrow"
                       IsVisible="{Binding HasNextStep}"/>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button Grid.Row="2"
            Content="{DynamicResource Loc.QuickFill.Sequence.AddStep}"
            Classes="sk-secondary"
            Command="{Binding OpenAddStepModalCommand}"
            HorizontalAlignment="Left"/>
  </Grid>
</UserControl>
