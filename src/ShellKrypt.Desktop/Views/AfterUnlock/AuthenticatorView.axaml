<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.AuthenticatorView"
             x:CompileBindings="False"
             x:DataType="vm:AuthenticatorViewModel">

  <Grid>
    <Grid Margin="20"
          RowDefinitions="Auto,*"
          RowSpacing="22"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,300"
              ColumnSpacing="16">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource Loc.Authenticator.Title}"
                       FontSize="28"
                       FontWeight="SemiBold"
                       LetterSpacing="-0.8"/>
            <TextBlock Text="{Binding PageSubtitle}"
                       Classes="page-subtitle"
                       FontSize="13"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <Grid Grid.Column="1"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12"
                VerticalAlignment="Center">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="sk-search-input"
                     PlaceholderText="{DynamicResource Loc.Authenticator.Search.Placeholder}"/>
            <Button Grid.Column="1"
                    Content="{DynamicResource Loc.Authenticator.Button.AddCode}"
                    Classes="sk-primary"
                    Command="{Binding AddNewCommand}"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,0.82*"
              ColumnSpacing="12"
              VerticalAlignment="Stretch">
          <Border Classes="auth-list-shell"
                  VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*">
              <Border Background="{StaticResource TableHeaderBrush}"
                      BorderBrush="{StaticResource BorderBrushSoft}"
                      BorderThickness="0,0,0,1"
                      CornerRadius="14,14,0,0"
                      Padding="12,10">
            <TextBlock Text="{Binding CodesCountDisplay}"
                           Classes="auth-footer-meta"
                           VerticalAlignment="Center"/>
              </Border>

              <ScrollViewer Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding HasEntries}">
                <ItemsControl ItemsSource="{Binding FilteredEntries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AuthenticatorAccountVm">
                      <Button Classes="auth-list-button"
                              Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Border Classes="auth-list-item"
                                Classes.active="{Binding IsSelected}">
                          <Grid ColumnDefinitions="Auto,*,118"
                                ColumnSpacing="12"
                                MinHeight="58"
                                VerticalAlignment="Center">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="{StaticResource AppBackgroundSoftBrush}">
                              <TextBlock Text="{Binding Monogram}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         FontWeight="Black"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding AccountSubtitle}"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         FontSize="11"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Grid Grid.Column="2"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="8"
                                  Width="118"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                              <TextBlock Text="{Binding CurrentCodeDisplay}"
                                         Classes="auth-list-code"
                                         Grid.Row="0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                              <Grid Grid.Row="1"
                                    ColumnDefinitions="36,*"
                                    ColumnSpacing="6"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasCountdown}">
                                <TextBlock Text="{Binding RemainingDisplay}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1"
                                             Classes="auth-mini-progress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProgressPercent}"
                                             VerticalAlignment="Center"/>
                              </Grid>
                              <TextBlock Grid.Row="1"
                                         Text="{Binding CounterDisplay, StringFormat=Counter {0}}"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         FontSize="11"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding !HasCountdown}"/>
                            </Grid>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Border Grid.Row="1"
                      Padding="28,24"
                      Background="Transparent"
                      IsVisible="{Binding !HasEntries}">
                <StackPanel Spacing="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding EmptyTitle}"
                             FontSize="18"
                             FontWeight="Bold"
                             TextAlignment="Center"/>
                  <TextBlock Text="{Binding EmptySubtitle}"
                             Classes="page-subtitle"
                             MaxWidth="360"
                             TextAlignment="Center"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

            </Grid>
          </Border>

          <Grid x:Name="AuthenticatorDetailStack"
                Grid.Column="1"
                RowDefinitions="*,Auto"
                RowSpacing="18"
                VerticalAlignment="Stretch">
            <Border Grid.Row="0"
                    Classes="auth-detail-card"
                    MinHeight="300"
                    IsVisible="{Binding HasSelection}">
              <Grid>
                <Border Background="{StaticResource AccentMutedBrush}"
                        CornerRadius="8"
                        Padding="10,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                  <TextBlock Text="{Binding SelectedEntry.VerifiedLabel}"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11"
                             FontWeight="Black"/>
                </Border>

                <StackPanel Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0">
                  <Border Width="48"
                          Height="48"
                          CornerRadius="24"
                          Background="{StaticResource AppBackgroundSoftBrush}">
                    <TextBlock Text="{Binding SelectedEntry.Monogram}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="Black"/>
                  </Border>

                  <StackPanel Spacing="4"
                              HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectedEntry.Name}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding DetailSubtitle}"
                               Classes="page-subtitle"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedEntry.DetailHint}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextAlignment="Center"/>
                  </StackPanel>

                  <Border Classes="auth-code-card"
                          MaxWidth="270"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center">
                      <TextBlock Text="{Binding SelectedEntry.CurrentCodeDisplay}"
                                 Classes="auth-detail-code"
                                 HorizontalAlignment="Center"/>
                      <Grid ColumnDefinitions="44,*"
                            ColumnSpacing="10"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding SelectedEntry.HasCountdown}">
                        <TextBlock Text="{Binding SelectedEntry.RemainingDisplay}"
                                   Classes="auth-footer-meta"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1"
                                     Classes="auth-detail-progress"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding SelectedEntry.ProgressPercent}"
                                     VerticalAlignment="Center"/>
                      </Grid>
                      <TextBlock Text="{Binding SelectedEntry.ProgressLabel}"
                                 Classes="auth-footer-meta"
                                 HorizontalAlignment="Center"
                                 IsVisible="{Binding !SelectedEntry.HasCountdown}"/>
                    </StackPanel>
                  </Border>

                  <StackPanel Orientation="Horizontal"
                              Spacing="10"
                              HorizontalAlignment="Center">
                    <Button Content="{Binding SelectedEntry.CopyButtonText}"
                            Classes="sk-secondary sk-secondary-accent"
                            Command="{Binding CopyCodeCommand}"
                            IsEnabled="{Binding CanCopyCode}"/>
                    <Button Content="{DynamicResource Loc.Common.Details}"
                            Classes="sk-secondary"
                            Command="{Binding OpenDetailsCommand}"
                            IsEnabled="{Binding CanEditSelection}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="0"
                    Classes="auth-detail-card"
                    Padding="24"
                    MinHeight="300"
                    IsVisible="{Binding !HasSelection}">
              <StackPanel Spacing="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Loc.Authenticator.NoSelection.Title}"
                           FontSize="18"
                           FontWeight="Bold"
                           TextAlignment="Center"/>
                <TextBlock Text="{DynamicResource Loc.Authenticator.NoSelection.Subtitle}"
                           Classes="page-subtitle"
                           MaxWidth="340"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Classes="auth-info-card"
                    MinWidth="0"
                    IsVisible="{Binding HasSelection}">
              <Grid ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="18"
                    RowSpacing="22">
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource Loc.Authenticator.Form.SecretKey}"
                             Classes="auth-kicker"/>
                  <Grid ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding SelectedEntry.SecretDisplay}"
                               Classes="auth-secret-text"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="128"/>
                    <Button Grid.Column="1"
                            Classes="sk-icon-ghost auth-secret-eye-button"
                            Command="{Binding ToggleSecretVisibilityCommand}"
                            CommandParameter="{Binding SelectedEntry}"
                            IsVisible="{Binding !SelectedEntry.IsSecretVisible}">
                      <PathIcon Data="{StaticResource IconVisibility}"
                                Width="17"
                                Height="17"/>
                    </Button>
                    <Button Grid.Column="1"
                            Classes="sk-icon-ghost auth-secret-eye-button"
                            Command="{Binding ToggleSecretVisibilityCommand}"
                            CommandParameter="{Binding SelectedEntry}"
                            IsVisible="{Binding SelectedEntry.IsSecretVisible}">
                      <PathIcon Data="{StaticResource IconVisibilityOff}"
                                Width="17"
                                Height="17"/>
                    </Button>
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="6">
                  <TextBlock Text="{DynamicResource Loc.Authenticator.Form.KeyType}"
                             Classes="auth-kicker"/>
                  <TextBlock Text="{Binding SelectedEntry.KeyTypeDisplay}"
                             FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="6">
                  <TextBlock Text="{DynamicResource Loc.Authenticator.Detail.CodeFormat}"
                             Classes="auth-kicker"/>
                  <TextBlock Text="{Binding SelectedEntry.DigitsDisplay}"
                             FontFamily="{StaticResource MonoFontFamily}"
                             FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Spacing="6">
                  <TextBlock Text="{DynamicResource Loc.Authenticator.Form.Algorithm}"
                             Classes="auth-kicker"/>
                  <TextBlock Text="{Binding SelectedEntry.RotationDisplay}"
                             FontSize="13"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
    </Grid>

    <Border Background="{StaticResource OverlayScrimBrush}"
            IsVisible="{Binding IsDetailsModalOpen}">
      <Grid>
        <Border Classes="auth-modal-card"
                Width="640"
                MaxHeight="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=Grid}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="22">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Loc.Authenticator.Details.Title}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{DynamicResource Loc.Authenticator.Details.Subtitle}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="X"
                      Classes="sk-icon-ghost"
                      Command="{Binding CloseDetailsCommand}"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="16"
                  VerticalAlignment="Center">
              <Border Width="56"
                      Height="56"
                      CornerRadius="28"
                      Background="{StaticResource AppBackgroundSoftBrush}">
                <TextBlock Text="{Binding SelectedEntry.Monogram}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Black"/>
              </Border>

              <StackPanel Grid.Column="1"
                          Spacing="4"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedEntry.Name}"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedEntry.DetailHint}"
                           Classes="page-subtitle"
                           FontSize="13"/>
              </StackPanel>
            </Grid>

            <Border Classes="auth-code-card"
                    MaxWidth="560"
                    HorizontalAlignment="Stretch">
              <StackPanel Spacing="12"
                          HorizontalAlignment="Center">
                <TextBlock Text="{Binding SelectedEntry.CurrentCodeDisplay}"
                           Classes="auth-detail-code"
                           HorizontalAlignment="Center"/>
                <Grid ColumnDefinitions="52,*"
                      ColumnSpacing="12"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding SelectedEntry.HasCountdown}">
                  <TextBlock Text="{Binding SelectedEntry.RemainingDisplay}"
                             Classes="auth-footer-meta"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1"
                               Classes="auth-detail-progress"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding SelectedEntry.ProgressPercent}"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding SelectedEntry.ProgressLabel}"
                           Classes="auth-footer-meta"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding !SelectedEntry.HasCountdown}"/>
              </StackPanel>
            </Border>

            <Border Classes="auth-info-card">
              <Grid ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="28"
                    RowSpacing="22">
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource Loc.Authenticator.Form.SecretKey}"
                             Classes="auth-kicker"/>
                  <Grid ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding SelectedEntry.SecretDisplay}"
                               Classes="auth-secret-text"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360"/>
                    <Button Grid.Column="1"
                            Classes="sk-icon-ghost auth-secret-eye-button"
                            Command="{Binding ToggleSecretVisibilityCommand}"
                            CommandParameter="{Binding SelectedEntry}"
                            IsVisible="{Binding !SelectedEntry.IsSecretVisible}">
                      <PathIcon Data="{StaticResource IconVisibility}"
                                Width="17"
                                Height="17"/>
                    </Button>
                    <Button Grid.Column="1"
                            Classes="sk-icon-ghost auth-secret-eye-button"
                            Command="{Binding ToggleSecretVisibilityCommand}"
                            CommandParameter="{Binding SelectedEntry}"
                            IsVisible="{Binding SelectedEntry.IsSecretVisible}">
                      <PathIcon Data="{StaticResource IconVisibilityOff}"
                                Width="17"
                                Height="17"/>
                    </Button>
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="6">
                  <TextBlock Text="{DynamicResource Loc.Authenticator.Form.KeyType}"
                             Classes="auth-kicker"/>
                  <TextBlock Text="{Binding SelectedEntry.KeyTypeDisplay}"
                             FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="6">
                  <TextBlock Text="{DynamicResource Loc.Authenticator.Detail.CodeFormat}"
                             Classes="auth-kicker"/>
                  <TextBlock Text="{Binding SelectedEntry.DigitsDisplay}"
                             FontFamily="{StaticResource MonoFontFamily}"
                             FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Spacing="6">
                  <TextBlock Text="{DynamicResource Loc.Authenticator.Form.Algorithm}"
                             Classes="auth-kicker"/>
                  <TextBlock Text="{Binding SelectedEntry.RotationDisplay}"
                             FontSize="13"/>
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="12">
              <TextBlock Text="{DynamicResource Loc.Authenticator.Modal.Footer}"
                         Classes="page-subtitle"
                         FontSize="12"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Content="{DynamicResource Loc.Common.Delete}"
                      Classes="sk-danger"
                      Command="{Binding BeginDetailsDeleteCommand}"/>
              <Button Grid.Column="2"
                      Content="{DynamicResource Loc.Common.Edit}"
                      Classes="sk-primary"
                      Command="{Binding BeginDetailsEditCommand}"/>
            </Grid>
          </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <Border Background="{StaticResource OverlayScrimBrush}"
            IsVisible="{Binding IsEditorModalOpen}">
      <Grid>
        <Border Classes="auth-modal-card"
                Width="640"
                MaxHeight="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=Grid}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="22">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding EditorModalTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding EditorModalSubtitle}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="{DynamicResource Loc.Authenticator.Button.ImportQr}"
                      Classes="sk-secondary sk-secondary-accent"
                      Command="{Binding ImportQrScreenshotCommand}"/>

              <Button Grid.Column="2"
                      Content="{DynamicResource Loc.Authenticator.Button.PasteQr}"
                      Classes="sk-secondary sk-secondary-accent"
                      Command="{Binding PasteQrImageCommand}"/>

              <Button Grid.Column="3"
                      Content="X"
                      Classes="sk-icon-ghost"
                      Command="{Binding CancelEditorCommand}"/>
            </Grid>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="16"
                  RowSpacing="14">
              <StackPanel Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Common.Name.Label}"
                           Classes="auth-kicker"/>
                <TextBox Text="{Binding FormName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="sk-input sk-input-large"
                         PlaceholderText="{DynamicResource Loc.Authenticator.Form.Name.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Authenticator.Form.KeyType}"
                           Classes="auth-kicker"/>
                <ComboBox Classes="sk-combo-modal"
                          ItemsSource="{Binding KeyTypeOptions}"
                          SelectedItem="{Binding SelectedFormKeyType, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Authenticator.Form.SecretKey}"
                           Classes="auth-kicker"/>
                <Border Classes="sk-input-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">
                    <TextBox Text="{Binding FormSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="sk-input sk-input-large sk-input-borderless"
                             PasswordChar="*"
                             IsVisible="{Binding !IsFormSecretVisible}"
                             PlaceholderText="{DynamicResource Loc.Authenticator.Form.Secret.Placeholder}"/>
                    <TextBox Text="{Binding FormSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="sk-input sk-input-large sk-input-borderless"
                             IsVisible="{Binding IsFormSecretVisible}"
                             PlaceholderText="{DynamicResource Loc.Authenticator.Form.Secret.Placeholder}"/>
                    <Button Grid.Column="1"
                            Classes="sk-icon-ghost"
                            Command="{Binding ToggleFormSecretVisibilityCommand}"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            IsVisible="{Binding !IsFormSecretVisible}">
                      <PathIcon Data="{StaticResource IconVisibility}"
                                Width="17"
                                Height="17"/>
                    </Button>
                    <Button Grid.Column="1"
                            Classes="sk-icon-ghost"
                            Command="{Binding ToggleFormSecretVisibilityCommand}"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            IsVisible="{Binding IsFormSecretVisible}">
                      <PathIcon Data="{StaticResource IconVisibilityOff}"
                                Width="17"
                                Height="17"/>
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
              <StackPanel Spacing="10">
                <CheckBox Content="{DynamicResource Loc.Authenticator.Advanced.Options}"
                          IsChecked="{Binding IsAdvancedOptionsExpanded, Mode=TwoWay}"
                          Classes="auth-advanced-toggle"/>
                <TextBlock Text="{Binding AdvancedOptionsNote}"
                           Classes="page-subtitle"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsAdvancedOptionsExpanded}"/>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="16"
                      RowSpacing="14"
                      IsVisible="{Binding IsAdvancedOptionsExpanded}">
                  <StackPanel Spacing="7">
                    <TextBlock Text="{DynamicResource Loc.Authenticator.Form.Algorithm}"
                               Classes="auth-kicker"/>
                    <ComboBox Classes="sk-combo-modal"
                              ItemsSource="{Binding AlgorithmOptions}"
                              SelectedItem="{Binding SelectedFormAlgorithm, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Spacing="7">
                    <TextBlock Text="{DynamicResource Loc.Authenticator.Form.Digits}"
                               Classes="auth-kicker"/>
                    <ComboBox Classes="sk-combo-modal"
                              ItemsSource="{Binding DigitsOptions}"
                              SelectedItem="{Binding SelectedFormDigits, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Spacing="7"
                              IsVisible="{Binding ShowAdvancedPeriod}">
                    <TextBlock Text="{DynamicResource Loc.Authenticator.Form.ValidPeriod}"
                               Classes="auth-kicker"/>
                    <TextBox Text="{Binding FormPeriodSecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="sk-input sk-input-large"
                             PlaceholderText="{DynamicResource Loc.Authenticator.Form.ValidPeriod.Placeholder}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
              <TextBlock Text="{Binding SelectedTypeSummary}"
                         Classes="page-subtitle"
                         FontSize="12"
                         TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="{Binding Error}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasError}"/>

            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="12">
              <TextBlock Text="{DynamicResource Loc.Authenticator.Qr.Footer}"
                         Classes="page-subtitle"
                         FontSize="12"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Content="{DynamicResource Loc.Common.Cancel}"
                      Classes="sk-secondary"
                      Command="{Binding CancelEditorCommand}"/>
              <Button Grid.Column="2"
                      Content="{Binding SaveButtonText}"
                      Classes="sk-primary"
                      Command="{Binding SaveEditorCommand}"/>
            </Grid>
          </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <Border Background="{StaticResource OverlayScrimBrush}"
            IsVisible="{Binding IsDeleteConfirmOpen}">
      <Grid>
        <Border Classes="auth-modal-card"
                Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="20">
            <Border Width="72"
                    Height="72"
                    CornerRadius="36"
                    Background="{StaticResource AppBackgroundSoftBrush}"
                    HorizontalAlignment="Center">
              <TextBlock Text="!"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource DangerBrush}"
                         FontSize="30"
                         FontWeight="Bold"/>
            </Border>

            <StackPanel Spacing="10"
                        HorizontalAlignment="Center">
              <TextBlock Text="{Binding DeleteConfirmationText}"
                         FontSize="28"
                         FontWeight="SemiBold"
                         TextAlignment="Center"/>
              <TextBlock Text="{DynamicResource Loc.Authenticator.Delete.Body}"
                         Classes="page-subtitle"
                         MaxWidth="420"
                         TextAlignment="Center"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <Border Background="{StaticResource DangerPanelBrush}"
                    BorderBrush="{StaticResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16">
              <TextBlock Text="{DynamicResource Loc.Authenticator.Delete.Warning}"
                         Foreground="{StaticResource DangerBrush}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"/>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="12">
              <TextBlock Text="{Binding SelectedEntry.Name}"
                         Classes="page-subtitle"
                         FontSize="12"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Content="{DynamicResource Loc.Common.Cancel}"
                      Classes="sk-secondary"
                      Command="{Binding CancelDeleteCommand}"/>
              <Button Grid.Column="2"
                      Content="{DynamicResource Loc.Authenticator.Button.DeleteCode}"
                      Classes="sk-danger"
                      Command="{Binding ConfirmDeleteCommand}"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.auth-list-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="Button.auth-list-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="Border.auth-list-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,14"/>
      <Setter Property="Margin" Value="4,4"/>
    </Style>

    <Style Selector="Border.auth-list-item.active">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.auth-list-button:pointerover Border.auth-list-item">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>


    <Style Selector="TextBlock.auth-list-code">
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.4"/>
    </Style>

    <Style Selector="Border.auth-detail-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style Selector="Border.auth-code-card">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style Selector="TextBlock.auth-detail-code">
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.auth-info-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="TextBlock.auth-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.1"/>
    </Style>

    <Style Selector="TextBlock.auth-secret-text">
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="Button.auth-secret-eye-button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinWidth" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.auth-shield-glyph">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style Selector="TextBlock.auth-footer-meta">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="ProgressBar.auth-mini-progress">
      <Setter Property="Height" Value="4"/>
      <Setter Property="MinWidth" Value="52"/>
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="ProgressBar.auth-detail-progress">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.auth-modal-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ModalBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="28"/>
    </Style>








  </UserControl.Styles>
</UserControl>
