<Styles xmlns="https://github.com/avaloniaui">
<Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
</Style>

<Style Selector="UserControl">
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
</Style>

<Style Selector="SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource TextSelectionBackgroundBrush}"/>
</Style>

<Style Selector="Path.material-icon">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Stretch" Value="Uniform"/>
</Style>

<Style Selector="Path.material-icon.accent">
    <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
</Style>

<Style Selector="Path.material-icon.muted">
    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
</Style>

<Style Selector="Path.material-icon.on-primary">
    <Setter Property="Fill" Value="{StaticResource AccentForegroundBrush}"/>
</Style>

<Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="Bold"/>
</Style>

<Style Selector="TextBlock.page-subtitle">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="13"/>
</Style>

<Style Selector="TextBlock.hero-title">
    <Setter Property="FontSize" Value="34"/>
    <Setter Property="FontWeight" Value="Black"/>
</Style>

<Style Selector="TextBlock.hero-highlight">
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
    <Setter Property="FontSize" Value="34"/>
    <Setter Property="FontWeight" Value="Black"/>
</Style>

<Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
</Style>

<Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="10"/>
</Style>

<Style Selector="TextBlock.metric-value">
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="Bold"/>
</Style>

<Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
</Style>

<Style Selector="Border.panel-raised">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
</Style>

<Style Selector="Border.metric-card">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
</Style>

<Style Selector="Border.badge">
    <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="999"/>
</Style>

<Style Selector="Border.vault-row">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
</Style>

<Style Selector="Border.status-card">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
</Style>

</Styles>
