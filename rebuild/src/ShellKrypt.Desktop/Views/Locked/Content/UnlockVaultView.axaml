<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="ShellKrypt.Desktop.Views.Locked.Content.UnlockVaultView"
             d:DesignWidth="640"
             d:DesignHeight="720">
  <UserControl.Styles>
    <Style Selector="Button.unlock-primary">
      <Setter Property="Height" Value="50" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.unlock-primary:pointerover">
      <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
    </Style>

    <Style Selector="Button.unlock-primary:pressed,
                     Button.unlock-primary.keyboard-pressed">
      <Setter Property="Background" Value="{StaticResource OnPrimaryContainerBrush}" />
    </Style>

    <Style Selector="Button.unlock-secondary">
      <Setter Property="Height" Value="48" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.unlock-secondary:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <Style Selector="Button.password-visibility">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0,7,7,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.password-visibility:pointerover">
      <Setter Property="Background" Value="#12000000" />
    </Style>

    <Style Selector="TextBox.password-input">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="TextBox.password-input /template/ Border#PART_BorderElement,
    TextBox.password-input:pointerover /template/ Border#PART_BorderElement,
    TextBox.password-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

  </UserControl.Styles>

  <Border Background="{StaticResource BackgroundBrush}"
          Padding="64,48">
    <StackPanel MaxWidth="360"
                MinWidth="280"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
      <Border Width="58"
              Height="58"
              HorizontalAlignment="Center"
              Background="#DBEAFE"
              CornerRadius="29">
        <Path Data="{StaticResource IconPlaceHolder}"
              Width="27"
              Height="27"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Fill="{StaticResource PrimaryBrush}"
              Stretch="Uniform" />
      </Border>

      <TextBlock Margin="0,22,0,0"
                 Text="Unlock Your Vault"
                 HorizontalAlignment="Center"
                 FontSize="28"
                 FontWeight="SemiBold" />

      <TextBlock Margin="0,8,0,0"
                 Text="Enter your master password to continue."
                 HorizontalAlignment="Center"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 FontSize="15"
                 TextAlignment="Center" />

      <TextBlock Margin="0,42,0,8"
                 Text="Master Password"
                 FontSize="13"
                 FontWeight="SemiBold" />

      <Border Height="48"
              Background="{StaticResource SurfaceMutedBrush}"
              BorderBrush="{StaticResource BorderDefaultBrush}"
              BorderThickness="1"
              CornerRadius="7">
        <Grid ColumnDefinitions="*,48">
          <TextBox x:Name="PasswordInput"
                   Classes="password-input"
                   Padding="14,0"
                   VerticalContentAlignment="Center"
                   Background="Transparent"
                   BorderThickness="0"
                   PasswordChar="⦁"
                   PlaceholderText="Master Password"
                   KeyDown="OnPasswordInputKeyDown"
                   KeyUp="OnPasswordInputKeyUp" />

          <Button Grid.Column="1"
                  Classes="password-visibility"
                  Click="OnTogglePasswordVisibilityClicked"
                  >
            <Path Data="{StaticResource IconPlaceHolder}"
                  Width="19"
                  Height="19"
                  Fill="{StaticResource TextSecondaryBrush}"
                  Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>

      <Button x:Name="UnlockButton"
              Margin="0,32,0,0"
              Classes="unlock-primary"
              IsDefault="True">
        <StackPanel Orientation="Horizontal"
                    Spacing="10">
          <Path Data="{StaticResource IconPlaceHolder}"
                Width="18"
                Height="18"
                VerticalAlignment="Center"
                Fill="White"
                Stretch="Uniform" />
          <TextBlock Text="Unlock Vault"
                     VerticalAlignment="Center"
                     Foreground="White"
                     FontSize="15"
                     FontWeight="SemiBold" />
        </StackPanel>
      </Button>

      <Button Margin="0,14,0,0"
              Classes="unlock-secondary"
              Click="OnBackClicked">
        <StackPanel Orientation="Horizontal"
                    Spacing="10">
          <Path Data="{StaticResource IconPlaceHolder}"
                Width="18"
                Height="18"
                VerticalAlignment="Center"
                Fill="{StaticResource TextPrimaryBrush}"
                Stretch="Uniform" />
          <TextBlock Text="Back to Vaults"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     FontSize="15"
                     FontWeight="SemiBold" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
