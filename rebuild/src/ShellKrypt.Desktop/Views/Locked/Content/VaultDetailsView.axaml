<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="ShellKrypt.Desktop.Views.Locked.Content.VaultDetailsView"
             d:DesignWidth="640"
             d:DesignHeight="720">
  <UserControl.Styles>
    <Style Selector="Button.vault-action">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.vault-action:pointerover">
      <Setter Property="Background" Value="#18FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource PrimaryBrush}"
          Padding="72">
    <Grid MaxWidth="496"
          MinWidth="280"
          HorizontalAlignment="Stretch"
          RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0"
                  Spacing="12">
        <Path Data="{StaticResource IconPlaceHolder}"
              Width="30"
              Height="30"
              HorizontalAlignment="Left"
              Fill="White"
              Stretch="Uniform" />

        <TextBlock Text="Personal Vault"
                   Foreground="White"
                   FontSize="38"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock Text="Your passwords, secure notes, and sensitive information are protected in this local vault."
                   Foreground="#D9FFFFFF"
                   FontSize="16"
                   LineHeight="25"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1"
                  Margin="-12,34,0,0"
                  VerticalAlignment="Top"
                  Spacing="6">
        <Button Classes="vault-action">
          <StackPanel Orientation="Horizontal"
                      Spacing="14">
            <Path Data="{StaticResource IconPlaceHolder}"
                  Width="18"
                  Height="18"
                  VerticalAlignment="Center"
                  Fill="White"
                  Stretch="Uniform" />
            <TextBlock Text="Edit Vault"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Button>

        <Button Classes="vault-action">
          <StackPanel Orientation="Horizontal"
                      Spacing="14">
            <Path Data="{StaticResource IconPlaceHolder}"
                  Width="18"
                  Height="18"
                  VerticalAlignment="Center"
                  Fill="White"
                  Stretch="Uniform" />
            <TextBlock Text="Delete Vault"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </StackPanel>

      <Border Grid.Row="2"
              HorizontalAlignment="Left"
              Background="#260F172A"
              CornerRadius="20"
              Padding="14,8">
        <StackPanel Orientation="Horizontal"
                    Spacing="9">
          <Path Data="{StaticResource IconPlaceHolder}"
                Width="15"
                Height="15"
                VerticalAlignment="Center"
                Fill="#BFFFFFFF"
                Stretch="Uniform" />
          <TextBlock Text="LOCAL VAULT"
                     VerticalAlignment="Center"
                     Foreground="#CCFFFFFF"
                     FontSize="12"
                     FontWeight="SemiBold"
                     LetterSpacing="1.5" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
