<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="ShellKrypt.Desktop.Views.Locked.Content.WelcomeView"
             d:DesignWidth="640"
             d:DesignHeight="720">
  <Border Background="{DynamicResource PrimaryBrush}"
          Padding="72">
    <StackPanel MaxWidth="496"
                MinWidth="280"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Spacing="16">
      <Border Width="76"
              Height="76"
              HorizontalAlignment="Left"
              Background="#24FFFFFF"
              BorderBrush="#38FFFFFF"
              BorderThickness="1"
              CornerRadius="16">
        <Path Data="{StaticResource IconPlaceHolder}"
              Width="48"
              Height="48"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Fill="White"
              Stretch="Uniform"/>
      </Border>

      <StackPanel Spacing="12">
        <TextBlock Text="Welcome to&#x0a;ShellKrypt"
                   Foreground="White"
                   FontSize="44"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock Text="Manage your passwords, secure notes, and sensitive information in one place."
                   Foreground="#D9FFFFFF"
                   FontSize="18"
                   LineHeight="28"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border HorizontalAlignment="Left"
              Background="#260F172A"
              CornerRadius="20"
              Padding="14,8">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Path Data="{StaticResource IconPlaceHolder}"
            Width="15"
            Height="15"
            VerticalAlignment="Center"
            Fill="#BFFFFFFF"
            Stretch="Uniform"/>
          <TextBlock Text="LOCAL VAULT"
                     VerticalAlignment="Center"
                     Foreground="#CCFFFFFF"
                     FontSize="12"
                     FontWeight="SemiBold"
                     LetterSpacing="1.5" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
