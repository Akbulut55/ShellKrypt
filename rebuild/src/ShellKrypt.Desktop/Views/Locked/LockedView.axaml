<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:content="using:ShellKrypt.Desktop.Views.Locked.Content"
             x:Class="ShellKrypt.Desktop.Views.Locked.LockedView"
             d:DesignWidth="1280"
             d:DesignHeight="720">
  <Grid ColumnDefinitions="*,*">
    <TransitioningContentControl x:Name="LeftContent"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
      <TransitioningContentControl.PageTransition>
        <PageSlide Orientation="Vertical" Duration="0:0:0.5" />
      </TransitioningContentControl.PageTransition>
      <content:WelcomeView />
    </TransitioningContentControl>

    <TransitioningContentControl x:Name="RightContent"
                                 Grid.Column="1"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
      <TransitioningContentControl.PageTransition>
        <PageSlide Orientation="Vertical" Duration="0:0:0.5" />
      </TransitioningContentControl.PageTransition>
      <content:VaultListView VaultSelected="OnVaultSelected" />
    </TransitioningContentControl>
  </Grid>
</UserControl>
