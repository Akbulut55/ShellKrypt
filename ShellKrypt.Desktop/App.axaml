<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShellKrypt.Desktop.App"
             xmlns:local="using:ShellKrypt.Desktop"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0e151d"/>
        <SolidColorBrush x:Key="AppBackgroundSoftBrush" Color="#111a23"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#17212b"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1b2732"/>
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#22303d"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#101923"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#223342"/>
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#31495d"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#eaf2fb"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9cadbf"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3c94a7"/>
        <SolidColorBrush x:Key="AccentMutedBrush" Color="#163744"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#45a07a"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#c3924f"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#d26b6f"/>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter#Inter"/>
        </Style>

        <Style Selector="UserControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style Selector="TextBlock.metric-value">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style Selector="Border.panel-raised">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style Selector="Border.metric-card">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#06131a"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#4aa3b5"/>
            <Setter Property="BorderBrush" Value="#4aa3b5"/>
        </Style>

        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#331a20"/>
            <Setter Property="Foreground" Value="#ffd8db"/>
            <Setter Property="BorderBrush" Value="#69414a"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        </Style>
    </Application.Styles>
</Application>
