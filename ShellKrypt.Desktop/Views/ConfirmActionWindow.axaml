<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShellKrypt.Desktop.Views.ConfirmActionWindow"
        Width="448"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirm Action"
        Background="{StaticResource AppBackgroundSoftBrush}">
  <Border Background="{StaticResource SurfaceRaisedBrush}"
          BorderBrush="{StaticResource BorderBrushSoft}"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,Auto">
      <StackPanel Margin="32,28,32,22"
                  HorizontalAlignment="Center"
                  Spacing="16">
        <Border Width="64"
                Height="64"
                CornerRadius="999"
                Background="#3393000a">
          <TextBlock Text="!"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="34"
                     FontWeight="Black"
                     Foreground="{StaticResource DangerBrush}"/>
        </Border>

        <TextBlock x:Name="MessageText"
                   FontSize="24"
                   FontWeight="Black"
                   TextAlignment="Center"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Row="1"
              Margin="32,0,32,28"
              Padding="16"
              Background="#2293000a"
              BorderBrush="#33ffb4ab"
              BorderThickness="1"
              CornerRadius="8">
        <TextBlock x:Name="DetailText"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
      </Border>

      <Border Grid.Row="2"
              Padding="32,22"
              Background="{StaticResource SurfaceElevatedBrush}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Button Content="Cancel"
                  Classes="subtle"
                  HorizontalAlignment="Stretch"
                  Click="OnCancelClicked"/>
          <Button x:Name="ConfirmButton"
                  Grid.Column="1"
                  Content="Confirm"
                  Classes="danger"
                  HorizontalAlignment="Stretch"
                  IsDefault="True"
                  Click="OnConfirmClicked"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
