<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.ActivityView"
             x:CompileBindings="False"
             x:DataType="vm:ActivityViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32"
                  MaxWidth="1500"
                  HorizontalAlignment="Stretch"
                  Spacing="22">
        <Grid Margin="0,10,0,0">
          <StackPanel Spacing="9">
            <TextBlock Text="Activity Log"
                       FontSize="28"
                       FontWeight="SemiBold"
                       LetterSpacing="-0.8"/>
            <TextBlock Text="Real-time monitoring of all security events and access requests."
                       Classes="page-subtitle"
                       FontSize="13"/>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="440,*,Auto"
              ColumnSpacing="12"
              VerticalAlignment="Center">
          <Border Classes="activity-search-shell">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="activity-search-box"
                     PlaceholderText="Search audit logs..."/>
          </Border>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <Button Content="All"
                    Classes="activity-chip"
                    Classes.active="{Binding IsAllFilterActive}"
                    Command="{Binding ShowAllCommand}"/>
            <Button Content="Vault"
                    Classes="activity-chip"
                    Classes.active="{Binding IsVaultFilterActive}"
                    Command="{Binding ShowVaultCommand}"/>
            <Button Content="Items"
                    Classes="activity-chip"
                    Classes.active="{Binding IsItemsFilterActive}"
                    Command="{Binding ShowItemsCommand}"/>
            <Button Content="Audit"
                    Classes="activity-chip"
                    Classes.active="{Binding IsAuditFilterActive}"
                    Command="{Binding ShowAuditCommand}"/>
            <Button Content="Export"
                    Classes="activity-chip"
                    Classes.active="{Binding IsTransferFilterActive}"
                    Command="{Binding ShowTransferCommand}"/>
            <Button Content="Settings"
                    Classes="activity-chip"
                    Classes.active="{Binding IsSettingsFilterActive}"
                    Command="{Binding ShowSettingsCommand}"/>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,330"
              ColumnSpacing="22">
          <Border Classes="activity-table-shell"
                  ClipToBounds="True">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Background="{StaticResource SurfaceBrush}"
                      Padding="22,14">
                <Grid ColumnDefinitions="1.5*,1.3*,2*,2*,1.2*"
                      ColumnSpacing="16">
                  <TextBlock Text="TIMESTAMP"
                             Classes="activity-table-header"/>
                  <TextBlock Grid.Column="1"
                             Text="SESSION ID"
                             Classes="activity-table-header"/>
                  <TextBlock Grid.Column="2"
                             Text="EVENT TITLE"
                             Classes="activity-table-header"/>
                  <TextBlock Grid.Column="3"
                             Text="AFFECTED ITEM"
                             Classes="activity-table-header"/>
                  <TextBlock Grid.Column="4"
                             Text="STATUS"
                             Classes="activity-table-header"
                             HorizontalAlignment="Right"/>
                </Grid>
              </Border>

              <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Classes="activity-list"
                         IsVisible="{Binding HasItems}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityItemVm">
                      <Border Classes="activity-row-card">
                        <Grid ColumnDefinitions="1.5*,1.3*,2*,2*,1.2*"
                              ColumnSpacing="16"
                              MinHeight="72"
                              Margin="22,0">
                          <TextBlock Text="{Binding TimestampColumnDisplay}"
                                     Classes="activity-row-meta"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding SessionIdDisplay}"
                                     Classes="activity-row-accent"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Title}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="3"
                                     Text="{Binding AffectedItemDisplay}"
                                     Classes="activity-row-meta"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <Border Grid.Column="4"
                                  Background="{Binding SeverityBackground}"
                                  CornerRadius="999"
                                  Padding="10,4"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding SeverityChipText}"
                                       Foreground="{Binding SeverityForeground}"
                                       FontSize="10"
                                       FontWeight="Black"/>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="Transparent"
                        Padding="28,38"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsVisible="{Binding !HasItems}">
                  <StackPanel Spacing="12"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding EmptyStateTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyStateSubtitle}"
                               Classes="page-subtitle"
                               MaxWidth="520"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="2"
                      Background="{StaticResource SurfaceBrush}"
                      Padding="22,14"
                      IsVisible="{Binding HasFilteredItems}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                      ColumnSpacing="10">
                  <TextBlock Text="{Binding ItemsSummary}"
                             Classes="activity-footer-text"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="1"
                          Content="Previous"
                          Classes="activity-page-button"
                          Command="{Binding PreviousPageCommand}"
                          IsEnabled="{Binding CanGoPreviousPage}"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding PageSummary}"
                             Classes="activity-footer-text"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="3"
                          Content="Next"
                          Classes="activity-page-button"
                          Command="{Binding NextPageCommand}"
                          IsEnabled="{Binding CanGoNextPage}"/>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1"
                      Spacing="18">
            <Border Classes="activity-detail-card">
              <StackPanel Spacing="16">
                <TextBlock Text="EVENT METADATA"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="Black"
                           LetterSpacing="2.2"/>

                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="EVENT UUID"
                               Classes="activity-detail-label"/>
                    <Border Classes="activity-detail-shell">
                      <TextBlock Text="{Binding SelectedEventId}"
                                 Classes="activity-detail-value"
                                 TextWrapping="Wrap"/>
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="TIMESTAMP"
                               Classes="activity-detail-label"/>
                    <TextBlock Text="{Binding SelectedTimestamp}"
                               Classes="activity-detail-value"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="CATEGORY"
                               Classes="activity-detail-label"/>
                    <TextBlock Text="{Binding SelectedCategory}"
                               Classes="activity-detail-value"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="STATUS"
                               Classes="activity-detail-label"/>
                    <Border Background="{Binding SelectedStatusBackground}"
                            CornerRadius="999"
                            Padding="10,4"
                            HorizontalAlignment="Left">
                      <TextBlock Text="{Binding SelectedStatus}"
                                 Foreground="{Binding SelectedStatusForeground}"
                                 FontSize="10"
                                 FontWeight="Black"/>
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="AFFECTED ITEM"
                               Classes="activity-detail-label"/>
                    <TextBlock Text="{Binding SelectedAffectedItem}"
                               Classes="activity-detail-value"
                               TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="VAULT PATH"
                               Classes="activity-detail-label"/>
                    <TextBlock Text="{Binding SelectedVaultPath}"
                               Classes="activity-detail-value"
                               TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="DETAIL"
                               Classes="activity-detail-label"/>
                    <TextBlock Text="{Binding SelectedDetail}"
                               Classes="activity-detail-value"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>

                <Border Classes="activity-detail-shell">
                  <StackPanel Spacing="8">
                    <TextBlock Text="SHA-256 INTEGRITY HASH"
                               Classes="activity-detail-label"/>
                    <TextBlock Text="{Binding SelectedIntegrityHash}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="11"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>

            <Border Classes="activity-detail-card">
              <StackPanel Spacing="14">
                <TextBlock Text="LOG MANAGEMENT"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="Black"
                           LetterSpacing="2.2"/>
                <TextBlock Text="Export or clear all activity logs stored for this vault."
                           Classes="page-subtitle"
                           FontSize="12"
                           TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">
                  <Button Content="Export Report"
                          Classes="activity-report-button"
                          Command="{Binding ExportReportCommand}"/>
                  <Button Grid.Column="1"
                          Content="Clear Logs"
                          Classes="activity-report-button"
                          Command="{Binding ClearCommand}"/>
                </Grid>
              </StackPanel>
            </Border>

          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Error}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   IsVisible="{Binding HasError}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.activity-search-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Height" Value="38"/>
    </Style>

    <Style Selector="TextBox.activity-search-box">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style Selector="Button.activity-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.activity-chip.active">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
    </Style>

    <Style Selector="Border.activity-table-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBlock.activity-table-header">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="ListBox.activity-list">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.activity-list ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Border.activity-row-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="#171f1d"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox.activity-list ListBoxItem:selected Border.activity-row-card">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="#171f1d"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="ListBox.activity-list ListBoxItem:pointerover Border.activity-row-card">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
    </Style>

    <Style Selector="TextBlock.activity-row-meta">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <Style Selector="TextBlock.activity-row-accent">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <Style Selector="TextBlock.activity-footer-text">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.activity-page-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.activity-page-button:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.activity-detail-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <Style Selector="TextBlock.activity-detail-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="TextBlock.activity-detail-value">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.activity-detail-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style Selector="Button.activity-report-button">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

  </UserControl.Styles>
</UserControl>
