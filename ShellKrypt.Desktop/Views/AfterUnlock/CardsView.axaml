<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:ShellKrypt.UI.Shared.Controls"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.CardsView"
             x:CompileBindings="False"
             x:DataType="vm:CardsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16"
                  HorizontalAlignment="Stretch"
                  Spacing="14">
        <TextBlock Text="{DynamicResource Loc.Cards.Title}"
                   Margin="0,10,0,-4"
                   FontSize="28"
                   FontWeight="SemiBold"
                   LetterSpacing="-0.8"/>

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="8">
          <Border Classes="cards-stat primary"
                  Padding="16,14">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.Cards.ActiveCards}"
                         Classes="cards-kicker"/>
              <TextBlock Text="{Binding ActiveCardsCount}"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Path Width="18"
                      Height="18"
                      Classes="material-icon accent"
                      VerticalAlignment="Center"
                      Data="{StaticResource IconTrendingUp}"/>
                <TextBlock Text="{Binding ActiveCardsSummary}"
                           Classes="cards-accent-note"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="cards-stat danger"
                  Padding="16,14">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.Cards.ExpiringSoon}"
                         Classes="cards-kicker"/>
              <TextBlock Text="{Binding ExpiringSoonCount}"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="!"
                           Foreground="{StaticResource DangerBrush}"
                           FontWeight="Black"/>
                <TextBlock Text="{Binding ExpiringSoonSummary}"
                           Classes="cards-danger-note"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  Classes="cards-stat danger"
                  Padding="16,14">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.Cards.ExpiredCards}"
                         Classes="cards-kicker"/>
              <TextBlock Text="{Binding ExpiredCardsCount}"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="!"
                           Foreground="{StaticResource DangerBrush}"
                           FontWeight="Black"/>
                <TextBlock Text="{Binding ExpiredCardsSummary}"
                           Classes="cards-danger-note"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="cards-filter-shell"
                Padding="0">
          <WrapPanel Orientation="Horizontal"
                     VerticalAlignment="Center">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="cards-search"
                     PlaceholderText="{DynamicResource Loc.Cards.Search.Placeholder}"
                     VerticalAlignment="Center"/>
            <ComboBox Classes="cards-select"
                      ItemsSource="{Binding BankFilters}"
                      SelectedItem="{Binding SelectedBankFilter, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="cards-select"
                      ItemsSource="{Binding CardTypeFilters}"
                      SelectedItem="{Binding SelectedCardTypeFilter, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="cards-select"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <Button Classes="sk-primary"
                    Command="{Binding AddNewCommand}"
                    Margin="0,0,0,10"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"
                          Spacing="7"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Loc.Cards.Button.Add}"
                           Foreground="{StaticResource AccentForegroundBrush}"
                           FontWeight="SemiBold"/>
                <Path Classes="material-icon on-primary"
                      Width="15"
                      Height="15"
                      Data="{StaticResource IconAdd}"/>
              </StackPanel>
            </Button>
          </WrapPanel>
        </Border>

        <Border Classes="table-shell"
                MinWidth="540"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,390,Auto">
            <Border Classes="table-header-row">
              <Grid ColumnDefinitions="1.12*,0.58*,0.82*,28,0.42*,0.42*,176"
                    ColumnSpacing="8">
                <TextBlock Text="{DynamicResource Loc.Cards.Table.Identity}" Classes="table-header-text"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource Loc.Cards.Table.Bank}" Classes="table-header-text"/>
                <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Cards.Table.Number}" Classes="table-header-text"/>
                <TextBlock Grid.Column="4" Text="{DynamicResource Loc.Cards.Table.Expiry}" Classes="table-header-text"/>
                <TextBlock Grid.Column="5" Text="{DynamicResource Loc.Cards.Table.Issuer}" Classes="table-header-text"/>
                <TextBlock Grid.Column="6"
                           Text="{DynamicResource Loc.Common.Actions.Header}"
                           Classes="table-header-text"
                           HorizontalAlignment="Right"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding HasRows}">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CardRowVm">
                    <Border Classes="table-row">
                      <Grid ColumnDefinitions="1.12*,0.58*,0.82*,28,0.42*,0.42*,176"
                            ColumnSpacing="8"
                            Margin="12,0"
                            MinHeight="78">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              VerticalAlignment="Center">
                          <Border Width="34"
                                  Height="34"
                                  CornerRadius="4"
                                  Background="{StaticResource SurfaceElevatedBrush}">
                            <Grid>
                              <Border Width="24"
                                      Height="24"
                                      CornerRadius="2"
                                      Background="{StaticResource AppBackgroundSoftBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                              <TextBlock Text="C"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         FontWeight="Black"
                                         Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="4"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SubtitleDisplay}"
                                       Classes="cards-row-subtitle"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding BankDisplay}"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding NumberDisplay}"
                                     Classes="cards-number"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Content="E"
                                Classes="sk-icon-ghost"
                                Command="{Binding DataContext.ToggleSecretsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding SecretsActionLabel}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="4"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <Grid ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="6">
                            <TextBlock Text="{Binding ExpiryDisplay}"
                                       Classes="cards-expiry"/>
                            <TextBlock Grid.Column="1"
                                       Text="!"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontWeight="Black"
                                       IsVisible="{Binding IsExpiryUrgent}"/>
                          </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="5"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <Border Classes="cards-issuer-chip"
                                  Padding="9,3"
                                  HorizontalAlignment="Left">
                            <TextBlock Text="{Binding IssuerDisplay}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                          </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="6"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                          <Button Content="{DynamicResource Loc.Common.Details}"
                                  Classes="sk-table-action"
                                  Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="{DynamicResource Loc.Cards.Button.CopyCardNumber}"
                                  Classes="sk-table-action"
                                  Command="{Binding DataContext.CopyCardNumberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel Classes="table-empty"
                          IsVisible="{Binding !HasRows}">
                <TextBlock Text="{Binding EmptyTableTitle}"
                           Classes="table-empty-title"/>
                <TextBlock Text="{Binding EmptyTableSubtitle}"
                           Classes="table-empty-subtitle"/>
              </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Classes="table-footer-row">
              <Grid ColumnDefinitions="*">
                <TextBlock Text="{Binding ItemsSummary}"
                           Classes="table-footer-text"
                           VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <shared:ModalShell IsOpen="{Binding IsAddCardModalOpen}"
                       Title="{Binding CardModalTitle}"
                       Subtitle="{Binding CardModalSubtitle}"
                       Error="{Binding Error}"
                       FooterText="{Binding CardModalFooterText}"
                       CloseCommand="{Binding CancelAddCardCommand}">
      <shared:ModalShell.Body>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,*,*"
              RowSpacing="14"
              ColumnSpacing="16">
              <StackPanel Grid.ColumnSpan="2"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Cards.Form.Title}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsCardFormReadOnly}"
                         PlaceholderText="{DynamicResource Loc.Cards.Form.Title.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Column="2"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Cards.Form.Type}"
                           Classes="modal-shell-label"/>
                <ComboBox ItemsSource="{Binding CardTypeOptions}"
                          SelectedItem="{Binding AddCardType, Mode=TwoWay}"
                          IsEnabled="{Binding IsCardFormEditable}"
                          Classes="modal-shell-input"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Cards.Form.Bank}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddBank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsCardFormReadOnly}"
                         PlaceholderText="{DynamicResource Loc.Cards.Form.Bank.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Cards.Form.Cardholder}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddCardholder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsCardFormReadOnly}"
                         PlaceholderText="{DynamicResource Loc.Cards.Form.Cardholder.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.Column="2"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Cards.Form.Issuer}"
                           Classes="modal-shell-label"/>
                <ComboBox ItemsSource="{Binding IssuerOptions}"
                          SelectedItem="{Binding AddIssuer, Mode=TwoWay}"
                          IsEnabled="{Binding IsCardFormEditable}"
                          Classes="modal-shell-input"/>
              </StackPanel>

              <StackPanel Grid.Row="2"
                          Grid.ColumnSpan="3"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Cards.Form.Number}"
                           Classes="modal-shell-label"/>
                <TextBox x:Name="AddCardNumberTextBox"
                         Text="{Binding AddNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsCardFormReadOnly}"
                         MaxLength="19"
                         TextChanged="AddCardNumberTextBox_OnTextChanged"
                         PlaceholderText="{DynamicResource Loc.Cards.Form.Number.Placeholder}"/>
              </StackPanel>

              <Grid Grid.Row="3"
                    Grid.ColumnSpan="3"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="16">
                <StackPanel Spacing="7">
                  <TextBlock Text="{DynamicResource Loc.Cards.Form.ExpiryMonth}"
                             Classes="modal-shell-label"/>
                  <TextBox Text="{Binding AddExpiryMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="modal-shell-input"
                           IsReadOnly="{Binding IsCardFormReadOnly}"
                           MaxLength="2"
                           PlaceholderText="{DynamicResource Loc.Cards.Form.ExpiryMonth.Placeholder}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="7">
                  <TextBlock Text="{DynamicResource Loc.Cards.Form.ExpiryYear}"
                             Classes="modal-shell-label"/>
                  <TextBox Text="{Binding AddExpiryYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="modal-shell-input"
                           IsReadOnly="{Binding IsCardFormReadOnly}"
                           MaxLength="4"
                           PlaceholderText="{DynamicResource Loc.Cards.Form.ExpiryYear.Placeholder}"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Spacing="7">
                  <TextBlock Text="{DynamicResource Loc.Cards.Form.Cvc}"
                             Classes="modal-shell-label"/>
                  <Border Classes="modal-shell-input-shell">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                      <TextBox Text="{Binding AddCvc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Classes="modal-shell-input borderless"
                               IsReadOnly="{Binding IsCardFormReadOnly}"
                               IsVisible="{Binding !IsAddCvcVisible}"
                               PasswordChar="*"
                               MaxLength="4"
                               PlaceholderText="{DynamicResource Loc.Cards.Form.Cvc.Placeholder}"/>
                      <TextBox Text="{Binding AddCvc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Classes="modal-shell-input borderless"
                               IsReadOnly="{Binding IsCardFormReadOnly}"
                               IsVisible="{Binding IsAddCvcVisible}"
                               MaxLength="4"
                               PlaceholderText="{DynamicResource Loc.Cards.Form.Cvc.Placeholder}"/>
                      <Button Grid.Column="1"
                              Content="{Binding AddCvcVisibilityLabel}"
                              Classes="modal-shell-field-action"
                              Command="{Binding ToggleAddCvcVisibilityCommand}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>

              <StackPanel Grid.Row="4"
                          Grid.ColumnSpan="3"
                          Spacing="12">
                <StackPanel Spacing="7">
                  <TextBlock Text="{DynamicResource Loc.Common.Notes.Label}"
                             Classes="modal-shell-label"/>
                  <TextBox Text="{Binding AddNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="modal-shell-input multiline"
                           IsReadOnly="{Binding IsCardFormReadOnly}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="98"
                           PlaceholderText="{DynamicResource Loc.Cards.Form.Notes.Placeholder}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
      </shared:ModalShell.Body>
      <shared:ModalShell.FooterActions>
        <Grid ColumnDefinitions="Auto,Auto"
              ColumnSpacing="12">
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Cancel}"
                        Classes="modal-shell-secondary-button"
                        IsVisible="{Binding IsAddCardMode}"
                        Command="{Binding CancelAddCardCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Cards.Button.AddSubmit}"
                        Classes="modal-shell-primary-button"
                        IsVisible="{Binding IsAddCardMode}"
                        Command="{Binding SaveAddCardCommand}"/>
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Delete}"
                        Classes="modal-shell-danger-button"
                        IsVisible="{Binding IsCardDetailsViewMode}"
                        Command="{Binding BeginDetailsDeleteCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Edit}"
                        Classes="modal-shell-primary-button"
                        IsVisible="{Binding IsCardDetailsViewMode}"
                        Command="{Binding BeginDetailsEditCommand}"/>
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Cancel}"
                        Classes="modal-shell-secondary-button"
                        IsVisible="{Binding IsCardDetailsEditMode}"
                        Command="{Binding CancelDetailsEditCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Save}"
                        Classes="modal-shell-primary-button"
                        IsVisible="{Binding IsCardDetailsEditMode}"
                        Command="{Binding SaveDetailsCommand}"/>
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Cancel}"
                        Classes="modal-shell-secondary-button"
                        IsVisible="{Binding IsCardDetailsDeleteConfirmMode}"
                        Command="{Binding CancelDetailsDeleteCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Delete}"
                        Classes="modal-shell-danger-button"
                        IsVisible="{Binding IsCardDetailsDeleteConfirmMode}"
                        Command="{Binding ConfirmDetailsDeleteCommand}"/>
              </Grid>
      </shared:ModalShell.FooterActions>
    </shared:ModalShell>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.cards-encryption-badge">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="CornerRadius" Value="999"/>
    </Style>

    <Style Selector="Border.cards-count-badge">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBlock.cards-badge-text">
      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="1.7"/>
    </Style>

    <Style Selector="TextBlock.cards-muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock.cards-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="TextBlock.cards-accent-note">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.cards-danger-note">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.cards-stat">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight" Value="96"/>
    </Style>

    <Style Selector="Border.cards-stat.primary">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.cards-stat.danger">
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
    </Style>

    <Style Selector="Border.cards-filter-shell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="TextBox.cards-search">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="260"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="ComboBox.cards-select">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="112"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>












    <Style Selector="TextBlock.cards-row-subtitle">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="TextBlock.cards-number">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LetterSpacing" Value="1.6"/>
    </Style>

    <Style Selector="TextBlock.cards-expiry">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.cards-issuer-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
  </UserControl.Styles>
</UserControl>
