<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.CardsView"
             x:CompileBindings="False"
             x:DataType="vm:CardsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32"
                  MaxWidth="1500"
                  HorizontalAlignment="Stretch"
                  Spacing="22">
        <TextBlock Text="Credit Cards"
                   Margin="0,10,0,-4"
                   FontSize="28"
                   FontWeight="SemiBold"
                   LetterSpacing="-0.8"/>

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="18">
          <Border Classes="cards-stat primary"
                  Padding="24,20">
            <StackPanel Spacing="8">
              <TextBlock Text="ACTIVE CARDS"
                         Classes="cards-kicker"/>
              <TextBlock Text="{Binding ActiveCardsCount}"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Image Source="avares://ShellKrypt.Desktop/Assets/trend-up.png"
                       Width="18"
                       Height="12"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ActiveCardsSummary}"
                           Classes="cards-accent-note"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="cards-stat danger"
                  Padding="24,20">
            <StackPanel Spacing="8">
              <TextBlock Text="EXPIRING SOON"
                         Classes="cards-kicker"/>
              <TextBlock Text="{Binding ExpiringSoonCount}"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="!"
                           Foreground="{StaticResource DangerBrush}"
                           FontWeight="Black"/>
                <TextBlock Text="{Binding ExpiringSoonSummary}"
                           Classes="cards-danger-note"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  Classes="cards-stat danger"
                  Padding="24,20">
            <StackPanel Spacing="8">
              <TextBlock Text="EXPIRED CARDS"
                         Classes="cards-kicker"/>
              <TextBlock Text="{Binding ExpiredCardsCount}"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="!"
                           Foreground="{StaticResource DangerBrush}"
                           FontWeight="Black"/>
                <TextBlock Text="{Binding ExpiredCardsSummary}"
                           Classes="cards-danger-note"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="cards-filter-shell"
                Padding="0">
          <WrapPanel Orientation="Horizontal"
                     VerticalAlignment="Center">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="cards-search"
                     PlaceholderText="Search by name or bank..."
                     VerticalAlignment="Center"/>
            <ComboBox Classes="cards-select"
                      ItemsSource="{Binding BankFilters}"
                      SelectedItem="{Binding SelectedBankFilter, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="cards-select"
                      ItemsSource="{Binding CardTypeFilters}"
                      SelectedItem="{Binding SelectedCardTypeFilter, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="cards-select"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <Button Content="+ Add New Card"
                    Classes="cards-add-button"
                    Command="{Binding AddNewCommand}"
                    VerticalAlignment="Center"/>
          </WrapPanel>
        </Border>

        <Border Classes="table-shell"
                MinWidth="1080"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Classes="table-header-row">
              <Grid ColumnDefinitions="1.45*,1.2*,1.35*,42,0.75*,0.8*,260"
                    ColumnSpacing="18">
                <TextBlock Text="CARD IDENTITY" Classes="table-header-text"/>
                <TextBlock Grid.Column="1" Text="BANK" Classes="table-header-text"/>
                <TextBlock Grid.Column="2" Text="NUMBER" Classes="table-header-text"/>
                <TextBlock Grid.Column="4" Text="EXPIRY" Classes="table-header-text"/>
                <TextBlock Grid.Column="5" Text="ISSUER" Classes="table-header-text"/>
                <TextBlock Grid.Column="6"
                           Text="ACTIONS"
                           Classes="table-header-text"
                           HorizontalAlignment="Right"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1"
                  MinHeight="390">
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CardRowVm">
                    <Border Classes="table-row">
                      <Grid ColumnDefinitions="1.45*,1.2*,1.35*,42,0.75*,0.8*,260"
                            ColumnSpacing="18"
                            Margin="22,0"
                            MinHeight="78">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              VerticalAlignment="Center">
                          <Border Width="34"
                                  Height="34"
                                  CornerRadius="4"
                                  Background="{StaticResource SurfaceElevatedBrush}">
                            <Grid>
                              <Border Width="24"
                                      Height="24"
                                      CornerRadius="2"
                                      Background="{StaticResource AppBackgroundSoftBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                              <TextBlock Text="C"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         FontWeight="Black"
                                         Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="4"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SubtitleDisplay}"
                                       Classes="cards-row-subtitle"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding BankDisplay}"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding NumberDisplay}"
                                     Classes="cards-number"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Content="E"
                                Classes="cards-reveal-button"
                                Command="{Binding DataContext.ToggleSecretsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding SecretsActionLabel}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="4"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <Grid ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="6">
                            <TextBlock Text="{Binding ExpiryDisplay}"
                                       Classes="cards-expiry"/>
                            <TextBlock Grid.Column="1"
                                       Text="!"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontWeight="Black"
                                       IsVisible="{Binding IsExpiryUrgent}"/>
                          </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="5"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <Border Classes="cards-issuer-chip"
                                  Padding="9,3"
                                  HorizontalAlignment="Left">
                            <TextBlock Text="{Binding IssuerDisplay}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                          </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="6"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                          <Button Content="Details"
                                  Classes="table-action-button"
                                  Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="Copy Card Number"
                                  Classes="table-action-button"
                                  Command="{Binding DataContext.CopyCardNumberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Classes="table-empty"
                          IsVisible="{Binding !HasRows}">
                <TextBlock Text="{Binding EmptyTableTitle}"
                           Classes="table-empty-title"/>
                <TextBlock Text="{Binding EmptyTableSubtitle}"
                           Classes="table-empty-subtitle"/>
              </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Classes="table-footer-row">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                    ColumnSpacing="10">
                <TextBlock Text="{Binding ItemsSummary}"
                           Classes="table-footer-text"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Previous"
                        Classes="table-page-button"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPreviousPage}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding PageSummary}"
                           Classes="table-footer-text"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="3"
                        Content="Next"
                        Classes="table-page-button"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNextPage}"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Background="{StaticResource OverlayScrimBrush}"
            IsVisible="{Binding IsAddCardModalOpen}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Grid>
        <Border Classes="cards-modal-card"
                Width="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28">
          <StackPanel Spacing="22">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding CardModalTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           LetterSpacing="-0.4"/>
                <TextBlock Text="{Binding CardModalSubtitle}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="X"
                      Classes="cards-modal-close-button"
                      Command="{Binding CancelAddCardCommand}"
                      ToolTip.Tip="Close"/>
            </Grid>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,*,*"
                  RowSpacing="14"
                  ColumnSpacing="16">
              <StackPanel Grid.ColumnSpan="2"
                          Spacing="7">
                <TextBlock Text="CARD TITLE"
                           Classes="cards-modal-label"/>
                <TextBox Text="{Binding AddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="cards-modal-input"
                         IsReadOnly="{Binding IsCardFormReadOnly}"
                         PlaceholderText="Titanium Business"/>
              </StackPanel>

              <StackPanel Grid.Column="2"
                          Spacing="7">
                <TextBlock Text="CARD TYPE"
                           Classes="cards-modal-label"/>
                <ComboBox ItemsSource="{Binding CardTypeOptions}"
                          SelectedItem="{Binding AddCardType, Mode=TwoWay}"
                          IsEnabled="{Binding IsCardFormEditable}"
                          Classes="cards-modal-input"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Spacing="7">
                <TextBlock Text="BANK"
                           Classes="cards-modal-label"/>
                <TextBox Text="{Binding AddBank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="cards-modal-input"
                         IsReadOnly="{Binding IsCardFormReadOnly}"
                         PlaceholderText="Chase"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="CARDHOLDER"
                           Classes="cards-modal-label"/>
                <TextBox Text="{Binding AddCardholder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="cards-modal-input"
                         IsReadOnly="{Binding IsCardFormReadOnly}"
                         PlaceholderText="Alex Morgan"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.Column="2"
                          Spacing="7">
                <TextBlock Text="ISSUER"
                           Classes="cards-modal-label"/>
                <ComboBox ItemsSource="{Binding IssuerOptions}"
                          SelectedItem="{Binding AddIssuer, Mode=TwoWay}"
                          IsEnabled="{Binding IsCardFormEditable}"
                          Classes="cards-modal-input"/>
              </StackPanel>

              <StackPanel Grid.Row="2"
                          Grid.ColumnSpan="3"
                          Spacing="7">
                <TextBlock Text="CARD NUMBER"
                           Classes="cards-modal-label"/>
                <TextBox x:Name="AddCardNumberTextBox"
                         Text="{Binding AddNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="cards-modal-input"
                         IsReadOnly="{Binding IsCardFormReadOnly}"
                         MaxLength="19"
                         TextChanged="AddCardNumberTextBox_OnTextChanged"
                         PlaceholderText="4242 4242 4242 4242"/>
              </StackPanel>

              <Grid Grid.Row="3"
                    Grid.ColumnSpan="3"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="16">
                <StackPanel Spacing="7">
                  <TextBlock Text="EXPIRY MONTH"
                             Classes="cards-modal-label"/>
                  <TextBox Text="{Binding AddExpiryMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="cards-modal-input"
                           IsReadOnly="{Binding IsCardFormReadOnly}"
                           MaxLength="2"
                           PlaceholderText="09"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="7">
                  <TextBlock Text="EXPIRY YEAR"
                             Classes="cards-modal-label"/>
                  <TextBox Text="{Binding AddExpiryYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="cards-modal-input"
                           IsReadOnly="{Binding IsCardFormReadOnly}"
                           MaxLength="4"
                           PlaceholderText="2028"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Spacing="7">
                  <TextBlock Text="CVC"
                             Classes="cards-modal-label"/>
                  <Border Classes="cards-modal-input-shell">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                      <TextBox Text="{Binding AddCvc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Classes="cards-modal-input borderless"
                               IsReadOnly="{Binding IsCardFormReadOnly}"
                               IsVisible="{Binding !IsAddCvcVisible}"
                               PasswordChar="*"
                               MaxLength="4"
                               PlaceholderText="123"/>
                      <TextBox Text="{Binding AddCvc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Classes="cards-modal-input borderless"
                               IsReadOnly="{Binding IsCardFormReadOnly}"
                               IsVisible="{Binding IsAddCvcVisible}"
                               MaxLength="4"
                               PlaceholderText="123"/>
                      <Button Grid.Column="1"
                              Content="{Binding AddCvcVisibilityLabel}"
                              Classes="cards-modal-field-action"
                              Command="{Binding ToggleAddCvcVisibilityCommand}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>

              <StackPanel Grid.Row="4"
                          Grid.ColumnSpan="3"
                          Spacing="12">
                <StackPanel Spacing="7">
                  <TextBlock Text="NOTES"
                             Classes="cards-modal-label"/>
                  <TextBox Text="{Binding AddNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="cards-modal-input"
                           IsReadOnly="{Binding IsCardFormReadOnly}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="98"
                           PlaceholderText="Rewards category, usage notes, or card context..."/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Error}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="-8,0,-8,-8">
              <Grid ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="{Binding CardModalFooterText}"
                           Classes="page-subtitle"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="cards-modal-secondary-button"
                        IsVisible="{Binding IsAddCardMode}"
                        Command="{Binding CancelAddCardCommand}"/>
                <Button Grid.Column="2"
                        Content="Add Credit Card"
                        Classes="cards-modal-primary-button"
                        IsVisible="{Binding IsAddCardMode}"
                        Command="{Binding SaveAddCardCommand}"/>
                <Button Grid.Column="1"
                        Content="Delete"
                        Classes="cards-modal-danger-button"
                        IsVisible="{Binding IsCardDetailsViewMode}"
                        Command="{Binding BeginDetailsDeleteCommand}"/>
                <Button Grid.Column="2"
                        Content="Edit"
                        Classes="cards-modal-primary-button"
                        IsVisible="{Binding IsCardDetailsViewMode}"
                        Command="{Binding BeginDetailsEditCommand}"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="cards-modal-secondary-button"
                        IsVisible="{Binding IsCardDetailsEditMode}"
                        Command="{Binding CancelDetailsEditCommand}"/>
                <Button Grid.Column="2"
                        Content="Save"
                        Classes="cards-modal-primary-button"
                        IsVisible="{Binding IsCardDetailsEditMode}"
                        Command="{Binding SaveDetailsCommand}"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="cards-modal-secondary-button"
                        IsVisible="{Binding IsCardDetailsDeleteConfirmMode}"
                        Command="{Binding CancelDetailsDeleteCommand}"/>
                <Button Grid.Column="2"
                        Content="Delete"
                        Classes="cards-modal-danger-button"
                        IsVisible="{Binding IsCardDetailsDeleteConfirmMode}"
                        Command="{Binding ConfirmDetailsDeleteCommand}"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.cards-encryption-badge">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="CornerRadius" Value="999"/>
    </Style>

    <Style Selector="Border.cards-count-badge">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBlock.cards-badge-text">
      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="1.7"/>
    </Style>

    <Style Selector="TextBlock.cards-muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock.cards-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="TextBlock.cards-accent-note">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.cards-danger-note">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.cards-stat">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight" Value="112"/>
    </Style>

    <Style Selector="Border.cards-stat.primary">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.cards-stat.danger">
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
    </Style>

    <Style Selector="Border.cards-filter-shell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="TextBox.cards-search">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="360"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style Selector="ComboBox.cards-select">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="140"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-add-button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Width" Value="164"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-add-button:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Border.cards-modal-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ModalBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Border.cards-modal-input-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="TextBlock.cards-modal-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.1"/>
    </Style>

    <Style Selector="TextBox.cards-modal-input">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style Selector="TextBox.cards-modal-input:pointerover">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="ComboBox.cards-modal-input">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Width" Value="210"/>
      <Setter Property="MinWidth" Value="210"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style Selector="TextBox.cards-modal-input:focus">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox.cards-modal-input.borderless">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox.cards-modal-input.borderless:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox.cards-modal-input.borderless:focus">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.cards-modal-close-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-modal-close-button:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.cards-modal-field-action">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-modal-field-action:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.cards-modal-secondary-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-modal-secondary-button:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.cards-modal-danger-button">
      <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource DangerForegroundBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="24,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-modal-danger-button:pointerover">
      <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
    </Style>

    <Style Selector="Button.cards-modal-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="24,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-modal-primary-button:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="TextBlock.cards-row-subtitle">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="TextBlock.cards-number">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LetterSpacing" Value="2.4"/>
    </Style>

    <Style Selector="TextBlock.cards-expiry">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.cards-issuer-chip">
