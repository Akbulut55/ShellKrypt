<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:ShellKrypt.UI.Shared.Controls"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.WebLoginsView"
             x:CompileBindings="False"
             x:DataType="vm:WebLoginsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16"
                  HorizontalAlignment="Stretch"
                  Spacing="14">
        <TextBlock Text="{DynamicResource Loc.WebLogins.Title}"
                   Margin="0,10,0,-4"
                   FontSize="28"
                   FontWeight="SemiBold"
                   LetterSpacing="-0.8"/>

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="8">
          <Border Classes="web-stat">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.WebLogins.TotalLogins}"
                         Classes="web-kicker"/>
              <TextBlock Text="{Binding TotalLoginsCount}"
                         FontSize="24"
                         FontWeight="SemiBold"/>
              <TextBlock Text="{Binding TotalLoginsSummary}"
                         Classes="web-accent-note"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="web-stat">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.WebLogins.ReusedPasswords}"
                         Classes="web-kicker"/>
              <TextBlock Text="{Binding ReusedPasswordCount}"
                         FontSize="24"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="{Binding ReusedPasswordSummary}"
                         Classes="web-muted-note"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  Classes="web-stat">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.WebLogins.WeakPasswords}"
                         Classes="web-kicker"/>
              <TextBlock Text="{Binding WeakPasswordCount}"
                         FontSize="24"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="{Binding WeakPasswordSummary}"
                         Classes="web-muted-note"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="web-filter-shell">
          <WrapPanel Orientation="Horizontal"
                     VerticalAlignment="Center">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="web-search"
                     PlaceholderText="{DynamicResource Loc.WebLogins.Search.Placeholder}"
                     VerticalAlignment="Center"/>
            <ComboBox Classes="web-select"
                      ItemsSource="{Binding UsernameFilters}"
                      SelectedItem="{Binding SelectedUsernameFilterChoice, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="web-select"
                      ItemsSource="{Binding EmailFilters}"
                      SelectedItem="{Binding SelectedEmailFilterChoice, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="web-select"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <Button Classes="sk-primary"
                    Command="{Binding AddNewCommand}"
                    Margin="0,0,0,10"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"
                          Spacing="7"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Loc.WebLogins.Button.Add}"
                           Foreground="{StaticResource AccentForegroundBrush}"
                           FontWeight="SemiBold"/>
                <Path Classes="material-icon on-primary"
                      Width="15"
                      Height="15"
                      Data="{StaticResource IconAdd}"/>
              </StackPanel>
            </Button>
          </WrapPanel>
        </Border>

      <Border Classes="table-shell"
              MinWidth="580"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,390,Auto">
          <Border Classes="table-header-row">
            <Grid ColumnDefinitions="1.16*,0.84*,0.74*,0.86*,156"
                  ColumnSpacing="8">
              <TextBlock Text="{DynamicResource Loc.WebLogins.Table.Title}" Classes="table-header-text"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource Loc.WebLogins.Table.Username}" Classes="table-header-text"/>
              <TextBlock Grid.Column="2" Text="{DynamicResource Loc.WebLogins.Table.Password}" Classes="table-header-text"/>
              <TextBlock Grid.Column="3"
                         Text="{DynamicResource Loc.WebLogins.Table.Url}"
                         Classes="table-header-text"
                         TextAlignment="Center"/>
              <TextBlock Grid.Column="4"
                         Text="{DynamicResource Loc.Common.Actions.Header}"
                         Classes="table-header-text"
                         HorizontalAlignment="Right"/>
            </Grid>
          </Border>

          <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasRows}">
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WebLoginRowVm">
                  <Border Classes="table-row">
                    <Grid ColumnDefinitions="1.16*,0.84*,0.74*,0.86*,156"
                          ColumnSpacing="8"
                          MinHeight="78"
                          Margin="12,0">
                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="12"
                            VerticalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="4"
                                Background="{StaticResource SurfaceElevatedBrush}">
                          <Grid>
                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="2"
                                    Background="{StaticResource AppBackgroundSoftBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IconLetter}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Black"
                                       Foreground="{StaticResource AccentBrush}"/>
                          </Grid>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                      </Grid>

                      <TextBlock Grid.Column="1"
                                 Text="{Binding UsernameDisplay}"
                                 Classes="web-row-muted"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>

                      <Grid Grid.Column="2"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding PasswordDisplay}"
                                   Classes="web-password"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Classes="sk-icon-ghost"
                                Content="E"
                                Command="{Binding DataContext.TogglePasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{DynamicResource Loc.WebLogins.Tooltip.RevealPassword}"/>
                      </Grid>

                      <TextBlock Grid.Column="3"
                                 Text="{Binding UrlHost}"
                                 Classes="web-url"
                                 TextTrimming="CharacterEllipsis"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center"/>

                      <StackPanel Grid.Column="4"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                   Spacing="6">
                        <Button Classes="sk-table-action"
                                Content="{DynamicResource Loc.Common.Details}"
                                Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{DynamicResource Loc.WebLogins.Tooltip.ViewDetails}"/>
                        <Button Classes="sk-table-action"
                                Content="{DynamicResource Loc.WebLogins.Button.CopyPassword}"
                                Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{DynamicResource Loc.WebLogins.Tooltip.CopyPassword}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <StackPanel Classes="table-empty"
                        IsVisible="{Binding !HasRows}">
              <TextBlock Text="{Binding EmptyTableTitle}"
                         Classes="table-empty-title"/>
              <TextBlock Text="{Binding EmptyTableSubtitle}"
                         Classes="table-empty-subtitle"/>
            </StackPanel>
          </Grid>

          <Border Grid.Row="2"
                  Classes="table-footer-row">
            <Grid ColumnDefinitions="*">
              <TextBlock Text="{Binding ItemsSummary}"
                         Classes="table-footer-text"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      </StackPanel>
    </ScrollViewer>

    <shared:ModalShell IsOpen="{Binding IsAddWebLoginModalOpen}"
                       Title="{Binding AddModalTitle}"
                       Subtitle="{Binding AddModalSubtitle}"
                       Error="{Binding Error}"
                       FooterText="{Binding AddModalFooterText}"
                       CloseCommand="{Binding CancelAddCommand}">
      <shared:ModalShell.Body>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,*"
              RowSpacing="14"
              ColumnSpacing="16">
              <StackPanel Spacing="7">
                <TextBlock Text="{DynamicResource Loc.WebLogins.Form.Title}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         PlaceholderText="{DynamicResource Loc.WebLogins.Form.Title.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.WebLogins.Form.Url}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         PlaceholderText="{DynamicResource Loc.WebLogins.Form.Url.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.WebLogins.Form.Username}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         PlaceholderText="{DynamicResource Loc.WebLogins.Form.Username.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.WebLogins.Form.Email}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         PlaceholderText="{DynamicResource Loc.WebLogins.Form.Email.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Row="2"
                          Grid.ColumnSpan="2"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.WebLogins.Form.Password}"
                           Classes="modal-shell-label"/>
                <Border Classes="modal-shell-input-shell">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                        ColumnSpacing="8">
                    <TextBox Text="{Binding AddPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="modal-shell-input borderless"
                             PasswordChar="*"
                             IsReadOnly="{Binding IsAddFormReadOnly}"
                             IsVisible="{Binding !IsAddPasswordVisible}"
                             PlaceholderText="{DynamicResource Loc.WebLogins.Form.Password.Placeholder}"/>
                    <TextBox Text="{Binding AddPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="modal-shell-input borderless"
                             IsReadOnly="{Binding IsAddFormReadOnly}"
                             IsVisible="{Binding IsAddPasswordVisible}"
                             PlaceholderText="{DynamicResource Loc.WebLogins.Form.Password.Placeholder}"/>
                    <Button Grid.Column="1"
                            Classes="modal-shell-field-action"
                            Command="{Binding ToggleAddPasswordVisibilityCommand}"
                            ToolTip.Tip="{Binding AddPasswordVisibilityLabel}">
                      <Grid>
                        <PathIcon Data="{StaticResource IconVisibility}"
                                  Width="16"
                                  Height="16"
                                  IsVisible="{Binding !IsAddPasswordVisible}"/>
                        <PathIcon Data="{StaticResource IconVisibilityOff}"
                                  Width="16"
                                  Height="16"
                                  IsVisible="{Binding IsAddPasswordVisible}"/>
                      </Grid>
                    </Button>
                    <Button Grid.Column="2"
                            Content="{DynamicResource Loc.Common.Copy}"
                            Classes="modal-shell-field-action"
                            Command="{Binding CopyAddPasswordCommand}"/>
                    <Button Grid.Column="3"
                            Content="{DynamicResource Loc.Common.Generate}"
                            Classes="modal-shell-field-action primary"
                            IsVisible="{Binding CanGenerateModalPassword}"
                            Command="{Binding GenerateAddPasswordCommand}"/>
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Grid.Row="3"
                          Grid.ColumnSpan="2"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Common.Notes.Label}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input multiline"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="110"
                         PlaceholderText="{DynamicResource Loc.WebLogins.Form.Notes.Placeholder}"/>
              </StackPanel>
            </Grid>
      </shared:ModalShell.Body>
      <shared:ModalShell.FooterActions>
        <Grid ColumnDefinitions="Auto,Auto"
              ColumnSpacing="12">
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Cancel}"
                        Classes="modal-shell-secondary-button"
                        IsVisible="{Binding IsAddWebLoginMode}"
                        Command="{Binding CancelAddCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.WebLogins.Button.AddSubmit}"
                        Classes="modal-shell-primary-button"
                        IsVisible="{Binding IsAddWebLoginMode}"
                        Command="{Binding SaveAddCommand}"/>
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Delete}"
                        Classes="modal-shell-danger-button"
                        IsVisible="{Binding IsDetailsViewMode}"
                        Command="{Binding BeginDetailsDeleteCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Edit}"
                        Classes="modal-shell-primary-button"
                        IsVisible="{Binding IsDetailsViewMode}"
                        Command="{Binding BeginDetailsEditCommand}"/>
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Cancel}"
                        Classes="modal-shell-secondary-button"
                        IsVisible="{Binding IsDetailsEditMode}"
                        Command="{Binding CancelDetailsEditCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Save}"
                        Classes="modal-shell-primary-button"
                        IsVisible="{Binding IsDetailsEditMode}"
                        Command="{Binding SaveDetailsCommand}"/>
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Cancel}"
                        Classes="modal-shell-secondary-button"
                        IsVisible="{Binding IsDetailsDeleteConfirmMode}"
                        Command="{Binding CancelDetailsDeleteCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Delete}"
                        Classes="modal-shell-danger-button"
                        IsVisible="{Binding IsDetailsDeleteConfirmMode}"
                        Command="{Binding ConfirmDetailsDeleteCommand}"/>
              </Grid>
      </shared:ModalShell.FooterActions>
    </shared:ModalShell>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.web-encryption-badge">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="CornerRadius" Value="999"/>
    </Style>

    <Style Selector="Border.web-stat">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="MinHeight" Value="96"/>
    </Style>

    <Style Selector="Border.web-filter-shell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="TextBox.web-search">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="260"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="ComboBox.web-select">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="124"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>










    <Style Selector="TextBlock.web-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="TextBlock.web-accent-note">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.web-muted-note">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.web-row-muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LetterSpacing" Value="0.4"/>
    </Style>

    <Style Selector="TextBlock.web-password">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LetterSpacing" Value="1.6"/>
    </Style>

    <Style Selector="TextBlock.web-url">
      <Setter Property="Foreground" Value="{StaticResource BorderBrushStrong}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LetterSpacing" Value="0.6"/>
    </Style>

    <Style Selector="TextBlock.web-footer-text">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Styles>
</UserControl>
