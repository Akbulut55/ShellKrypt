<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.WebLoginsView"
             x:CompileBindings="False"
             x:DataType="vm:WebLoginsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32"
                  MaxWidth="1500"
                  HorizontalAlignment="Stretch"
                  Spacing="22">
      <Grid Margin="0,10,0,8">
        <StackPanel Spacing="9">
          <TextBlock Text="Web Logins"
                     FontSize="28"
                     FontWeight="SemiBold"
                     LetterSpacing="-0.8"/>
          <TextBlock Text="Manage your secure credentials for web platforms."
                     Classes="page-subtitle"
                     FontSize="13"/>

          <Grid ColumnDefinitions="440,Auto,*,Auto"
                ColumnSpacing="12"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="web-search"
                     PlaceholderText="Search logins..."/>
            <Grid Grid.Column="1">
              <Button x:Name="EmailFilterButton"
                      Content="{Binding EmailFilterButtonText}"
                      Classes="web-filter-button"
                      Command="{Binding ToggleEmailFilterCommand}"/>

              <Popup IsOpen="{Binding IsEmailFilterPopupOpen, Mode=TwoWay}"
                     PlacementTarget="{Binding #EmailFilterButton}"
                     Placement="BottomEdgeAlignedLeft"
                     VerticalOffset="8"
                     IsLightDismissEnabled="True">
                <Border Classes="web-email-filter-popup"
                        Width="300">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="FILTER BY EMAIL"
                                 Classes="web-modal-label"/>
                      <TextBlock Text="{Binding EmailFilterSummary}"
                                 Classes="web-footer-text"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Content="All emails"
                            Classes="web-email-filter-option"
                            Command="{Binding ClearEmailFilterCommand}"/>

                    <TextBlock Text="No saved emails yet."
                               Classes="web-footer-text"
                               IsVisible="{Binding !HasEmailFilterOptions}"/>

                    <ScrollViewer MaxHeight="320"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding HasEmailFilterOptions}">
                      <ItemsControl ItemsSource="{Binding EmailFilterOptions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:EmailFilterOptionVm">
                            <Button Classes="web-email-filter-option"
                                    Command="{Binding SelectCommand}"
                                    CommandParameter="{Binding Email}">
                              <TextBlock Text="{Binding Email}"
                                         TextTrimming="CharacterEllipsis"/>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
            <Button Grid.Column="3"
                    Content="+ Add Website Login"
                    Classes="web-add-login-button"
                    Command="{Binding AddNewCommand}"/>
          </Grid>
        </StackPanel>
      </Grid>

      <Border Classes="table-shell"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Classes="table-header-row">
            <Grid ColumnDefinitions="1.55*,1.55*,1.45*,1.55*,280"
                  ColumnSpacing="24">
              <TextBlock Text="TITLE" Classes="table-header-text"/>
              <TextBlock Grid.Column="1" Text="USERNAME" Classes="table-header-text"/>
              <TextBlock Grid.Column="2" Text="PASSWORD" Classes="table-header-text"/>
              <TextBlock Grid.Column="3"
                         Text="URL"
                         Classes="table-header-text"
                         TextAlignment="Center"/>
              <TextBlock Grid.Column="4"
                         Text="ACTIONS"
                         Classes="table-header-text"
                         HorizontalAlignment="Right"/>
            </Grid>
          </Border>

          <Grid Grid.Row="1"
                MinHeight="390">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WebLoginRowVm">
                  <Border Classes="table-row">
                    <Grid ColumnDefinitions="1.55*,1.55*,1.45*,1.55*,280"
                          ColumnSpacing="24"
                          MinHeight="78"
                          Margin="22,0">
                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="12"
                            VerticalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="4"
                                Background="{StaticResource SurfaceElevatedBrush}">
                          <Grid>
                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="2"
                                    Background="{StaticResource AppBackgroundSoftBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IconLetter}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Black"
                                       Foreground="{StaticResource AccentBrush}"/>
                          </Grid>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                      </Grid>

                      <TextBlock Grid.Column="1"
                                 Text="{Binding UsernameDisplay}"
                                 Classes="web-row-muted"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>

                      <Grid Grid.Column="2"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding PasswordDisplay}"
                                   Classes="web-password"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Classes="web-inline-icon"
                                Content="E"
                                Command="{Binding DataContext.TogglePasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Reveal password"/>
                      </Grid>

                      <TextBlock Grid.Column="3"
                                 Text="{Binding UrlHost}"
                                 Classes="web-url"
                                 TextTrimming="CharacterEllipsis"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center"/>

                      <StackPanel Grid.Column="4"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Spacing="8">
                        <Button Classes="table-action-button"
                                Content="Details"
                                Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="View login details"/>
                        <Button Classes="table-action-button"
                                Content="Copy Password"
                                Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Copy password"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Classes="table-empty"
                        IsVisible="{Binding !HasRows}">
              <TextBlock Text="{Binding EmptyTableTitle}"
                         Classes="table-empty-title"/>
              <TextBlock Text="{Binding EmptyTableSubtitle}"
                         Classes="table-empty-subtitle"/>
            </StackPanel>
          </Grid>

          <Border Grid.Row="2"
                  Classes="table-footer-row">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="10">
              <TextBlock Text="{Binding ItemsSummary}"
                         Classes="table-footer-text"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Content="Previous"
                      Classes="table-page-button"
                      Command="{Binding PreviousPageCommand}"
                      IsEnabled="{Binding CanGoPreviousPage}"/>
              <TextBlock Grid.Column="2"
                         Text="{Binding PageSummary}"
                         Classes="table-footer-text"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="3"
                      Content="Next"
                      Classes="table-page-button"
                      Command="{Binding NextPageCommand}"
                      IsEnabled="{Binding CanGoNextPage}"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Classes="web-bento-card"
              MinHeight="112"
              Padding="24,20">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="24">
          <StackPanel Spacing="8"
                      MaxWidth="860"
                      VerticalAlignment="Center">
            <TextBlock Text="Password Health Check"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock Text="We found 2 reused passwords and 1 weak password. Update risky entries with generated high-entropy strings."
                       Classes="page-subtitle"
                       FontSize="13"
                       LineHeight="19"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <Button Grid.Column="1"
                  Content="START AUDIT ->"
                  Classes="web-link-action"
                  VerticalAlignment="Center"/>
        </Grid>
      </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Background="{StaticResource OverlayScrimBrush}"
            IsVisible="{Binding IsAddWebLoginModalOpen}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Grid>
        <Border Classes="web-modal-card"
                Width="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28">
          <StackPanel Spacing="22">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding AddModalTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           LetterSpacing="-0.4"/>
                <TextBlock Text="{Binding AddModalSubtitle}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="X"
                      Classes="web-modal-close-button"
                      Command="{Binding CancelAddCommand}"
                      ToolTip.Tip="Close"/>
            </Grid>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,*"
                  RowSpacing="14"
                  ColumnSpacing="16">
              <StackPanel Spacing="7">
                <TextBlock Text="TITLE"
                           Classes="web-modal-label"/>
                <TextBox Text="{Binding AddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="web-modal-input"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         PlaceholderText="ShellKrypt"/>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="WEBSITE URL"
                           Classes="web-modal-label"/>
                <TextBox Text="{Binding AddUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="web-modal-input"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         PlaceholderText="https://example.com"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Spacing="7">
                <TextBlock Text="USERNAME"
                           Classes="web-modal-label"/>
                <TextBox Text="{Binding AddUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="web-modal-input"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         PlaceholderText="shellkrypt-user"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="EMAIL"
                           Classes="web-modal-label"/>
                <TextBox Text="{Binding AddEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="web-modal-input"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         PlaceholderText="dev@shellkrypt.local"/>
              </StackPanel>

              <StackPanel Grid.Row="2"
                          Grid.ColumnSpan="2"
                          Spacing="7">
                <TextBlock Text="PASSWORD"
                           Classes="web-modal-label"/>
                <Border Classes="web-modal-input-shell">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                        ColumnSpacing="8">
                    <TextBox Text="{Binding AddPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="web-modal-input borderless"
                             PasswordChar="*"
                             IsReadOnly="{Binding IsAddFormReadOnly}"
                             IsVisible="{Binding !IsAddPasswordVisible}"
                             PlaceholderText="Use Generate or enter a password"/>
                    <TextBox Text="{Binding AddPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="web-modal-input borderless"
                             IsReadOnly="{Binding IsAddFormReadOnly}"
                             IsVisible="{Binding IsAddPasswordVisible}"
                             PlaceholderText="Use Generate or enter a password"/>
                    <Button Grid.Column="1"
                            Content="{Binding AddPasswordVisibilityLabel}"
                            Classes="web-modal-field-action"
                            Command="{Binding ToggleAddPasswordVisibilityCommand}"/>
                    <Button Grid.Column="2"
                            Content="Copy"
                            Classes="web-modal-field-action"
                            Command="{Binding CopyAddPasswordCommand}"/>
                    <Button Grid.Column="3"
                            Content="Generate"
                            Classes="web-modal-field-action primary"
                            IsVisible="{Binding CanGenerateModalPassword}"
                            Command="{Binding GenerateAddPasswordCommand}"/>
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Grid.Row="3"
                          Grid.ColumnSpan="2"
                          Spacing="7">
                <TextBlock Text="NOTES"
                           Classes="web-modal-label"/>
                <TextBox Text="{Binding AddNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="web-modal-input"
                         IsReadOnly="{Binding IsAddFormReadOnly}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="110"
                         PlaceholderText="Recovery hints, account context, or internal notes..."/>
              </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Error}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="-8,0,-8,-8">
              <Grid ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="{Binding AddModalFooterText}"
                           Classes="page-subtitle"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="web-modal-secondary-button"
                        IsVisible="{Binding IsAddWebLoginMode}"
                        Command="{Binding CancelAddCommand}"/>
                <Button Grid.Column="2"
                        Content="Add Web Login"
                        Classes="web-modal-primary-button"
                        IsVisible="{Binding IsAddWebLoginMode}"
                        Command="{Binding SaveAddCommand}"/>
                <Button Grid.Column="1"
                        Content="Delete"
                        Classes="web-modal-danger-button"
                        IsVisible="{Binding IsDetailsViewMode}"
                        Command="{Binding BeginDetailsDeleteCommand}"/>
                <Button Grid.Column="2"
                        Content="Edit"
                        Classes="web-modal-primary-button"
                        IsVisible="{Binding IsDetailsViewMode}"
                        Command="{Binding BeginDetailsEditCommand}"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="web-modal-secondary-button"
                        IsVisible="{Binding IsDetailsEditMode}"
                        Command="{Binding CancelDetailsEditCommand}"/>
                <Button Grid.Column="2"
                        Content="Save"
                        Classes="web-modal-primary-button"
                        IsVisible="{Binding IsDetailsEditMode}"
                        Command="{Binding SaveDetailsCommand}"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="web-modal-secondary-button"
                        IsVisible="{Binding IsDetailsDeleteConfirmMode}"
                        Command="{Binding CancelDetailsDeleteCommand}"/>
                <Button Grid.Column="2"
                        Content="Delete"
                        Classes="web-modal-danger-button"
                        IsVisible="{Binding IsDetailsDeleteConfirmMode}"
                        Command="{Binding ConfirmDetailsDeleteCommand}"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.web-encryption-badge">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="CornerRadius" Value="999"/>
    </Style>

    <Style Selector="TextBox.web-search">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style Selector="Button.web-filter-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.web-filter-button:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.web-email-filter-popup">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ModalBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style Selector="Button.web-email-filter-option">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="MaxWidth" Value="272"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.web-email-filter-option:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.web-add-login-button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.web-add-login-button:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Border.web-bento-card">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.web-modal-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ModalBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Border.web-modal-input-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="TextBlock.web-modal-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.1"/>
    </Style>

    <Style Selector="TextBox.web-modal-input">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style Selector="TextBox.web-modal-input:focus">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="TextBox.web-modal-input.borderless">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="Button.web-modal-close-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.web-modal-close-button:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.web-modal-field-action">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.web-modal-field-action:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.web-modal-field-action.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
    </Style>

    <Style Selector="Button.web-modal-field-action.primary:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Button.web-modal-secondary-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.web-modal-secondary-button:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.web-modal-danger-button">
      <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource DangerForegroundBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="24,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.web-modal-danger-button:pointerover">
      <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
    </Style>

    <Style Selector="Button.web-modal-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="24,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.web-modal-primary-button:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="TextBlock.web-kicker">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="TextBlock.web-row-muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LetterSpacing" Value="0.4"/>
    </Style>

    <Style Selector="TextBlock.web-password">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LetterSpacing" Value="2.4"/>
    </Style>

    <Style Selector="TextBlock.web-url">
      <Setter Property="Foreground" Value="{StaticResource BorderBrushStrong}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LetterSpacing" Value="0.6"/>
    </Style>

    <Style Selector="TextBlock.web-footer-text">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.web-inline-icon">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.web-inline-icon:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.web-link-action">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="3"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
</UserControl>
