<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             xmlns:markdown="using:ShellKrypt.Application.Markdown"
             x:Class="ShellKrypt.Desktop.Views.MarkdownNotesView"
             x:CompileBindings="False"
             x:DataType="vm:MarkdownNotesViewModel">
  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*">
      <Border Classes="notesHeader">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="14"
              VerticalAlignment="Center">
          <Grid>
            <Grid ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="8">
              <StackPanel Spacing="3"
                          MinWidth="220"
                          MaxWidth="420"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedNoteTitleDisplay}"
                           FontSize="24"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SelectedNoteMeta}"
                           Classes="notesMutedText"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="sk-icon notesTitlePickerButton"
                      Command="{Binding ToggleNotePickerCommand}"
                      VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconDropDown}"
                          Width="16"
                          Height="16"
                          Foreground="{StaticResource TextMutedBrush}"/>
              </Button>
            </Grid>

            <Popup IsOpen="{Binding IsNotePickerOpen}"
                   PlacementTarget="{Binding #PickerAnchor}"
                   Placement="Bottom"
                   IsLightDismissEnabled="True">
              <Border Classes="notesPickerPopup">
                <Grid RowDefinitions="Auto,Auto,Auto,*"
                      RowSpacing="10">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Loc.Notes.Picker.SelectNote}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="17"
                                 FontWeight="Bold"/>
                      <TextBlock Text="{Binding NoteCount, StringFormat='{}{0} notes'}"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="12"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="+ Add"
                            Classes="sk-primary"
                            Command="{Binding NewNoteCommand}"/>
                  </Grid>

                  <TextBox Grid.Row="1"
                           Text="{Binding NotePickerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="notesPickerSearch"
                           PlaceholderText="{DynamicResource Loc.Notes.Picker.SearchPlaceholder}"/>

                  <Border Grid.Row="2"
                          Classes="notesPickerSectionHeader">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource Loc.Notes.Picker.AllNotes}"
                                 Classes="notesKicker"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding NotePickerAll.Count, StringFormat='{}{0} shown'}"
                                 Classes="notesPickerCount"/>
                    </Grid>
                  </Border>

                  <ScrollViewer Grid.Row="3"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                      <ItemsControl ItemsSource="{Binding NotePickerAll}"
                                    IsVisible="{Binding HasNotePickerAll}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NoteItemVm">
                            <Button Classes="notesPickerItem"
                                    Classes.active="{Binding IsSelected}"
                                    Command="{Binding DataContext.SelectNoteFromPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Grid RowDefinitions="Auto,Auto,Auto"
                                    ColumnDefinitions="*,Auto"
                                    RowSpacing="5"
                                    ColumnSpacing="10">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding UpdatedDisplay}"
                                           Classes="notesMutedText"/>
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding PreviewText}"
                                           Classes="notesMutedText"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Row="2"
                                        Classes="notesPickerBadge"
                                        HorizontalAlignment="Left">
                                  <TextBlock Text="{Binding StatusLabel}"/>
                                </Border>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border Classes="notesPickerEmpty"
                              IsVisible="{Binding !HasNotePickerAll}">
                        <TextBlock Text="{DynamicResource Loc.Notes.Picker.NoResults}"
                                   Classes="notesMutedText"
                                   TextWrapping="Wrap"/>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Popup>
            <Border x:Name="PickerAnchor"
                    Width="1"
                    Height="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"/>
          </Grid>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="6"
                      VerticalAlignment="Center">
            <Button Classes="sk-icon-ghost notesModeButton"
                    Classes.active="{Binding IsSplitMode}"
                    Command="{Binding ShowSplitModeCommand}"
                    ToolTip.Tip="{DynamicResource Loc.Notes.Mode.Split}">
              <PathIcon Data="{StaticResource IconMarkdownSplitMode}"
                        Width="20"
                        Height="20"/>
            </Button>
            <Button Classes="sk-icon-ghost notesModeButton"
                    Classes.active="{Binding !IsSplitMode}"
                    Command="{Binding ToggleDocumentViewCommand}"
                    ToolTip.Tip="{DynamicResource Loc.Notes.Mode.Editor}">
              <Grid>
                <PathIcon Data="{StaticResource IconMarkdownEditorMode}"
                          Width="20"
                          Height="20"
                          IsVisible="{Binding !IsPreviewOnlyMode}"/>
                <PathIcon Data="{StaticResource IconMarkdownPreviewMode}"
                          Width="20"
                          Height="20"
                          IsVisible="{Binding IsPreviewOnlyMode}"/>
              </Grid>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="3"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    Classes="sk-secondary"
                    Command="{Binding CancelEditingCommand}"
                    IsVisible="{Binding ShowHeaderCommitButtons}"/>
            <Button Content="{DynamicResource Loc.Common.Save}"
                    Classes="sk-primary"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    IsVisible="{Binding ShowHeaderCommitButtons}"/>
            <Button Content="{DynamicResource Loc.Notes.Button.CreateNew}"
                    Classes="sk-primary"
                    Command="{Binding NewNoteCommand}"
                    IsVisible="{Binding ShowHeaderCreateButton}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1"
            Margin="16"
            IsVisible="{Binding HasEditor}">
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="12"
              IsVisible="{Binding IsSplitMode}">
          <Border Classes="notesPane">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{DynamicResource Loc.Notes.Mode.Editor}"
                         Classes="notesPaneTitle"/>
              <TextBox Grid.Row="1"
                       Text="{Binding EditorContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Classes="notesMarkdownEditor"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       PlaceholderText="{DynamicResource Loc.Notes.Editor.Placeholder}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
          </Border>

          <Border Grid.Column="1"
                  Classes="notesPane">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{DynamicResource Loc.Notes.Mode.Preview}"
                         Classes="notesPaneTitle"/>
              <ScrollViewer Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="0">
                  <Border Classes="notesPreviewPlaceholder"
                          IsVisible="{Binding !HasPreviewContent}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{DynamicResource Loc.Notes.Preview.EmptyTitle}"
                                 FontSize="17"
                                 FontWeight="Bold"/>
                      <TextBlock Text="{DynamicResource Loc.Notes.Preview.EmptySubtitle}"
                                 Classes="page-subtitle"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding PreviewBlocks}"
                                IsVisible="{Binding HasPreviewContent}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="markdown:MarkdownBlock">
                        <StackPanel Margin="0,0,0,18">
                          <TextBlock Text="{Binding Text}" Classes="notesMarkdownH1" IsVisible="{Binding IsHeading1}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Text}" Classes="notesMarkdownH2" IsVisible="{Binding IsHeading2}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Text}" Classes="notesMarkdownH3" IsVisible="{Binding IsHeading3}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Text}" Classes="notesMarkdownParagraph" IsVisible="{Binding IsParagraph}" TextWrapping="Wrap"/>
                          <Border Background="{StaticResource QuoteBackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="4,0,0,0" CornerRadius="8" Padding="16,14" IsVisible="{Binding IsQuote}">
                            <TextBlock Text="{Binding Text}" FontSize="14" FontStyle="Italic" LineHeight="22" TextWrapping="Wrap"/>
                          </Border>
                          <Border Background="{StaticResource AppBackgroundSoftBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="16,14" IsVisible="{Binding IsCodeBlock}">
                            <TextBlock Text="{Binding Text}" Classes="notesMarkdownCode" TextWrapping="Wrap"/>
                          </Border>
                          <ItemsControl ItemsSource="{Binding DisplayItems}" IsVisible="{Binding IsList}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" Classes="notesMarkdownListItem" TextWrapping="Wrap"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <Border Classes="notesPane"
                IsVisible="{Binding IsEditorOnlyMode}">
          <Grid RowDefinitions="Auto,*">
            <TextBox Text="{Binding EditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="notesTitleInput"
                     PlaceholderText="{DynamicResource Loc.Notes.Title.Placeholder}"/>
            <TextBox Grid.Row="1"
                     Text="{Binding EditorContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="notesMarkdownEditor"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="{DynamicResource Loc.Notes.Editor.Placeholder}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </Grid>
        </Border>

        <Border Classes="notesPane"
                IsVisible="{Binding IsPreviewOnlyMode}">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="{Binding PreviewDocumentTitle}"
                       Classes="notesPreviewTitle"
                       TextWrapping="Wrap"/>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="0">
                <Border Classes="notesPreviewPlaceholder"
                        IsVisible="{Binding !HasPreviewContent}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Loc.Notes.Preview.EmptyTitle}"
                               FontSize="17"
                               FontWeight="Bold"/>
                    <TextBlock Text="{DynamicResource Loc.Notes.Preview.EmptySubtitle}"
                               Classes="page-subtitle"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding PreviewBlocks}"
                              IsVisible="{Binding HasPreviewContent}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="markdown:MarkdownBlock">
                      <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="{Binding Text}" Classes="notesMarkdownH1" IsVisible="{Binding IsHeading1}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Text}" Classes="notesMarkdownH2" IsVisible="{Binding IsHeading2}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Text}" Classes="notesMarkdownH3" IsVisible="{Binding IsHeading3}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Text}" Classes="notesMarkdownParagraph" IsVisible="{Binding IsParagraph}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource QuoteBackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="4,0,0,0" CornerRadius="8" Padding="16,14" IsVisible="{Binding IsQuote}">
                          <TextBlock Text="{Binding Text}" FontSize="14" FontStyle="Italic" LineHeight="22" TextWrapping="Wrap"/>
                        </Border>
                        <Border Background="{StaticResource AppBackgroundSoftBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="16,14" IsVisible="{Binding IsCodeBlock}">
                          <TextBlock Text="{Binding Text}" Classes="notesMarkdownCode" TextWrapping="Wrap"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding DisplayItems}" IsVisible="{Binding IsList}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" Classes="notesMarkdownListItem" TextWrapping="Wrap"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Background="Transparent"
              IsVisible="{Binding !HasEditor}">
        <StackPanel Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Loc.Notes.NoSelection.Title}"
                     FontSize="20"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{DynamicResource Loc.Notes.NoSelection.Subtitle}"
                     Classes="page-subtitle"
                     MaxWidth="420"
                     TextWrapping="Wrap"
                     TextAlignment="Center"/>
          <Button Content="{DynamicResource Loc.Notes.Button.CreateMarkdown}"
                  Classes="sk-primary"
                  Command="{Binding NewNoteCommand}"
                  HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="notesErrorBanner"
            IsVisible="{Binding HasError}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="16">
      <TextBlock Text="{Binding Error}"
                 Foreground="{StaticResource DangerBrush}"
                 FontSize="12"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"/>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.notesHeader">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style Selector="Button.notesModeButton">
      <Setter Property="Width" Value="42"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.notesModeButton:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.notesModeButton.active">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.notesTitlePickerButton">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.notesPickerPopup">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Width" Value="420"/>
      <Setter Property="MaxHeight" Value="520"/>
    </Style>

    <Style Selector="TextBox.notesPickerSearch">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="Border.notesPickerSectionHeader">
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style Selector="Button.notesPickerItem">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Button.notesPickerItem:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
    </Style>

    <Style Selector="Button.notesPickerItem.active">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="TextBlock.notesPickerCount">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.notesPickerBadge">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <Style Selector="Border.notesPickerBadge TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.notesKicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.6"/>
    </Style>

    <Style Selector="TextBlock.notesMutedText">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.notesSaveStatus">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.notesPane">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="TextBlock.notesPaneTitle">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style Selector="TextBox.notesTitleInput">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style Selector="TextBox.notesMarkdownEditor">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="LineHeight" Value="24"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <Style Selector="TextBlock.notesPreviewTitle">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style Selector="Border.notesPreviewPlaceholder">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="20,18"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style Selector="Border.notesPickerEmpty">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="Border.notesErrorBanner">
      <Setter Property="Background" Value="{StaticResource DangerPanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="MaxWidth" Value="420"/>
    </Style>

    <Style Selector="TextBlock.notesMarkdownH1">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style Selector="TextBlock.notesMarkdownH2">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style Selector="TextBlock.notesMarkdownH3">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style Selector="TextBlock.notesMarkdownParagraph">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="LineHeight" Value="24"/>
    </Style>

    <Style Selector="TextBlock.notesMarkdownListItem">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="LineHeight" Value="24"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="TextBlock.notesMarkdownCode">
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>
  </UserControl.Styles>
</UserControl>
