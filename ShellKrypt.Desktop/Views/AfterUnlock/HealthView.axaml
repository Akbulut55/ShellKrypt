<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.HealthView"
             x:CompileBindings="False"
             x:DataType="vm:HealthViewModel">
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,24,28,28"
                  MaxWidth="1500"
                  Spacing="24">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="18"
              VerticalAlignment="Bottom">
          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Loc.SecurityAudit.Title}"
                       FontSize="30"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding SummaryText}"
                       Classes="page-subtitle"/>
          </StackPanel>

          <Button Grid.Column="1"
                  Content="{DynamicResource Loc.SecurityAudit.Button.RunScan}"
                  Classes="audit-run-button"
                  Command="{Binding RefreshCommand}"/>
        </Grid>

        <Grid ColumnDefinitions="5*,7*"
              ColumnSpacing="22">
          <Border Classes="audit-score-card">
            <StackPanel Spacing="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <Border Width="184"
                      Height="184"
                      CornerRadius="92"
                      BorderBrush="{StaticResource AccentBrush}"
                      BorderThickness="6"
                      Background="{StaticResource SurfaceBrush}">
                <Grid>
                  <Border Width="158"
                          Height="158"
                          CornerRadius="79"
                          Background="{StaticResource SurfaceBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Spacing="6">
                    <TextBlock Text="{Binding HealthScoreDisplay}"
                               FontSize="46"
                               FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Loc.SecurityAudit.HealthScore}"
                               Classes="audit-kicker"
                               HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>

              <StackPanel Spacing="6"
                          HorizontalAlignment="Center">
                <TextBlock Text="{Binding HealthScoreTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding HealthScoreSubtitle}"
                           Classes="page-subtitle"
                           TextAlignment="Center"
                           MaxWidth="300"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Column="1"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="18"
                VerticalAlignment="Top">
            <Border Classes="audit-metric-card"
                    BorderThickness="0,0,0,4"
                    BorderBrush="{StaticResource DangerBrush}">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource DangerMutedBrush}">
                    <TextBlock Text="HI"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource DangerBrush}"
                               FontWeight="Black"
                               FontSize="11"/>
                  </Border>
                  <Border Grid.Column="1"
                          Background="{StaticResource DangerPanelBrush}"
                          CornerRadius="999"
                          Padding="10,4"
                          HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource Loc.SecurityAudit.Risk}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="10"
                               FontWeight="Black"/>
                  </Border>
                </Grid>
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding HighRiskCount}"
                             FontSize="34"
                             FontWeight="Black"/>
                  <TextBlock Text="{DynamicResource Loc.SecurityAudit.Metric.HighRisk}"
                             Classes="page-subtitle"
                             FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Classes="audit-metric-card"
                    BorderThickness="0,0,0,4"
                    BorderBrush="{StaticResource WarningBrush}">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource WarningMutedBrush}">
                    <TextBlock Text="PW"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource WarningBrush}"
                               FontWeight="Black"
                               FontSize="11"/>
                  </Border>
                  <Border Grid.Column="1"
                          Background="{StaticResource WarningMutedBrush}"
                          CornerRadius="999"
                          Padding="10,4"
                          HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource Loc.SecurityAudit.Local}"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="10"
                               FontWeight="Black"/>
                  </Border>
                </Grid>
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding PasswordFindingCount}"
                             FontSize="34"
                             FontWeight="Black"/>
                  <TextBlock Text="{DynamicResource Loc.SecurityAudit.Metric.PasswordFindings}"
                             Classes="page-subtitle"
                             FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Classes="audit-metric-card"
                    BorderThickness="0,0,0,4"
                    BorderBrush="{StaticResource BorderBrushStrong}">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource SurfaceElevatedBrush}">
                    <TextBlock Text="VA"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontWeight="Black"
                               FontSize="11"/>
                  </Border>
                  <Border Grid.Column="1"
                          Background="{StaticResource SurfaceElevatedBrush}"
                          CornerRadius="999"
                          Padding="10,4"
                          HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource Loc.SecurityAudit.Items}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"
                               FontWeight="Black"/>
                  </Border>
                </Grid>
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding OtherFindingCount}"
                             FontSize="34"
                             FontWeight="Black"/>
                  <TextBlock Text="{DynamicResource Loc.SecurityAudit.Metric.OtherFindings}"
                             Classes="page-subtitle"
                             FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <Grid ColumnDefinitions="8*,4*"
              ColumnSpacing="22">
          <Border Classes="audit-list-shell">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="24,20">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource Loc.SecurityAudit.ActiveFindings}"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="{DynamicResource Loc.SecurityAudit.ActiveFindings.Subtitle}"
                               Classes="page-subtitle"
                               FontSize="12"/>
                  </StackPanel>

                  <WrapPanel Grid.Column="1"
                             Orientation="Horizontal"
                             VerticalAlignment="Center">
                    <Button Content="{Binding AllFilterLabel}"
                            Classes="audit-filter-chip"
                            Classes.active="{Binding IsAllFilterActive}"
                            Command="{Binding ShowAllFindingsCommand}"/>
                    <Button Content="{Binding HighRiskFilterLabel}"
                            Classes="audit-filter-chip"
                            Classes.active="{Binding IsHighRiskFilterActive}"
                            Command="{Binding ShowHighRiskFindingsCommand}"/>
                    <Button Content="{Binding PasswordsFilterLabel}"
                            Classes="audit-filter-chip"
                            Classes.active="{Binding IsPasswordFilterActive}"
                            Command="{Binding ShowPasswordFindingsCommand}"/>
                    <Button Content="{Binding CardsFilterLabel}"
                            Classes="audit-filter-chip"
                            Classes.active="{Binding IsCardFilterActive}"
                            Command="{Binding ShowCardFindingsCommand}"/>
                    <Button Content="{Binding ApiKeysFilterLabel}"
                            Classes="audit-filter-chip"
                            Classes.active="{Binding IsApiKeyFilterActive}"
                            Command="{Binding ShowApiKeyFindingsCommand}"/>
                    <Button Content="{Binding SettingsFilterLabel}"
                            Classes="audit-filter-chip"
                            Classes.active="{Binding IsSettingsFilterActive}"
                            Command="{Binding ShowSettingsFindingsCommand}"/>
                  </WrapPanel>
                </Grid>
              </Border>

              <ScrollViewer Grid.Row="1"
                            MaxHeight="510"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleIssues}"
                              IsVisible="{Binding HasVisibleIssues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HealthIssueVm">
                      <Border Classes="audit-issue-row">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="18">
                          <Border Width="48"
                                  Height="48"
                                  CornerRadius="12"
                                  Background="{Binding CategoryBadgeBackground, Converter={StaticResource ThemeResourceBrushConverter}}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding IconGlyph}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding CategoryBadgeForeground, Converter={StaticResource ThemeResourceBrushConverter}}"
                                       FontWeight="Black"
                                       FontSize="11"/>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="7"
                                      VerticalAlignment="Center">
                            <WrapPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="14"
                                         FontWeight="Bold"
                                         TextWrapping="Wrap"
                                         Margin="0,0,8,0"/>
                              <Border Background="{Binding SeverityBadgeBackground, Converter={StaticResource ThemeResourceBrushConverter}}"
                                      CornerRadius="999"
                                      Padding="10,4"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding SeverityText}"
                                           Foreground="{Binding SeverityBadgeForeground, Converter={StaticResource ThemeResourceBrushConverter}}"
                                           FontSize="10"
                                           FontWeight="Black"/>
                              </Border>
                              <Border Background="{Binding CategoryBadgeBackground, Converter={StaticResource ThemeResourceBrushConverter}}"
                                      CornerRadius="999"
                                      Padding="10,4"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding CategoryText}"
                                           Foreground="{Binding CategoryBadgeForeground, Converter={StaticResource ThemeResourceBrushConverter}}"
                                           FontSize="10"
                                           FontWeight="Black"/>
                              </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding AffectedItem}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Details}"
                                       Classes="page-subtitle"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                          </StackPanel>

                          <Button Grid.Column="2"
                                  Content="{Binding ActionText}"
                                  Classes="audit-remediate-button"
                                  Command="{Binding DataContext.RemediateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  IsVisible="{Binding CanRunPrimaryAction}"
                                  VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Border Grid.Row="1"
                      Background="Transparent"
                      Padding="24,12,24,24"
                      IsVisible="{Binding !HasVisibleIssues}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding EmptyIssuesTitle}"
                             FontSize="18"
                             FontWeight="Bold"/>
                  <TextBlock Text="{Binding EmptyIssuesText}"
                             Classes="page-subtitle"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1"
                      Spacing="18">
            <Border Classes="audit-side-card">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <TextBlock Text="{DynamicResource Loc.SecurityAudit.SmartSuggestion}"
                             FontSize="15"
                             FontWeight="Bold"
                             Foreground="{StaticResource AccentBrush}"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="1"
                          Content="{DynamicResource Loc.Common.Dismiss}"
                          Classes="audit-ghost-button"
                          Command="{Binding DismissSuggestionCommand}"
                          IsEnabled="{Binding CanDismissSuggestion}"
                          VerticalAlignment="Top"/>
                </Grid>
                <TextBlock Text="{Binding SmartSuggestionTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SmartSuggestionText}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
                <Button Content="{Binding SmartSuggestionActionText}"
                        Classes="audit-side-button"
                        Command="{Binding RunSmartSuggestionCommand}"
                        IsEnabled="{Binding CanRunSmartSuggestion}"/>
              </StackPanel>
            </Border>

            <Border Classes="audit-side-card">
              <StackPanel Spacing="14">
                <TextBlock Text="{DynamicResource Loc.SecurityAudit.Checklist.Title}"
                           FontSize="15"
                           FontWeight="Bold"/>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <TextBlock Text="OK"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11"
                             FontWeight="Black"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Text="{DynamicResource Loc.SecurityAudit.Checklist.EncryptedVault}"
                             Classes="page-subtitle"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <TextBlock Text="OK"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11"
                             FontWeight="Black"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasAutoLock}"/>
                  <TextBlock Text="--"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11"
                             FontWeight="Black"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !HasAutoLock}"/>
                  <TextBlock Grid.Column="1"
                             Text="{DynamicResource Loc.SecurityAudit.Checklist.AutoLock}"
                             Classes="page-subtitle"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <TextBlock Text="OK"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11"
                             FontWeight="Black"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasClipboardTimeout}"/>
                  <TextBlock Text="--"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11"
                             FontWeight="Black"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !HasClipboardTimeout}"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding ChecklistClipboardText}"
                             Classes="page-subtitle"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <TextBlock Text="OK"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11"
                             FontWeight="Black"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasFocusLock}"/>
                  <TextBlock Text="--"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11"
                             FontWeight="Black"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !HasFocusLock}"/>
                  <TextBlock Grid.Column="1"
                             Text="{DynamicResource Loc.SecurityAudit.Checklist.FocusLock}"
                             Classes="page-subtitle"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Error}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasError}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.audit-run-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.audit-score-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="26"/>
      <Setter Property="MinHeight" Value="320"/>
    </Style>

    <Style Selector="TextBlock.audit-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.6"/>
    </Style>

    <Style Selector="Border.audit-metric-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20,18"/>
      <Setter Property="MinHeight" Value="168"/>
      <Setter Property="MaxHeight" Value="168"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style Selector="Border.audit-list-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <Style Selector="Button.audit-filter-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.audit-filter-chip.active">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.audit-issue-row">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="24,18"/>
    </Style>

    <Style Selector="Button.audit-remediate-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.audit-side-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <Style Selector="Button.audit-side-button">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.audit-ghost-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
</UserControl>
