<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.HealthView"
             x:CompileBindings="False"
             x:DataType="vm:HealthViewModel">
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,24,28,28"
                  MaxWidth="1500"
                  Spacing="24">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="18"
              VerticalAlignment="Bottom">
          <StackPanel Spacing="6">
            <TextBlock Text="Security Audit"
                       FontSize="30"
                       FontWeight="Bold"
                       LetterSpacing="-0.6"/>
            <TextBlock Text="{Binding SummaryText}"
                       Classes="page-subtitle"/>
          </StackPanel>

          <Button Grid.Column="1"
                  Content="Run New Scan"
                  Classes="audit-run-button"
                  Command="{Binding RefreshCommand}"/>
        </Grid>

        <Grid ColumnDefinitions="5*,7*"
              ColumnSpacing="22">
          <Border Classes="audit-score-card">
            <StackPanel Spacing="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <Border Width="184"
                      Height="184"
                      CornerRadius="92"
                      BorderBrush="{StaticResource AccentBrush}"
                      BorderThickness="6"
                      Background="{StaticResource SurfaceBrush}">
                <Grid>
                  <Border Width="158"
                          Height="158"
                          CornerRadius="79"
                          Background="{StaticResource SurfaceBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Spacing="6">
                    <TextBlock Text="{Binding HealthScoreDisplay}"
                               FontSize="46"
                               FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="HEALTH SCORE"
                               Classes="audit-kicker"
                               HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>

              <StackPanel Spacing="6"
                          HorizontalAlignment="Center">
                <TextBlock Text="{Binding HealthScoreTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding HealthScoreSubtitle}"
                           Classes="page-subtitle"
                           TextAlignment="Center"
                           MaxWidth="300"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Column="1"
                RowDefinitions="Auto,Auto"
                RowSpacing="18">
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="18">
              <Border Classes="audit-metric-card"
                      BorderThickness="0,0,0,4"
                      BorderBrush="{StaticResource DangerBrush}">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#3A2426">
                      <TextBlock Text="RP"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource DangerBrush}"
                                 FontWeight="Black"
                                 FontSize="11"/>
                    </Border>
                    <Border Grid.Column="1"
                            Background="#261e1112"
                            CornerRadius="999"
                            Padding="10,4"
                            HorizontalAlignment="Right">
                      <TextBlock Text="HIGH"
                                 Foreground="{StaticResource DangerBrush}"
                                 FontSize="10"
                                 FontWeight="Black"/>
                    </Border>
                  </Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ReusedCount}"
                               FontSize="34"
                               FontWeight="Black"/>
                    <TextBlock Text="Reused Passwords"
                               Classes="page-subtitle"
                               FontSize="12"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1"
                      Classes="audit-metric-card"
                      BorderThickness="0,0,0,4"
                      BorderBrush="{StaticResource WarningBrush}">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#3A3228">
                      <TextBlock Text="WP"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource WarningBrush}"
                                 FontWeight="Black"
                                 FontSize="11"/>
                    </Border>
                    <Border Grid.Column="1"
                            Background="#3A3228"
                            CornerRadius="999"
                            Padding="10,4"
                            HorizontalAlignment="Right">
                      <TextBlock Text="MED"
                                 Foreground="{StaticResource WarningBrush}"
                                 FontSize="10"
                                 FontWeight="Black"/>
                    </Border>
                  </Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding WeakCount}"
                               FontSize="34"
                               FontWeight="Black"/>
                    <TextBlock Text="Weak Passwords"
                               Classes="page-subtitle"
                               FontSize="12"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Classes="audit-metric-card"
                      BorderThickness="0,0,0,4"
                      BorderBrush="{StaticResource BorderBrushStrong}">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="{StaticResource SurfaceElevatedBrush}">
                      <TextBlock Text="OC"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontWeight="Black"
                                 FontSize="11"/>
                    </Border>
                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            CornerRadius="999"
                            Padding="10,4"
                            HorizontalAlignment="Right">
                      <TextBlock Text="LOW"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="10"
                                 FontWeight="Black"/>
                    </Border>
                  </Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding OldCount}"
                               FontSize="34"
                               FontWeight="Black"/>
                    <TextBlock Text="Old Credentials"
                               Classes="page-subtitle"
                               FontSize="12"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="1"
                    Classes="audit-context-card">
              <Grid ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="14">
                <Border Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="#223B36"
                        VerticalAlignment="Center">
                  <TextBlock Text="✓"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource SuccessBrush}"
                             FontWeight="Black"
                             FontSize="16"/>
                </Border>
                <StackPanel Grid.Column="1"
                            Spacing="4">
                  <TextBlock Text="Master Password Strength"
                             FontSize="14"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding MasterPasswordSummary}"
                             Classes="page-subtitle"
                             FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                  <Border Width="8" Height="8" CornerRadius="999" Background="{StaticResource AccentBrush}"/>
                  <Border Width="8" Height="8" CornerRadius="999" Background="{StaticResource AccentBrush}"/>
                  <Border Width="8" Height="8" CornerRadius="999" Background="{StaticResource AccentBrush}"/>
                  <Border Width="8" Height="8" CornerRadius="999" Background="{StaticResource AccentBrush}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Grid ColumnDefinitions="8*,4*"
              ColumnSpacing="22">
          <Border Classes="audit-list-shell">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="24,20">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Detailed Findings"
                               FontSize="20"
                               FontWeight="Bold"/>
                  <TextBlock Text="Address the highest-risk credentials first."
                             Classes="page-subtitle"
                             FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <Button Content="All Issues"
                          Classes="audit-filter-chip"/>
                  <Button Content="Breaches"
                          Classes="audit-filter-chip"/>
                </StackPanel>
                </Grid>
              </Border>

              <ScrollViewer Grid.Row="1"
                            MaxHeight="430"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Issues}"
                              IsVisible="{Binding HasIssues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HealthIssueVm">
                      <Border Classes="audit-issue-row">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="18">
                          <Border Width="48"
                                  Height="48"
                                  CornerRadius="12"
                                  Background="{Binding SeverityBadgeBackground}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding IconGlyph}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding SeverityBadgeForeground}"
                                       FontWeight="Black"
                                       FontSize="11"/>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="6"
                                      VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="14"
                                         FontWeight="Bold"
                                         TextWrapping="Wrap"/>
                              <Border Background="{Binding SeverityBadgeBackground}"
                                      CornerRadius="999"
                                      Padding="10,4"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding Severity}"
                                           Foreground="{Binding SeverityBadgeForeground}"
                                           FontSize="10"
                                           FontWeight="Black"/>
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Details}"
                                       Classes="page-subtitle"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                          </StackPanel>

                          <Button Grid.Column="2"
                                  Content="Remediate"
                                  Classes="audit-remediate-button"
                                  VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Border Grid.Row="1"
                      Background="Transparent"
                      Padding="24,12,24,24"
                      IsVisible="{Binding !HasIssues}">
                <StackPanel Spacing="8">
                  <TextBlock Text="No findings right now"
                             FontSize="18"
                             FontWeight="Bold"/>
                  <TextBlock Text="This vault does not currently have any weak, reused, or stale web login findings."
                             Classes="page-subtitle"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1"
                      Spacing="18">
            <Border Classes="audit-side-card">
              <StackPanel Spacing="14">
                <TextBlock Text="Smart Suggestion"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding SmartSuggestionTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SmartSuggestionText}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
                <Button Content="Generate Unique Batch"
                        Classes="audit-side-button"/>
                <Button Content="Dismiss"
                        Classes="audit-ghost-button"/>
              </StackPanel>
            </Border>

            <Border Classes="audit-side-card">
              <StackPanel Spacing="14">
                <TextBlock Text="Security Checklist"
                           FontSize="15"
                           FontWeight="Bold"/>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <TextBlock Text="●"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Text="Encrypted local vault"
                             Classes="page-subtitle"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <TextBlock Text="●"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasAutoLock}"/>
                  <TextBlock Text="○"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !HasAutoLock}"/>
                  <TextBlock Grid.Column="1"
                             Text="Auto-lock enabled"
                             Classes="page-subtitle"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <TextBlock Text="●"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasClipboardTimeout}"/>
                  <TextBlock Text="○"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !HasClipboardTimeout}"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding ChecklistClipboardText}"
                             Classes="page-subtitle"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                  <TextBlock Text="●"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasFocusLock}"/>
                  <TextBlock Text="○"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !HasFocusLock}"/>
                  <TextBlock Grid.Column="1"
                             Text="Lock on app deactivate"
                             Classes="page-subtitle"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="audit-lockdown-card">
              <StackPanel Spacing="10">
                <TextBlock Text="Instant Shield"
                           FontSize="14"
                           FontWeight="Black"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding AuditStatusText}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
                <Button Content="Activate Lockdown"
                        Classes="audit-lockdown-button"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Error}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasError}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.audit-run-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.audit-score-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="26"/>
      <Setter Property="MinHeight" Value="360"/>
    </Style>

    <Style Selector="TextBlock.audit-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.6"/>
    </Style>

    <Style Selector="Border.audit-metric-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20,18"/>
    </Style>

    <Style Selector="Border.audit-context-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20,18"/>
    </Style>

    <Style Selector="Border.audit-list-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <Style Selector="Button.audit-filter-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Border.audit-issue-row">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#183C4A46"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="24,18"/>
    </Style>

    <Style Selector="Button.audit-remediate-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="#223B36"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Border.audit-side-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <Style Selector="Button.audit-side-button">
      <Setter Property="Background" Value="#223B36"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Button.audit-ghost-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Border.audit-lockdown-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <Style Selector="Button.audit-lockdown-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
  </UserControl.Styles>
</UserControl>
