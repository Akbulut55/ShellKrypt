<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.AllItemsView"
             x:CompileBindings="False"
             x:DataType="vm:AllItemsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16"
                  MaxWidth="1500"
                  HorizontalAlignment="Stretch"
                  Spacing="14">

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="8">
          <Border Classes="allitems-stat-card">
            <Grid>
              <TextBlock Text="↻"
                         Classes="allitems-stat-watermark"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
              <Grid RowDefinitions="Auto,Auto,*"
                    RowSpacing="8">
                <TextBlock Text="{DynamicResource Loc.AllItems.TotalItems}"
                           Classes="allitems-kicker"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding TotalCount}"
                           FontSize="34"
                           FontWeight="Black"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding TotalItemsDeltaText}"
                           Classes="allitems-accent-note"
                           VerticalAlignment="Bottom"/>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="1"
                  Classes="allitems-stat-card">
            <Grid>
              <TextBlock Text="!"
                         Classes="allitems-stat-watermark"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
              <Grid RowDefinitions="Auto,Auto,*"
                    RowSpacing="8">
                <TextBlock Text="{DynamicResource Loc.AllItems.WeakPasswords.Title}"
                           Classes="allitems-kicker"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding WeakPasswordCount}"
                           FontSize="34"
                           FontWeight="Black"
                           Foreground="{StaticResource DangerBrush}"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding WeakPasswordSubtitle}"
                           Classes="allitems-muted-note"
                           VerticalAlignment="Bottom"/>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  Classes="allitems-stat-card">
            <Grid>
              <TextBlock Text="⇄"
                         Classes="allitems-stat-watermark"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
              <Grid RowDefinitions="Auto,Auto,*"
                    RowSpacing="8">
                <TextBlock Text="{DynamicResource Loc.AllItems.ExpiringSoon.Title}"
                           Classes="allitems-kicker"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding ExpiringSoonCardCount}"
                           FontSize="34"
                           FontWeight="Black"
                           Foreground="{StaticResource WarningBrush}"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding ExpiringSoonCardSubtitle}"
                           Classes="allitems-muted-note"
                           VerticalAlignment="Bottom"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <Border Classes="allitems-filter-shell">
          <WrapPanel Orientation="Horizontal"
                     VerticalAlignment="Center">
            <Border Classes="allitems-search-shell"
                    VerticalAlignment="Center">
              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">
                <TextBlock Text="⌕"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="allitems-top-search"
                         PlaceholderText="{DynamicResource Loc.AllItems.Search.Placeholder}"/>
              </Grid>
            </Border>

            <WrapPanel Orientation="Horizontal"
                       VerticalAlignment="Center">
              <Button Content="{Binding AllFilterLabel}"
                      Classes="allitems-chip"
                      VerticalAlignment="Center"
                      Classes.active="{Binding IsAllTypeActive}"
                      Command="{Binding ShowAllCommand}"/>
              <Button Content="{Binding WebFilterLabel}"
                      Classes="allitems-chip"
                      VerticalAlignment="Center"
                      Classes.active="{Binding IsWebTypeActive}"
                      Command="{Binding ShowWebTypesCommand}"/>
              <Button Content="{Binding CardFilterLabel}"
                      Classes="allitems-chip"
                      VerticalAlignment="Center"
                      Classes.active="{Binding IsCardTypeActive}"
                      Command="{Binding ShowCardTypesCommand}"/>
              <Button Content="{Binding AuthenticatorFilterLabel}"
                      Classes="allitems-chip"
                      VerticalAlignment="Center"
                      Classes.active="{Binding IsAuthenticatorTypeActive}"
                      Command="{Binding ShowAuthenticatorTypesCommand}"/>
              <Button Content="{Binding ApiKeyFilterLabel}"
                      Classes="allitems-chip"
                      VerticalAlignment="Center"
                      Classes.active="{Binding IsApiKeyTypeActive}"
                      Command="{Binding ShowApiKeyTypesCommand}"/>
              <Button Content="{Binding NoteFilterLabel}"
                      Classes="allitems-chip"
                      VerticalAlignment="Center"
                      Classes.active="{Binding IsNoteTypeActive}"
                      Command="{Binding ShowNoteTypesCommand}"/>
            </WrapPanel>
          </WrapPanel>
        </Border>

        <Border Classes="table-shell"
                MinWidth="580">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Classes="table-header-row">
              <Grid ColumnDefinitions="1.78*,0.72*,0.95*,0.75*,96"
                    ColumnSpacing="8">
                <TextBlock Text="{DynamicResource Loc.Common.Name.Header}"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource Loc.Common.Type.Header}"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="2"
                           Text="{DynamicResource Loc.AllItems.Identifier.Header}"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="3"
                           Text="{DynamicResource Loc.Common.LastModified.Header}"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="4"
                           Text=""
                           Classes="table-header-text"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Rows}"
                            Classes="allitems-list"
                            IsVisible="{Binding HasRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AllItemEntry">
                    <Border Classes="table-row">
                      <Grid ColumnDefinitions="1.78*,0.72*,0.95*,0.75*,96"
                            ColumnSpacing="8"
                            Margin="12,0"
                            MinHeight="78">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              VerticalAlignment="Center">
                          <Border Width="38"
                                  Height="38"
                                  CornerRadius="10"
                                  Background="{Binding IconBackground, Converter={StaticResource ThemeResourceBrushConverter}}">
                            <TextBlock Text="{Binding IconGlyph}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding IconForeground, Converter={StaticResource ThemeResourceBrushConverter}}"
                                       FontWeight="Black"
                                       FontSize="11"/>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="3"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NameSubtitleDisplay}"
                                       Classes="allitems-cell-subtitle"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>

                        <Border Grid.Column="1"
                                Background="{Binding TypeBadgeBackground, Converter={StaticResource ThemeResourceBrushConverter}}"
                                CornerRadius="999"
                                Padding="10,5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayTypeLabel}"
                                     Foreground="{Binding TypeBadgeForeground, Converter={StaticResource ThemeResourceBrushConverter}}"
                                     FontSize="10"
                                     FontWeight="Black"/>
                        </Border>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding IdentifierDisplay}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding UpdatedDisplay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                          <Button Content="{DynamicResource Loc.Common.View}"
                                  Classes="table-action-button"
                                  Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Padding="30,30"
                      Background="Transparent"
                      IsVisible="{Binding !HasRows}">
                <StackPanel Classes="table-empty">
                  <TextBlock Text="{Binding EmptyStateTitle}"
                             Classes="table-empty-title"/>
                  <TextBlock Text="{Binding EmptyStateSubtitle}"
                             Classes="table-empty-subtitle"/>
                  <Grid ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="10"
                        HorizontalAlignment="Center">
                    <Button Classes="allitems-add-button"
                            Command="{Binding AddItemCommand}">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding AddItemButtonText}"
                                   Foreground="{StaticResource AccentForegroundBrush}"
                                   FontWeight="SemiBold"/>
                        <Path Classes="material-icon on-primary"
                              Width="15"
                              Height="15"
                              Data="{StaticResource IconAdd}"/>
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Loc.Common.ResetFilters}"
                            Classes="allitems-filter-button"
                            Command="{Binding ResetFiltersCommand}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="2"
                    Classes="table-footer-row">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                    ColumnSpacing="10">
                <StackPanel Spacing="4"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding FooterSummary}"
                             Classes="table-footer-text"/>
                  <TextBlock Text="{Binding Error}"
                             Foreground="{StaticResource DangerBrush}"
                             FontSize="12"
                             IsVisible="{Binding HasError}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Previous}"
                        Classes="table-page-button"
                        Command="{Binding GoPreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding PageSummary}"
                           Classes="table-footer-text"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="3"
                        Content="{DynamicResource Loc.Common.Next}"
                        Classes="table-page-button"
                        Command="{Binding GoNextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.allitems-search-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="MinWidth" Value="220"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
    </Style>

    <Style Selector="TextBox.allitems-top-search">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,11"/>
      <Setter Property="MinHeight" Value="42"/>
    </Style>

    <Style Selector="Button.allitems-top-link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,0,0,8"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.allitems-top-link.active">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style Selector="Button.allitems-icon-button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.allitems-add-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="MinWidth" Value="128"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.allitems-stat-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="TextBlock.allitems-stat-watermark">
      <Setter Property="Foreground" Value="{StaticResource WatermarkBrush}"/>
      <Setter Property="FontSize" Value="96"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Margin" Value="0,0,-12,-20"/>
    </Style>

    <Style Selector="TextBlock.allitems-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.4"/>
    </Style>

    <Style Selector="TextBlock.allitems-accent-note">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.allitems-muted-note">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="Border.allitems-filter-shell">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="10"/>
    </Style>

    <Style Selector="Button.allitems-filter-button">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="MinWidth" Value="118"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.allitems-chip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,6,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.allitems-chip.active">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="ItemsControl.allitems-list">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TextBlock.allitems-cell-subtitle">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

  </UserControl.Styles>
</UserControl>
