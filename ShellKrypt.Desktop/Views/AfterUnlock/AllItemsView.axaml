<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.AllItemsView"
             x:CompileBindings="False"
             x:DataType="vm:AllItemsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,24,28,28"
                  MaxWidth="1500"
                  HorizontalAlignment="Stretch"
                  Spacing="24">

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="18">
          <Border Classes="allitems-stat-card">
            <Grid>
              <TextBlock Text="↻"
                         Classes="allitems-stat-watermark"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
              <Grid RowDefinitions="Auto,Auto,*"
                    RowSpacing="8">
                <TextBlock Text="TOTAL ITEMS"
                           Classes="allitems-kicker"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding TotalCount}"
                           FontSize="34"
                           FontWeight="Black"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding TotalItemsDeltaText}"
                           Classes="allitems-accent-note"
                           VerticalAlignment="Bottom"/>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="1"
                  Classes="allitems-stat-card">
            <Grid>
              <TextBlock Text="!"
                         Classes="allitems-stat-watermark"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
              <Grid RowDefinitions="Auto,Auto,*"
                    RowSpacing="8">
                <TextBlock Text="WEAK PASSWORDS"
                           Classes="allitems-kicker"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding WeakPasswordCount}"
                           FontSize="34"
                           FontWeight="Black"
                           Foreground="{StaticResource DangerBrush}"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding WeakPasswordSubtitle}"
                           Classes="allitems-muted-note"
                           VerticalAlignment="Bottom"/>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  Classes="allitems-stat-card">
            <Grid>
              <TextBlock Text="⇄"
                         Classes="allitems-stat-watermark"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
              <Grid RowDefinitions="Auto,Auto,*"
                    RowSpacing="8">
                <TextBlock Text="EXPIRING SOON"
                           Classes="allitems-kicker"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding ExpiringSoonCardCount}"
                           FontSize="34"
                           FontWeight="Black"
                           Foreground="{StaticResource WarningBrush}"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding ExpiringSoonCardSubtitle}"
                           Classes="allitems-muted-note"
                           VerticalAlignment="Bottom"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <Border Classes="allitems-filter-shell">
          <Grid ColumnDefinitions="320,*"
                ColumnSpacing="10"
                VerticalAlignment="Center">
            <Border Classes="allitems-search-shell">
              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">
                <TextBlock Text="⌕"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="allitems-top-search"
                         PlaceholderText="Search all items..."/>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
              <Button Content="{Binding TotalCount, StringFormat=All ({0})}"
                      Classes="allitems-chip"
                      Classes.active="{Binding IsAllTypeActive}"
                      Command="{Binding ShowAllCommand}"/>
              <Button Content="{Binding WebCount, StringFormat=Logins ({0})}"
                      Classes="allitems-chip"
                      Classes.active="{Binding IsWebTypeActive}"
                      Command="{Binding ShowWebTypesCommand}"/>
              <Button Content="{Binding CardCount, StringFormat=Cards ({0})}"
                      Classes="allitems-chip"
                      Classes.active="{Binding IsCardTypeActive}"
                      Command="{Binding ShowCardTypesCommand}"/>
              <Button Content="{Binding NoteCount, StringFormat=Markdown Notes ({0})}"
                      Classes="allitems-chip"
                      Classes.active="{Binding IsNoteTypeActive}"
                      Command="{Binding ShowNoteTypesCommand}"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="allitems-table-shell">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    Padding="22,14">
              <Grid ColumnDefinitions="2.3*,1.1*,1.4*,1.1*,170"
                    ColumnSpacing="18">
                <TextBlock Text="NAME"
                           Classes="allitems-table-header"/>
                <TextBlock Grid.Column="1"
                           Text="TYPE"
                           Classes="allitems-table-header"/>
                <TextBlock Grid.Column="2"
                           Text="USERNAME / ID"
                           Classes="allitems-table-header"/>
                <TextBlock Grid.Column="3"
                           Text="LAST MODIFIED"
                           Classes="allitems-table-header"/>
                <TextBlock Grid.Column="4"
                           Text=""
                           Classes="allitems-table-header"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Rows}"
                            Classes="allitems-list"
                            IsVisible="{Binding HasRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AllItemEntry">
                    <Border Classes="allitems-row">
                      <Grid ColumnDefinitions="2.3*,1.1*,1.4*,1.1*,170"
                            ColumnSpacing="18"
                            Margin="22,0"
                            MinHeight="78">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              VerticalAlignment="Center">
                          <Border Width="38"
                                  Height="38"
                                  CornerRadius="10"
                                  Background="{StaticResource SurfaceElevatedBrush}">
                            <TextBlock Text="{Binding IconGlyph}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding IconForeground}"
                                       FontWeight="Black"
                                       FontSize="11"/>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="3"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NameSubtitleDisplay}"
                                       Classes="allitems-cell-subtitle"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>

                        <Border Grid.Column="1"
                                Background="{Binding TypeBadgeBackground}"
                                CornerRadius="999"
                                Padding="10,5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayTypeLabel}"
                                     Foreground="{Binding TypeBadgeForeground}"
                                     FontSize="10"
                                     FontWeight="Black"/>
                        </Border>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding IdentifierDisplay}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding UpdatedDisplay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                          <Button Content="View"
                                  Classes="allitems-inline-button"
                                  Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Padding="30,30"
                      Background="Transparent"
                      IsVisible="{Binding !HasRows}">
                <StackPanel Spacing="12"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding EmptyStateTitle}"
                             FontSize="18"
                             FontWeight="Bold"/>
                  <TextBlock Text="{Binding EmptyStateSubtitle}"
                             Classes="page-subtitle"
                             MaxWidth="520"
                             TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal"
                              Spacing="10">
                    <Button Content="{Binding AddItemButtonText}"
                            Classes="allitems-add-button"
                            Command="{Binding AddItemCommand}"/>
                    <Button Content="Reset filters"
                            Classes="allitems-filter-button"
                            Command="{Binding ResetFiltersCommand}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="22,18">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding FooterSummary}"
                             Classes="allitems-footer-text"/>
                  <TextBlock Text="{Binding Error}"
                             Foreground="{StaticResource DangerBrush}"
                             FontSize="12"
                             IsVisible="{Binding HasError}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <Button Content="Previous"
                          Classes="allitems-page-button"
                          Command="{Binding GoPreviousPageCommand}"
                          IsEnabled="{Binding CanGoPrevious}"/>
                  <ItemsControl ItemsSource="{Binding PageChips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PageChipVm">
                        <Button Content="{Binding Label}"
                                Classes="allitems-page-button"
                                Classes.active="{Binding IsCurrent}"
                                Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Next"
                          Classes="allitems-page-button"
                          Command="{Binding GoNextPageCommand}"
                          IsEnabled="{Binding CanGoNext}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.allitems-search-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="MinWidth" Value="320"/>
    </Style>

    <Style Selector="TextBox.allitems-top-search">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,11"/>
      <Setter Property="MinHeight" Value="42"/>
    </Style>

    <Style Selector="Button.allitems-top-link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,0,0,8"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.allitems-top-link.active">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style Selector="Button.allitems-icon-button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.allitems-add-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.allitems-stat-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="24,20"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="TextBlock.allitems-stat-watermark">
      <Setter Property="Foreground" Value="#0fffffff"/>
      <Setter Property="FontSize" Value="96"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Margin" Value="0,0,-12,-20"/>
    </Style>

    <Style Selector="TextBlock.allitems-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.4"/>
    </Style>

    <Style Selector="TextBlock.allitems-accent-note">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.allitems-muted-note">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="Border.allitems-filter-shell">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style Selector="Button.allitems-filter-button">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="Button.allitems-chip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.allitems-chip.active">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Border.allitems-table-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="TextBlock.allitems-table-header">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="ItemsControl.allitems-list">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Border.allitems-row">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#183C4A46"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="Border.allitems-row:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="TextBlock.allitems-cell-subtitle">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Button.allitems-inline-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.allitems-footer-text">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.allitems-page-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.allitems-page-button.active">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
    </Style>
  </UserControl.Styles>
</UserControl>
