<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.AllItemsView"
             x:CompileBindings="False"
             x:DataType="vm:AllItemsViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="All Items" Classes="page-title"/>
          <TextBlock Text="Monitor every encrypted record inside the active vault."
                     Classes="page-subtitle"/>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
        <Border Classes="metric-card" Padding="18">
          <StackPanel Spacing="8">
            <TextBlock Text="TOTAL ITEMS" Classes="caption"/>
            <TextBlock Text="{Binding TotalCount}" Classes="metric-value"/>
            <TextBlock Text="Encrypted records in the active vault."
                       Classes="page-subtitle"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="metric-card" Padding="18">
          <StackPanel Spacing="8">
            <TextBlock Text="WEAK PASSWORDS" Classes="caption"/>
            <TextBlock Text="{Binding WeakPasswordCount}" Classes="metric-value"/>
            <TextBlock Text="Logins that should be rotated soon."
                       Classes="page-subtitle"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="metric-card" Padding="18">
          <StackPanel Spacing="8">
            <TextBlock Text="REUSED PASSWORDS" Classes="caption"/>
            <TextBlock Text="{Binding ReusedPasswordCount}" Classes="metric-value"/>
            <TextBlock Text="Entries sharing a password with another login."
                       Classes="page-subtitle"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="panel-raised" Padding="16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
            <Button Classes="subtle inline" Content="Filter"/>
            <Button Grid.Column="1" Classes="subtle inline" Content="Sort"/>

            <WrapPanel Grid.Column="3"
                       HorizontalAlignment="Right"
                       ItemSpacing="8"
                       LineSpacing="8">
              <Border Classes="badge" Padding="10,6">
                <TextBlock Text="{Binding WebCount, StringFormat={}{0} Logins}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SuccessBrush}"/>
              </Border>
              <Border Classes="badge" Padding="10,6">
                <TextBlock Text="{Binding CardCount, StringFormat={}{0} Cards}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource WarningBrush}"/>
              </Border>
              <Border Classes="badge" Padding="10,6">
                <TextBlock Text="{Binding NoteCount, StringFormat={}{0} Secure Notes}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </Border>
            </WrapPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Background="{StaticResource SurfaceRaisedBrush}"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  BorderThickness="0,0,0,1"
                  Padding="18,14">
            <Grid ColumnDefinitions="2.1*,1.05*,1.2*,1.1*,Auto" ColumnSpacing="12">
              <TextBlock Text="Name" Classes="caption"/>
              <TextBlock Grid.Column="1" Text="Type" Classes="caption"/>
              <TextBlock Grid.Column="2" Text="Username / ID" Classes="caption"/>
              <TextBlock Grid.Column="3" Text="Last Modified" Classes="caption"/>
              <TextBlock Grid.Column="4" Text="" Classes="caption"/>
            </Grid>
          </Border>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Rows}"
                   SelectedItem="{Binding SelectedRow}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AllItemEntry">
                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        Padding="16,14">
                  <Grid ColumnDefinitions="2.1*,1.05*,1.2*,1.1*,Auto" ColumnSpacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Width="32"
                              Height="32"
                              CornerRadius="8"
                              Background="{StaticResource AppBackgroundSoftBrush}">
                        <TextBlock Text="{Binding IconLetter}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Title}"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <Border Classes="badge" Padding="8,3" IsVisible="{Binding Favorite}">
                            <TextBlock Text="Favorite"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Snippet}"
                                   Classes="caption"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>

                    <Border Grid.Column="1"
                            Classes="badge"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                      <TextBlock Text="{Binding DisplayTypeLabel}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource SuccessBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SecondaryText}"
                                 FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding LabelsDisplay}"
                                 Classes="caption"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding UpdatedDisplay}" FontWeight="Medium"/>
                      <TextBlock Text="{Binding CreatedDisplay}" Classes="caption"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Classes="row-actions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="4"
                                VerticalAlignment="Center">
                      <Button Classes="icon subtle"
                              Content="⧉"
                              ToolTip.Tip="Copy"/>
                      <Button Classes="icon subtle"
                              Content="⋮"
                              ToolTip.Tip="More"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Showing" Classes="page-subtitle"/>
          <TextBlock Text="{Binding FilteredCount}" Classes="page-subtitle"/>
          <TextBlock Text="of" Classes="page-subtitle"/>
          <TextBlock Text="{Binding TotalCount}" Classes="page-subtitle"/>
          <TextBlock Text="items" Classes="page-subtitle"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="subtle inline" Content="Previous" IsEnabled="False"/>
          <Button Classes="primary inline" Content="1"/>
          <Button Classes="subtle inline" Content="2"/>
          <Button Classes="subtle inline" Content="3"/>
          <Button Classes="subtle inline" Content="Next" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="StackPanel.row-actions">
      <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem:pointerover StackPanel.row-actions">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>
</UserControl>
