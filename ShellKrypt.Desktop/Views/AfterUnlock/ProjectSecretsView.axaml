<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.ProjectSecretsView"
             x:Name="Root"
             x:CompileBindings="False"
             x:DataType="vm:ProjectSecretsViewModel">
  <UserControl.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="18"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*"
        Background="{StaticResource AppBackgroundSoftBrush}"
        MinHeight="680">
    <Grid RowDefinitions="Auto,*"
          Background="{StaticResource AppBackgroundSoftBrush}">
      <Border BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="0"
              Padding="24,18,24,8">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
          <StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
	              <TextBlock Text="{Binding ProjectName}"
	                         Foreground="{StaticResource TextPrimaryBrush}"
	                         FontSize="25"
	                         FontWeight="Bold"
	                         IsVisible="{Binding IsProjectReadOnly}"
	                         VerticalAlignment="Center"/>
	              <TextBox Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
	                       FontSize="25"
	                       FontWeight="Bold"
	                       MinWidth="260"
	                       IsVisible="{Binding IsProjectEditing}"
	                       Background="{StaticResource InputBackgroundBrush}"
	                       BorderBrush="{StaticResource BorderBrushSoft}"
	                       VerticalAlignment="Center"/>
              <Button Content="⌄"
                      Width="34"
                      Height="30"
                      Padding="0"
                      VerticalAlignment="Center"
                      Background="{StaticResource SurfaceRaisedBrush}"
                      BorderBrush="{StaticResource BorderBrushSoft}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <Border Width="390"
                            MaxHeight="520"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14">
                      <Grid RowDefinitions="Auto,Auto,Auto,*"
                            RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                          <StackPanel>
                            <TextBlock Text="Select project"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} projects'}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="12"/>
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Content="+ Add"
                                  Command="{Binding AddProjectCommand}"
                                  Background="{StaticResource AccentBrush}"
                                  Foreground="{StaticResource AccentForegroundBrush}"
                                  FontWeight="Bold"/>
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Search projects..."
                                 Background="{StaticResource InputBackgroundBrush}"
                                 BorderBrush="{StaticResource BorderBrushSoft}"/>

                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="0,0,0,1"
                                Margin="0,0,0,2"
                                MinHeight="28">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="WORKSPACES"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TotalVariableCount, StringFormat='{}{0} vars'}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                          </Grid>
                        </Border>

                        <ListBox Grid.Row="3"
                                 ItemsSource="{Binding Rows}"
                                 SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="360">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectSecretRowVm">
                              <Border Background="{StaticResource InputBackgroundBrush}"
                                      BorderBrush="{StaticResource BorderBrushSoft}"
                                      BorderThickness="1"
                                      CornerRadius="5"
                                      Padding="10"
                                      Margin="0,0,0,8">
                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="5">
                                  <TextBlock Text="{Binding Name}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="14"
                                             FontWeight="Bold"
                                             TextTrimming="CharacterEllipsis"/>
                                  <Border Grid.Column="1"
                                          BorderBrush="{StaticResource AccentBrush}"
                                          BorderThickness="1"
                                          Padding="7,2"
                                          CornerRadius="2">
                                    <TextBlock Text="{Binding EnvironmentCount, StringFormat='{}{0} envs'}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                  </Border>
                                  <StackPanel Grid.Row="1"
                                              Grid.ColumnSpan="2"
                                              Spacing="3">
                                    <TextBlock Text="{Binding RootDisplay}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock Text="{Binding VariableCount, StringFormat='{}{0} variables'}"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="12"/>
                                      <TextBlock Grid.Column="1"
                                                 Text="{Binding WarningSummary}"
                                                 Foreground="{StaticResource WarningBrush}"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="11"/>
                                    </Grid>
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Border BorderBrush="{StaticResource WarningBrush}"
                      BorderThickness="1"
                      Padding="8,3"
                      CornerRadius="2"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalWarningCount, StringFormat='{}{0} warnings'}"
                           Foreground="{StaticResource WarningBrush}"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="11"
                           FontWeight="Bold"/>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
	              <TextBlock Text="Project root"
	                         Foreground="{StaticResource TextMutedBrush}"
	                         FontFamily="{StaticResource MonoFontFamily}"
	                         FontSize="12"/>
              <TextBlock Text="{Binding ProjectRootDisplay}"
                         Foreground="{StaticResource TextMutedBrush}"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock Text="{Binding ProjectDescription}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="13"
                       IsVisible="{Binding HasProjectDescription}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Top">
            <Button Content="Import .env"
                    Command="{Binding PickImportFileCommand}"
                    IsVisible="{Binding IsProjectReadOnly}"/>
            <Button Content="Export"
                    Command="{Binding ExportEnvCommand}"
                    IsVisible="{Binding IsProjectReadOnly}"/>
            <Button Content="Edit"
                    Command="{Binding EditProjectCommand}"
                    IsVisible="{Binding IsProjectReadOnly}"/>
            <Button Content="Cancel"
                    Command="{Binding CancelProjectEditCommand}"
                    IsVisible="{Binding IsProjectEditing}"/>
            <Button Content="Save"
                    Command="{Binding SaveProjectCommand}"
                    IsVisible="{Binding IsProjectEditing}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="{StaticResource AccentForegroundBrush}"
                    FontWeight="Bold"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,0,24,24"
                    Spacing="16">
          <TextBlock Text="{Binding Error}"
                     Foreground="{StaticResource DangerBrush}"
                     IsVisible="{Binding HasError}"/>

          <Grid>
            <Border Height="1"
                    Background="{StaticResource BorderBrushSoft}"
                    VerticalAlignment="Top"
                    Margin="0,43,0,0"/>
            <TabControl>
            <TabItem Header="Variables">
              <StackPanel Spacing="14"
                          Margin="0,14,0,0">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8"
                          Margin="14">
                      <ItemsControl ItemsSource="{Binding EnvironmentOptions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProjectSecretEnvironmentOption">
                            <Button Command="{Binding DataContext.SelectEnvironmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,8,0"
                                    Padding="12,6"
                                    Background="{StaticResource SurfaceRaisedBrush}">
                              <TextBlock Text="{Binding Name}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontFamily="{StaticResource MonoFontFamily}"
                                         FontSize="12"/>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Button Grid.Column="1"
                              Content="+ Environment"
                              Command="{Binding AddEnvironmentCommand}"
                              IsVisible="{Binding IsProjectEditing}"/>
                      <Button Grid.Column="2"
                              Content="Delete Env"
                              Command="{Binding DeleteEnvironmentCommand}"
                              IsVisible="{Binding IsProjectEditing}"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,180"
                          ColumnSpacing="8"
                          Margin="14,0,14,14">
	                      <TextBox Text="{Binding NewEnvironmentName, Mode=TwoWay}"
	                               PlaceholderText="New environment name"
	                               IsReadOnly="{Binding IsProjectReadOnly}"
	                               IsVisible="{Binding IsProjectEditing}"
	                               Background="{StaticResource InputBackgroundBrush}"
	                               BorderBrush="{StaticResource BorderBrushSoft}"/>
	                      <ComboBox Grid.Column="1"
	                                ItemsSource="{Binding EnvironmentKindOptions}"
	                                SelectedItem="{Binding NewEnvironmentKind, Mode=TwoWay}"
	                                IsVisible="{Binding IsProjectEditing}"
	                                Background="{StaticResource InputBackgroundBrush}"/>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,1,0,1"
                            MinHeight="42">
	                      <Grid ColumnDefinitions="34,1.2*,1.8*,1.2*,250"
	                            ColumnSpacing="10">
                        <TextBlock Grid.Column="1"
                                   Text="KEY"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="VALUE"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
	                        <TextBlock Grid.Column="3"
	                                   Text="NOTES"
	                                   Foreground="{StaticResource TextMutedBrush}"
	                                   FontFamily="{StaticResource MonoFontFamily}"
	                                   FontSize="11"
	                                   FontWeight="Bold"
	                                   VerticalAlignment="Center"/>
	                        <TextBlock Grid.Column="4"
	                                   Text="ACTIONS"
	                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>
                      </Grid>
                    </Border>

                    <StackPanel Grid.Row="3">
                      <ItemsControl ItemsSource="{Binding Variables}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProjectSecretVariableRowVm">
	                            <Border Background="{StaticResource InputBackgroundBrush}"
	                                    BorderBrush="{StaticResource BorderBrushSoft}"
	                                    BorderThickness="0,0,0,1"
	                                    MinHeight="50"
                                      DragDrop.AllowDrop="True"
                                      DragDrop.DragOver="OnVariableRowDragOver"
                                      DragDrop.Drop="OnVariableRowDrop">
	                              <Grid ColumnDefinitions="22,1.2*,1.8*,1.2*,250"
	                                    ColumnSpacing="10"
	                                    Margin="4,0,12,0">
                                <Border Width="28"
                                        Height="34"
                                        Background="Transparent"
                                        VerticalAlignment="Center"
                                        PointerPressed="OnVariableDragHandlePointerPressed"
                                        IsVisible="{Binding DataContext.IsProjectEditing, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                  <PathIcon Data="{StaticResource IconDragIndicator}"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
	                                <TextBlock Grid.Column="1"
	                                           Text="{Binding Key}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="13"
	                                           FontWeight="Bold"
	                                           VerticalAlignment="Center"
	                                           IsVisible="{Binding !IsEditing}"
	                                           TextTrimming="CharacterEllipsis"/>
	                                <TextBox Grid.Column="1"
	                                         Text="{Binding EditKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
	                                         IsVisible="{Binding IsEditing}"
	                                         FontFamily="{StaticResource MonoFontFamily}"
	                                         Background="{StaticResource InputBackgroundBrush}"
	                                         BorderBrush="{StaticResource BorderBrushSoft}"/>
	                                <TextBlock Grid.Column="2"
	                                           Text="{Binding ValueDisplay}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}"
	                                           FontSize="13"
	                                           VerticalAlignment="Center"
	                                           IsVisible="{Binding !IsEditing}"
	                                           TextTrimming="CharacterEllipsis"/>
		                                <Border Grid.Column="2"
		                                        IsVisible="{Binding IsEditing}"
		                                        Background="{StaticResource InputBackgroundBrush}"
		                                        BorderBrush="{StaticResource BorderBrushSoft}"
		                                        BorderThickness="1"
		                                        CornerRadius="4">
		                                  <Grid ColumnDefinitions="*,Auto"
		                                        ColumnSpacing="8">
		                                    <TextBox Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
		                                             IsVisible="{Binding UseMaskedEditValueInput}"
		                                             IsReadOnly="{Binding IsLinked}"
		                                             PasswordChar="*"
		                                             FontFamily="{StaticResource MonoFontFamily}"
		                                             Background="Transparent"
		                                             BorderBrush="Transparent"/>
		                                    <TextBox Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
		                                             IsVisible="{Binding UsePlainEditValueInput}"
		                                             IsReadOnly="{Binding IsLinked}"
		                                             FontFamily="{StaticResource MonoFontFamily}"
		                                             Background="Transparent"
		                                             BorderBrush="Transparent"/>
		                                    <Button Grid.Column="1"
		                                            Width="34"
		                                            Padding="0"
		                                            Command="{Binding DataContext.RevealVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
		                                            CommandParameter="{Binding}"
		                                            IsVisible="{Binding CanRevealEditValue}">
		                                      <Grid>
		                                        <PathIcon Data="{StaticResource IconVisibility}"
		                                                  Width="16"
		                                                  Height="16"
		                                                  Foreground="{StaticResource TextMutedBrush}"
		                                                  IsVisible="{Binding !IsValueRevealed}"/>
		                                        <PathIcon Data="{StaticResource IconVisibilityOff}"
		                                                  Width="16"
		                                                  Height="16"
		                                                  Foreground="{StaticResource TextMutedBrush}"
		                                                  IsVisible="{Binding IsValueRevealed}"/>
		                                      </Grid>
		                                    </Button>
		                                  </Grid>
		                                </Border>
	                                <StackPanel Grid.Column="3"
	                                            Spacing="2"
	                                            VerticalAlignment="Center"
	                                            IsVisible="{Binding !IsEditing}">
	                                  <TextBlock Text="{Binding NotesDisplay}"
	                                             Foreground="{StaticResource TextMutedBrush}"
                                             FontSize="12"
                                             TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Text="{Binding LinkDisplay}"
                                             Foreground="{StaticResource WarningBrush}"
                                             FontFamily="{StaticResource MonoFontFamily}"
                                             FontSize="11"
	                                             TextTrimming="CharacterEllipsis"/>
	                                </StackPanel>
	                                <TextBox Grid.Column="3"
	                                         Text="{Binding EditNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
	                                         IsVisible="{Binding IsEditing}"
	                                         Background="{StaticResource InputBackgroundBrush}"
	                                         BorderBrush="{StaticResource BorderBrushSoft}"/>
	                                <StackPanel Grid.Column="4"
	                                            Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
	                                  <Button Content="Edit"
	                                          Command="{Binding DataContext.SelectVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
	                                          CommandParameter="{Binding}"
	                                          IsVisible="{Binding !IsEditing}"
	                                          IsEnabled="{Binding DataContext.IsProjectEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
	                                  <Button Content="Save"
	                                          Command="{Binding DataContext.SaveVariableEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
	                                          CommandParameter="{Binding}"
	                                          IsVisible="{Binding IsEditing}"
	                                          Foreground="{StaticResource AccentBrush}"/>
	                                  <Button Content="Cancel"
	                                          Command="{Binding DataContext.CancelVariableEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
	                                          CommandParameter="{Binding}"
	                                          IsVisible="{Binding IsEditing}"/>
	                                  <Button Content="Delete"
	                                          Command="{Binding DataContext.DeleteVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
	                                          CommandParameter="{Binding}"
	                                          IsVisible="{Binding DataContext.IsProjectEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"
	                                          Foreground="{StaticResource DangerBrush}"/>
	                                  <Button Content="Copy"
                                          Command="{Binding DataContext.CopyVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border Background="{StaticResource SurfaceRaisedBrush}"
                              Padding="12"
                              IsVisible="{Binding IsProjectEditing}">
	                        <Grid RowDefinitions="Auto,Auto"
	                              RowSpacing="10">
		                          <Grid ColumnDefinitions="1.05*,1.4*,*,Auto,Auto,Auto"
		                                ColumnSpacing="10">
	                          <TextBox Text="{Binding VariableKey, Mode=TwoWay}"
	                                   PlaceholderText="NEW_KEY"
	                                   IsReadOnly="{Binding IsProjectReadOnly}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Background="{StaticResource InputBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushSoft}"/>
	                          <TextBox Grid.Column="1"
	                                   Text="{Binding VariableValue, Mode=TwoWay}"
	                                   PlaceholderText="Value..."
	                                   IsReadOnly="{Binding IsVariableValueReadOnly}"
	                                   FontFamily="{StaticResource MonoFontFamily}"
	                                   Background="{StaticResource InputBackgroundBrush}"
	                                   BorderBrush="{StaticResource BorderBrushSoft}"/>
	                          <TextBox Grid.Column="2"
	                                   Text="{Binding VariableNotes, Mode=TwoWay}"
	                                   PlaceholderText="Notes"
	                                   IsReadOnly="{Binding IsProjectReadOnly}"
	                                   Background="{StaticResource InputBackgroundBrush}"
	                                   BorderBrush="{StaticResource BorderBrushSoft}"/>
	                          <CheckBox Grid.Column="3"
	                                    Content="Secret"
	                                    IsChecked="{Binding VariableIsSecret, Mode=TwoWay}"
	                                    IsEnabled="{Binding IsProjectEditing}"
	                                    VerticalAlignment="Center"/>
		                          <Button Grid.Column="4"
		                                  Content="{Binding VariableSubmitLabel}"
		                                  Command="{Binding AddOrUpdateVariableCommand}"
		                                  IsEnabled="{Binding IsProjectEditing}"
		                                  Foreground="{StaticResource AccentBrush}"/>
		                          <Button Grid.Column="5"
		                                  Content="Reference API Key"
		                                  IsEnabled="{Binding IsProjectEditing}"
		                                  IsVisible="{Binding IsManualVariableSource}">
		                            <Button.Flyout>
		                              <Flyout Placement="BottomEdgeAlignedRight">
		                                <Border Width="390"
		                                        MaxHeight="520"
		                                        Background="{StaticResource SurfaceBrush}"
		                                        BorderBrush="{StaticResource BorderBrushSoft}"
		                                        BorderThickness="1"
		                                        CornerRadius="6"
		                                        Padding="14">
		                                  <Grid RowDefinitions="Auto,Auto,*"
		                                        RowSpacing="10">
		                                    <StackPanel>
		                                      <TextBlock Text="Reference API Key"
		                                                 Foreground="{StaticResource TextPrimaryBrush}"
		                                                 FontSize="17"
		                                                 FontWeight="Bold"/>
		                                      <TextBlock Text="Select a saved API key field to reference without copying or modifying the original."
		                                                 Foreground="{StaticResource TextMutedBrush}"
		                                                 FontSize="12"
		                                                 TextWrapping="Wrap"/>
		                                    </StackPanel>

		                                    <TextBox Grid.Row="1"
		                                             Text="{Binding ApiKeyLinkSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
		                                             PlaceholderText="Search API keys..."
		                                             Background="{StaticResource InputBackgroundBrush}"
		                                             BorderBrush="{StaticResource BorderBrushSoft}"/>

		                                    <ListBox Grid.Row="2"
		                                             ItemsSource="{Binding FilteredApiKeyLinkOptions}"
		                                             Background="Transparent"
		                                             BorderThickness="0"
		                                             MaxHeight="360">
		                                      <ListBox.ItemTemplate>
		                                        <DataTemplate x:DataType="vm:ProjectSecretApiKeyLinkOption">
		                                          <Button Command="{Binding DataContext.AddLinkedApiKeyVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
		                                                  CommandParameter="{Binding}"
		                                                  HorizontalContentAlignment="Stretch"
		                                                  Margin="0,0,0,8">
		                                            <Grid ColumnDefinitions="*,Auto"
		                                                  RowDefinitions="Auto,Auto"
		                                                  RowSpacing="3">
		                                              <TextBlock Text="{Binding ApiKeyName}"
		                                                         Foreground="{StaticResource TextPrimaryBrush}"
		                                                         FontWeight="Bold"
		                                                         TextTrimming="CharacterEllipsis"/>
		                                              <TextBlock Grid.Row="1"
		                                                         Text="{Binding FieldLabel}"
		                                                         Foreground="{StaticResource TextMutedBrush}"
		                                                         FontFamily="{StaticResource MonoFontFamily}"
		                                                         FontSize="12"
		                                                         TextTrimming="CharacterEllipsis"/>
		                                              <Border Grid.Column="1"
		                                                      Grid.RowSpan="2"
		                                                      BorderBrush="{StaticResource AccentBrush}"
		                                                      BorderThickness="1"
		                                                      Padding="7,2"
		                                                      CornerRadius="2"
		                                                      VerticalAlignment="Center">
		                                                <TextBlock Text="Reference"
		                                                           Foreground="{StaticResource AccentBrush}"
		                                                           FontFamily="{StaticResource MonoFontFamily}"
		                                                           FontSize="11"
		                                                           FontWeight="Bold"/>
		                                              </Border>
		                                            </Grid>
		                                          </Button>
		                                        </DataTemplate>
		                                      </ListBox.ItemTemplate>
		                                    </ListBox>
		                                  </Grid>
		                                </Border>
		                              </Flyout>
		                            </Button.Flyout>
		                          </Button>
		                          </Grid>
	                        </Grid>
	                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </TabItem>

            <TabItem Header="Import / Export">
              <StackPanel Spacing="16"
                          Margin="0,14,0,0">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="18"
                          ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Import Preview"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="19"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Review .env rows before applying them to the selected environment."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="8">
                        <Button Content="Browse"
                                Command="{Binding PickImportFileCommand}"/>
                        <Button Content="Preview"
                                Command="{Binding PreviewImportCommand}"/>
                        <Button Content="Confirm Import"
                                Command="{Binding ApplyImportCommand}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="{StaticResource AccentForegroundBrush}"
                                FontWeight="Bold"/>
                      </StackPanel>
                    </Grid>

                    <TextBox Text="{Binding ImportPath, Mode=TwoWay}"
                             PlaceholderText=".env file path"
                             Margin="18,0,18,14"
                             Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushSoft}"/>

                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="12"
                          Margin="18,0,18,16">
                      <Border Background="{StaticResource SurfaceRaisedBrush}"
                              BorderBrush="{StaticResource BorderBrushSoft}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Padding="14">
                        <StackPanel>
                          <TextBlock Text="NEW VARIABLES"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="11"
                                     FontWeight="Bold"/>
                          <TextBlock Text="{Binding ImportNewCount}"
                                     Foreground="{StaticResource AccentBrush}"
                                     FontSize="24"
                                     FontWeight="Bold"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1"
                              Background="{StaticResource SurfaceRaisedBrush}"
                              BorderBrush="{StaticResource WarningBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Padding="14">
                        <StackPanel>
                          <TextBlock Text="CONFLICTS"
                                     Foreground="{StaticResource WarningBrush}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="11"
                                     FontWeight="Bold"/>
                          <TextBlock Text="{Binding ImportConflictCount}"
                                     Foreground="{StaticResource WarningBrush}"
                                     FontSize="24"
                                     FontWeight="Bold"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2"
                              Background="{StaticResource DangerMutedBrush}"
                              BorderBrush="{StaticResource DangerBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Padding="14">
                        <StackPanel>
                          <TextBlock Text="INVALID"
                                     Foreground="{StaticResource DangerBrush}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="11"
                                     FontWeight="Bold"/>
                          <TextBlock Text="{Binding ImportInvalidCount}"
                                     Foreground="{StaticResource DangerBrush}"
                                     FontSize="24"
                                     FontWeight="Bold"/>
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Border Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,1,0,1"
                            Padding="18,12">
                      <TextBlock Text="{Binding ImportPreview}"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="13"/>
                    </Border>
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                          ColumnSpacing="8">
                      <StackPanel>
                        <TextBlock Text="Export .env"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="19"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Value export writes plaintext. Template export writes keys only."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13"/>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="Browse"
                              Command="{Binding PickExportFileCommand}"/>
                      <Button Grid.Column="2"
                              Content="Export Values"
                              Command="{Binding ExportEnvCommand}"
                              Foreground="{StaticResource WarningBrush}"/>
                      <Button Grid.Column="3"
                              Content="Export Template"
                              Command="{Binding ExportTemplateCommand}"/>
                    </Grid>
                    <TextBox Text="{Binding ExportPath, Mode=TwoWay}"
                             PlaceholderText="Output path"
                             Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushSoft}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </TabItem>

            <TabItem Header="Compare">
              <Border Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource BorderBrushSoft}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Margin="0,14,0,0">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="1.4*,*"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        MinHeight="46"
                        ColumnSpacing="12">
                    <TextBlock Text="VARIABLE KEY"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="18,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="ENVIRONMENT STATUS"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                  </Grid>
                  <ItemsControl Grid.Row="1"
                                ItemsSource="{Binding CompareRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectSecretCompareRowVm">
                        <Border Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="0,0,0,1"
                                Padding="18,10">
                          <Grid ColumnDefinitions="1.4*,*"
                                ColumnSpacing="12">
                            <TextBlock Text="{Binding Key}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1"
                                          ItemsSource="{Binding Cells}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel/>
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border BorderBrush="{StaticResource AccentBrush}"
                                          BorderThickness="1"
                                          Padding="8,4"
                                          CornerRadius="2"
                                          Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                      <TextBlock Text="{Binding EnvironmentName}"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="11"/>
                                      <TextBlock Text="{Binding Status}"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="11"
                                                 FontWeight="Bold"/>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </TabItem>

            <TabItem Header="Scanner">
              <StackPanel Spacing="16"
                          Margin="0,14,0,0">
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="16">
                  <Border Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrushSoft}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="18"
                          MinHeight="118">
                    <StackPanel>
                      <TextBlock Text="HEALTH SCORE"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="11"
                                 FontWeight="Bold"/>
                      <TextBlock Text="{Binding TotalWarningCount, StringFormat='{}{0} issues'}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="30"
                                 FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrushSoft}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="18"
                          MinHeight="118">
                    <StackPanel>
                      <TextBlock Text="LAST SCAN"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="11"
                                 FontWeight="Bold"/>
                      <TextBlock Text="{Binding LastScanSummary}"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="13"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrushSoft}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="18"
                          MinHeight="118">
                    <StackPanel Spacing="9">
                      <TextBlock Text="SCAN LIMITS"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="11"
                                 FontWeight="Bold"/>
                      <TextBlock Text="3000 files / 1 MB file / 50 MB total"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                      <Button Content="Run Security Scan"
                              Command="{Binding ScanProjectCommand}"
                              IsEnabled="{Binding IsProjectEditing}"
                              Background="{StaticResource AccentBrush}"
                              Foreground="{StaticResource AccentForegroundBrush}"
                              FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                  <TextBox Text="{Binding ProjectRootPath, Mode=TwoWay}"
                           PlaceholderText="Project root path"
                           IsReadOnly="{Binding IsProjectReadOnly}"
                           Background="{StaticResource InputBackgroundBrush}"
                           BorderBrush="{StaticResource BorderBrushSoft}"/>
                  <Button Grid.Column="1"
                          Content="Choose Folder"
                          Command="{Binding PickProjectRootCommand}"
                          IsEnabled="{Binding IsProjectEditing}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding PlaintextLeakFindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectSecretScanFindingVm">
                      <Border Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrushSoft}"
                              BorderThickness="1"
                              CornerRadius="5"
                              Padding="14"
                              Margin="0,0,0,8">
                        <Grid ColumnDefinitions="180,*,180,90"
                              ColumnSpacing="12">
                          <TextBlock Text="CRITICAL"
                                     Foreground="{StaticResource DangerBrush}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontWeight="Bold"/>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding VariableKey}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="{StaticResource MonoFontFamily}"/>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Location}"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     FontFamily="{StaticResource MonoFontFamily}"/>
                          <TextBlock Grid.Column="3"
                                     Text="{Binding Severity}"
                                     Foreground="{StaticResource DangerBrush}"
                                     HorizontalAlignment="Right"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="14">
                      <TextBlock Text="Referenced but missing"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="18"
                                 FontWeight="Bold"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding MissingReferenceFindings.Count, StringFormat='{}{0} findings'}"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MissingReferenceFindings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectSecretScanFindingVm">
                          <Border Background="{StaticResource InputBackgroundBrush}"
                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                  BorderThickness="0,1,0,0"
                                  Padding="14,10">
                            <Grid ColumnDefinitions="1.3*,*,120"
                                  ColumnSpacing="12">
                              <TextBlock Text="{Binding VariableKey}"
                                         Foreground="{StaticResource WarningBrush}"
                                         FontFamily="{StaticResource MonoFontFamily}"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Location}"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         FontFamily="{StaticResource MonoFontFamily}"/>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding Severity}"
                                         Foreground="{StaticResource WarningBrush}"
                                         HorizontalAlignment="Right"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="14">
                      <TextBlock Text="Unused variables and warnings"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="18"
                                 FontWeight="Bold"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding UnusedVariableFindings.Count, StringFormat='{}{0} unused'}"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding UnusedVariableFindings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectSecretScanFindingVm">
                          <Border Background="{StaticResource InputBackgroundBrush}"
                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                  BorderThickness="0,1,0,0"
                                  Padding="14,10">
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFontFamily}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ScannerWarningFindings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectSecretScanFindingVm">
                          <Border Background="{StaticResource InputBackgroundBrush}"
                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                  BorderThickness="0,1,0,0"
                                  Padding="14,10">
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontFamily="{StaticResource MonoFontFamily}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </TabItem>

            <TabItem Header="Settings">
              <StackPanel Spacing="14"
                          Margin="0,14,0,0">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18">
                  <Grid ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="10">
                    <TextBox Text="{Binding ProjectName, Mode=TwoWay}"
                             PlaceholderText="Project name"
                             IsReadOnly="{Binding IsProjectReadOnly}"
                             Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushSoft}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ProjectRootPath, Mode=TwoWay}"
                             PlaceholderText="Project root path"
                             IsReadOnly="{Binding IsProjectReadOnly}"
                             Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushSoft}"/>
                    <TextBox Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Text="{Binding ProjectDescription, Mode=TwoWay}"
                             PlaceholderText="Description"
                             IsReadOnly="{Binding IsProjectReadOnly}"
                             Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushSoft}"/>
                    <TextBox Grid.Row="2"
                             Grid.ColumnSpan="2"
                             Text="{Binding ProjectNotes, Mode=TwoWay}"
                             PlaceholderText="Notes"
                             IsReadOnly="{Binding IsProjectReadOnly}"
                             AcceptsReturn="True"
                             MinHeight="110"
                             Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushSoft}"/>
                  </Grid>
                </Border>

                <Border Background="{StaticResource DangerMutedBrush}"
                        BorderBrush="{StaticResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Delete project"
                                 Foreground="{StaticResource DangerBrush}"
                                 FontSize="18"
                                 FontWeight="Bold"/>
                      <TextBlock Text="Removes the encrypted project environments and variables from this vault."
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Delete Project"
                            Command="{Binding DeleteProjectCommand}"
                            Foreground="{StaticResource DangerBrush}"/>
                  </Grid>
                </Border>
              </StackPanel>
            </TabItem>
            </TabControl>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
