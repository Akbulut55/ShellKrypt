<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.ProjectSecretsView"
             x:CompileBindings="False"
             x:DataType="vm:ProjectSecretsViewModel">
  <Grid ColumnDefinitions="300,*"
        Margin="16"
        ColumnSpacing="14">
    <Border Classes="table-shell">
      <Grid RowDefinitions="Auto,Auto,*"
            Margin="14"
            RowSpacing="12">
        <TextBlock Text="Project Secrets"
                   FontSize="24"
                   FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1"
                    Spacing="8">
          <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Search projects"/>
          <Button Content="Add Project"
                  Command="{Binding AddProjectCommand}"/>
          <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} projects'}"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectSecretRowVm">
                <Button Command="{Binding DataContext.OpenEntryByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Id}"
                        HorizontalContentAlignment="Stretch"
                        Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Summary}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"/>
                    <TextBlock Text="{Binding WarningSummary}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Classes="table-shell"
                Padding="16">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="10">
              <TextBlock Text="Project"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <Button Grid.Column="1"
                      Content="Save"
                      Command="{Binding SaveProjectCommand}"/>
              <Button Grid.Column="2"
                      Content="Delete"
                      Command="{Binding DeleteProjectCommand}"/>
            </Grid>

            <TextBlock Text="{Binding Error}"
                       Foreground="{StaticResource DangerBrush}"
                       IsVisible="{Binding HasError}"/>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="10">
              <TextBox Text="{Binding ProjectName, Mode=TwoWay}"
                       PlaceholderText="Project name"/>
              <TextBox Grid.Column="1"
                       Text="{Binding ProjectRootPath, Mode=TwoWay}"
                       PlaceholderText="Project root path"/>
              <TextBox Grid.Row="1"
                       Text="{Binding ProjectDescription, Mode=TwoWay}"
                       PlaceholderText="Description"/>
              <Button Grid.Row="1"
                      Grid.Column="1"
                      Content="Choose Folder"
                      Command="{Binding PickProjectRootCommand}"/>
              <TextBox Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Text="{Binding ProjectNotes, Mode=TwoWay}"
                       PlaceholderText="Notes"
                       AcceptsReturn="True"
                       MinHeight="70"/>
            </Grid>
          </StackPanel>
        </Border>

        <TabControl>
          <TabItem Header="Variables">
            <StackPanel Spacing="12"
                        Margin="0,12,0,0">
              <Border Classes="table-shell"
                      Padding="16">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding EnvironmentOptions}"
                              SelectedItem="{Binding SelectedEnvironment, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Name}"/>
                    <Button Grid.Column="1"
                            Content="Add Environment"
                            Command="{Binding AddEnvironmentCommand}"/>
                    <Button Grid.Column="2"
                            Content="Delete Environment"
                            Command="{Binding DeleteEnvironmentCommand}"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,180"
                        ColumnSpacing="8">
                    <TextBox Text="{Binding NewEnvironmentName, Mode=TwoWay}"
                             PlaceholderText="New environment name"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding EnvironmentKindOptions}"
                              SelectedItem="{Binding NewEnvironmentKind, Mode=TwoWay}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="table-shell"
                      Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Variable"
                             FontSize="18"
                             FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,*,150"
                        ColumnSpacing="8">
                    <TextBox Text="{Binding VariableKey, Mode=TwoWay}"
                             PlaceholderText="VARIABLE_KEY"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding VariableValue, Mode=TwoWay}"
                             PlaceholderText="Value"/>
                    <CheckBox Grid.Column="2"
                              Content="Secret"
                              IsChecked="{Binding VariableIsSecret, Mode=TwoWay}"/>
                  </Grid>
                  <Grid ColumnDefinitions="200,*,*"
                        ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding VariableSourceKindOptions}"
                              SelectedItem="{Binding VariableSourceKind, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ApiKeyOptions}"
                              SelectedItem="{Binding SelectedApiKey, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Name}"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding ApiKeyFieldOptions}"
                              SelectedItem="{Binding SelectedApiKeyField, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Label}"/>
                  </Grid>
                  <TextBox Text="{Binding VariableNotes, Mode=TwoWay}"
                           PlaceholderText="Variable notes"/>
                  <StackPanel Orientation="Horizontal"
                              Spacing="8">
                    <Button Content="Add / Update Variable"
                            Command="{Binding AddOrUpdateVariableCommand}"/>
                    <Button Content="Delete Variable"
                            Command="{Binding DeleteVariableCommand}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="table-shell"
                      Padding="12">
                <ItemsControl ItemsSource="{Binding Variables}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectSecretVariableRowVm">
                      <Border Classes="table-row"
                              Margin="0,0,0,6">
                        <Grid ColumnDefinitions="1.1*,1.1*,150,180"
                              ColumnSpacing="10"
                              Margin="10"
                              MinHeight="52">
                          <StackPanel>
                            <TextBlock Text="{Binding Key}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LinkDisplay}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding ValueDisplay}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding SourceLabel}"
                                     VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="3"
                                      Orientation="Horizontal"
                                      Spacing="6"
                                      HorizontalAlignment="Right">
                            <Button Content="Select"
                                    Command="{Binding DataContext.SelectVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="Reveal"
                                    Command="{Binding DataContext.RevealVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="Copy"
                                    Command="{Binding DataContext.CopyVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </TabItem>

          <TabItem Header="Import / Export">
            <StackPanel Spacing="12"
                        Margin="0,12,0,0">
              <Border Classes="table-shell"
                      Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Import .env"
                             FontSize="18"
                             FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                        ColumnSpacing="8">
                    <TextBox Text="{Binding ImportPath, Mode=TwoWay}"
                             PlaceholderText=".env file path"/>
                    <Button Grid.Column="1"
                            Content="Browse"
                            Command="{Binding PickImportFileCommand}"/>
                    <Button Grid.Column="2"
                            Content="Preview"
                            Command="{Binding PreviewImportCommand}"/>
                    <Button Grid.Column="3"
                            Content="Import"
                            Command="{Binding ApplyImportCommand}"/>
                  </Grid>
                  <TextBlock Text="{Binding ImportPreview}"
                             Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
              </Border>

              <Border Classes="table-shell"
                      Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Export .env"
                             FontSize="18"
                             FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                        ColumnSpacing="8">
                    <TextBox Text="{Binding ExportPath, Mode=TwoWay}"
                             PlaceholderText="Output path"/>
                    <Button Grid.Column="1"
                            Content="Browse"
                            Command="{Binding PickExportFileCommand}"/>
                    <Button Grid.Column="2"
                            Content="Export Values"
                            Command="{Binding ExportEnvCommand}"/>
                    <Button Grid.Column="3"
                            Content="Export Template"
                            Command="{Binding ExportTemplateCommand}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>

          <TabItem Header="Compare">
            <Border Classes="table-shell"
                    Padding="12"
                    Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding CompareRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectSecretCompareRowVm">
                    <StackPanel Spacing="4"
                                Margin="0,0,0,10">
                      <TextBlock Text="{Binding Key}"
                                 FontWeight="SemiBold"/>
                      <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="api-env-chip"
                                    Margin="0,0,6,4">
                              <TextBlock Text="{Binding Status}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </TabItem>

          <TabItem Header="Scanner">
            <StackPanel Spacing="12"
                        Margin="0,12,0,0">
              <Border Classes="table-shell"
                      Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Scanner"
                             FontSize="18"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="Limits: 3000 files, 1 MB per file, 50 MB total, 500 findings."
                             Foreground="{StaticResource TextMutedBrush}"/>
                  <Button Content="Scan Project"
                          Command="{Binding ScanProjectCommand}"/>
                  <TextBlock Text="{Binding LastScanSummary}"
                             Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding ScanFindings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectSecretScanFindingVm">
                    <Border Classes="table-row"
                            Margin="0,0,0,6"
                            Padding="12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Message}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Location}"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Severity}"
                                   Foreground="{StaticResource AccentBrush}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
