<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             xmlns:vaulting="using:ShellKrypt.Core.Vaulting"
             x:Class="ShellKrypt.Desktop.Views.SettingsView"
             x:Name="Root"
             x:CompileBindings="False"
             x:DataType="vm:SettingsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  BringIntoViewOnFocusChange="False"
                  ScrollChanged="OnSettingsScrollChanged">
      <StackPanel Margin="28,24,28,28"
                  MaxWidth="1500"
                  Spacing="24">
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource Loc.Settings.Title}"
                     FontSize="30"
                     FontWeight="SemiBold"
                     LetterSpacing="-0.6"/>
          <TextBlock Text="{DynamicResource Loc.Settings.Subtitle}"
                     Classes="page-subtitle"/>
        </StackPanel>

        <Grid ColumnDefinitions="7*,5*"
              ColumnSpacing="22">
          <StackPanel Spacing="22">
            <Border Classes="settings-block">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource AccentMutedBrush}">
                    <TextBlock Text="S"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SuccessBrush}"
                               FontWeight="Black"/>
                  </Border>
                  <TextBlock Text="{DynamicResource Loc.Settings.Security}"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource Loc.Settings.AutoLock.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SecurityStatusText}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Column="1"
                          Width="170">
                      <Button x:Name="AutoLockPickerButton"
                              Classes="settings-picker-button"
                              Command="{Binding ToggleAutoLockPickerCommand}">
                        <Grid ColumnDefinitions="*,Auto"
                              HorizontalAlignment="Stretch">
                          <TextBlock Text="{Binding SelectedAutoLockDurationLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1"
                                     Text="&#xE70D;"
                                     FontFamily="Segoe MDL2 Assets"
                                     FontSize="10"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                      </Button>

                      <Popup IsOpen="{Binding IsAutoLockPickerOpen, Mode=TwoWay}"
                             PlacementTarget="{Binding #AutoLockPickerButton}"
                             Placement="BottomEdgeAlignedLeft"
                             PlacementConstraintAdjustment="SlideX"
                             VerticalOffset="4"
                             IsLightDismissEnabled="True">
                        <Border Classes="settings-picker-popup"
                                Width="170">
                          <ItemsControl ItemsSource="{Binding AutoLockDurations}"
                                        HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Classes="settings-picker-option"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding #Root.DataContext.SelectAutoLockDurationCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Popup>
                    </Grid>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource Loc.Settings.FocusLock.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding FocusLockSummary}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Column="1"
                          Width="170">
                      <Button x:Name="FocusLockPickerButton"
                              Classes="settings-picker-button"
                              Command="{Binding ToggleFocusLockPickerCommand}">
                        <Grid ColumnDefinitions="*,Auto"
                              HorizontalAlignment="Stretch">
                          <TextBlock Text="{Binding SelectedFocusLossLockDelayLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1"
                                     Text="&#xE70D;"
                                     FontFamily="Segoe MDL2 Assets"
                                     FontSize="10"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                      </Button>

                      <Popup IsOpen="{Binding IsFocusLockPickerOpen, Mode=TwoWay}"
                             PlacementTarget="{Binding #FocusLockPickerButton}"
                             Placement="BottomEdgeAlignedLeft"
                             PlacementConstraintAdjustment="SlideX"
                             VerticalOffset="4"
                             IsLightDismissEnabled="True">
                        <Border Classes="settings-picker-popup"
                                Width="170">
                          <ItemsControl ItemsSource="{Binding FocusLossLockDelayOptions}"
                                        HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Classes="settings-picker-option"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding #Root.DataContext.SelectFocusLossLockDelayCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Popup>
                    </Grid>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource Loc.Settings.Clipboard.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Loc.Settings.Clipboard.Detail}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding ClipboardClearSummary}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Opacity="0.82"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Spacing="8"
                                Width="170">
                      <CheckBox Content="{DynamicResource Loc.Settings.AllowCopy}"
                                IsChecked="{Binding ClipboardCopyEnabled}"/>
                      <Grid>
                        <Button x:Name="ClipboardClearPickerButton"
                                Classes="settings-picker-button"
                                Command="{Binding ToggleClipboardClearPickerCommand}">
                          <Grid ColumnDefinitions="*,Auto"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding SelectedClipboardClearDurationLabel}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                          </Grid>
                        </Button>

                        <Popup IsOpen="{Binding IsClipboardClearPickerOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding #ClipboardClearPickerButton}"
                               Placement="BottomEdgeAlignedLeft"
                               PlacementConstraintAdjustment="SlideX"
                               VerticalOffset="4"
                               IsLightDismissEnabled="True">
                          <Border Classes="settings-picker-popup"
                                  Width="170">
                            <ItemsControl ItemsSource="{Binding ClipboardClearTimeoutOptions}"
                                          HorizontalAlignment="Stretch">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Content="{Binding Label}"
                                          Classes="settings-picker-option"
                                          Classes.active="{Binding IsSelected}"
                                          Command="{Binding #Root.DataContext.SelectClipboardClearDurationCommand}"
                                          CommandParameter="{Binding}"/>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </Popup>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="14">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecoveryGuidanceText}"
                                   Classes="page-subtitle"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <Border Grid.Column="1"
                              Background="{StaticResource SurfaceRaisedBrush}"
                              CornerRadius="999"
                              Padding="12,6"
                              VerticalAlignment="Top">
                        <TextBlock Text="{Binding ActiveSecurityProfileLabel}"
                                   Classes="settings-mini-label"/>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.Current}"
                                   Classes="settings-mini-label"/>
                        <TextBox Text="{Binding CurrentMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="{DynamicResource Loc.Settings.MasterPassword.Current.Placeholder}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Spacing="8">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.SecurityProfile}"
                                   Classes="settings-mini-label"/>
                        <ComboBox ItemsSource="{Binding SecurityProfiles}"
                                  SelectedItem="{Binding SelectedSecurityProfile}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.New}"
                                   Classes="settings-mini-label"/>
                        <TextBox Text="{Binding NewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="{DynamicResource Loc.Settings.MasterPassword.New.Placeholder}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Spacing="8">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.Confirm}"
                                   Classes="settings-mini-label"/>
                        <TextBox Text="{Binding ConfirmNewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="{DynamicResource Loc.Settings.MasterPassword.Confirm.Placeholder}"/>
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding PasswordPolicyGuidance}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedSecurityProfileDescription}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Opacity="0.82"/>
                    <TextBlock Text="{Binding MasterPasswordStatus}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               IsVisible="{Binding HasMasterPasswordStatus}"/>

                    <Button Content="{DynamicResource Loc.Settings.Button.ChangeMasterPassword}"
                            Classes="settings-primary-button"
                            Command="{Binding ChangeMasterPasswordCommand}"
                            HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settings-block">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource SurfaceElevatedBrush}">
                    <TextBlock Text="G"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontWeight="Black"/>
                  </Border>
                  <TextBlock Text="{DynamicResource Loc.Settings.General}"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-toggle-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <TextBlock Text="{DynamicResource Loc.Settings.Theme.Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="1"
                          Width="140">
                      <Button x:Name="ThemePickerButton"
                              Classes="settings-picker-button"
                              Command="{Binding ToggleThemePickerCommand}">
                        <Grid ColumnDefinitions="*,Auto"
                              HorizontalAlignment="Stretch">
                          <TextBlock Text="{Binding ThemeModeLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1"
                                     Text="&#xE70D;"
                                     FontFamily="Segoe MDL2 Assets"
                                     FontSize="10"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                      </Button>

                      <Popup IsOpen="{Binding IsThemePickerOpen, Mode=TwoWay}"
                             PlacementTarget="{Binding #ThemePickerButton}"
                             Placement="BottomEdgeAlignedLeft"
                             PlacementConstraintAdjustment="SlideX"
                             VerticalOffset="4"
                             IsLightDismissEnabled="True">
                        <Border Classes="settings-picker-popup"
                                Width="140">
                          <ItemsControl ItemsSource="{Binding ThemeOptions}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Classes="settings-picker-option"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding #Root.DataContext.SelectThemeCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Popup>
                    </Grid>
                  </Grid>
                </Border>

                <Border Classes="settings-toggle-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <StackPanel Spacing="3"
                                VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Loc.Settings.Language.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Loc.Settings.Language.Description}"
                                 Classes="page-subtitle"
                                 FontSize="12"/>
                    </StackPanel>
                    <Grid Grid.Column="1"
                          Width="140">
                      <Button x:Name="LanguagePickerButton"
                              Classes="settings-picker-button"
                              Command="{Binding ToggleLanguagePickerCommand}">
                        <Grid ColumnDefinitions="*,Auto"
                              HorizontalAlignment="Stretch">
                          <TextBlock Text="{Binding SelectedLanguageLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1"
                                     Text="&#xE70D;"
                                     FontFamily="Segoe MDL2 Assets"
                                     FontSize="10"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                      </Button>

                      <Popup IsOpen="{Binding IsLanguagePickerOpen, Mode=TwoWay}"
                             PlacementTarget="{Binding #LanguagePickerButton}"
                             Placement="BottomEdgeAlignedLeft"
                             PlacementConstraintAdjustment="SlideX"
                             VerticalOffset="4"
                             IsLightDismissEnabled="True">
                        <Border Classes="settings-picker-popup"
                                Width="140">
                          <ItemsControl ItemsSource="{Binding LanguageOptions}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Classes="settings-picker-option"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding #Root.DataContext.SelectLanguageCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Popup>
                    </Grid>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Spacing="22">
            <Border Classes="settings-block">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource SurfaceElevatedBrush}">
                    <TextBlock Text="V"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontWeight="Black"/>
                  </Border>
                  <TextBlock Text="{DynamicResource Loc.Settings.VaultManagement}"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-vault-card">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                      <Border Width="48"
                              Height="48"
                              CornerRadius="12"
                              Background="{StaticResource AppBackgroundSoftBrush}">
                        <TextBlock Text="DB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Black"/>
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Spacing="4">
                        <TextBlock Text="{DynamicResource Loc.Settings.PrimaryDatabase}"
                                   Classes="settings-mini-label"/>
                        <TextBlock Text="{Binding ActiveVaultDisplay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <Border Background="{StaticResource AccentMutedBrush}"
                              CornerRadius="999"
                              Padding="10,4">
                        <TextBlock Text="{DynamicResource Loc.Settings.Encrypted}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="10"
                                   FontWeight="Black"/>
                      </Border>
                      <Border Background="{StaticResource SurfaceElevatedBrush}"
                              CornerRadius="999"
                              Padding="10,4">
                        <TextBlock Text="{Binding EncryptionDisplay, FallbackValue=AES-256}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   FontWeight="Black"/>
                      </Border>
                    </StackPanel>

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding VaultStoragePercent}"
                                 Height="6"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource AppBackgroundSoftBrush}"/>
                    <TextBlock Text="{Binding VaultStorageDisplay}"
                               Classes="page-subtitle"
                               FontSize="12"/>
                  </StackPanel>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="14">
                    <TextBlock Text="{DynamicResource Loc.Settings.Backup.Title}"
                               Classes="settings-mini-label"/>
                    <TextBlock Text="{Binding BackupRecommendationText}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <StackPanel Spacing="8">
                      <TextBlock Text="{DynamicResource Loc.Settings.Backup.EncryptedPath}"
                                 Classes="settings-mini-label"/>
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <TextBox Text="{Binding EncryptedExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{DynamicResource Loc.Settings.Backup.EncryptedPath.Placeholder}"/>
                        <Button Grid.Column="1"
                                Content="{DynamicResource Loc.Common.Browse}"
                                Classes="settings-secondary-button"
                                Command="{Binding BrowseEncryptedExportPathCommand}"/>
                      </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="{DynamicResource Loc.Settings.Backup.Passphrase}"
                                 Classes="settings-mini-label"/>
                      <TextBox Text="{Binding ExportPassphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PasswordChar="*"
                               PlaceholderText="{DynamicResource Loc.Settings.Backup.Passphrase.Placeholder}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="10">
                      <Button Content="{DynamicResource Loc.Settings.Button.PreviewBackup}"
                              Classes="settings-transfer-button"
                              Command="{Binding PreviewExportCommand}"/>
                      <Button Grid.Column="1"
                              Content="{DynamicResource Loc.Settings.Button.ExportBackup}"
                              Classes="settings-primary-button"
                              Command="{Binding ExportEncryptedCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding ExportSummary}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="14">
                    <TextBlock Text="{DynamicResource Loc.Settings.Restore.Title}"
                               Classes="settings-mini-label"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <TextBox Text="{Binding EncryptedImportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="{DynamicResource Loc.Settings.Restore.ImportPath.Placeholder}"/>
                      <Button Grid.Column="1"
                              Content="{DynamicResource Loc.Common.Browse}"
                              Classes="settings-secondary-button"
                              Command="{Binding BrowseEncryptedImportPathCommand}"/>
                    </Grid>

                    <TextBox Text="{Binding EncryptedImportPassphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PasswordChar="*"
                             PlaceholderText="{DynamicResource Loc.Settings.Restore.Passphrase.Placeholder}"/>

                    <Grid ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="10">
                      <Button Content="{DynamicResource Loc.Settings.Button.PreviewRestore}"
                              Classes="settings-transfer-button"
                              Command="{Binding PreviewEncryptedImportCommand}"/>
                      <Button Grid.Column="1"
                              Content="{DynamicResource Loc.Settings.Button.RestoreBackup}"
                              Classes="settings-transfer-button"
                              Command="{Binding ImportEncryptedCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding EncryptedImportSummary}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="14">
                    <TextBlock Text="{DynamicResource Loc.Settings.Advanced.Title}"
                               Classes="settings-mini-label"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <TextBox Text="{Binding CsvImportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="{DynamicResource Loc.Settings.Csv.Path.Placeholder}"/>
                      <Button Grid.Column="1"
                              Content="{DynamicResource Loc.Common.BrowseCsv}"
                              Classes="settings-secondary-button"
                              Command="{Binding BrowseCsvImportPathCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="10">
                      <Button Content="{DynamicResource Loc.Settings.Button.PreviewCsv}"
                              Classes="settings-transfer-button"
                              Command="{Binding PreviewCsvImportCommand}"/>
                      <Button Grid.Column="1"
                              Content="{DynamicResource Loc.Settings.Button.ImportCsv}"
                              Classes="settings-transfer-button"
                              Command="{Binding ImportCsvCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <TextBox Text="{Binding PlaintextExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="{DynamicResource Loc.Settings.Plaintext.Path.Placeholder}"/>
                      <Button Grid.Column="1"
                              Content="{DynamicResource Loc.Common.BrowseJson}"
                              Classes="settings-secondary-button"
                              Command="{Binding BrowsePlaintextExportPathCommand}"/>
                    </Grid>
                    <CheckBox Content="{DynamicResource Loc.Settings.Plaintext.Warning}"
                              IsChecked="{Binding ConfirmPlaintextExport}"/>
                    <TextBox Text="{Binding PlaintextExportConfirmationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{DynamicResource Loc.Settings.Plaintext.Confirmation.Placeholder}"/>
                    <Button Content="{DynamicResource Loc.Settings.Button.ExportPlaintext}"
                            Classes="settings-danger-link"
                            Command="{Binding ExportPlaintextCommand}"/>

                    <TextBlock Text="{Binding CsvPreviewSummary}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasCsvPreview}"/>
                  </StackPanel>
                </Border>

                <Button Content="{DynamicResource Loc.Settings.Button.DestroyVault}"
                        Classes="settings-danger-link"
                        Command="{Binding DestroyVaultCommand}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.settings-block">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <Style Selector="Border.settings-field-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="Border.settings-toggle-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="TextBlock.settings-mini-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="Button.settings-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.settings-secondary-button">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.settings-picker-button">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="Button.settings-picker-button:pointerover">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    </Style>

    <Style Selector="Button.settings-picker-button:pressed">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
    </Style>

    <Style Selector="Border.settings-picker-popup">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="Button.settings-picker-option">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="Button.settings-picker-option:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.settings-picker-option.active">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.settings-picker-option.active:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.settings-vault-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="Button.settings-transfer-button">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.settings-danger-link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

  </UserControl.Styles>
</UserControl>
