<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             xmlns:vaulting="using:ShellKrypt.Core.Vaulting"
             x:Class="ShellKrypt.Desktop.Views.SettingsView"
             x:CompileBindings="False"
             x:DataType="vm:SettingsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,24,28,28"
                  MaxWidth="1500"
                  Spacing="24">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="18"
              VerticalAlignment="Center">
          <Border Classes="settings-top-search-shell">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
              <TextBlock Text="⌕"
                         Foreground="{StaticResource TextMutedBrush}"
                         VerticalAlignment="Center"/>
              <TextBox Grid.Column="1"
                       Classes="settings-top-search"
                       PlaceholderText="Search settings..."/>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="22"
                      VerticalAlignment="Center"
                      Margin="18,0,0,0">
            <TextBlock Text="All Items"
                       Classes="settings-top-link"/>
            <TextBlock Text="Favorites"
                       Classes="settings-top-link"/>
            <TextBlock Text="Recent"
                       Classes="settings-top-link"/>
          </StackPanel>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center">
            <Border Width="36"
                    Height="36"
                    CornerRadius="10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
              <TextBlock Text="↻"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}"/>
            </Border>
            <Border Width="36"
                    Height="36"
                    CornerRadius="10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
              <TextBlock Text="!"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}"/>
            </Border>
            <Border Width="36"
                    Height="36"
                    CornerRadius="18"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
              <TextBlock Text="A"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMutedBrush}"
                         FontWeight="Bold"/>
            </Border>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="18"
              VerticalAlignment="Bottom">
          <StackPanel Spacing="6">
            <TextBlock Text="Vault Configuration"
                       FontSize="30"
                       FontWeight="SemiBold"
                       LetterSpacing="-0.6"/>
            <TextBlock Text="Manage security protocols and system preferences."
                       Classes="page-subtitle"/>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Bottom">
            <Button Content="Discard"
                    Classes="settings-secondary-button"
                    Command="{Binding DiscardChangesCommand}"/>
            <Button Content="Save Changes"
                    Classes="settings-primary-button"
                    Command="{Binding SaveChangesCommand}"/>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="7*,5*"
              ColumnSpacing="22">
          <StackPanel Spacing="22">
            <Border Classes="settings-block">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="#1A4F47">
                    <TextBlock Text="S"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SuccessBrush}"
                               FontWeight="Black"/>
                  </Border>
                  <TextBlock Text="Security"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Auto-lock vault after inactivity"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SecurityStatusText}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="170"
                              ItemsSource="{Binding AutoLockDurations}"
                              SelectedItem="{Binding SelectedAutoLockDuration}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="14">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Clear clipboard after timeout"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Automatically purges copied secrets from the OS clipboard."
                                   Classes="page-subtitle"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ClipboardClearSecondsDisplay}"
                                 Foreground="{StaticResource AccentBrush}"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 VerticalAlignment="Top"/>
                    </Grid>
                    <Slider Minimum="5"
                            Maximum="120"
                            Value="{Binding ClipboardClearSecondsValue}"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="14">
                      <TextBox Text="{Binding ClipboardClearSecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Width="120"
                               PlaceholderText="Seconds"/>
                      <TextBlock Grid.Column="1"
                                 Text="5s"
                                 Classes="settings-mini-label"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settings-block">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource SurfaceElevatedBrush}">
                    <TextBlock Text="G"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontWeight="Black"/>
                  </Border>
                  <TextBlock Text="General"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14">
                  <Border Classes="settings-toggle-shell">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                      <TextBlock Text="Lock on Deactivate"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                      <CheckBox Grid.Column="1"
                                IsChecked="{Binding LockOnDeactivate}"
                                VerticalAlignment="Center"/>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1"
                          Classes="settings-toggle-shell">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                      <TextBlock Text="Theme Mode"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1"
                                Width="110"
                                ItemsSource="{Binding ThemeModes}"
                                SelectedItem="{Binding SelectedThemeMode}"/>
                    </Grid>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Spacing="22">
            <Border Classes="settings-block">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource SurfaceElevatedBrush}">
                    <TextBlock Text="V"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontWeight="Black"/>
                  </Border>
                  <TextBlock Text="Vault Management"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-vault-card">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                      <Border Width="48"
                              Height="48"
                              CornerRadius="12"
                              Background="{StaticResource AppBackgroundSoftBrush}">
                        <TextBlock Text="DB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Black"/>
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Spacing="4">
                        <TextBlock Text="PRIMARY DATABASE"
                                   Classes="settings-mini-label"/>
                        <TextBlock Text="{Binding ActiveVaultDisplay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <Border Background="#1A4F47"
                              CornerRadius="999"
                              Padding="10,4">
                        <TextBlock Text="ENCRYPTED"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="10"
                                   FontWeight="Black"/>
                      </Border>
                      <Border Background="{StaticResource SurfaceElevatedBrush}"
                              CornerRadius="999"
                              Padding="10,4">
                        <TextBlock Text="{Binding EncryptionDisplay, FallbackValue=AES-256}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   FontWeight="Black"/>
                      </Border>
                    </StackPanel>

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding VaultStoragePercent}"
                                 Height="6"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource AppBackgroundSoftBrush}"/>
                    <TextBlock Text="{Binding VaultStorageDisplay}"
                               Classes="page-subtitle"
                               FontSize="12"/>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14">
                  <StackPanel Spacing="10">
                    <TextBlock Text="IMPORT"
                               Classes="settings-mini-label"/>
                    <Button Content="From Backup"
                            Classes="settings-transfer-button"
                            Command="{Binding PreviewEncryptedImportCommand}"/>
                    <Button Content="Import CSV"
                            Classes="settings-transfer-button"
                            Command="{Binding PreviewCsvImportCommand}"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Spacing="10">
                    <TextBlock Text="EXPORT"
                               Classes="settings-mini-label"/>
                    <Button Content="Export .SKBX"
                            Classes="settings-transfer-button"
                            Command="{Binding ExportEncryptedCommand}"/>
                    <Button Content="Export .JSON"
                            Classes="settings-transfer-button"
                            Command="{Binding ExportPlaintextCommand}"/>
                  </StackPanel>
                </Grid>

                <Button Content="Destroy All Vault Data"
                        Classes="settings-danger-link"
                        Command="{Binding DestroyVaultCommand}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Border Classes="settings-integrity-card">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="24">
            <Border Width="136"
                    Height="136"
                    CornerRadius="18"
                    ClipToBounds="True">
              <Image Source="avares://ShellKrypt.Desktop/Assets/settings-integrity-chip.png"
                     Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="10"
                        VerticalAlignment="Center">
              <TextBlock Text="Architectural Integrity"
                         FontSize="24"
                         FontWeight="Bold"/>
              <TextBlock Text="{Binding IntegrityStatusText}"
                         Classes="page-subtitle"
                         TextWrapping="Wrap"
                         MaxWidth="780"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="14">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                  <Border Width="7" Height="7" CornerRadius="999" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="E2E READY" Classes="settings-mini-label"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                  <Border Width="7" Height="7" CornerRadius="999" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="LOCAL ONLY" Classes="settings-mini-label"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="View Audit Log"
                    Classes="settings-secondary-button"
                    Command="{Binding ViewAuditCommand}"
                    VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <TextBlock Text="{Binding TransferStatus}"
                   Classes="page-subtitle"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.settings-top-search-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="MinWidth" Value="320"/>
    </Style>

    <Style Selector="TextBox.settings-top-search">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,11"/>
      <Setter Property="MinHeight" Value="42"/>
    </Style>

    <Style Selector="TextBlock.settings-top-link">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.settings-block">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <Style Selector="Border.settings-field-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="Border.settings-toggle-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="TextBlock.settings-mini-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="Button.settings-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.settings-secondary-button">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.settings-vault-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="Button.settings-transfer-button">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.settings-danger-link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Border.settings-integrity-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
  </UserControl.Styles>
</UserControl>
