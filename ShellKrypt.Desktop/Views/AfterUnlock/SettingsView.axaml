<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:ShellKrypt.UI.Shared.Controls"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             xmlns:vaulting="using:ShellKrypt.Core.Vaulting"
             x:Class="ShellKrypt.Desktop.Views.SettingsView"
             x:Name="Root"
             x:CompileBindings="False"
             x:DataType="vm:SettingsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  BringIntoViewOnFocusChange="False"
                  ScrollChanged="OnSettingsScrollChanged">
      <StackPanel Margin="16"
                  MaxWidth="1500"
                  Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource Loc.Settings.Title}"
                     FontSize="30"
                     FontWeight="SemiBold"
                     LetterSpacing="-0.6"/>
          <TextBlock Text="{DynamicResource Loc.Settings.Subtitle}"
                     Classes="page-subtitle"/>
        </StackPanel>

        <Grid RowDefinitions="Auto,Auto,Auto"
              RowSpacing="14">
          <StackPanel Grid.Row="2"
                      Spacing="14">
            <Border Classes="settings-block">
              <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <TextBlock Text="{DynamicResource Loc.Settings.Security}"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource Loc.Settings.AutoLock.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SecurityStatusText}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Right">
                      <Button x:Name="AutoLockPickerButton"
                              Classes="sk-button settings-picker-button"
                              Command="{Binding ToggleAutoLockPickerCommand}">
                        <Grid ColumnDefinitions="Auto,Auto"
                              HorizontalAlignment="Center">
                          <TextBlock Text="{Binding SelectedAutoLockDurationLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <PathIcon Grid.Column="1"
                                    Data="{StaticResource IconDropDown}"
                                    Width="16"
                                    Height="16"
                                    Margin="10,0,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    IsVisible="{Binding !IsAutoLockPickerOpen}"/>
                          <PathIcon Grid.Column="1"
                                    Data="{StaticResource IconDropUp}"
                                    Width="16"
                                    Height="16"
                                    Margin="10,0,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    IsVisible="{Binding IsAutoLockPickerOpen}"/>
                        </Grid>
                      </Button>

                      <Popup IsOpen="{Binding IsAutoLockPickerOpen, Mode=TwoWay}"
                             PlacementTarget="{Binding #AutoLockPickerButton}"
                             Placement="BottomEdgeAlignedLeft"
                             PlacementConstraintAdjustment="SlideX"
                             VerticalOffset="4"
                             IsLightDismissEnabled="True">
                        <Border Classes="settings-picker-popup"
                                MinWidth="150">
                          <ItemsControl ItemsSource="{Binding AutoLockDurations}"
                                        HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Classes="sk-picker-option"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding #Root.DataContext.SelectAutoLockDurationCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Popup>
                    </Grid>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource Loc.Settings.FocusLock.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding FocusLockSummary}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Right">
                      <Button x:Name="FocusLockPickerButton"
                              Classes="sk-button settings-picker-button"
                              Command="{Binding ToggleFocusLockPickerCommand}">
                        <Grid ColumnDefinitions="Auto,Auto"
                              HorizontalAlignment="Center">
                          <TextBlock Text="{Binding SelectedFocusLossLockDelayLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <PathIcon Grid.Column="1"
                                    Data="{StaticResource IconDropDown}"
                                    Width="16"
                                    Height="16"
                                    Margin="10,0,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    IsVisible="{Binding !IsFocusLockPickerOpen}"/>
                          <PathIcon Grid.Column="1"
                                    Data="{StaticResource IconDropUp}"
                                    Width="16"
                                    Height="16"
                                    Margin="10,0,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    IsVisible="{Binding IsFocusLockPickerOpen}"/>
                        </Grid>
                      </Button>

                      <Popup IsOpen="{Binding IsFocusLockPickerOpen, Mode=TwoWay}"
                             PlacementTarget="{Binding #FocusLockPickerButton}"
                             Placement="BottomEdgeAlignedLeft"
                             PlacementConstraintAdjustment="SlideX"
                             VerticalOffset="4"
                             IsLightDismissEnabled="True">
                        <Border Classes="settings-picker-popup"
                                MinWidth="128">
                          <ItemsControl ItemsSource="{Binding FocusLossLockDelayOptions}"
                                        HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Classes="sk-picker-option"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding #Root.DataContext.SelectFocusLossLockDelayCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Popup>
                    </Grid>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource Loc.Settings.Clipboard.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Loc.Settings.Clipboard.Detail}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding ClipboardClearSummary}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Opacity="0.82"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Spacing="8"
                                HorizontalAlignment="Right">
                      <CheckBox Content="{DynamicResource Loc.Settings.AllowCopy}"
                                IsChecked="{Binding ClipboardCopyEnabled}"/>
                      <Grid>
                        <Button x:Name="ClipboardClearPickerButton"
                                Classes="sk-button settings-picker-button"
                                Command="{Binding ToggleClipboardClearPickerCommand}">
                          <Grid ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SelectedClipboardClearDurationLabel}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <PathIcon Grid.Column="1"
                                      Data="{StaticResource IconDropDown}"
                                      Width="16"
                                      Height="16"
                                      Margin="10,0,0,0"
                                      Foreground="{StaticResource TextMutedBrush}"
                                      IsVisible="{Binding !IsClipboardClearPickerOpen}"/>
                            <PathIcon Grid.Column="1"
                                      Data="{StaticResource IconDropUp}"
                                      Width="16"
                                      Height="16"
                                      Margin="10,0,0,0"
                                      Foreground="{StaticResource TextMutedBrush}"
                                      IsVisible="{Binding IsClipboardClearPickerOpen}"/>
                          </Grid>
                        </Button>

                        <Popup IsOpen="{Binding IsClipboardClearPickerOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding #ClipboardClearPickerButton}"
                               Placement="BottomEdgeAlignedLeft"
                               PlacementConstraintAdjustment="SlideX"
                               VerticalOffset="4"
                               IsLightDismissEnabled="True">
                          <Border Classes="settings-picker-popup"
                                  MinWidth="128">
                            <ItemsControl ItemsSource="{Binding ClipboardClearTimeoutOptions}"
                                          HorizontalAlignment="Stretch">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Content="{Binding Label}"
                                          Classes="sk-picker-option"
                                          Classes.active="{Binding IsSelected}"
                                          Command="{Binding #Root.DataContext.SelectClipboardClearDurationCommand}"
                                          CommandParameter="{Binding}"/>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </Popup>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="14">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecoveryGuidanceText}"
                                   Classes="page-subtitle"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <Border Grid.Column="1"
                              Background="{StaticResource SurfaceRaisedBrush}"
                              CornerRadius="999"
                              Padding="12,6"
                              VerticalAlignment="Top">
                        <TextBlock Text="{Binding ActiveSecurityProfileLabel}"
                                   Classes="settings-mini-label"/>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.Current}"
                                   Classes="settings-mini-label"/>
                        <TextBox Text="{Binding CurrentMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="{DynamicResource Loc.Settings.MasterPassword.Current.Placeholder}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Spacing="8">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.SecurityProfile}"
                                   Classes="settings-mini-label"/>
                        <ComboBox ItemsSource="{Binding SecurityProfiles}"
                                  SelectedItem="{Binding SelectedSecurityProfile}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.New}"
                                   Classes="settings-mini-label"/>
                        <TextBox Text="{Binding NewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="{DynamicResource Loc.Settings.MasterPassword.New.Placeholder}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Spacing="8">
                        <TextBlock Text="{DynamicResource Loc.Settings.MasterPassword.Confirm}"
                                   Classes="settings-mini-label"/>
                        <TextBox Text="{Binding ConfirmNewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="{DynamicResource Loc.Settings.MasterPassword.Confirm.Placeholder}"/>
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding PasswordPolicyGuidance}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedSecurityProfileDescription}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Opacity="0.82"/>
                    <TextBlock Text="{Binding MasterPasswordStatus}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               IsVisible="{Binding HasMasterPasswordStatus}"/>

                    <Button Content="{DynamicResource Loc.Settings.Button.ChangeMasterPassword}"
                            Classes="sk-primary"
                            Command="{Binding ChangeMasterPasswordCommand}"
                            HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </Border>

                <Button Content="{DynamicResource Loc.Settings.Button.DestroyVault}"
                        Classes="sk-danger"
                        Command="{Binding DestroyVaultCommand}"/>
              </StackPanel>
            </Border>

          </StackPanel>

          <StackPanel Grid.Row="0"
                      Spacing="14">
            <Border Classes="settings-block">
              <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <TextBlock Text="{DynamicResource Loc.Settings.General}"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-toggle-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <TextBlock Text="{DynamicResource Loc.Settings.Theme.Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Right">
                      <Button x:Name="ThemePickerButton"
                              Classes="sk-button settings-picker-button"
                              Command="{Binding ToggleThemePickerCommand}">
                        <Grid ColumnDefinitions="Auto,Auto"
                              HorizontalAlignment="Center">
                          <TextBlock Text="{Binding ThemeModeLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <PathIcon Grid.Column="1"
                                    Data="{StaticResource IconDropDown}"
                                    Width="16"
                                    Height="16"
                                    Margin="10,0,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    IsVisible="{Binding !IsThemePickerOpen}"/>
                          <PathIcon Grid.Column="1"
                                    Data="{StaticResource IconDropUp}"
                                    Width="16"
                                    Height="16"
                                    Margin="10,0,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    IsVisible="{Binding IsThemePickerOpen}"/>
                        </Grid>
                      </Button>

                      <Popup IsOpen="{Binding IsThemePickerOpen, Mode=TwoWay}"
                             PlacementTarget="{Binding #ThemePickerButton}"
                             Placement="BottomEdgeAlignedLeft"
                             PlacementConstraintAdjustment="SlideX"
                             VerticalOffset="4"
                             IsLightDismissEnabled="True">
                        <Border Classes="settings-picker-popup"
                                MinWidth="104">
                          <ItemsControl ItemsSource="{Binding ThemeOptions}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Classes="sk-picker-option"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding #Root.DataContext.SelectThemeCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Popup>
                    </Grid>
                  </Grid>
                </Border>

                <Border Classes="settings-toggle-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <StackPanel Spacing="3"
                                VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Loc.Settings.Language.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Loc.Settings.Language.Description}"
                                 Classes="page-subtitle"
                                 FontSize="12"/>
                    </StackPanel>
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Right">
                      <Button x:Name="LanguagePickerButton"
                              Classes="sk-button settings-picker-button"
                              Command="{Binding ToggleLanguagePickerCommand}">
                        <Grid ColumnDefinitions="Auto,Auto"
                              HorizontalAlignment="Center">
                          <TextBlock Text="{Binding SelectedLanguageLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <PathIcon Grid.Column="1"
                                    Data="{StaticResource IconDropDown}"
                                    Width="16"
                                    Height="16"
                                    Margin="10,0,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    IsVisible="{Binding !IsLanguagePickerOpen}"/>
                          <PathIcon Grid.Column="1"
                                    Data="{StaticResource IconDropUp}"
                                    Width="16"
                                    Height="16"
                                    Margin="10,0,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    IsVisible="{Binding IsLanguagePickerOpen}"/>
                        </Grid>
                      </Button>

                      <Popup IsOpen="{Binding IsLanguagePickerOpen, Mode=TwoWay}"
                             PlacementTarget="{Binding #LanguagePickerButton}"
                             Placement="BottomEdgeAlignedLeft"
                             PlacementConstraintAdjustment="SlideX"
                             VerticalOffset="4"
                             IsLightDismissEnabled="True">
                        <Border Classes="settings-picker-popup"
                                MinWidth="104">
                          <ItemsControl ItemsSource="{Binding LanguageOptions}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Classes="sk-picker-option"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding #Root.DataContext.SelectLanguageCommand}"
                                        CommandParameter="{Binding}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Popup>
                    </Grid>
                  </Grid>
                </Border>

                <Border Classes="settings-toggle-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <StackPanel Spacing="3"
                                VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Loc.Settings.CloseToTray.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Loc.Settings.CloseToTray.Description}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Content="{DynamicResource Loc.Settings.CloseToTray.Toggle}"
                              IsChecked="{Binding CloseToTrayEnabled}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="1"
                      Spacing="14">
            <Border Classes="settings-block">
              <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <TextBlock Text="{DynamicResource Loc.Settings.VaultManagement}"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-vault-card">
                  <StackPanel Spacing="14">
                    <Grid>
                      <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Loc.Settings.PrimaryDatabase}"
                                   Classes="settings-mini-label"/>
                        <TextBlock Text="{Binding ActiveVaultDisplay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <Border Background="{StaticResource AccentMutedBrush}"
                              CornerRadius="999"
                              Padding="10,4">
                        <TextBlock Text="{DynamicResource Loc.Settings.Encrypted}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="10"
                                   FontWeight="Black"/>
                      </Border>
                      <Border Background="{StaticResource SurfaceElevatedBrush}"
                              CornerRadius="999"
                              Padding="10,4">
                        <TextBlock Text="{Binding EncryptionDisplay, FallbackValue=AES-256}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   FontWeight="Black"/>
                      </Border>
                    </StackPanel>

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding VaultStoragePercent}"
                                 Height="6"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource AppBackgroundSoftBrush}"/>
                    <TextBlock Text="{Binding VaultStorageDisplay}"
                               Classes="page-subtitle"
                               FontSize="12"/>
                  </StackPanel>
                </Border>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource Loc.Settings.BackupCenter.Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Loc.Settings.BackupCenter.Description}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Loc.Settings.Button.OpenBackupCenter}"
                            Classes="sk-primary"
                            Command="{Binding OpenBackupCenterCommand}"/>
                  </Grid>
                </Border>

              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

      </StackPanel>
    </ScrollViewer>

    <shared:ModalShell IsOpen="{Binding IsDestroyVaultModalOpen}"
                       Title="{Binding DestroyVaultModalTitle}"
                       Subtitle="{Binding DestroyVaultModalSubtitle}"
                       Error="{Binding DestroyVaultError}"
                       FooterText="{Binding DestroyVaultFooterText}"
                       DialogWidth="640"
                       CloseCommand="{Binding CancelDestroyVaultCommand}">
      <shared:ModalShell.Body>
        <Grid RowDefinitions="Auto,Auto">
          <Border Background="{StaticResource SurfaceBrush}"
                  CornerRadius="10"
                  Padding="16"
                  IsVisible="{Binding IsDestroyVaultWarningStep}">
            <TextBlock Text="{Binding DestroyVaultWarningText}"
                       Classes="page-subtitle"
                       FontSize="13"
                       LineHeight="19"
                       TextWrapping="Wrap"/>
          </Border>

          <StackPanel Grid.Row="1"
                      Spacing="8"
                      IsVisible="{Binding IsDestroyVaultPasswordStep}">
            <TextBlock Text="{Binding DestroyVaultPasswordLabel}"
                       Classes="modal-shell-label"/>
            <TextBox Text="{Binding DestroyVaultPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="modal-shell-input"
                     PasswordChar="*"
                     PlaceholderText="{Binding DestroyVaultPasswordPlaceholder}"/>
          </StackPanel>
        </Grid>
      </shared:ModalShell.Body>
      <shared:ModalShell.FooterActions>
        <Grid ColumnDefinitions="Auto,Auto"
              ColumnSpacing="12">
          <Button Grid.Column="0"
                  Content="{DynamicResource Loc.Common.Cancel}"
                  Classes="modal-shell-secondary-button"
                  Command="{Binding CancelDestroyVaultCommand}"/>
          <Button Grid.Column="1"
                  Content="{DynamicResource Loc.Settings.DestroyVault.Continue}"
                  Classes="modal-shell-danger-button"
                  IsVisible="{Binding IsDestroyVaultWarningStep}"
                  Command="{Binding ContinueDestroyVaultCommand}"/>
          <Button Grid.Column="1"
                  Content="{DynamicResource Loc.Settings.DestroyVault.Delete}"
                  Classes="modal-shell-danger-button"
                  IsVisible="{Binding IsDestroyVaultPasswordStep}"
                  Command="{Binding ConfirmDestroyVaultCommand}"/>
        </Grid>
      </shared:ModalShell.FooterActions>
    </shared:ModalShell>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.settings-block">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="Border.settings-field-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="Border.settings-toggle-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="TextBlock.settings-mini-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="Border.settings-picker-popup">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="Button.settings-picker-button">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="Border.settings-vault-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

  </UserControl.Styles>
</UserControl>
