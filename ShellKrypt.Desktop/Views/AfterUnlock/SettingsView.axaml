<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             xmlns:vaulting="using:ShellKrypt.Core.Vaulting"
             x:Class="ShellKrypt.Desktop.Views.SettingsView"
             x:CompileBindings="False"
             x:DataType="vm:SettingsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,24,28,28"
                  MaxWidth="1500"
                  Spacing="24">
        <StackPanel Spacing="6">
          <TextBlock Text="Vault Configuration"
                     FontSize="30"
                     FontWeight="SemiBold"
                     LetterSpacing="-0.6"/>
          <TextBlock Text="Manage security protocols and system preferences."
                     Classes="page-subtitle"/>
        </StackPanel>

        <Grid ColumnDefinitions="7*,5*"
              ColumnSpacing="22">
          <StackPanel Spacing="22">
            <Border Classes="settings-block">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="#1A4F47">
                    <TextBlock Text="S"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SuccessBrush}"
                               FontWeight="Black"/>
                  </Border>
                  <TextBlock Text="Security"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Auto-lock vault after inactivity"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SecurityStatusText}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="170"
                              ItemsSource="{Binding AutoLockDurations}"
                              SelectedItem="{Binding SelectedAutoLockDuration}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Auto-lock when app is not focused"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding FocusLockSummary}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="170"
                              ItemsSource="{Binding FocusLossLockDelayOptions}"
                              SelectedItem="{Binding SelectedFocusLossLockDelay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Clear clipboard after timeout"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="Automatically purges copied secrets from the OS clipboard."
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding ClipboardClearSummary}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Opacity="0.82"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="170"
                              ItemsSource="{Binding ClipboardClearTimeoutOptions}"
                              SelectedItem="{Binding SelectedClipboardClearDuration}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="14">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Change master password"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecoveryGuidanceText}"
                                   Classes="page-subtitle"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <Border Grid.Column="1"
                              Background="{StaticResource SurfaceRaisedBrush}"
                              CornerRadius="999"
                              Padding="12,6"
                              VerticalAlignment="Top">
                        <TextBlock Text="{Binding ActiveSecurityProfileLabel}"
                                   Classes="settings-mini-label"/>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                      <StackPanel Spacing="8">
                        <TextBlock Text="CURRENT PASSWORD"
                                   Classes="settings-mini-label"/>
                        <TextBox Text="{Binding CurrentMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="Enter the current master password"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Spacing="8">
                        <TextBlock Text="SECURITY PROFILE"
                                   Classes="settings-mini-label"/>
                        <ComboBox ItemsSource="{Binding SecurityProfiles}"
                                  SelectedItem="{Binding SelectedSecurityProfile}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                      <StackPanel Spacing="8">
                        <TextBlock Text="NEW PASSWORD"
                                   Classes="settings-mini-label"/>
                        <TextBox Text="{Binding NewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="Use a strong passphrase or long secret"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Spacing="8">
                        <TextBlock Text="CONFIRM NEW PASSWORD"
                                   Classes="settings-mini-label"/>
                        <TextBox Text="{Binding ConfirmNewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="*"
                                 PlaceholderText="Re-enter the new master password"/>
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding PasswordPolicyGuidance}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedSecurityProfileDescription}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Opacity="0.82"/>
                    <TextBlock Text="{Binding MasterPasswordStatus}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               IsVisible="{Binding HasMasterPasswordStatus}"/>

                    <Button Content="Change Master Password"
                            Classes="settings-primary-button"
                            Command="{Binding ChangeMasterPasswordCommand}"
                            HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settings-block">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource SurfaceElevatedBrush}">
                    <TextBlock Text="G"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontWeight="Black"/>
                  </Border>
                  <TextBlock Text="General"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-toggle-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <TextBlock Text="Theme Mode"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              Width="110"
                              ItemsSource="{Binding ThemeModes}"
                              SelectedItem="{Binding SelectedThemeMode}"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Spacing="22">
            <Border Classes="settings-block">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                  <Border Width="36"
                          Height="36"
                          CornerRadius="10"
                          Background="{StaticResource SurfaceElevatedBrush}">
                    <TextBlock Text="V"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontWeight="Black"/>
                  </Border>
                  <TextBlock Text="Vault Management"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Border Classes="settings-vault-card">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                      <Border Width="48"
                              Height="48"
                              CornerRadius="12"
                              Background="{StaticResource AppBackgroundSoftBrush}">
                        <TextBlock Text="DB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Black"/>
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Spacing="4">
                        <TextBlock Text="PRIMARY DATABASE"
                                   Classes="settings-mini-label"/>
                        <TextBlock Text="{Binding ActiveVaultDisplay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <Border Background="#1A4F47"
                              CornerRadius="999"
                              Padding="10,4">
                        <TextBlock Text="ENCRYPTED"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="10"
                                   FontWeight="Black"/>
                      </Border>
                      <Border Background="{StaticResource SurfaceElevatedBrush}"
                              CornerRadius="999"
                              Padding="10,4">
                        <TextBlock Text="{Binding EncryptionDisplay, FallbackValue=AES-256}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   FontWeight="Black"/>
                      </Border>
                    </StackPanel>

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding VaultStoragePercent}"
                                 Height="6"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource AppBackgroundSoftBrush}"/>
                    <TextBlock Text="{Binding VaultStorageDisplay}"
                               Classes="page-subtitle"
                               FontSize="12"/>
                  </StackPanel>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="14">
                    <TextBlock Text="BACKUP AND RECOVERY"
                               Classes="settings-mini-label"/>
                    <TextBlock Text="{Binding BackupRecommendationText}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <StackPanel Spacing="8">
                      <TextBlock Text="ENCRYPTED BACKUP PATH"
                                 Classes="settings-mini-label"/>
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <TextBox Text="{Binding EncryptedExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Choose where to store the encrypted backup"/>
                        <Button Grid.Column="1"
                                Content="Browse"
                                Classes="settings-secondary-button"
                                Command="{Binding BrowseEncryptedExportPathCommand}"/>
                      </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="BACKUP PASSPHRASE"
                                 Classes="settings-mini-label"/>
                      <TextBox Text="{Binding ExportPassphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PasswordChar="*"
                               PlaceholderText="Use a separate passphrase for the .skbx backup"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="10">
                      <Button Content="Preview Backup"
                              Classes="settings-transfer-button"
                              Command="{Binding PreviewExportCommand}"/>
                      <Button Grid.Column="1"
                              Content="Export Backup"
                              Classes="settings-primary-button"
                              Command="{Binding ExportEncryptedCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding ExportSummary}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="14">
                    <TextBlock Text="RESTORE ENCRYPTED BACKUP"
                               Classes="settings-mini-label"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <TextBox Text="{Binding EncryptedImportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Select an encrypted .skbx backup"/>
                      <Button Grid.Column="1"
                              Content="Browse"
                              Classes="settings-secondary-button"
                              Command="{Binding BrowseEncryptedImportPathCommand}"/>
                    </Grid>

                    <TextBox Text="{Binding EncryptedImportPassphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PasswordChar="*"
                             PlaceholderText="Enter the backup passphrase"/>

                    <Grid ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="10">
                      <Button Content="Preview Restore"
                              Classes="settings-transfer-button"
                              Command="{Binding PreviewEncryptedImportCommand}"/>
                      <Button Grid.Column="1"
                              Content="Restore Backup"
                              Classes="settings-transfer-button"
                              Command="{Binding ImportEncryptedCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding EncryptedImportSummary}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <Border Classes="settings-field-shell">
                  <StackPanel Spacing="14">
                    <TextBlock Text="ADVANCED IMPORT OR EXPORT"
                               Classes="settings-mini-label"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <TextBox Text="{Binding CsvImportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Select a CSV file for bulk import"/>
                      <Button Grid.Column="1"
                              Content="Browse CSV"
                              Classes="settings-secondary-button"
                              Command="{Binding BrowseCsvImportPathCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="10">
                      <Button Content="Preview CSV"
                              Classes="settings-transfer-button"
                              Command="{Binding PreviewCsvImportCommand}"/>
                      <Button Grid.Column="1"
                              Content="Import CSV"
                              Classes="settings-transfer-button"
                              Command="{Binding ImportCsvCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <TextBox Text="{Binding PlaintextExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Choose where to save the plaintext JSON export"/>
                      <Button Grid.Column="1"
                              Content="Browse JSON"
                              Classes="settings-secondary-button"
                              Command="{Binding BrowsePlaintextExportPathCommand}"/>
                    </Grid>
                    <CheckBox Content="I understand plaintext JSON exports are not encrypted."
                              IsChecked="{Binding ConfirmPlaintextExport}"/>
                    <Button Content="Export Plaintext JSON"
                            Classes="settings-danger-link"
                            Command="{Binding ExportPlaintextCommand}"/>

                    <TextBlock Text="{Binding CsvPreviewSummary}"
                               Classes="page-subtitle"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasCsvPreview}"/>
                  </StackPanel>
                </Border>

                <Button Content="Destroy All Vault Data"
                        Classes="settings-danger-link"
                        Command="{Binding DestroyVaultCommand}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Border Classes="settings-integrity-card">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="24">
            <Border Width="136"
                    Height="136"
                    CornerRadius="18"
                    ClipToBounds="True">
              <Image Source="avares://ShellKrypt.Desktop/Assets/settings-integrity-chip.png"
                     Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="10"
                        VerticalAlignment="Center">
              <TextBlock Text="Architectural Integrity"
                         FontSize="24"
                         FontWeight="Bold"/>
              <TextBlock Text="{Binding IntegrityStatusText}"
                         Classes="page-subtitle"
                         TextWrapping="Wrap"
                         MaxWidth="780"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="14">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                  <Border Width="7" Height="7" CornerRadius="999" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="E2E READY" Classes="settings-mini-label"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                  <Border Width="7" Height="7" CornerRadius="999" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="LOCAL ONLY" Classes="settings-mini-label"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="View Audit Log"
                    Classes="settings-secondary-button"
                    Command="{Binding ViewAuditCommand}"
                    VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <TextBlock Text="{Binding TransferStatus}"
                   Classes="page-subtitle"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.settings-block">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <Style Selector="Border.settings-field-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="Border.settings-toggle-shell">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="TextBlock.settings-mini-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="Button.settings-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.settings-secondary-button">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.settings-vault-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="Button.settings-transfer-button">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.settings-danger-link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.settings-integrity-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
  </UserControl.Styles>
</UserControl>
