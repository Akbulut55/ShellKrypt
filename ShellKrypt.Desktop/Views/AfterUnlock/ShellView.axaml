<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Name="Root"
             x:Class="ShellKrypt.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">

  <Grid Background="{StaticResource AppBackgroundBrush}"
        ColumnDefinitions="Auto,*">
    <Border Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource WindowOutlineBrush}"
            BorderThickness="0,0,1,0"
            Width="{Binding SidebarWidth}"
            Padding="12,22,12,18">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="10"
              IsVisible="{Binding IsSidebarExpanded}">
          <TextBlock Text="ShellKrypt"
                     FontSize="18"
                     FontWeight="Black"
                     Foreground="{StaticResource AccentBrush}"
                     VerticalAlignment="Center"/>

          <Button Grid.Column="1"
                  Classes="shell-sidebar-toggle"
                  Command="{Binding ToggleSidebarCommand}"
                  ToolTip.Tip="{Binding SidebarToggleToolTip}">
            <Grid Classes="shell-sidebar-icon"
                  Width="15"
                  Height="14">
              <Border BorderBrush="{StaticResource AccentBrush}"
                      BorderThickness="1"
                      CornerRadius="3"/>
              <Border Width="1"
                      Margin="5,3,0,3"
                      HorizontalAlignment="Left"
                      Background="{StaticResource AccentBrush}"/>
            </Grid>
          </Button>
        </Grid>

        <Button Classes="shell-collapsed-logo-button"
                Command="{Binding ToggleSidebarCommand}"
                HorizontalAlignment="Center"
                IsVisible="{Binding IsSidebarCollapsed}"
                ToolTip.Tip="{Binding SidebarToggleToolTip}">
          <Grid>
            <TextBlock Text="SK"
                       Classes="shell-collapsed-logo-mark"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="Black"
                       Foreground="{StaticResource AccentBrush}"/>
            <Grid Classes="shell-collapsed-open-icon shell-sidebar-icon"
                  Width="15"
                  Height="14"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <Border BorderBrush="{StaticResource AccentBrush}"
                      BorderThickness="1"
                      CornerRadius="3"/>
              <Border Width="1"
                      Margin="5,3,0,3"
                      HorizontalAlignment="Left"
                      Background="{StaticResource AccentBrush}"/>
            </Grid>
          </Grid>
        </Button>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Margin="0,18,0,12">
          <TextBlock Text="{DynamicResource Loc.Shell.Sections}"
                     FontSize="11"
                     FontWeight="Black"
                     LetterSpacing="2.4"
                     Foreground="{StaticResource TextMutedBrush}"
                     IsVisible="{Binding IsSidebarExpanded}"/>

          <ScrollViewer Grid.Row="1"
                        Margin="0,12,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Grid>
              <ItemsControl ItemsSource="{Binding NavItems}"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsSidebarExpanded}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavItemVm">
                    <Button Classes="shell-nav-button"
                            Command="{Binding #Root.DataContext.SelectSectionCommand}"
                            CommandParameter="{Binding}">
                      <Border Classes="shell-nav-item"
                              Classes.active="{Binding IsSelected}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                          <Border Width="28"
                                  Height="28"
                                  CornerRadius="8"
                                  Background="{StaticResource SurfaceElevatedBrush}">
                            <TextBlock Text="{Binding ShortCode}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="9"
                                       FontWeight="Black"
                                       Foreground="{StaticResource AccentBrush}"/>
                          </Border>

                          <TextBlock Grid.Column="1"
                                     Text="{Binding Title}"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding NavItems}"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsSidebarCollapsed}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavItemVm">
                    <Button Classes="shell-nav-button collapsed"
                            Command="{Binding #Root.DataContext.SelectSectionCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Title}">
                      <Border Classes="shell-nav-item collapsed"
                              Classes.active="{Binding IsSelected}">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="8"
                                Background="{StaticResource SurfaceElevatedBrush}">
                          <TextBlock Text="{Binding ShortCode}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="9"
                                     FontWeight="Black"
                                     Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="14" IsVisible="{Binding IsSidebarExpanded}">
          <Button Content="{DynamicResource Loc.Shell.LockVault}"
                  Classes="primary"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Command="{Binding LockCommand}"/>

          <Border Classes="shell-vault-profile-card">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
              <Border Width="36"
                      Height="36"
                      CornerRadius="10"
                      Background="{StaticResource SurfaceElevatedBrush}"
                      VerticalAlignment="Top">
                <TextBlock Text="{Binding VaultMonogram}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Black"
                           Foreground="{StaticResource AccentBrush}"/>
              </Border>

              <StackPanel Grid.Column="1"
                          Spacing="2">
                <TextBlock Text="{Binding VaultFooterLabel}"
                           Classes="shell-vault-profile-kicker"/>
                <TextBlock Text="{Binding VaultName}"
                           FontSize="13"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding VaultSubtitle}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Spacing="12"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsSidebarCollapsed}">
          <Button Content="L"
                  Classes="primary shell-lock-collapsed"
                  Command="{Binding LockCommand}"
                  ToolTip.Tip="{DynamicResource Loc.Shell.LockVault}"/>

          <Border Classes="shell-vault-profile-card collapsed"
                  ToolTip.Tip="{Binding VaultName}">
            <TextBlock Text="{Binding VaultMonogram}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="Black"
                       Foreground="{StaticResource AccentBrush}"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Background="{StaticResource AppBackgroundBrush}">
      <ContentControl Content="{Binding CurrentPage}"/>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.shell-nav-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style Selector="Button.shell-nav-button.collapsed">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pressed">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Border.shell-nav-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,9"/>
    </Style>

    <Style Selector="Border.shell-nav-item.collapsed">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pointerover Border.shell-nav-item">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    </Style>

    <Style Selector="Border.shell-nav-item.active">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pointerover Border.shell-nav-item.active">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.shell-vault-profile-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style Selector="Border.shell-vault-profile-card.collapsed">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.shell-sidebar-toggle">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.shell-sidebar-toggle:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Grid.shell-collapsed-open-icon">
      <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="Button.shell-collapsed-logo-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.shell-collapsed-logo-button:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.shell-collapsed-logo-button:pointerover TextBlock.shell-collapsed-logo-mark">
      <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="Button.shell-collapsed-logo-button:pointerover Grid.shell-collapsed-open-icon">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.shell-lock-collapsed">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.shell-vault-profile-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="1.8"/>
    </Style>

    <Style Selector="TextBlock.shell-vault-profile-meta">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>
</UserControl>
