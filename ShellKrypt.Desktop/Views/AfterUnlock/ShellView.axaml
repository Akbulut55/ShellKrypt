<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Name="Root"
             x:Class="ShellKrypt.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">

  <Grid Background="{StaticResource AppBackgroundBrush}"
        ColumnDefinitions="Auto,*">
    <Border Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource WindowOutlineBrush}"
            BorderThickness="0,0,1,0"
            Width="{Binding SidebarWidth}"
            Padding="12,22,12,18">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="10"
              IsVisible="{Binding IsSidebarExpanded}">
          <TextBlock Text="ShellKrypt"
                     FontSize="18"
                     FontWeight="Black"
                     Foreground="{StaticResource AccentBrush}"
                     VerticalAlignment="Center"/>

          <Button Grid.Column="1"
                  Classes="shell-sidebar-toggle"
                  Command="{Binding ToggleSidebarCommand}"
                  ToolTip.Tip="{Binding SidebarToggleToolTip}">
            <Path Classes="material-icon accent shell-sidebar-icon"
                  Width="18"
                  Height="18"
                  Data="{StaticResource IconLeftPanelClose}"/>
          </Button>
        </Grid>

        <Button Classes="shell-collapsed-logo-button"
                Command="{Binding ToggleSidebarCommand}"
                HorizontalAlignment="Center"
                IsVisible="{Binding IsSidebarCollapsed}"
                ToolTip.Tip="{Binding SidebarToggleToolTip}">
          <Grid>
            <Path Classes="shell-collapsed-logo-mark"
                  Width="24"
                  Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stretch="Uniform"
                  Fill="{StaticResource AccentBrush}"
                  Data="{StaticResource IconShellKryptLogo}"/>
            <Path Classes="material-icon accent shell-collapsed-open-icon"
                  Width="18"
                  Height="18"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="{StaticResource IconLeftPanelOpen}"/>
          </Grid>
        </Button>

        <Grid Grid.Row="1"
              RowDefinitions="*"
              Margin="0,18,0,12">
          <ScrollViewer
                        Margin="0,0,-12,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,12,0">
              <ItemsControl ItemsSource="{Binding NavGroups}"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsSidebarExpanded}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavGroupVm">
                    <StackPanel Spacing="6"
                                Margin="0,0,0,12">
                      <TextBlock Text="{Binding Title}"
                                 Classes="shell-nav-group-label"/>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NavItemVm">
                            <Button Classes="shell-nav-button"
                                    Command="{Binding #Root.DataContext.SelectSectionCommand}"
                                    CommandParameter="{Binding}">
                              <Border Classes="shell-nav-item"
                                      Classes.active="{Binding IsSelected}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                  <Border Classes="shell-nav-icon-tile"
                                          Classes.active="{Binding IsSelected}">
                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                      <Viewbox Width="18"
                                               Height="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding HasIcon}">
                                        <Canvas Width="960" Height="960">
                                          <Path Fill="{StaticResource AccentBrush}"
                                                Data="{Binding IconResourceKey, Converter={StaticResource ThemeResourceGeometryConverter}}">
                                            <Path.RenderTransform>
                                              <TranslateTransform Y="960"/>
                                            </Path.RenderTransform>
                                          </Path>
                                        </Canvas>
                                      </Viewbox>
                                      <TextBlock Text="{Binding ShortCode}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 FontSize="9"
                                                 FontWeight="Black"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 IsVisible="{Binding !HasIcon}"/>
                                    </Grid>
                                  </Border>

                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Title}"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             VerticalAlignment="Center"/>
                                </Grid>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding VisibleNavItems}"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsSidebarCollapsed}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavItemVm">
                    <Button Classes="shell-nav-button collapsed"
                            Command="{Binding #Root.DataContext.SelectSectionCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Title}">
                      <Border Classes="shell-nav-icon-tile collapsed"
                              Classes.active="{Binding IsSelected}">
                        <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                          <Viewbox Width="20"
                                   Height="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasIcon}">
                            <Canvas Width="960" Height="960">
                              <Path Fill="{StaticResource AccentBrush}"
                                    Data="{Binding IconResourceKey, Converter={StaticResource ThemeResourceGeometryConverter}}">
                                <Path.RenderTransform>
                                  <TranslateTransform Y="960"/>
                                </Path.RenderTransform>
                              </Path>
                            </Canvas>
                          </Viewbox>
                          <TextBlock Text="{Binding ShortCode}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="9"
                                     FontWeight="Black"
                                     Foreground="{StaticResource AccentBrush}"
                                     IsVisible="{Binding !HasIcon}"/>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="14" IsVisible="{Binding IsSidebarExpanded}">
          <Button Classes="primary"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Command="{Binding LockCommand}">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <Path Classes="material-icon on-primary"
                    Width="16"
                    Height="16"
                    Data="{StaticResource IconLock}"/>
              <TextBlock Text="{DynamicResource Loc.Shell.LockVault}"
                         Foreground="{StaticResource AccentForegroundBrush}"
                         FontWeight="SemiBold"/>
            </StackPanel>
          </Button>

          <Border Classes="shell-vault-profile-card">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
              <Border Width="40"
                      Height="40"
                      CornerRadius="10"
                      Background="{StaticResource SurfaceElevatedBrush}"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding VaultMonogram}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Black"
                           Foreground="{StaticResource AccentBrush}"/>
              </Border>

              <Grid Grid.Column="1"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                <TextBlock Text="{Binding VaultFooterLabel}"
                           Classes="shell-vault-profile-kicker"/>
                <Button Grid.Column="1"
                        Grid.RowSpan="3"
                        Classes="shell-settings-button"
                        Classes.active="{Binding IsSettingsSelected}"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{Binding SettingsNavItem}"
                        ToolTip.Tip="{DynamicResource Loc.Sidebar.settings.Title}">
                  <Path Classes="material-icon accent"
                        Width="20"
                        Height="20"
                        Data="{StaticResource IconSettings}"
                        Stretch="Uniform"/>
                </Button>
                <TextBlock Grid.Row="1"
                           Text="{Binding VaultName}"
                           FontSize="13"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding VaultSubtitle}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Spacing="12"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsSidebarCollapsed}">
          <Button Classes="primary shell-lock-collapsed"
                  Command="{Binding LockCommand}"
                  ToolTip.Tip="{DynamicResource Loc.Shell.LockVault}">
            <Viewbox Width="20"
                     Height="20"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
              <Canvas Width="960" Height="960">
                <Path Fill="{StaticResource AccentForegroundBrush}"
                      Data="{StaticResource IconLock}">
                  <Path.RenderTransform>
                    <TranslateTransform Y="960"/>
                  </Path.RenderTransform>
                </Path>
              </Canvas>
            </Viewbox>
          </Button>

          <Button Classes="shell-settings-button collapsed"
                  Classes.active="{Binding IsSettingsSelected}"
                  Command="{Binding SelectSectionCommand}"
                  CommandParameter="{Binding SettingsNavItem}"
                  ToolTip.Tip="{DynamicResource Loc.Sidebar.settings.Title}">
            <Path Classes="material-icon accent"
                  Width="20"
                  Height="20"
                  Data="{StaticResource IconSettings}"
                  Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Background="{StaticResource AppBackgroundBrush}">
      <ContentControl Content="{Binding CurrentPage}"/>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.shell-nav-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style Selector="TextBlock.shell-nav-group-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.0"/>
      <Setter Property="Margin" Value="6,2,0,2"/>
    </Style>

    <Style Selector="Button.shell-nav-button.collapsed">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="MaxWidth" Value="44"/>
      <Setter Property="MaxHeight" Value="44"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Button.shell-nav-button.collapsed:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.shell-nav-button.collapsed:pressed">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.shell-nav-button.collapsed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Button.shell-nav-button.collapsed:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.shell-nav-button.collapsed:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pressed">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Border.shell-nav-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,9"/>
    </Style>

    <Style Selector="Border.shell-nav-icon-tile">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="Border.shell-nav-icon-tile.collapsed">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pointerover Border.shell-nav-item">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    </Style>

    <Style Selector="Border.shell-nav-item.active">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pointerover Border.shell-nav-item.active">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.shell-nav-icon-tile.active">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pointerover Border.shell-nav-icon-tile">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    </Style>

    <Style Selector="Button.shell-nav-button:pointerover Border.shell-nav-icon-tile.active">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.shell-vault-profile-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style Selector="Border.shell-vault-profile-card.collapsed">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.shell-settings-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.shell-settings-button:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.shell-settings-button.active">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.shell-settings-button.collapsed">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.shell-sidebar-toggle">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.shell-sidebar-toggle:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Path.shell-collapsed-open-icon">
      <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="Button.shell-collapsed-logo-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.shell-collapsed-logo-button:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.shell-collapsed-logo-button:pointerover Path.shell-collapsed-logo-mark">
      <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="Button.shell-collapsed-logo-button:pointerover Path.shell-collapsed-open-icon">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.shell-lock-collapsed">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.shell-vault-profile-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="1.8"/>
    </Style>

    <Style Selector="TextBlock.shell-vault-profile-meta">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>
</UserControl>
