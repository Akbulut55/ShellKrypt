<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.ApiKeysView"
             x:CompileBindings="False"
             x:DataType="vm:ApiKeysViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32"
                  MaxWidth="1500"
                  HorizontalAlignment="Stretch"
                  Spacing="22">

        <TextBlock Text="API Keys"
                   Margin="0,10,0,-4"
                   FontSize="28"
                   FontWeight="SemiBold"
                   LetterSpacing="-0.8"/>

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="18">
          <Border Classes="api-stat">
            <StackPanel Spacing="8">
              <TextBlock Text="TOTAL KEYS"
                         Classes="api-kicker"/>
              <TextBlock Text="{Binding TotalCount}"
                         FontSize="24"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Encrypted API records in this vault"
                         Classes="api-accent-note"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="api-stat">
            <StackPanel Spacing="8">
              <TextBlock Text="PROVIDERS"
                         Classes="api-kicker"/>
              <TextBlock Text="{Binding ProviderCount}"
                         FontSize="24"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Unique services and platforms"
                         Classes="api-muted-note"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  Classes="api-stat">
            <StackPanel Spacing="8">
              <TextBlock Text="SENSITIVE FIELDS"
                         Classes="api-kicker"/>
              <TextBlock Text="{Binding SensitiveFieldCount}"
                         FontSize="24"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="Masked until revealed"
                         Classes="api-muted-note"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="api-filter-shell">
          <WrapPanel Orientation="Horizontal"
                     VerticalAlignment="Center">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="api-search"
                     PlaceholderText="Search by name, provider, field, or environment..."
                     VerticalAlignment="Center"/>
            <ComboBox Classes="api-select"
                      ItemsSource="{Binding EnvironmentFilters}"
                      SelectedItem="{Binding SelectedEnvironmentFilter, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="api-select"
                      ItemsSource="{Binding ProviderFilters}"
                      SelectedItem="{Binding SelectedProviderFilter, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="api-select"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <Button Content="+ Add API Key"
                    Classes="api-add-button"
                    Command="{Binding AddNewCommand}"
                    VerticalAlignment="Center"/>
          </WrapPanel>
        </Border>

        <Border Classes="table-shell"
                MinWidth="1080"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Classes="table-header-row">
              <Grid ColumnDefinitions="1.35*,1.05*,0.95*,1.25*,0.9*,250"
                    ColumnSpacing="18">
                <TextBlock Text="KEY IDENTITY"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="1"
                           Text="PROVIDER"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="2"
                           Text="ENVIRONMENT"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="3"
                           Text="PRIMARY FIELD"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="4"
                           Text="UPDATED"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="5"
                           Text="ACTIONS"
                           Classes="table-header-text"
                           HorizontalAlignment="Right"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1"
                  MinHeight="390">
              <ItemsControl ItemsSource="{Binding Rows}"
                            IsVisible="{Binding HasRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ApiKeyRowVm">
                    <Border Classes="table-row">
                      <Grid ColumnDefinitions="1.35*,1.05*,0.95*,1.25*,0.9*,250"
                            ColumnSpacing="18"
                            Margin="22,0"
                            MinHeight="78">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              VerticalAlignment="Center">
                          <Border Width="34"
                                  Height="34"
                                  CornerRadius="4"
                                  Background="{StaticResource SurfaceElevatedBrush}">
                            <Grid>
                              <Border Width="24"
                                      Height="24"
                                      CornerRadius="2"
                                      Background="{StaticResource AppBackgroundSoftBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Monogram}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="11"
                                         FontWeight="Black"
                                         Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="4"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FieldCountDisplay}"
                                       Classes="api-row-subtitle"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProviderDisplay}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Column="2"
                                Classes="api-env-chip"
                                Padding="9,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding EnvironmentDisplay}"
                                     FontSize="11"
                                     FontWeight="Black"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <StackPanel Grid.Column="3"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding PrimaryFieldLabel}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding PrimaryFieldDisplay}"
                                     Classes="api-secret"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding UpdatedDisplay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                          <Button Content="Details"
                                  Classes="table-action-button"
                                  Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="Copy Secret"
                                  Classes="table-action-button"
                                  Command="{Binding DataContext.CopyPrimarySecretCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Classes="table-empty"
                          IsVisible="{Binding !HasRows}">
                <TextBlock Text="{Binding EmptyTitle}"
                           Classes="table-empty-title"/>
                <TextBlock Text="{Binding EmptySubtitle}"
                           Classes="table-empty-subtitle"/>
              </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Classes="table-footer-row">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                    ColumnSpacing="10">
                <TextBlock Text="{Binding ItemsSummary}"
                           Classes="table-footer-text"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Previous"
                        Classes="table-page-button"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPreviousPage}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding PageSummary}"
                           Classes="table-footer-text"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="3"
                        Content="Next"
                        Classes="table-page-button"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNextPage}"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Background="{StaticResource OverlayScrimBrush}"
            IsVisible="{Binding IsApiKeyModalOpen}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Grid>
        <Border Classes="api-modal-card"
                Width="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28">
          <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding ApiKeyModalTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           LetterSpacing="-0.4"/>
                <TextBlock Text="{Binding ApiKeyModalSubtitle}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="X"
                      Classes="api-modal-close-button"
                      Command="{Binding CancelApiKeyModalCommand}"
                      ToolTip.Tip="Close"/>
            </Grid>

            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="1.2*,1.05*,0.85*"
                  RowSpacing="14"
                  ColumnSpacing="16">
              <StackPanel Spacing="7">
                <TextBlock Text="NAME"
                           Classes="api-modal-label"/>
                <TextBox Text="{Binding AddName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="api-modal-input"
                         IsReadOnly="{Binding IsApiKeyFormReadOnly}"
                         PlaceholderText="Stripe production key"/>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="PROVIDER"
                           Classes="api-modal-label"/>
                <TextBox Text="{Binding AddProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="api-modal-input"
                         IsReadOnly="{Binding IsApiKeyFormReadOnly}"
                         PlaceholderText="Stripe"/>
              </StackPanel>

              <StackPanel Grid.Column="2"
                          Spacing="7">
                <TextBlock Text="ENVIRONMENT"
                           Classes="api-modal-label"/>
                <ComboBox ItemsSource="{Binding EnvironmentOptions}"
                          SelectedItem="{Binding AddEnvironment, Mode=TwoWay}"
                          IsEnabled="{Binding IsApiKeyFormEditable}"
                          Classes="api-modal-input"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.ColumnSpan="3"
                          Spacing="7">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <TextBlock Text="FIELDS"
                             Classes="api-modal-label"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="1"
                          Content="+ Add Field"
                          Classes="api-modal-small-button"
                          Command="{Binding AddFieldCommand}"
                          IsVisible="{Binding IsApiKeyFormEditable}"/>
                </Grid>

                <Border Classes="api-fields-shell">
                  <ScrollViewer MaxHeight="300"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FormFields}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApiKeyFieldRowVm">
                          <Border Classes="api-field-row"
                                  MinWidth="760">
                            <Grid ColumnDefinitions="1.15*,150,1.85*,Auto,Auto"
                                  ColumnSpacing="12"
                                  VerticalAlignment="Center">
                              <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Classes="api-modal-input compact"
                                       IsReadOnly="{Binding DataContext.IsApiKeyFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       PlaceholderText="Field label"
                                       VerticalAlignment="Center"/>

                              <ComboBox Grid.Column="1"
                                        Classes="api-modal-input compact"
                                        ItemsSource="{Binding DataContext.FieldTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedItem="{Binding FieldType, Mode=TwoWay}"
                                        IsEnabled="{Binding DataContext.IsApiKeyFormEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        VerticalAlignment="Center"/>

                              <Border Grid.Column="2"
                                      Classes="api-modal-input-shell"
                                      VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8"
                                      VerticalAlignment="Center">
                                  <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Classes="api-modal-input borderless"
                                           IsReadOnly="{Binding DataContext.IsApiKeyFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           PasswordChar="*"
                                           IsVisible="{Binding UseMaskedValueInput}"
                                           PlaceholderText="Secret value"
                                           VerticalAlignment="Center"/>
                                  <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Classes="api-modal-input borderless"
                                           IsReadOnly="{Binding DataContext.IsApiKeyFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           IsVisible="{Binding UsePlainValueInput}"
                                           PlaceholderText="Secret value"
                                           VerticalAlignment="Center"/>
                                  <Button Grid.Column="1"
                                          Content="{Binding VisibilityLabel}"
                                          Classes="api-modal-field-action"
                                          Command="{Binding DataContext.ToggleFieldVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"
                                          IsVisible="{Binding CanReveal}"/>
                                </Grid>
                              </Border>

                              <CheckBox Grid.Column="3"
                                        Content="Secret"
                                        Classes="api-check"
                                        IsChecked="{Binding IsSensitive, Mode=TwoWay}"
                                        IsEnabled="{Binding DataContext.IsApiKeyFormEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        VerticalAlignment="Center"/>

                              <Button Grid.Column="4"
                                      Content="X"
                                      Classes="api-modal-field-remove"
                                      Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding DataContext.IsApiKeyFormEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </StackPanel>

              <StackPanel Grid.Row="2"
                          Grid.ColumnSpan="3"
                          Spacing="7">
                <TextBlock Text="NOTES"
                           Classes="api-modal-label"/>
                <TextBox Text="{Binding AddNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="api-modal-input"
                         IsReadOnly="{Binding IsApiKeyFormReadOnly}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="82"
                         PlaceholderText="Rotation policy, service context, allowed scopes, or setup notes..."/>
              </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Error}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasError}"/>

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="-8,0,-8,-8">
              <Grid ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="{Binding ModalFooterText}"
                           Classes="page-subtitle"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="api-modal-secondary-button"
                        IsVisible="{Binding IsAddApiKeyMode}"
                        Command="{Binding CancelApiKeyModalCommand}"/>
                <Button Grid.Column="2"
                        Content="Add API Key"
                        Classes="api-modal-primary-button"
                        IsVisible="{Binding IsAddApiKeyMode}"
                        Command="{Binding SaveAddApiKeyCommand}"/>
                <Button Grid.Column="1"
                        Content="Delete"
                        Classes="api-modal-danger-button"
                        IsVisible="{Binding IsApiKeyDetailsViewMode}"
                        Command="{Binding BeginDetailsDeleteCommand}"/>
                <Button Grid.Column="2"
                        Content="Edit"
                        Classes="api-modal-primary-button"
                        IsVisible="{Binding IsApiKeyDetailsViewMode}"
                        Command="{Binding BeginDetailsEditCommand}"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="api-modal-secondary-button"
                        IsVisible="{Binding IsApiKeyDetailsEditMode}"
                        Command="{Binding CancelDetailsEditCommand}"/>
                <Button Grid.Column="2"
                        Content="Save"
                        Classes="api-modal-primary-button"
                        IsVisible="{Binding IsApiKeyDetailsEditMode}"
                        Command="{Binding SaveDetailsCommand}"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="api-modal-secondary-button"
                        IsVisible="{Binding IsApiKeyDetailsDeleteConfirmMode}"
                        Command="{Binding CancelDetailsDeleteCommand}"/>
                <Button Grid.Column="2"
                        Content="Delete"
                        Classes="api-modal-danger-button"
                        IsVisible="{Binding IsApiKeyDetailsDeleteConfirmMode}"
                        Command="{Binding ConfirmDetailsDeleteCommand}"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="TextBlock.api-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="TextBlock.api-accent-note">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.api-muted-note">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.api-stat">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="24,20"/>
      <Setter Property="MinHeight" Value="112"/>
    </Style>

    <Style Selector="Border.api-filter-shell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="TextBox.api-search">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Width" Value="360"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style Selector="ComboBox.api-select">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="140"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.api-add-button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Width" Value="154"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.api-add-button:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="TextBlock.api-row-subtitle">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="TextBlock.api-secret">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LetterSpacing" Value="1.8"/>
    </Style>

    <Style Selector="Border.api-env-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="Border.api-modal-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ModalBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="TextBlock.api-modal-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.1"/>
    </Style>

    <Style Selector="TextBox.api-modal-input">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style Selector="TextBox.api-modal-input.compact">
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="TextBox.api-modal-input:pointerover">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox.api-modal-input:focus">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="ComboBox.api-modal-input">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style Selector="ComboBox.api-modal-input.compact">
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style Selector="Border.api-modal-input-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Border.api-modal-input-shell:focus-within">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="TextBox.api-modal-input.borderless">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="TextBox.api-modal-input.borderless /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox.api-modal-input.borderless:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="TextBox.api-modal-input.borderless:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Border.api-fields-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10"/>
    </Style>

    <Style Selector="Border.api-field-row">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="CheckBox.api-check">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.api-modal-close-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
