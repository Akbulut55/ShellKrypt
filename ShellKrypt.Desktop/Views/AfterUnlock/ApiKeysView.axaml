<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:ShellKrypt.UI.Shared.Controls"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.ApiKeysView"
             x:CompileBindings="False"
             x:DataType="vm:ApiKeysViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16"
                  HorizontalAlignment="Stretch"
                  Spacing="14">

        <TextBlock Text="{DynamicResource Loc.ApiKeys.Title}"
                   Margin="0,10,0,-4"
                   FontSize="28"
                   FontWeight="SemiBold"
                   LetterSpacing="-0.8"/>

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="8">
          <Border Classes="api-stat">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.ApiKeys.TotalKeys}"
                         Classes="api-kicker"/>
              <TextBlock Text="{Binding TotalCount}"
                         FontSize="24"
                         FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource Loc.ApiKeys.Summary.Total}"
                         Classes="api-accent-note"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="api-stat">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.ApiKeys.Providers}"
                         Classes="api-kicker"/>
              <TextBlock Text="{Binding ProviderCount}"
                         FontSize="24"
                         FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource Loc.ApiKeys.Summary.Providers}"
                         Classes="api-muted-note"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  Classes="api-stat">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Loc.ApiKeys.SensitiveFields}"
                         Classes="api-kicker"/>
              <TextBlock Text="{Binding SensitiveFieldCount}"
                         FontSize="24"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="{DynamicResource Loc.ApiKeys.Summary.Sensitive}"
                         Classes="api-muted-note"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="api-filter-shell">
          <WrapPanel Orientation="Horizontal"
                     VerticalAlignment="Center">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="api-search"
                     PlaceholderText="{DynamicResource Loc.ApiKeys.Search.Placeholder}"
                     VerticalAlignment="Center"/>
            <ComboBox Classes="api-select"
                      ItemsSource="{Binding EnvironmentFilters}"
                      SelectedItem="{Binding SelectedEnvironmentFilter, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="api-select"
                      ItemsSource="{Binding ProviderFilters}"
                      SelectedItem="{Binding SelectedProviderFilter, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Classes="api-select"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <Button Classes="api-add-button"
                    Command="{Binding AddNewCommand}"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"
                          Spacing="7"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Loc.ApiKeys.Button.Add}"
                           Foreground="{StaticResource AccentForegroundBrush}"
                           FontWeight="SemiBold"/>
                <Path Classes="material-icon on-primary"
                      Width="15"
                      Height="15"
                      Data="{StaticResource IconAdd}"/>
              </StackPanel>
            </Button>
          </WrapPanel>
        </Border>

        <Border Classes="table-shell"
                MinWidth="610"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,390,Auto">
            <Border Classes="table-header-row">
              <Grid ColumnDefinitions="1.0*,0.62*,0.52*,0.78*,0.44*,152"
                    ColumnSpacing="8">
                <TextBlock Text="{DynamicResource Loc.ApiKeys.Table.Identity}"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource Loc.ApiKeys.Table.Provider}"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="2"
                           Text="{DynamicResource Loc.ApiKeys.Table.Environment}"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="3"
                           Text="{DynamicResource Loc.ApiKeys.Table.PrimaryField}"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="4"
                           Text="{DynamicResource Loc.ApiKeys.Table.Updated}"
                           Classes="table-header-text"/>
                <TextBlock Grid.Column="5"
                           Text="{DynamicResource Loc.Common.Actions.Header}"
                           Classes="table-header-text"
                           HorizontalAlignment="Right"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding HasRows}">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ApiKeyRowVm">
                    <Border Classes="table-row">
                      <Grid ColumnDefinitions="1.0*,0.62*,0.52*,0.78*,0.44*,152"
                            ColumnSpacing="8"
                            Margin="12,0"
                            MinHeight="78">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              VerticalAlignment="Center">
                          <Border Width="34"
                                  Height="34"
                                  CornerRadius="4"
                                  Background="{StaticResource SurfaceElevatedBrush}">
                            <Grid>
                              <Border Width="24"
                                      Height="24"
                                      CornerRadius="2"
                                      Background="{StaticResource AppBackgroundSoftBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Monogram}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="11"
                                         FontWeight="Black"
                                         Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="4"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FieldCountDisplay}"
                                       Classes="api-row-subtitle"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProviderDisplay}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Column="2"
                                Classes="api-env-chip"
                                Padding="9,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding EnvironmentDisplay}"
                                     FontSize="11"
                                     FontWeight="Black"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <StackPanel Grid.Column="3"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding PrimaryFieldLabel}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding PrimaryFieldDisplay}"
                                     Classes="api-secret"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding UpdatedDisplay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                          <Button Content="{DynamicResource Loc.Common.Details}"
                                  Classes="table-action-button"
                                  Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="{DynamicResource Loc.ApiKeys.Button.CopySecret}"
                                  Classes="table-action-button"
                                  Command="{Binding DataContext.CopyPrimarySecretCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel Classes="table-empty"
                          IsVisible="{Binding !HasRows}">
                <TextBlock Text="{Binding EmptyTitle}"
                           Classes="table-empty-title"/>
                <TextBlock Text="{Binding EmptySubtitle}"
                           Classes="table-empty-subtitle"/>
              </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Classes="table-footer-row">
              <Grid ColumnDefinitions="*">
                <TextBlock Text="{Binding ItemsSummary}"
                           Classes="table-footer-text"
                           VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <shared:ModalShell IsOpen="{Binding IsApiKeyModalOpen}"
                       Title="{Binding ApiKeyModalTitle}"
                       Subtitle="{Binding ApiKeyModalSubtitle}"
                       Error="{Binding Error}"
                       FooterText="{Binding ModalFooterText}"
                       CloseCommand="{Binding CancelApiKeyModalCommand}">
      <shared:ModalShell.Body>
        <Grid RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="1.2*,1.05*,0.85*"
              RowSpacing="14"
              ColumnSpacing="16">
              <StackPanel Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Common.Name.Label}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsApiKeyFormReadOnly}"
                         PlaceholderText="{DynamicResource Loc.ApiKeys.Form.Name.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.ApiKeys.Form.Provider}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input"
                         IsReadOnly="{Binding IsApiKeyFormReadOnly}"
                         PlaceholderText="{DynamicResource Loc.ApiKeys.Form.Provider.Placeholder}"/>
              </StackPanel>

              <StackPanel Grid.Column="2"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.ApiKeys.Form.Environment}"
                           Classes="modal-shell-label"/>
                <ComboBox ItemsSource="{Binding EnvironmentOptions}"
                          SelectedItem="{Binding AddEnvironment, Mode=TwoWay}"
                          IsEnabled="{Binding IsApiKeyFormEditable}"
                          Classes="modal-shell-input"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.ColumnSpan="3"
                          Spacing="7">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <TextBlock Text="{DynamicResource Loc.ApiKeys.Form.Fields}"
                             Classes="modal-shell-label"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="1"
                          Classes="modal-shell-small-button"
                          Command="{Binding AddFieldCommand}"
                          IsVisible="{Binding IsApiKeyFormEditable}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Loc.ApiKeys.Button.AddField}"
                                 Foreground="{StaticResource AccentBrush}"
                                 FontWeight="Black"/>
                      <Path Classes="material-icon accent"
                            Width="14"
                            Height="14"
                            Data="{StaticResource IconAdd}"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <Border Classes="api-fields-shell">
                  <ScrollViewer MaxHeight="220"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FormFields}"
                                  HorizontalAlignment="Stretch">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="5"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApiKeyFieldRowVm">
                          <Border Classes="api-field-row"
                                  ClipToBounds="True"
                                  HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="1*,0.82*,1.12*,Auto,Auto"
                                  ColumnSpacing="6"
                                  ClipToBounds="True"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center">
                              <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Classes="modal-shell-input compact"
                                       IsReadOnly="{Binding DataContext.IsApiKeyFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       PlaceholderText="{DynamicResource Loc.ApiKeys.Form.FieldLabel.Placeholder}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"/>

                              <ComboBox Grid.Column="1"
                                        Classes="modal-shell-input compact"
                                        ItemsSource="{Binding DataContext.FieldTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedItem="{Binding FieldType, Mode=TwoWay}"
                                        IsEnabled="{Binding DataContext.IsApiKeyFormEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        PointerWheelChanged="OnFieldTypeComboBoxPointerWheelChanged"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"/>

                              <Border Grid.Column="2"
                                      Classes="modal-shell-input-shell compact"
                                      ClipToBounds="True"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8"
                                      ClipToBounds="True"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">
                                  <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Classes="modal-shell-input borderless compact"
                                           IsReadOnly="{Binding DataContext.IsApiKeyFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           PasswordChar="*"
                                           IsVisible="{Binding UseMaskedValueInput}"
                                           PlaceholderText="{DynamicResource Loc.ApiKeys.Form.SecretValue.Placeholder}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"/>
                                  <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Classes="modal-shell-input borderless compact"
                                           IsReadOnly="{Binding DataContext.IsApiKeyFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           IsVisible="{Binding UsePlainValueInput}"
                                           PlaceholderText="{DynamicResource Loc.ApiKeys.Form.SecretValue.Placeholder}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"/>
                                  <Button Grid.Column="1"
                                          Content="{Binding VisibilityLabel}"
                                          Classes="modal-shell-field-action compact"
                                          Command="{Binding DataContext.ToggleFieldVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"
                                          IsVisible="{Binding CanReveal}"/>
                                </Grid>
                              </Border>

                              <CheckBox Grid.Column="3"
                                        Content="{DynamicResource Loc.ApiKeys.Form.Secret}"
                                        Classes="api-check"
                                        IsChecked="{Binding IsSensitive, Mode=TwoWay}"
                                        IsEnabled="{Binding DataContext.IsApiKeyFormEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        VerticalAlignment="Center"/>

                              <Button Grid.Column="4"
                                      Content="X"
                                      Classes="modal-shell-field-remove compact"
                                      Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding DataContext.IsApiKeyFormEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </StackPanel>

              <StackPanel Grid.Row="2"
                          Grid.ColumnSpan="3"
                          Spacing="7">
                <TextBlock Text="{DynamicResource Loc.Common.Notes.Label}"
                           Classes="modal-shell-label"/>
                <TextBox Text="{Binding AddNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="modal-shell-input multiline"
                         IsReadOnly="{Binding IsApiKeyFormReadOnly}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="150"
                         MinHeight="150"
                         MaxHeight="150"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="{DynamicResource Loc.ApiKeys.Form.Notes.Placeholder}"/>
              </StackPanel>
            </Grid>
      </shared:ModalShell.Body>
      <shared:ModalShell.FooterActions>
        <Grid ColumnDefinitions="Auto,Auto"
              ColumnSpacing="12">
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Cancel}"
                        Classes="modal-shell-secondary-button"
                        IsVisible="{Binding IsAddApiKeyMode}"
                        Command="{Binding CancelApiKeyModalCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.ApiKeys.Button.AddSubmit}"
                        Classes="modal-shell-primary-button"
                        IsVisible="{Binding IsAddApiKeyMode}"
                        Command="{Binding SaveAddApiKeyCommand}"/>
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Delete}"
                        Classes="modal-shell-danger-button"
                        IsVisible="{Binding IsApiKeyDetailsViewMode}"
                        Command="{Binding BeginDetailsDeleteCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Edit}"
                        Classes="modal-shell-primary-button"
                        IsVisible="{Binding IsApiKeyDetailsViewMode}"
                        Command="{Binding BeginDetailsEditCommand}"/>
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Cancel}"
                        Classes="modal-shell-secondary-button"
                        IsVisible="{Binding IsApiKeyDetailsEditMode}"
                        Command="{Binding CancelDetailsEditCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Save}"
                        Classes="modal-shell-primary-button"
                        IsVisible="{Binding IsApiKeyDetailsEditMode}"
                        Command="{Binding SaveDetailsCommand}"/>
                <Button Grid.Column="0"
                        Content="{DynamicResource Loc.Common.Cancel}"
                        Classes="modal-shell-secondary-button"
                        IsVisible="{Binding IsApiKeyDetailsDeleteConfirmMode}"
                        Command="{Binding CancelDetailsDeleteCommand}"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Delete}"
                        Classes="modal-shell-danger-button"
                        IsVisible="{Binding IsApiKeyDetailsDeleteConfirmMode}"
                        Command="{Binding ConfirmDetailsDeleteCommand}"/>
              </Grid>
      </shared:ModalShell.FooterActions>
    </shared:ModalShell>
  </Grid>

  <UserControl.Styles>
    <Style Selector="TextBlock.api-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="TextBlock.api-accent-note">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.api-muted-note">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.api-stat">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="MinHeight" Value="96"/>
    </Style>

    <Style Selector="Border.api-filter-shell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="TextBox.api-search">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="260"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style Selector="ComboBox.api-select">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="124"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.api-add-button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Width" Value="124"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.api-add-button:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="TextBlock.api-row-subtitle">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="TextBlock.api-secret">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LetterSpacing" Value="1.8"/>
    </Style>

    <Style Selector="Border.api-env-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>














    <Style Selector="Border.api-fields-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="6"/>
    </Style>

    <Style Selector="Border.api-field-row">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="5"/>
    </Style>

    <Style Selector="CheckBox.api-check">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
</UserControl>
