<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.SecureNotesView"
             x:CompileBindings="False"
             x:DataType="vm:SecureNotesViewModel">

  <Grid ColumnDefinitions="320,*" ColumnSpacing="18" Margin="24">
    <Border Classes="panel" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <Border Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding NotesHeader}"
                       Classes="section-title"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Classes="subtle inline"
                    Content="Filter"
                    VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Notes}"
                 SelectedItem="{Binding SelectedNote}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="12,12,12,16"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NoteItemVm">
              <Border Padding="14"
                      CornerRadius="12"
                      Background="{StaticResource SurfaceBrush}"
                      Margin="0,0,0,8">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1"
                               Text="*"
                               Foreground="{StaticResource AccentBrush}"
                               IsVisible="{Binding IsFavorite}"/>
                  </Grid>

                  <TextBlock Grid.Row="1"
                             Text="{Binding Content}"
                             Classes="caption"
                             TextWrapping="Wrap"
                             MaxHeight="38"/>

                  <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Border Classes="badge" Padding="8,3">
                      <TextBlock Text="Encrypted"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource SuccessBrush}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding UpdatedAtUtc}"
                               Classes="caption"
                               HorizontalAlignment="Right"/>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Column="1" Classes="panel" Padding="0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Border Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="18,16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding EditorTitle, FallbackValue=AWS Production Keys}"
                         Classes="page-title"/>
              <TextBlock Text="{Binding SelectedStatus}"
                         Classes="page-subtitle"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <WrapPanel Grid.Column="1" ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
              <Button Content="Copy Content" Classes="subtle inline" IsEnabled="False"/>
              <Button Content="Delete"
                      Classes="subtle inline"
                      Command="{Binding DeleteCommand}"
                      IsEnabled="{Binding !IsBusy}"/>
              <Button Content="Save"
                      Classes="primary inline"
                      Command="{Binding SaveCommand}"
                      IsEnabled="{Binding !IsBusy}"/>
            </WrapPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="panel-raised" Padding="12,14">
          <TextBlock Text="{Binding EditorStats}" Classes="page-subtitle"/>
        </Border>

        <Border Grid.Row="2"
                Classes="panel-raised"
                Padding="16"
                Background="{StaticResource AppBackgroundSoftBrush}">
          <TextBox Text="{Binding EditorContent}"
                   Background="Transparent"
                   BorderThickness="0"
                   Classes="page-subtitle"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   MinHeight="420"
                   IsEnabled="{Binding !IsBusy}"/>
        </Border>

        <Border Grid.Row="3" Classes="panel-raised" Padding="12">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="subtle inline" Content="B" IsEnabled="False"/>
              <Button Classes="subtle inline" Content="I" IsEnabled="False"/>
              <Button Classes="subtle inline" Content="Bul" IsEnabled="False"/>
              <Button Classes="subtle inline" Content="Link" IsEnabled="False"/>
              <Button Classes="subtle inline" Content="Code" IsEnabled="False"/>
              <Button Classes="subtle inline" Content="Img" IsEnabled="False"/>
            </WrapPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="UTF-8 - Markdown Enabled" Classes="caption"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="8" Height="8" CornerRadius="999" Background="{StaticResource AccentBrush}"/>
                <TextBlock Text="Auto-saved" Classes="caption"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
