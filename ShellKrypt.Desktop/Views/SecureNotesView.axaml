<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.SecureNotesView"
             x:DataType="vm:SecureNotesViewModel">

  <Grid ColumnDefinitions="320,*">
    <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="12">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="New Note" Command="{Binding NewNoteCommand}" IsEnabled="{Binding !IsBusy}"/>
          <Button Content="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding !IsBusy}"/>
          <Button Content="Fav" Command="{Binding ToggleFavoriteCommand}" IsEnabled="{Binding !IsBusy}"/>
          <Button Content="Lock" Command="{Binding LockCommand}" IsEnabled="{Binding !IsBusy}"/>
        </StackPanel>

        <TextBlock Text="{Binding NotesHeader}" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="{Binding SelectedStatus}" Opacity="0.7" TextWrapping="Wrap"/>

        <ListBox ItemsSource="{Binding Notes}"
                 SelectedItem="{Binding SelectedNote}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding FavoriteGlyph}" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding UpdatedAtUtc}" Opacity="0.55" FontSize="11"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{Binding Error}" Foreground="Tomato" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Padding="12">
      <StackPanel Spacing="10">
        <TextBlock Text="Editor" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="{Binding EditorStats}" Opacity="0.7"/>

        <TextBox Watermark="Title" Text="{Binding EditorTitle}" IsEnabled="{Binding !IsBusy}"/>
        <TextBox Watermark="Content"
                 Text="{Binding EditorContent}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="300"
                 IsEnabled="{Binding !IsBusy}"/>

        <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
      </StackPanel>
    </Border>
  </Grid>

</UserControl>
