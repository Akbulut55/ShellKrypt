<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.SecureNotesView"
             x:CompileBindings="False"
             x:DataType="vm:SecureNotesViewModel">

  <Grid ColumnDefinitions="320,*" ColumnSpacing="18" Margin="24">
    <Border Classes="panel-raised" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="Note Library" Classes="section-title"/>
          <TextBlock Text="{Binding NotesHeader}" Classes="page-subtitle"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="8">
          <Button Content="New Note" Classes="primary" Command="{Binding NewNoteCommand}" IsEnabled="{Binding !IsBusy}"/>
          <Button Content="Favorite" Classes="subtle" Command="{Binding ToggleFavoriteCommand}" IsEnabled="{Binding !IsBusy}"/>
          <Button Content="Delete" Classes="danger" Command="{Binding DeleteCommand}" IsEnabled="{Binding !IsBusy}"/>
          <Button Content="Lock" Classes="subtle" Command="{Binding LockCommand}" IsEnabled="{Binding !IsBusy}"/>
        </WrapPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Notes}"
                 SelectedItem="{Binding SelectedNote}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <Border Classes="badge" Padding="8,3" IsVisible="{Binding IsFavorite}">
                      <TextBlock Text="Favorite" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding UpdatedAtUtc}" Classes="page-subtitle"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
      </Grid>
    </Border>

    <Border Grid.Column="1" Classes="panel-raised" Padding="18">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
        <StackPanel Spacing="6">
          <TextBlock Text="Secure Note Editor" Classes="section-title"/>
          <TextBlock Text="{Binding SelectedStatus}" Classes="page-subtitle" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="panel" Padding="12">
          <TextBlock Text="{Binding EditorStats}" Classes="page-subtitle"/>
        </Border>

        <StackPanel Grid.Row="2" Spacing="6">
          <TextBlock Text="Title" Classes="caption"/>
          <TextBox Text="{Binding EditorTitle}"
                   Watermark="Title"
                   IsEnabled="{Binding !IsBusy}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="6">
          <TextBlock Text="Content" Classes="caption"/>
          <TextBox Text="{Binding EditorContent}"
                   Watermark="Write the note content here"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   MinHeight="320"
                   IsEnabled="{Binding !IsBusy}"/>
        </StackPanel>

        <DockPanel Grid.Row="4" LastChildFill="False">
          <Button Content="Save Note"
                  Classes="primary"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Error}"
                     Foreground="{StaticResource DangerBrush}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0"/>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
