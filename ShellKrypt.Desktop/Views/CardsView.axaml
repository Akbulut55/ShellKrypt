<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.CardsView"
             x:CompileBindings="False"
             x:DataType="vm:CardsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="18">
      <Border Classes="panel-raised" Padding="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBox Classes="search"
                   Watermark="Search cards by title, holder, masked number, notes, or favorite..."
                   Text="{Binding SearchText}"/>

          <Button Grid.Column="1"
                  Classes="primary"
                  Content="Add New Card"
                  Command="{Binding AddNewCommand}"/>
        </Grid>
      </Border>

      <Border Classes="panel-raised" Padding="16">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="72,1.5*,1.2*,1.4*,Auto" Margin="0,0,0,12">
            <TextBlock Text="Item" Classes="caption"/>
            <TextBlock Grid.Column="1" Text="Card" Classes="caption"/>
            <TextBlock Grid.Column="2" Text="Holder / Expiry" Classes="caption"/>
            <TextBlock Grid.Column="3" Text="Protected values" Classes="caption"/>
            <TextBlock Grid.Column="4" Text="Actions" Classes="caption"/>
          </Grid>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="panel" Padding="14" Margin="0,0,0,10">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="72,1.5*,1.2*,1.4*,Auto" ColumnSpacing="12">
                    <Border Width="52"
                            Height="52"
                            CornerRadius="16"
                            Background="{StaticResource AccentMutedBrush}"
                            BorderBrush="{StaticResource BorderBrushStrong}"
                            BorderThickness="1">
                      <TextBlock Text="{Binding IconLetter}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontWeight="Bold"
                                 FontSize="18"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" IsVisible="{Binding IsViewing}"/>
                        <Border Classes="badge" Padding="8,3" IsVisible="{Binding IsFavorite}">
                          <TextBlock Text="Pinned" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                      </StackPanel>
                      <TextBox Text="{Binding Title}" IsVisible="{Binding IsEditing}" Watermark="Title"/>
                      <TextBlock Text="{Binding NotesDisplay}" Classes="page-subtitle" IsVisible="{Binding IsViewing}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                      <TextBlock Text="{Binding Cardholder}" IsVisible="{Binding IsViewing}" FontWeight="SemiBold"/>
                      <TextBox Text="{Binding Cardholder}" IsVisible="{Binding IsEditing}" Watermark="Cardholder"/>
                      <TextBlock Text="{Binding ExpiryDisplay}" Classes="page-subtitle" IsVisible="{Binding IsViewing}"/>
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                        <TextBox Width="72" Text="{Binding ExpiryMonth}" Watermark="MM"/>
                        <TextBox Width="92" Text="{Binding ExpiryYear}" Watermark="YYYY"/>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="6">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding NumberDisplay}" VerticalAlignment="Center" IsVisible="{Binding IsViewing}"/>
                        <TextBox Text="{Binding Number}" Watermark="Card number" IsVisible="{Binding IsEditing}"/>
                        <Button Grid.Column="1"
                                Classes="subtle"
                                Content="Reveal"
                                Command="{Binding DataContext.ToggleSecretsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                      </Grid>

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="badge" Padding="10,6">
                          <TextBlock Text="{Binding CvcDisplay}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBox Width="82" Text="{Binding Cvc}" Watermark="CVC" IsVisible="{Binding IsEditing}"/>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button Content="Fav"
                              Classes="subtle"
                              IsVisible="{Binding IsViewing}"
                              Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="Edit"
                              Classes="subtle"
                              IsVisible="{Binding IsViewing}"
                              Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="Delete"
                              Classes="danger"
                              IsVisible="{Binding IsViewing}"
                              Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="Save"
                              Classes="primary"
                              IsVisible="{Binding IsEditing}"
                              Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="Cancel"
                              Classes="subtle"
                              IsVisible="{Binding IsEditing}"
                              Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,10,0,0" Spacing="6">
                      <TextBlock Text="Notes" Classes="caption"/>
                      <TextBlock Text="{Binding NotesDisplay}" Classes="page-subtitle" IsVisible="{Binding IsViewing}" TextWrapping="Wrap"/>
                      <TextBox Text="{Binding Notes}"
                               IsVisible="{Binding IsEditing}"
                               AcceptsReturn="True"
                               MinHeight="72"
                               TextWrapping="Wrap"
                               Watermark="Notes"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
