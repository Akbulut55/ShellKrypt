<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.CardsView"
             x:CompileBindings="False"
             x:DataType="vm:CardsViewModel">

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32"
                  MaxWidth="1500"
                  HorizontalAlignment="Stretch"
                  Spacing="22">
        <Grid Margin="0,10,0,8">
          <StackPanel Spacing="9">
            <TextBlock Text="Credit Cards"
                       FontSize="28"
                       FontWeight="SemiBold"
                       LetterSpacing="-0.8"/>
            <TextBlock Text="Manage your saved payment cards and encrypted card details."
                       Classes="page-subtitle"
                       FontSize="13"/>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="18">
          <Border Classes="cards-stat primary"
                  Padding="24,20">
            <StackPanel Spacing="8">
              <TextBlock Text="ACTIVE CARDS"
                         Classes="cards-kicker"/>
              <TextBlock Text="{Binding ActiveCardsCount}"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="^"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Black"/>
                <TextBlock Text="+ 2 added this month"
                           Classes="cards-accent-note"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="cards-stat danger"
                  Padding="24,20">
            <StackPanel Spacing="8">
              <TextBlock Text="EXPIRING SOON"
                         Classes="cards-kicker"/>
              <TextBlock Text="{Binding ExpiringSoonCount}"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="!"
                           Foreground="{StaticResource DangerBrush}"
                           FontWeight="Black"/>
                <TextBlock Text="Requires immediate action"
                           Classes="cards-danger-note"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  Classes="cards-stat secondary"
                  Padding="24,20">
            <StackPanel Spacing="8">
              <TextBlock Text="PRIMARY CARD"
                         Classes="cards-kicker"/>
              <Grid ColumnDefinitions="32,*"
                    ColumnSpacing="12">
                <Border Width="32"
                        Height="20"
                        CornerRadius="2"
                        Background="{StaticResource SurfaceElevatedBrush}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding PrimaryCardTitle}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
              <TextBlock Text="{Binding PrimaryCardNote}"
                         Classes="cards-muted"
                         FontSize="12"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="cards-filter-shell"
                Padding="0">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                ColumnSpacing="12">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="cards-search"
                     PlaceholderText="Search by name or bank..."
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      Classes="cards-select"
                      ItemsSource="{Binding NetworkFilters}"
                      SelectedItem="{Binding SelectedNetworkFilter, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2"
                      Classes="cards-select"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <Button Grid.Column="3"
                    Content="+ Add New Card"
                    Classes="cards-add-button"
                    Command="{Binding AddNewCommand}"
                    VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Border Classes="cards-table-shell"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Background="#26353534"
                    Padding="22,14">
              <Grid ColumnDefinitions="1.45*,1.2*,1.35*,0.75*,0.8*,280"
                    ColumnSpacing="24">
                <TextBlock Text="CARD IDENTITY" Classes="cards-table-header"/>
                <TextBlock Grid.Column="1" Text="BANK" Classes="cards-table-header"/>
                <TextBlock Grid.Column="2" Text="NUMBER" Classes="cards-table-header"/>
                <TextBlock Grid.Column="3" Text="EXPIRY" Classes="cards-table-header"/>
                <TextBlock Grid.Column="4" Text="ISSUER" Classes="cards-table-header"/>
                <TextBlock Grid.Column="5"
                           Text="ACTIONS"
                           Classes="cards-table-header"
                           HorizontalAlignment="Right"/>
              </Grid>
            </Border>

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CardRowVm">
                  <Border Classes="cards-row">
                    <Grid RowDefinitions="Auto,Auto"
                          Margin="22,0"
                          MinHeight="78">
                      <Grid ColumnDefinitions="1.45*,1.2*,1.35*,0.75*,0.8*,280"
                            ColumnSpacing="24"
                            MinHeight="78">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              VerticalAlignment="Center">
                          <Border Width="34"
                                  Height="34"
                                  CornerRadius="4"
                                  Background="{StaticResource SurfaceElevatedBrush}">
                            <Grid>
                              <Border Width="24"
                                      Height="24"
                                      CornerRadius="2"
                                      Background="{StaticResource AppBackgroundSoftBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                              <TextBlock Text="C"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         FontWeight="Black"
                                         Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="4"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding IsViewing}"/>
                            <TextBox Text="{Binding Title}"
                                     Classes="cards-inline-input"
                                     PlaceholderText="Card title"
                                     IsVisible="{Binding IsEditing}"/>
                            <TextBlock Text="{Binding SubtitleDisplay}"
                                       Classes="cards-row-subtitle"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding IsViewing}"/>
                          </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding BankDisplay}"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding IsViewing}"/>
                          <TextBox Text="{Binding Bank}"
                                   Classes="cards-inline-input"
                                   PlaceholderText="Bank"
                                   IsVisible="{Binding IsEditing}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding NumberDisplay}"
                                     Classes="cards-number"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding IsViewing}"/>
                          <TextBox Text="{Binding Number}"
                                   Classes="cards-inline-input mono"
                                   PlaceholderText="Card number"
                                   IsVisible="{Binding IsEditing}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <Grid ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="6"
                                IsVisible="{Binding IsViewing}">
                            <TextBlock Text="{Binding ExpiryDisplay}"
                                       Classes="cards-expiry"/>
                            <TextBlock Grid.Column="1"
                                       Text="!"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontWeight="Black"
                                       IsVisible="{Binding IsExpiryUrgent}"/>
                          </Grid>
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      IsVisible="{Binding IsEditing}">
                            <TextBox Width="58"
                                     Text="{Binding ExpiryMonth}"
                                     Classes="cards-inline-input"
                                     PlaceholderText="MM"/>
                            <TextBox Width="70"
                                     Text="{Binding ExpiryYear}"
                                     Classes="cards-inline-input"
                                     PlaceholderText="YYYY"/>
                          </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <Border Classes="cards-issuer-chip"
                                  Padding="9,3"
                                  HorizontalAlignment="Left"
                                  IsVisible="{Binding IsViewing}">
                            <TextBlock Text="{Binding IssuerDisplay}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                          </Border>
                          <TextBox Text="{Binding Cvc}"
                                   Classes="cards-inline-input"
                                   PlaceholderText="CVC"
                                   IsVisible="{Binding IsEditing}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                          <Button Content="{Binding SecretsActionLabel}"
                                  Classes="cards-action"
                                  IsVisible="{Binding IsViewing}"
                                  Command="{Binding DataContext.ToggleSecretsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="Edit"
                                  Classes="cards-action"
                                  IsVisible="{Binding IsViewing}"
                                  Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="Delete"
                                  Classes="cards-action danger"
                                  IsVisible="{Binding IsViewing}"
                                  Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="Save"
                                  Classes="cards-action primary"
                                  IsVisible="{Binding IsEditing}"
                                  Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="Cancel"
                                  Classes="cards-action"
                                  IsVisible="{Binding IsEditing}"
                                  Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>

                      <TextBox Grid.Row="1"
                               Text="{Binding Notes}"
                               Classes="cards-inline-input notes"
                               PlaceholderText="Notes"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsEditing}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2"
                    Background="#26353534"
                    Padding="22,14">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                    ColumnSpacing="10">
                <TextBlock Text="{Binding ItemsSummary}"
                           Classes="cards-footer-text"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Previous"
                        Classes="cards-page-button"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPreviousPage}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding PageSummary}"
                           Classes="cards-footer-text"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="3"
                        Content="Next"
                        Classes="cards-page-button"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNextPage}"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Background="#b0000000"
            IsVisible="{Binding IsAddCardModalOpen}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Grid>
        <Border Classes="cards-modal-card"
                Width="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28">
          <StackPanel Spacing="22">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="Add Credit Card"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           LetterSpacing="-0.4"/>
                <TextBlock Text="Store a new payment card in your encrypted vault."
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="X"
                      Classes="cards-modal-close-button"
                      Command="{Binding CancelAddCardCommand}"
                      ToolTip.Tip="Close"/>
            </Grid>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,*,*"
                  RowSpacing="14"
                  ColumnSpacing="16">
              <StackPanel Spacing="7">
                <TextBlock Text="CARD TITLE"
                           Classes="cards-modal-label"/>
                <TextBox Text="{Binding AddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="cards-modal-input"
                         PlaceholderText="Titanium Business"/>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="7">
                <TextBlock Text="BANK"
                           Classes="cards-modal-label"/>
                <TextBox Text="{Binding AddBank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="cards-modal-input"
                         PlaceholderText="Chase"/>
              </StackPanel>

              <StackPanel Grid.Column="2"
                          Spacing="7">
                <TextBlock Text="CARDHOLDER"
                           Classes="cards-modal-label"/>
                <TextBox Text="{Binding AddCardholder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="cards-modal-input"
                         PlaceholderText="Alex Morgan"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Spacing="7">
                <TextBlock Text="ISSUER"
                           Classes="cards-modal-label"/>
                <ComboBox ItemsSource="{Binding IssuerOptions}"
                          SelectedItem="{Binding AddIssuer, Mode=TwoWay}"
                          Classes="cards-modal-input"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Spacing="7">
                <TextBlock Text="CARD NUMBER"
                           Classes="cards-modal-label"/>
                <TextBox x:Name="AddCardNumberTextBox"
                         Text="{Binding AddNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Classes="cards-modal-input"
                         MaxLength="23"
                         TextChanged="AddCardNumberTextBox_OnTextChanged"
                         PlaceholderText="4242 4242 4242 4242"/>
              </StackPanel>

              <Grid Grid.Row="2"
                    Grid.ColumnSpan="3"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="16">
                <StackPanel Spacing="7">
                  <TextBlock Text="EXPIRY MONTH"
                             Classes="cards-modal-label"/>
                  <TextBox Text="{Binding AddExpiryMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="cards-modal-input"
                           PlaceholderText="09"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="7">
                  <TextBlock Text="EXPIRY YEAR"
                             Classes="cards-modal-label"/>
                  <TextBox Text="{Binding AddExpiryYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="cards-modal-input"
                           PlaceholderText="2028"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Spacing="7">
                  <TextBlock Text="CVC"
                             Classes="cards-modal-label"/>
                  <TextBox Text="{Binding AddCvc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="cards-modal-input"
                           PasswordChar="*"
                           PlaceholderText="123"/>
                </StackPanel>
              </Grid>

              <StackPanel Grid.Row="3"
                          Grid.ColumnSpan="3"
                          Spacing="12">
                <StackPanel Spacing="7">
                  <TextBlock Text="NOTES"
                             Classes="cards-modal-label"/>
                  <TextBox Text="{Binding AddNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="cards-modal-input"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="98"
                           PlaceholderText="Rewards category, usage notes, or card context..."/>
                </StackPanel>

                <CheckBox Content="Mark as favorite"
                          IsChecked="{Binding AddFavorite, Mode=TwoWay}"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Error}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="-8,0,-8,-8">
              <Grid ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="Fields are encrypted locally before being stored."
                           Classes="page-subtitle"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Classes="cards-modal-secondary-button"
                        Command="{Binding CancelAddCardCommand}"/>
                <Button Grid.Column="2"
                        Content="Add Credit Card"
                        Classes="cards-modal-primary-button"
                        Command="{Binding SaveAddCardCommand}"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.cards-encryption-badge">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="CornerRadius" Value="999"/>
    </Style>

    <Style Selector="Border.cards-count-badge">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBlock.cards-badge-text">
      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="1.7"/>
    </Style>

    <Style Selector="TextBlock.cards-muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock.cards-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="TextBlock.cards-accent-note">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.cards-danger-note">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.cards-stat">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight" Value="112"/>
    </Style>

    <Style Selector="Border.cards-stat.primary">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.cards-stat.danger">
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
    </Style>

    <Style Selector="Border.cards-stat.secondary">
      <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
    </Style>

    <Style Selector="Border.cards-filter-shell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="TextBox.cards-search">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style Selector="ComboBox.cards-select">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="150"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style Selector="Button.cards-filter-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-filter-button:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.cards-add-button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Width" Value="174"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-add-button:pointerover">
      <Setter Property="Background" Value="#63f5e1"/>
      <Setter Property="BorderBrush" Value="#63f5e1"/>
    </Style>

    <Style Selector="Border.cards-table-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.cards-modal-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="#663c4a46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Border.cards-modal-input-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="#333c4a46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="TextBlock.cards-modal-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.1"/>
    </Style>

    <Style Selector="TextBox.cards-modal-input">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="#333c4a46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style Selector="ComboBox.cards-modal-input">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="#333c4a46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style Selector="TextBox.cards-modal-input:focus">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="TextBox.cards-modal-input.borderless">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="Button.cards-modal-close-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-modal-close-button:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.cards-modal-field-action">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-modal-field-action:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
    </Style>

    <Style Selector="Button.cards-modal-secondary-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-modal-secondary-button:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.cards-modal-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="24,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-modal-primary-button:pointerover">
      <Setter Property="Background" Value="#63f5e1"/>
    </Style>

    <Style Selector="TextBlock.cards-table-header">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.6"/>
    </Style>

    <Style Selector="Border.cards-row">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="#1a3c4a46"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="Border.cards-row:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    </Style>

    <Style Selector="TextBlock.cards-row-subtitle">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="TextBlock.cards-number">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="LetterSpacing" Value="2.4"/>
    </Style>

    <Style Selector="TextBlock.cards-expiry">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.cards-issuer-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="TextBox.cards-inline-input">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style Selector="TextBox.cards-inline-input.mono">
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <Style Selector="TextBox.cards-inline-input.notes">
      <Setter Property="Margin" Value="54,0,0,16"/>
      <Setter Property="MinHeight" Value="68"/>
    </Style>

    <Style Selector="Button.cards-action">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="MinWidth" Value="64"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-action:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.cards-action.danger:pointerover">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>

    <Style Selector="Button.cards-action.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
    </Style>

    <Style Selector="Button.cards-page-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.cards-page-button:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="TextBlock.cards-page-text">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.cards-footer-text">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

  </UserControl.Styles>

</UserControl>
