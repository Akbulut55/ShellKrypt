<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.UnlockView"
             x:DataType="vm:UnlockViewModel">
  <StackPanel Margin="24" Spacing="12" Width="420">
    <TextBlock Text="Unlock Vault" FontSize="22" FontWeight="Bold"/>

    <TextBox Watermark="Master password"
             PasswordChar="●"
             Text="{Binding MasterPassword}"/>

    <TextBlock Text="{Binding Error}" Foreground="Tomato" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Back" Command="{Binding BackCommand}"/>
      <Button Content="Unlock" Command="{Binding UnlockCommand}"/>
    </StackPanel>
  </StackPanel>
</UserControl>