<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:ShellKrypt.UI.Shared.Controls"
             x:Class="ShellKrypt.Desktop.Views.QuickFillEntryEditorView"
             x:Name="EditorRoot"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Border.qfe-chip">
      <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="Border.qfe-sequence-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.qfe-sequence-row">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.qfe-sequence-empty">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="MinHeight" Value="96" />
    </Style>
    <Style Selector="TextBlock.qfe-sequence-arrow">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,12,0" />
    </Style>
    <Style Selector="Border.qfe-step-number">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="TextBlock.qfe-label">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.qfe-section-title">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.qfe-input">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.qfe-notes">
      <Setter Property="MinHeight" Value="92" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="ComboBox.qfe-input">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.qfe-secondary">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Button.qfe-primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,0" />
    </Style>
    <Style Selector="Button.qfe-danger">
      <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Button.qfe-row-button">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid RowDefinitions="Auto,Auto,Auto"
          RowSpacing="20">
    <Grid Grid.Row="0"
          ColumnDefinitions="*,*"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="18"
          RowSpacing="8">
      <TextBlock Grid.Row="0"
                 Grid.Column="0"
                 Text="{DynamicResource Loc.QuickFill.Entry.Name}"
                 Classes="qfe-label" />
      <TextBlock Grid.Row="0"
                 Grid.Column="1"
                 Text="{DynamicResource Loc.QuickFill.Entry.Category}"
                 Classes="qfe-label" />
      <TextBox Grid.Row="1"
               Grid.Column="0"
               PlaceholderText="{DynamicResource Loc.QuickFill.Entry.NamePlaceholder}"
               Text="{Binding EntryName}"
               Classes="qfe-input" />
      <TextBox Grid.Row="1"
               Grid.Column="1"
               Text="{Binding EntryCategory}"
               Classes="qfe-input" />
    </Grid>

    <Border Grid.Row="1" Classes="qfe-sequence-card">
      <Grid RowDefinitions="Auto,Auto,Auto"
            RowSpacing="12">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="{DynamicResource Loc.QuickFill.Sequence.Title}"
                     Classes="qfe-section-title" />
          <Border Grid.Column="2" Classes="qfe-chip" VerticalAlignment="Center">
            <TextBlock Text="{Binding SequenceStepCountText}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12"
                       FontWeight="SemiBold" />
          </Border>
        </Grid>

        <Border Grid.Row="1"
                Classes="qfe-sequence-empty"
                IsVisible="{Binding HasNoSequenceSteps}">
          <StackPanel Spacing="6"
                      VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Loc.QuickFill.Sequence.EmptyTitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Loc.QuickFill.Sequence.EmptyExample}"
                       Foreground="{DynamicResource TextMutedBrush}"/>
          </StackPanel>
        </Border>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding SequenceSteps}"
                      IsVisible="{Binding HasSequenceSteps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal"
                          Margin="0,0,0,10">
                <Border Classes="qfe-sequence-row"
                        MinWidth="130"
                        MaxWidth="230">
                  <Grid RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        RowSpacing="4"
                        ColumnSpacing="8">
                    <TextBlock Text="{Binding DisplayLabel}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1"
                            Content="x"
                            Command="{Binding DataContext.RemoveSequenceStepCommand, ElementName=EditorRoot}"
                            CommandParameter="{Binding}"
                            Classes="qfe-row-button"
                            MinWidth="24"
                            MinHeight="24"
                            Padding="4,0"/>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding DisplaySubLabel}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
                <TextBlock Text="-&gt;"
                           Classes="qfe-sequence-arrow"
                           IsVisible="{Binding HasNextStep}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="2"
                Content="{DynamicResource Loc.QuickFill.Sequence.AddStep}"
                Classes="qfe-secondary"
                Command="{Binding OpenAddStepModalCommand}"
                HorizontalAlignment="Left"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2"
          RowDefinitions="Auto,Auto"
          RowSpacing="16">
      <TextBox Grid.Row="0"
               Text="{Binding Notes}"
               PlaceholderText="{DynamicResource Loc.QuickFill.Entry.Notes}"
               Classes="qfe-notes" />
      <Grid Grid.Row="1"
            ColumnDefinitions="*,Auto,Auto,Auto"
            ColumnSpacing="14"
            VerticalAlignment="Center">
        <Button Grid.Column="1"
                Content="{DynamicResource Loc.Common.Cancel}"
                Command="{Binding CancelEditCommand}"
                Classes="qfe-secondary" />
        <Button Grid.Column="2"
                Content="{DynamicResource Loc.Common.Delete}"
                Command="{Binding DeleteEntryCommand}"
                IsVisible="{Binding CanDeleteEntry}"
                Classes="qfe-danger" />
        <Button Grid.Column="3"
                Content="{DynamicResource Loc.QuickFill.Button.SaveEntry}"
                Command="{Binding SaveEntryCommand}"
                Classes="qfe-primary" />
      </Grid>
    </Grid>
    </Grid>

    <shared:ModalShell IsOpen="{Binding IsAddStepModalOpen}"
                       Title="{DynamicResource Loc.QuickFill.Sequence.AddStepPrompt}"
                       CloseCommand="{Binding CloseAddStepModalCommand}"
                       FooterText="{Binding PendingKeyPreviewText}"
                       DialogWidth="520">
      <shared:ModalShell.Body>
        <Grid RowDefinitions="Auto,Auto"
              RowSpacing="14">
          <WrapPanel Grid.Row="0">
            <Button Content="{DynamicResource Loc.QuickFill.Sequence.AddFieldChoice}"
                    Command="{Binding SelectAddFieldModeCommand}"
                    Classes="qfe-secondary"
                    Margin="0,0,8,8"/>
            <Button Content="{DynamicResource Loc.QuickFill.Sequence.AddKeyChoice}"
                    Command="{Binding SelectAddKeyModeCommand}"
                    Classes="qfe-secondary"
                    Margin="0,0,8,8"/>
            <Button Content="{DynamicResource Loc.QuickFill.Sequence.AddTextChoice}"
                    Command="{Binding SelectAddTextModeCommand}"
                    Classes="qfe-secondary"
                    Margin="0,0,8,8"/>
            <Button Content="{DynamicResource Loc.QuickFill.Sequence.AddDelayChoice}"
                    Command="{Binding SelectAddDelayModeCommand}"
                    Classes="qfe-secondary"
                    Margin="0,0,8,8"/>
          </WrapPanel>

          <Grid Grid.Row="1">
            <StackPanel Spacing="12"
                        IsVisible="{Binding IsAddFieldMode}">
              <WrapPanel>
                <Button Content="{DynamicResource Loc.QuickFill.Source.Manual}"
                        Command="{Binding SelectManualFieldSourceCommand}"
                        Classes="qfe-secondary"
                        Margin="0,0,8,8"/>
                <Button Content="{DynamicResource Loc.QuickFill.Source.WebLogin}"
                        Command="{Binding SelectWebLoginFieldSourceCommand}"
                        Classes="qfe-secondary"
                        Margin="0,0,8,8"/>
                <Button Content="{DynamicResource Loc.QuickFill.Source.CreditCard}"
                        Command="{Binding SelectCreditCardFieldSourceCommand}"
                        Classes="qfe-secondary"
                        Margin="0,0,8,8"/>
                <Button Content="{DynamicResource Loc.QuickFill.Source.ApiKey}"
                        Command="{Binding SelectApiKeyFieldSourceCommand}"
                        Classes="qfe-secondary"
                        Margin="0,0,8,8"/>
                <Button Content="{DynamicResource Loc.QuickFill.Source.Authenticator}"
                        Command="{Binding SelectAuthenticatorFieldSourceCommand}"
                        Classes="qfe-secondary"
                        Margin="0,0,8,8"/>
              </WrapPanel>

              <StackPanel Spacing="10"
                          IsVisible="{Binding IsManualFieldSource}">
                <TextBox Text="{Binding OwnedFieldLabel}"
                         PlaceholderText="{DynamicResource Loc.QuickFill.Field.Label}"
                         Classes="qfe-input" />
                <TextBox Text="{Binding OwnedFieldValue}"
                         PlaceholderText="{DynamicResource Loc.QuickFill.Field.Value}"
                         Classes="qfe-input" />
                <Button Content="{DynamicResource Loc.QuickFill.Button.AddOwnedField}"
                        Command="{Binding AddOwnedFieldCommand}"
                        Classes="qfe-secondary"
                        HorizontalAlignment="Right" />
              </StackPanel>

              <StackPanel Spacing="10"
                          IsVisible="{Binding IsWebLoginFieldSource}">
                <ComboBox ItemsSource="{Binding WebLoginOptions}"
                          SelectedItem="{Binding SelectedWebLoginOption}"
                          Classes="qfe-input" />
                <ComboBox ItemsSource="{Binding WebLoginFieldOptions}"
                          SelectedItem="{Binding SelectedWebLoginFieldOption}"
                          Classes="qfe-input" />
                <Button Content="{DynamicResource Loc.QuickFill.Button.AddWebLoginField}"
                        Command="{Binding AddWebLoginFieldCommand}"
                        Classes="qfe-secondary"
                        HorizontalAlignment="Right" />
              </StackPanel>

              <StackPanel Spacing="10"
                          IsVisible="{Binding IsCreditCardFieldSource}">
                <ComboBox ItemsSource="{Binding CreditCardOptions}"
                          SelectedItem="{Binding SelectedCreditCardOption}"
                          Classes="qfe-input" />
                <ComboBox ItemsSource="{Binding CreditCardFieldOptions}"
                          SelectedItem="{Binding SelectedCreditCardFieldOption}"
                          Classes="qfe-input" />
                <Button Content="{DynamicResource Loc.QuickFill.Button.AddCreditCardField}"
                        Command="{Binding AddCreditCardFieldCommand}"
                        Classes="qfe-secondary"
                        HorizontalAlignment="Right" />
              </StackPanel>

              <StackPanel Spacing="10"
                          IsVisible="{Binding IsApiKeyFieldSource}">
                <ComboBox ItemsSource="{Binding ApiKeyOptions}"
                          SelectedItem="{Binding SelectedApiKeyOption}"
                          Classes="qfe-input" />
                <ComboBox ItemsSource="{Binding ApiKeyFieldOptions}"
                          SelectedItem="{Binding SelectedApiKeyFieldOption}"
                          Classes="qfe-input" />
                <Button Content="{DynamicResource Loc.QuickFill.Button.AddApiKeyField}"
                        Command="{Binding AddApiKeyFieldCommand}"
                        Classes="qfe-secondary"
                        HorizontalAlignment="Right" />
              </StackPanel>

              <StackPanel Spacing="10"
                          IsVisible="{Binding IsAuthenticatorFieldSource}">
                <ComboBox ItemsSource="{Binding AuthenticatorOptions}"
                          SelectedItem="{Binding SelectedAuthenticatorOption}"
                          Classes="qfe-input" />
                <Button Content="{DynamicResource Loc.QuickFill.Button.AddAuthenticatorField}"
                        Command="{Binding AddAuthenticatorFieldCommand}"
                        Classes="qfe-secondary"
                        HorizontalAlignment="Right" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10"
                        IsVisible="{Binding IsAddKeyMode}">
              <Border Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrushSoft}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="12"
                      Focusable="True">
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource Loc.QuickFill.Sequence.KeyCaptureTitle}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource Loc.QuickFill.Sequence.KeyCaptureSubtitle}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="12"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10"
                        IsVisible="{Binding IsAddTextMode}">
              <TextBox Text="{Binding AddStepText}"
                       PlaceholderText="{DynamicResource Loc.QuickFill.Sequence.TextPlaceholder}"
                       Classes="qfe-input"/>
              <Button Content="{DynamicResource Loc.QuickFill.Sequence.AddText}"
                      Command="{Binding AddTextSequenceStepCommand}"
                      Classes="qfe-secondary"
                      HorizontalAlignment="Right"/>
            </StackPanel>

            <StackPanel Spacing="10"
                        IsVisible="{Binding IsAddDelayMode}">
              <TextBox Text="{Binding AddStepDelayMilliseconds}"
                       PlaceholderText="{DynamicResource Loc.QuickFill.Sequence.DelayPlaceholder}"
                       Classes="qfe-input"/>
              <Button Content="{DynamicResource Loc.QuickFill.Sequence.AddDelay}"
                      Command="{Binding AddDelaySequenceStepCommand}"
                      Classes="qfe-secondary"
                      HorizontalAlignment="Right"/>
            </StackPanel>
          </Grid>
        </Grid>
      </shared:ModalShell.Body>
      <shared:ModalShell.FooterActions>
        <Grid ColumnDefinitions="Auto,Auto,Auto"
              ColumnSpacing="10">
          <Button Grid.Column="0"
                  Content="{DynamicResource Loc.QuickFill.Sequence.ClearPendingKey}"
                  Classes="modal-shell-secondary-button"
                  IsVisible="{Binding HasPendingKeyStep}"
                  Command="{Binding ClearPendingKeyStepCommand}"/>
          <Button Grid.Column="1"
                  Content="{DynamicResource Loc.QuickFill.Sequence.ConfirmPendingKey}"
                  Classes="modal-shell-primary-button"
                  IsVisible="{Binding HasPendingKeyStep}"
                  Command="{Binding ConfirmPendingKeyStepCommand}"/>
          <Button Grid.Column="2"
                  Content="{DynamicResource Loc.Common.Cancel}"
                  Classes="modal-shell-secondary-button"
                  Command="{Binding CloseAddStepModalCommand}"/>
        </Grid>
      </shared:ModalShell.FooterActions>
    </shared:ModalShell>
  </Grid>
</UserControl>
