<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShellKrypt.Desktop.Views.EditVaultWindow"
        Width="700"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Edit Vault"
        TransparencyLevelHint="None"
        Background="{StaticResource SurfaceRaisedBrush}">
  <Border Background="{StaticResource SurfaceRaisedBrush}"
          CornerRadius="18">
    <Grid RowDefinitions="Auto,Auto">
      <StackPanel Spacing="18"
                  Margin="28">
        <StackPanel Spacing="8">
          <TextBlock Text="Edit Vault"
                     FontSize="30"
                     FontWeight="Black"/>
          <TextBlock Text="Update the display name and description used by the local ShellKrypt launcher."
                     Classes="page-subtitle"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="16">
          <StackPanel Spacing="8">
            <TextBlock Text="DISPLAY NAME"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"
                       FontWeight="Black"
                       LetterSpacing="2.2"/>
            <TextBox x:Name="DisplayNameBox"
                     PlaceholderText="Display name"/>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Spacing="8">
            <TextBlock Text="VAULT FILE"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"
                       FontWeight="Black"
                       LetterSpacing="2.2"/>
            <Border Background="{StaticResource AppBackgroundSoftBrush}"
                    CornerRadius="10"
                    Padding="14,12">
              <TextBlock x:Name="PathText"
                         Classes="page-subtitle"
                         TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Grid>

        <StackPanel Spacing="8">
          <TextBlock Text="DESCRIPTION"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="10"
                     FontWeight="Black"
                     LetterSpacing="2.2"/>
          <TextBox x:Name="DescriptionBox"
                   PlaceholderText="Describe this vault"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="140"/>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="1"
            Background="{StaticResource SurfaceElevatedBrush}"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10"
            Margin="28,22">
        <TextBlock Text="Metadata changes do not modify the encrypted vault file contents."
                   Classes="page-subtitle"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <Button Grid.Column="1"
                Content="Cancel"
                Classes="dialog-cancel-button"
                Click="OnCancelClicked"/>
        <Button Grid.Column="2"
                Content="Save Changes"
                Classes="dialog-primary-button"
                IsDefault="True"
                Click="OnSaveClicked"/>
      </Grid>
    </Grid>
  </Border>

  <Window.Styles>
    <Style Selector="Button.dialog-cancel-button">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="Button.dialog-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="FontWeight" Value="Black"/>
    </Style>
  </Window.Styles>
</Window>
