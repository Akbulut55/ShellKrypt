<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShellKrypt.Desktop.Views.ImportVaultWindow"
        Width="620"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Import Vault">
  <Border Padding="20" Background="{StaticResource AppBackgroundBrush}">
    <StackPanel Spacing="16">
      <StackPanel Spacing="8">
        <TextBlock Text="Import Vault" Classes="section-title"/>
        <TextBlock Text="Add an existing `.skvault` file to the local vault manager."
                   Classes="page-subtitle"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Vault file" Classes="caption"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="PathBox" Grid.Column="0" Watermark="Existing vault path"/>
          <Button Grid.Column="1" Content="Browse" Classes="subtle" Click="OnBrowseClicked"/>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Display name" Classes="caption"/>
        <TextBox x:Name="DisplayNameBox" Watermark="Display name (optional)"/>
      </StackPanel>

      <TextBlock x:Name="ErrorText"
                 Foreground="{StaticResource DangerBrush}"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

      <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right">
        <Button Content="Cancel" Classes="subtle" Click="OnCancelClicked"/>
        <Button Content="Import Vault" Classes="primary" IsDefault="True" Click="OnImportClicked"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
