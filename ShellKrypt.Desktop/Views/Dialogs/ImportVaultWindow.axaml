<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShellKrypt.Desktop.Views.ImportVaultWindow"
        Width="700"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Import Vault"
        Icon="/Assets/main-logo.ico"
        WindowDecorations="None"
        TransparencyLevelHint="None"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid RowDefinitions="40,*"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="10"
            Margin="10,0,0,0">
        <Path Width="20"
              Height="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Fill="{StaticResource CaptionButtonHoverForegroundBrush}"
              Data="{StaticResource IconShellKryptLogo}"/>

        <TextBlock Grid.Column="1"
                   Text="{DynamicResource Loc.Dialog.ImportVault.Title}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   IsHitTestVisible="False"/>

        <Grid Grid.Column="2"
              IsHitTestVisible="False"/>

        <Button Grid.Column="3"
                Classes="import-caption-button import-caption-button-close"
                Click="OnCloseClicked">
          <TextBlock Text="&#xE8BB;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="10"/>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{StaticResource SurfaceRaisedBrush}">
      <Grid RowDefinitions="Auto,Auto">
      <StackPanel Spacing="18"
                  Margin="28">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource Loc.Dialog.ImportVault.Title}"
                     FontSize="30"
                     FontWeight="Black"/>
          <TextBlock Text="{DynamicResource Loc.Dialog.ImportVault.Subtitle}"
                     Classes="page-subtitle"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource Loc.Dialog.ImportVault.FileLabel}"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="10"
                     FontWeight="Black"
                     LetterSpacing="2.2"/>
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="10">
            <TextBox x:Name="PathBox"
                     PlaceholderText="{DynamicResource Loc.Dialog.ImportVault.FilePlaceholder}"/>
            <Button Grid.Column="1"
                    Content="{DynamicResource Loc.Common.Browse}"
                    Classes="dialog-cancel-button"
                    Click="OnBrowseClicked"/>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource Loc.Common.DisplayName.Label}"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="10"
                     FontWeight="Black"
                     LetterSpacing="2.2"/>
          <TextBox x:Name="DisplayNameBox"
                   PlaceholderText="{DynamicResource Loc.Dialog.ImportVault.DisplayNamePlaceholder}"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="False"/>
      </StackPanel>

      <Grid Grid.Row="1"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10"
            Margin="28,0,28,28">
        <TextBlock Text="{DynamicResource Loc.Dialog.ImportVault.Footer}"
                   Classes="page-subtitle"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <Button Grid.Column="1"
                Content="{DynamicResource Loc.Common.Cancel}"
                Classes="dialog-cancel-button"
                Click="OnCancelClicked"/>
        <Button Grid.Column="2"
                Content="{DynamicResource Loc.Dialog.ImportVault.ImportButton}"
                Classes="dialog-primary-button"
                IsDefault="True"
                Click="OnImportClicked"/>
      </Grid>
      </Grid>
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.import-caption-button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="46"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource CaptionButtonForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.import-caption-button:pointerover">
      <Setter Property="Background" Value="{StaticResource CaptionButtonHoverBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource CaptionButtonHoverForegroundBrush}"/>
    </Style>

    <Style Selector="Button.import-caption-button-close:pointerover">
      <Setter Property="Background" Value="{StaticResource CaptionButtonCloseHoverBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource CaptionButtonHoverForegroundBrush}"/>
    </Style>

    <Style Selector="Button.dialog-cancel-button">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="Button.dialog-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="Black"/>
    </Style>
  </Window.Styles>
</Window>
