<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShellKrypt.Desktop.Views.ConfirmActionWindow"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Title="Confirm Action"
        TransparencyLevelHint="None"
        Background="{StaticResource SurfaceRaisedBrush}">
  <Border Background="{StaticResource SurfaceRaisedBrush}"
          CornerRadius="18"
          Padding="0">
      <Grid RowDefinitions="Auto,Auto,Auto">
        <StackPanel Spacing="18"
                    Margin="32,30,32,24">
          <Border Width="68"
                  Height="68"
                  CornerRadius="34"
                  Background="{StaticResource DangerPanelBrush}"
                  HorizontalAlignment="Center">
            <TextBlock Text="!"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="28"
                       FontWeight="Black"/>
          </Border>

          <TextBlock x:Name="MessageText"
                     FontSize="28"
                     FontWeight="Black"
                     TextAlignment="Center"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Spacing="16"
                    Margin="32,0,32,28">
          <Border Background="{StaticResource DangerPanelBrush}"
                  BorderBrush="{StaticResource DangerBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16,14">
            <TextBlock x:Name="DetailText"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
          </Border>
        </StackPanel>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="12"
              Margin="32,0,32,28">
          <Button Grid.Column="1"
                  Content="Cancel"
                  Classes="dialog-cancel-button"
                  Click="OnCancelClicked"/>
          <Button x:Name="ConfirmButton"
                  Grid.Column="2"
                  Content="Confirm"
                  Classes="dialog-danger-button"
                  IsDefault="True"
                  Click="OnConfirmClicked"/>
        </Grid>
      </Grid>
  </Border>

  <Window.Styles>
    <Style Selector="Button.dialog-cancel-button">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.dialog-danger-button">
      <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource DangerForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="MinWidth" Value="200"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>
</Window>
