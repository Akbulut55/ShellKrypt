<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShellKrypt.Desktop.Views.PasswordPromptWindow"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Title="Confirm Password"
        Background="{StaticResource SurfaceRaisedBrush}">
  <Border Background="{StaticResource SurfaceRaisedBrush}"
          CornerRadius="18">
    <Grid RowDefinitions="Auto,Auto">
      <StackPanel Spacing="18"
                  Margin="32,30,32,24">
        <StackPanel Spacing="8">
          <TextBlock x:Name="MessageText"
                     FontSize="30"
                     FontWeight="Black"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="DetailText"
                     Classes="page-subtitle"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="MASTER PASSWORD"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="10"
                     FontWeight="Black"
                     LetterSpacing="2.2"/>
          <TextBox x:Name="PasswordBox"
                   Classes="dialog-password-box"
                   PlaceholderText="Enter the master password"
                   PasswordChar="*"/>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="1"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10"
            Margin="32,0,32,28">
        <TextBlock Text="This confirms that the destructive or high-sensitivity action is intentional."
                   Classes="page-subtitle"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <Button Grid.Column="1"
                Content="Cancel"
                Classes="dialog-cancel-button"
                Click="OnCancelClicked"/>
        <Button x:Name="ConfirmButton"
                Grid.Column="2"
                Content="Confirm"
                Classes="dialog-primary-button"
                IsDefault="True"
                Click="OnConfirmClicked"/>
      </Grid>
    </Grid>
  </Border>

  <Window.Styles>
    <Style Selector="Button.dialog-cancel-button">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.dialog-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="MinWidth" Value="136"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.dialog-password-box">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Padding" Value="14,0,14,1"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.dialog-password-box:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Styles>
</Window>
