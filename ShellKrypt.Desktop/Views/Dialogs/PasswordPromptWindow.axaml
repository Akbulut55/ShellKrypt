<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShellKrypt.Desktop.Views.PasswordPromptWindow"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirm Password"
        Background="#900e0e0e">
  <Border Background="{StaticResource SurfaceRaisedBrush}"
          CornerRadius="18">
    <Grid RowDefinitions="Auto,Auto">
      <StackPanel Spacing="18"
                  Margin="28">
        <StackPanel Spacing="8">
          <TextBlock x:Name="MessageText"
                     FontSize="30"
                     FontWeight="Black"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="DetailText"
                     Classes="page-subtitle"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="MASTER PASSWORD"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="10"
                     FontWeight="Black"
                     LetterSpacing="2.2"/>
          <TextBox x:Name="PasswordBox"
                   PlaceholderText="Enter the master password"
                   PasswordChar="*"/>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="1"
            Background="{StaticResource SurfaceElevatedBrush}"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10"
            Margin="28,22">
        <TextBlock Text="This confirms that the destructive or high-sensitivity action is intentional."
                   Classes="page-subtitle"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <Button Grid.Column="1"
                Content="Cancel"
                Classes="dialog-cancel-button"
                Click="OnCancelClicked"/>
        <Button x:Name="ConfirmButton"
                Grid.Column="2"
                Content="Confirm"
                Classes="dialog-primary-button"
                IsDefault="True"
                Click="OnConfirmClicked"/>
      </Grid>
    </Grid>
  </Border>

  <Window.Styles>
    <Style Selector="Button.dialog-cancel-button">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="Button.dialog-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="FontWeight" Value="Black"/>
    </Style>
  </Window.Styles>
</Window>
