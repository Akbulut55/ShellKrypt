<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">

  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>
    <TextBlock Text="{Binding Message}" Opacity="0.7" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>