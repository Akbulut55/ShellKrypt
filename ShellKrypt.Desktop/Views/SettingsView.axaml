<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <StackPanel Margin="24" Spacing="14" Width="560">
    <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"/>
    <TextBlock Text="{Binding Status}" Opacity="0.75" TextWrapping="Wrap"/>

    <Border Padding="16" CornerRadius="10" BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="Session" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SessionState}" Opacity="0.8"/>
        <TextBlock Text="{Binding VaultPath}" Opacity="0.8" TextWrapping="Wrap"/>
        <Button Content="Copy Vault Path"
                Command="{Binding CopyVaultPathCommand}"
                HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <Border Padding="16" CornerRadius="10" BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="Security" FontSize="16" FontWeight="SemiBold"/>
        <CheckBox Content="Enable auto-lock"
                  IsChecked="{Binding AutoLockEnabled}"/>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Auto-lock after" VerticalAlignment="Center"/>
          <TextBox Width="120" Text="{Binding AutoLockMinutesText}"/>
          <TextBlock Text="minutes" VerticalAlignment="Center" Opacity="0.8"/>
        </StackPanel>

        <CheckBox Content="Lock when the window is deactivated"
                  IsChecked="{Binding LockOnDeactivate}"/>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Clear copied clipboard items after" VerticalAlignment="Center"/>
          <TextBox Width="120" Text="{Binding ClipboardClearSecondsText}"/>
          <TextBlock Text="seconds" VerticalAlignment="Center" Opacity="0.8"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
