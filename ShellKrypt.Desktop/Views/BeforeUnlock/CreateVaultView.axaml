<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.CreateVaultView"
             x:CompileBindings="False"
             x:DataType="vm:CreateVaultViewModel">

  <Grid Background="{StaticResource AppBackgroundBrush}">
      <StackPanel Margin="28,24,28,28"
                  MaxWidth="1360"
                  Spacing="24"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal"
                    Spacing="12">
          <Border Width="34"
                  Height="34"
                  CornerRadius="10"
                  Background="{StaticResource AccentMutedBrush}">
            <Path Width="20"
                  Height="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stretch="Uniform"
                  Fill="{StaticResource AccentBrush}"
                  Data="{StaticResource IconShellKryptLogo}"/>
          </Border>
          <TextBlock Text="ShellKrypt"
                     Foreground="{StaticResource AccentBrush}"
                     FontSize="20"
                     FontWeight="Black"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <Grid ColumnDefinitions="1.15*,0.85*"
              ColumnSpacing="24">
          <Border Classes="create-main-card">
            <StackPanel Spacing="22">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.CreateVault.Title}"
                           FontSize="34"
                           FontWeight="Black"
                           LetterSpacing="-0.6"/>
                <TextBlock Text="{DynamicResource Loc.CreateVault.Subtitle}"
                           Classes="page-subtitle"
                           FontSize="14"
                           MaxWidth="620"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*"
                    ColumnSpacing="16">
                <StackPanel Spacing="8">
                  <TextBlock Text="{DynamicResource Loc.Common.DisplayName.Label}"
                             Classes="create-kicker"/>
                  <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{DynamicResource Loc.CreateVault.DisplayName.Placeholder}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="8">
                  <TextBlock Text="{DynamicResource Loc.CreateVault.Location.Label}"
                             Classes="create-kicker"/>
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">
                    <TextBox Text="{Binding VaultPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{DynamicResource Loc.CreateVault.Location.Placeholder}"/>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Loc.Common.Browse}"
                            Classes="sk-secondary"
                            Command="{Binding BrowseVaultPathCommand}"/>
                  </Grid>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.Common.Description.Label}"
                           Classes="create-kicker"/>
                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{DynamicResource Loc.CreateVault.Description.Placeholder}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="110"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*"
                    ColumnSpacing="16">
                <StackPanel Spacing="8">
                  <TextBlock Text="{DynamicResource Loc.Common.MasterPassword.Label}"
                             Classes="create-kicker"/>
                  <TextBox Text="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{DynamicResource Loc.CreateVault.MasterPassword.Placeholder}"
                           PasswordChar="*"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="8">
                  <TextBlock Text="{DynamicResource Loc.CreateVault.ConfirmPassword.Label}"
                             Classes="create-kicker"/>
                  <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{DynamicResource Loc.CreateVault.ConfirmPassword.Placeholder}"
                           PasswordChar="*"/>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*"
                    ColumnSpacing="16">
                <StackPanel Spacing="8">
                  <TextBlock Text="{DynamicResource Loc.CreateVault.SecurityProfile.Label}"
                             Classes="create-kicker"/>
                  <ComboBox ItemsSource="{Binding SecurityProfiles}"
                            SelectedItem="{Binding SelectedSecurityProfile}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="8">
                  <TextBlock Text="{DynamicResource Loc.CreateVault.PasswordGuidance.Label}"
                             Classes="create-kicker"/>
                  <Border Classes="create-guidance-card">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding PasswordGuidanceText}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding SelectedSecurityDescription}"
                                 Classes="page-subtitle"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Opacity="0.8"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>

              <TextBlock Text="{Binding Error}"
                         Foreground="{StaticResource DangerBrush}"
                         FontSize="12"
                         IsVisible="{Binding HasError}"/>

              <Grid ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="10">
                <Button Grid.Column="1"
                        Content="{DynamicResource Loc.Common.Back}"
                        Classes="sk-secondary"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding !IsBusy}"/>
                <Button Grid.Column="2"
                        Content="{DynamicResource Loc.CreateVault.Button.Create}"
                        Classes="sk-primary"
                        Command="{Binding CreateCommand}"
                        IsEnabled="{Binding !IsBusy}"/>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="1"
                      Spacing="18">
            <Border Classes="create-side-card">
              <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource Loc.CreateVault.Sidebar.Step1.Title}"
                           FontSize="15"
                           FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Loc.CreateVault.Sidebar.Step1.Body}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Classes="create-side-card">
              <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource Loc.CreateVault.Sidebar.Step2.Title}"
                           FontSize="15"
                           FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Loc.CreateVault.Sidebar.Step2.Body}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Classes="create-side-card">
              <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource Loc.CreateVault.Sidebar.Step3.Title}"
                           FontSize="15"
                           FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Loc.CreateVault.Sidebar.Step3.Body}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.create-main-card">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="26"/>
    </Style>

    <Style Selector="Border.create-side-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <Style Selector="TextBlock.create-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1.2"/>
    </Style>

    <Style Selector="Border.create-guidance-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
  </UserControl.Styles>
</UserControl>
