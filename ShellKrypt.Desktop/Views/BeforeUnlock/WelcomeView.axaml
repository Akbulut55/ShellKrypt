<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.WelcomeView"
             x:CompileBindings="False"
             x:DataType="vm:WelcomeViewModel">

  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="28,24,28,28"
          MaxWidth="1420"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          RowSpacing="24">
      <Grid ColumnDefinitions="Auto,*"
            ColumnSpacing="18"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
          <Border Width="34"
                  Height="34"
                  CornerRadius="10"
                  Background="{StaticResource AccentMutedBrush}">
            <TextBlock Text="SK"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="Black"
                       FontSize="11"/>
          </Border>
          <TextBlock Text="ShellKrypt"
                     Foreground="{StaticResource AccentBrush}"
                     FontSize="20"
                     FontWeight="Black"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <Button Content="Import Existing Vault"
                  Classes="welcome-secondary-button"
                  Command="{Binding ImportVaultCommand}"/>
          <Button Content="+ Create New Vault"
                  Classes="welcome-primary-button"
                  Command="{Binding CreateVaultCommand}"/>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1"
                  Spacing="12"
                  HorizontalAlignment="Center"
                  Margin="0,18,0,4">
        <TextBlock HorizontalAlignment="Center">
          <Run Text="Welcome to your "
               FontSize="48"
               FontWeight="Black"/>
          <Run Text="Sanctum"
               FontSize="48"
               FontWeight="Black"
               Foreground="{StaticResource AccentBrush}"/>
        </TextBlock>
        <TextBlock Text="Open a local encrypted vault or create a new one to manage web logins, credit cards, markdown notes, and security tools."
                   Classes="page-subtitle"
                   FontSize="16"
                   MaxWidth="760"
                   TextAlignment="Center"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Grid Grid.Row="2"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="18"
            VerticalAlignment="Center">
        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Classes="welcome-search-box"
                 PlaceholderText="Search your vaults..."
                 HorizontalAlignment="Left"/>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="SORT BY"
                     Classes="welcome-mini-label"
                     VerticalAlignment="Center"
                     Margin="0,0,4,0"/>
          <Button Content="Recent"
                  Classes="welcome-sort-chip"
                  Classes.active="{Binding IsRecentSortActive}"
                  Command="{Binding SortByRecentCommand}"/>
          <Button Content="Name"
                  Classes="welcome-sort-chip"
                  Classes.active="{Binding IsNameSortActive}"
                  Command="{Binding SortByNameCommand}"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="3">
        <ItemsControl ItemsSource="{Binding Vaults}"
                      IsVisible="{Binding HasVaults}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="14"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VaultRecordVm">
              <Border Classes="welcome-vault-card">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="18">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="18">
                    <Border Width="52"
                            Height="52"
                            CornerRadius="12"
                            Background="{StaticResource SurfaceRaisedBrush}">
                      <TextBlock Text="VA"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource AccentBrush}"
                                 FontWeight="Black"
                                 FontSize="13"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="10">
                        <TextBlock Text="{Binding DisplayLabel}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Background="{StaticResource AccentMutedBrush}"
                                CornerRadius="999"
                                Padding="10,4"
                                IsVisible="{Binding IsDefault}">
                          <TextBlock Text="Default"
                                     Foreground="{StaticResource SuccessBrush}"
                                     FontSize="10"
                                     FontWeight="Black"/>
                        </Border>
                      </StackPanel>

                      <TextBlock Text="{Binding DescriptionDisplay}"
                                 Classes="page-subtitle"
                                 FontSize="13"
                                 TextTrimming="CharacterEllipsis"/>

                      <StackPanel Orientation="Horizontal"
                                  Spacing="16">
                        <TextBlock Text="{Binding LastOpenedDisplay, StringFormat=Last Accessed: {0}}"
                                   Classes="welcome-card-meta"/>
                        <TextBlock Text="{Binding PathDisplay}"
                                   Classes="welcome-card-meta"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>

                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center">
                    <Button Content="Open"
                            Classes="welcome-row-primary"
                            Command="{Binding DataContext.OpenVaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="Edit"
                            Classes="welcome-row-button"
                            Command="{Binding DataContext.EditVaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="Default"
                            Classes="welcome-row-button"
                            Command="{Binding DataContext.MakeDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding !IsDefault}"/>
                    <Button Content="Delete"
                            Classes="welcome-row-danger"
                            Command="{Binding DataContext.DeleteVaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Background="Transparent"
                Padding="20,30"
                IsVisible="{Binding !HasVaults}">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding EmptyStateTitle}"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding EmptyStateSubtitle}"
                       Classes="page-subtitle"
                       MaxWidth="520"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal"
                        Spacing="10">
              <Button Content="Import Existing Vault"
                      Classes="welcome-secondary-button"
                      Command="{Binding ImportVaultCommand}"/>
              <Button Content="Create New Vault"
                      Classes="welcome-primary-button"
                      Command="{Binding CreateVaultCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="4"
            ColumnDefinitions="*,Auto"
            IsVisible="{Binding HasMultiplePages}">
        <Border Background="Transparent"/>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <Button Content="Previous"
                  Classes="welcome-row-button"
                  Command="{Binding PreviousPageCommand}"
                  IsEnabled="{Binding CanGoPreviousPage}"/>
          <TextBlock Text="{Binding PageIndicator}"
                     VerticalAlignment="Center"
                     FontSize="12"
                     FontWeight="SemiBold"/>
          <Button Content="Next"
                  Classes="welcome-row-button"
                  Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding CanGoNextPage}"/>
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="5"
                 Text="{Binding Error}"
                 Foreground="{StaticResource DangerBrush}"
                 FontSize="12"
                 IsVisible="{Binding HasError}"
                 Margin="0,0,0,4"/>

      <StackPanel Grid.Row="5"
                  Orientation="Horizontal"
                  Spacing="28"
                  VerticalAlignment="Bottom">
        <StackPanel Spacing="3">
          <TextBlock Text="TOTAL STORAGE USED"
                     Classes="welcome-mini-label"/>
          <TextBlock Text="{Binding TotalStorageDisplay}"
                     FontSize="15"
                     FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="AVAILABLE VAULTS"
                     Classes="welcome-mini-label"/>
          <TextBlock Text="{Binding ExistingVaultCount, StringFormat={}{0} Vaults}"
                     FontSize="15"
                     FontWeight="SemiBold"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>

  <UserControl.Styles>
    <Style Selector="TextBox.welcome-search-box">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Width" Value="400"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="MinHeight" Value="50"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="TextBlock.welcome-mini-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="Button.welcome-sort-chip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.welcome-sort-chip.active">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.welcome-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.welcome-secondary-button">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.welcome-vault-card">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20"/>
    </Style>

    <Style Selector="Border.welcome-vault-card:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    </Style>

    <Style Selector="TextBlock.welcome-card-meta">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.welcome-row-primary">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.welcome-row-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.welcome-row-danger">
      <Setter Property="Background" Value="#3A2426"/>
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
</UserControl>
