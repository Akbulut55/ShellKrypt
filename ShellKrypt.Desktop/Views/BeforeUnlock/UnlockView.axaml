<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.UnlockView"
             x:CompileBindings="False"
             x:DataType="vm:UnlockViewModel">
  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Border Background="{StaticResource HeroGlowPrimaryBrush}"
            CornerRadius="999"
            Width="420"
            Height="420"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="180,160,0,0"
            IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="120"/>
      </Border.Effect>
    </Border>

    <Border Background="{StaticResource HeroGlowSecondaryBrush}"
            CornerRadius="999"
            Width="360"
            Height="360"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,180,140"
            IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="110"/>
      </Border.Effect>
    </Border>

    <StackPanel Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
      <StackPanel Spacing="8"
                  HorizontalAlignment="Center">
        <Border Width="62"
                Height="62"
                CornerRadius="14"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1">
          <TextBlock Text="SK"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource AccentBrush}"
                     FontWeight="Black"
                     FontSize="20"/>
        </Border>
        <TextBlock Text="ShellKrypt"
                   FontSize="28"
                   FontWeight="Black"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Military Grade Encryption"
                   Classes="page-subtitle"
                   FontSize="14"
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <Border Classes="unlock-card">
        <StackPanel Spacing="0">
          <Border Padding="36,32">
            <StackPanel Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding VaultTitle}"
                         FontSize="20"
                         FontWeight="SemiBold"/>
              <TextBlock Text="{Binding VaultDescription}"
                         Classes="page-subtitle"
                         FontSize="13"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="MASTER PASSWORD"
                         Classes="unlock-kicker"/>
              <Border Classes="unlock-password-shell">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                  <TextBox Text="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="unlock-password-box"
                           PlaceholderText="Enter your decryption key"
                           PasswordChar="*"
                           IsVisible="{Binding !ShowPassword}"/>
                  <TextBox Text="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Classes="unlock-password-box"
                           PlaceholderText="Enter your decryption key"
                           IsVisible="{Binding ShowPassword}"/>
                  <Button Grid.Column="1"
                        Content="{Binding PasswordVisibilityLabel}"
                        Classes="unlock-visibility-button"
                        Command="{Binding TogglePasswordVisibilityCommand}"/>
                </Grid>
              </Border>
            </StackPanel>

            <Button Content="Unlock Vault"
                    Classes="unlock-primary-button"
                    Command="{Binding UnlockCommand}"
                    IsDefault="True"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding !IsBusy}"/>

              <Grid ColumnDefinitions="*,Auto"
                  Margin="0,6,0,0">
              <StackPanel Spacing="4">
                <TextBlock Text="VAULT STATUS"
                           Classes="unlock-kicker"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <Border Width="8"
                          Height="8"
                          CornerRadius="999"
                          Background="{StaticResource DangerBrush}"
                          VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding VaultStatusDisplay}"
                             FontSize="12"
                             FontWeight="SemiBold"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="4"
                          HorizontalAlignment="Right">
                <TextBlock Text="LAST UPDATED"
                           Classes="unlock-kicker"
                           HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding LastUpdatedDisplay}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
              </StackPanel>
            </Grid>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceRaisedBrush}"
                  Padding="36,20">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="✓"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Black"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding EncryptionDisplay}"
                           Classes="page-subtitle"
                           FontSize="12"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Forgot Master Password?"
                      Classes="unlock-link-button"
                      Command="{Binding ShowRecoveryCommand}"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Button Content="Back to Vaults"
              Classes="unlock-footer-link"
              Command="{Binding BackCommand}"
              HorizontalAlignment="Center"/>

      <TextBlock Text="{Binding Error}"
                 Foreground="{StaticResource DangerBrush}"
                 FontSize="12"
                 TextAlignment="Center"
                 IsVisible="{Binding HasError}"/>

      <TextBlock Text="{Binding SessionIdDisplay}"
                 Classes="page-subtitle"
                 FontSize="10"
                 HorizontalAlignment="Center"
                 Opacity="0.55"/>
    </StackPanel>

    <Border Background="{StaticResource OverlaySoftScrimBrush}"
            IsVisible="{Binding ShowRecoveryInfo}">
      <Grid HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="480"
            Margin="24">
        <Border Background="{StaticResource SidebarBrush}"
                CornerRadius="18"
                Padding="24">
          <StackPanel Spacing="18">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding RecoveryTitle}"
                         FontSize="24"
                         FontWeight="Black"
                         TextWrapping="Wrap"/>
              <TextBlock Text="{Binding RecoveryBody}"
                         Classes="page-subtitle"
                         FontSize="13"
                         TextWrapping="Wrap"/>
              <TextBlock Text="{Binding RecoverySecondaryBody}"
                         Classes="page-subtitle"
                         FontSize="13"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="14">
              <StackPanel Spacing="6">
                <TextBlock Text="Recommended recovery path"
                           Classes="unlock-kicker"/>
                <TextBlock Text="1. Unlock the vault on a device where it is still open."
                           Classes="page-subtitle"
                           FontSize="12"/>
                <TextBlock Text="2. Export an encrypted backup with a separate passphrase."
                           Classes="page-subtitle"
                           FontSize="12"/>
                <TextBlock Text="3. Change the master password in Settings before locking the vault again."
                           Classes="page-subtitle"
                           FontSize="12"/>
              </StackPanel>
            </Border>

            <Button Content="Close"
                    Classes="unlock-primary-button"
                    Command="{Binding CloseRecoveryCommand}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.unlock-card">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="TextBlock.unlock-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="Button.unlock-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.unlock-password-shell">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="0,0,6,0"/>
    </Style>

    <Style Selector="TextBox.unlock-password-box">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Padding" Value="14,0,14,1"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.unlock-visibility-button">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="MinWidth" Value="60"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>

    <Style Selector="TextBox.unlock-password-box /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="TextBox.unlock-password-box:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBox.unlock-password-box:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.unlock-link-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Button.unlock-footer-link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
</UserControl>
