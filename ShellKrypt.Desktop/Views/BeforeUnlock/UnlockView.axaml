<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.UnlockView"
             x:CompileBindings="False"
             x:DataType="vm:UnlockViewModel">
  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Border Background="#1800ffff"
            CornerRadius="999"
            Width="420"
            Height="420"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="180,160,0,0"
            IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="120"/>
      </Border.Effect>
    </Border>

    <Border Background="#101a4f47"
            CornerRadius="999"
            Width="360"
            Height="360"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,180,140"
            IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="110"/>
      </Border.Effect>
    </Border>

    <StackPanel Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="22">
      <StackPanel Spacing="10"
                  HorizontalAlignment="Center">
        <Border Width="62"
                Height="62"
                CornerRadius="14"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1">
          <TextBlock Text="SK"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource AccentBrush}"
                     FontWeight="Black"
                     FontSize="20"/>
        </Border>
        <TextBlock Text="ShellKrypt"
                   FontSize="28"
                   FontWeight="Black"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Military Grade Encryption"
                   Classes="page-subtitle"
                   FontSize="14"
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <Border Classes="unlock-card">
        <StackPanel Spacing="0">
          <Border Padding="28">
            <StackPanel Spacing="18">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding VaultTitle}"
                         FontSize="20"
                         FontWeight="SemiBold"/>
              <TextBlock Text="{Binding VaultDescription}"
                         Classes="page-subtitle"
                         FontSize="13"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="MASTER PASSWORD"
                         Classes="unlock-kicker"/>
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                <TextBox Text="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Enter your decryption key"
                         PasswordChar="*"
                         IsVisible="{Binding !ShowPassword}"/>
                <TextBox Text="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Enter your decryption key"
                         IsVisible="{Binding ShowPassword}"/>
                <Button Grid.Column="1"
                        Content="{Binding PasswordVisibilityLabel}"
                        Classes="unlock-visibility-button"
                        Command="{Binding TogglePasswordVisibilityCommand}"/>
              </Grid>
            </StackPanel>

            <Button Content="Unlock Vault"
                    Classes="unlock-primary-button"
                    Command="{Binding UnlockCommand}"
                    IsEnabled="{Binding !IsBusy}"/>

            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,10,0,0">
              <StackPanel Spacing="4">
                <TextBlock Text="VAULT STATUS"
                           Classes="unlock-kicker"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <Border Width="8"
                          Height="8"
                          CornerRadius="999"
                          Background="{StaticResource DangerBrush}"
                          VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding VaultStatusDisplay}"
                             FontSize="12"
                             FontWeight="SemiBold"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="4"
                          HorizontalAlignment="Right">
                <TextBlock Text="LAST UPDATED"
                           Classes="unlock-kicker"
                           HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding LastUpdatedDisplay}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
              </StackPanel>
            </Grid>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceRaisedBrush}"
                  Padding="28,18">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="✓"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Black"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding EncryptionDisplay}"
                           Classes="page-subtitle"
                           FontSize="12"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Forgot Master Password?"
                      Classes="unlock-link-button"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal"
                  Spacing="20"
                  HorizontalAlignment="Center">
        <Button Content="Back to Vaults"
                Classes="unlock-footer-link"
                Command="{Binding BackCommand}"/>
        <TextBlock Text="Help Center"
                   Classes="page-subtitle"
                   FontSize="12"
                   VerticalAlignment="Center"/>
        <TextBlock Text="Emergency Access"
                   Classes="page-subtitle"
                   FontSize="12"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock Text="{Binding Error}"
                 Foreground="{StaticResource DangerBrush}"
                 FontSize="12"
                 TextAlignment="Center"
                 IsVisible="{Binding HasError}"/>

      <TextBlock Text="{Binding SessionIdDisplay}"
                 Classes="page-subtitle"
                 FontSize="10"
                 HorizontalAlignment="Center"
                 Opacity="0.55"/>
    </StackPanel>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.unlock-card">
      <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="TextBlock.unlock-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="Button.unlock-primary-button">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="FontWeight" Value="Black"/>
    </Style>

    <Style Selector="Button.unlock-visibility-button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Button.unlock-link-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Button.unlock-footer-link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Styles>
</UserControl>
