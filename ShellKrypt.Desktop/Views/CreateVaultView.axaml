<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.CreateVaultView"
             x:DataType="vm:CreateVaultViewModel">

  <StackPanel Margin="24" Spacing="12" Width="560">
    <TextBlock Text="Create Vault" FontSize="22" FontWeight="Bold"/>
    <TextBlock Text="Set a display name, confirm the file path, and choose whether this vault should become your default."
               Opacity="0.75"
               TextWrapping="Wrap"/>

    <TextBox Watermark="Display name" Text="{Binding DisplayName}"/>
    <TextBox Watermark="Description" Text="{Binding Description}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"/>

    <TextBlock Text="Vault location:" Opacity="0.75"/>
    <TextBox Text="{Binding VaultPath}" IsReadOnly="True"/>

    <CheckBox Content="Make this the default vault" IsChecked="{Binding IsDefaultVault}"/>

    <TextBox Watermark="Master password" PasswordChar="●" Text="{Binding MasterPassword}"/>
    <TextBox Watermark="Confirm password" PasswordChar="●" Text="{Binding ConfirmPassword}"/>

    <TextBlock Text="{Binding Error}" Foreground="Tomato" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding !IsBusy}"/>
      <Button Content="Create" Command="{Binding CreateCommand}" IsEnabled="{Binding !IsBusy}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
