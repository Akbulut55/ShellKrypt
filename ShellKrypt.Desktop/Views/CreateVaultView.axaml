<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.CreateVaultView"
             x:DataType="vm:CreateVaultViewModel">

  <StackPanel Margin="24" Spacing="12" Width="520">
    <TextBlock Text="Create Vault" FontSize="22" FontWeight="Bold"/>

    <TextBlock Text="Vault location (default AppData):" Opacity="0.75"/>
    <TextBox Text="{Binding VaultPath}" IsReadOnly="True"/>

    <TextBox Watermark="Master password" PasswordChar="●" Text="{Binding MasterPassword}"/>
    <TextBox Watermark="Confirm password" PasswordChar="●" Text="{Binding ConfirmPassword}"/>

    <TextBlock Text="{Binding Error}" Foreground="Tomato" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding !IsBusy}"/>
      <Button Content="Create" Command="{Binding CreateCommand}" IsEnabled="{Binding !IsBusy}"/>
    </StackPanel>
  </StackPanel>
</UserControl>