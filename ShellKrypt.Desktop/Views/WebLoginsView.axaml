<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.WebLoginsView"
             x:CompileBindings="False"
             x:DataType="vm:WebLoginsViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="Web Logins" Classes="page-title"/>
          <TextBlock Text="Manage your secure credentials for web platforms."
                     Classes="page-subtitle"/>
        </StackPanel>

        <Border Classes="badge" Padding="12,8" VerticalAlignment="Top">
          <TextBlock Text="AES-256 Encrypted"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{StaticResource SuccessBrush}"/>
        </Border>
      </Grid>

      <Border Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Background="{StaticResource SurfaceRaisedBrush}"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  BorderThickness="0,0,0,1"
                  Padding="18,14">
            <Grid ColumnDefinitions="1.4*,1.25*,1.15*,1.05*,Auto" ColumnSpacing="12">
              <TextBlock Text="Title" Classes="caption"/>
              <TextBlock Grid.Column="1" Text="Username" Classes="caption"/>
              <TextBlock Grid.Column="2" Text="Password" Classes="caption"/>
              <TextBlock Grid.Column="3" Text="URL" Classes="caption"/>
              <TextBlock Grid.Column="4" Text="Actions" Classes="caption"/>
            </Grid>
          </Border>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WebLoginRowVm">
                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                  <Border Padding="16,14">
                    <Grid ColumnDefinitions="1.4*,1.25*,1.15*,1.05*,Auto"
                          ColumnSpacing="12">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="8"
                                Background="{StaticResource AppBackgroundSoftBrush}">
                          <TextBlock Text="{Binding IconLetter}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding Title}"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Url}"
                                     Classes="caption"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Grid>

                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Copy on hover"
                                   Classes="caption"/>
                      </StackPanel>

                      <Grid Grid.Column="2"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding PasswordDisplay}"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1"
                                Classes="icon subtle"
                                Content="◔"
                                ToolTip.Tip="Reveal password"/>
                      </Grid>

                      <TextBlock Grid.Column="3"
                                 Text="{Binding Url}"
                                 Classes="page-subtitle"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>

                      <StackPanel Grid.Column="4"
                                  Classes="row-actions"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Spacing="4"
                                  VerticalAlignment="Center">
                        <Button Classes="icon subtle"
                                Content="↗"
                                ToolTip.Tip="Open"/>
                        <Button Classes="icon subtle"
                                Content="⧉"
                                ToolTip.Tip="Copy username"/>
                        <Button Classes="icon subtle"
                                Content="⌘"
                                ToolTip.Tip="Copy password"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="1.2*,0.8*" ColumnSpacing="18">
        <Border Classes="panel-raised" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Password Health Check" Classes="section-title"/>
            <TextBlock Text="We analyzed your vault. 2 passwords are reused across multiple sites and 1 is considered weak. We recommend updating these to generated high-entropy strings."
                       Classes="page-subtitle"
                       TextWrapping="Wrap"/>
            <Button Content="START AUDIT" Classes="subtle inline" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="panel-raised" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Quick Generate" Classes="section-title"/>
            <TextBlock Text="Create a secure 32-character string instantly."
                       Classes="page-subtitle"
                       TextWrapping="Wrap"/>
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="Generated password" Classes="caption"/>
                <TextBlock Text="xy_3b9nY6e_qLJ..."
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Text="3 total items stored in your vault"
                   Classes="caption"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="Page 1 of 1"
                   Classes="caption"
                   VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="StackPanel.row-actions">
      <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem:pointerover StackPanel.row-actions">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>
</UserControl>
