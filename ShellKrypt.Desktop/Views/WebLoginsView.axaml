<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.WebLoginsView"
             x:CompileBindings="False"
             x:DataType="vm:WebLoginsViewModel">

  <Grid RowDefinitions="Auto,*" Margin="16">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBox Watermark="Search vault..."
               Text="{Binding SearchText}"
               Height="38"/>

      <Button Grid.Column="1"
              Content="Add New"
              Command="{Binding AddNewCommand}"
              Height="38"
              Margin="12,0,0,0"/>
    </Grid>

    <Border Grid.Row="1" CornerRadius="12" BorderThickness="1" Padding="12">
      <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="70,2*,2*,2*,150" Margin="4,0,4,8">
          <TextBlock Text="ICON" Opacity="0.7"/>
          <TextBlock Grid.Column="1" Text="TITLE" Opacity="0.7"/>
          <TextBlock Grid.Column="2" Text="USERNAME" Opacity="0.7"/>
          <TextBlock Grid.Column="3" Text="PASSWORD" Opacity="0.7"/>
          <TextBlock Grid.Column="4" Text="ACTIONS" Opacity="0.7" HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="10" Padding="8" Margin="0,4" BorderThickness="1">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="70,2*,2*,2*,150" VerticalAlignment="Center">

                    <Border Width="38" Height="38" CornerRadius="19"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderThickness="1">
                      <TextBlock Text="{Binding IconLetter}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontWeight="Bold"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Title}" IsVisible="{Binding IsViewing}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Title}" IsVisible="{Binding IsEditing}" Height="34" Watermark="Title"/>

                    <TextBlock Grid.Column="2" Text="{Binding Username}" IsVisible="{Binding IsViewing}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Username}" IsVisible="{Binding IsEditing}" Height="34" Watermark="Username"/>

                    <Grid Grid.Column="3" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PasswordDisplay}" IsVisible="{Binding IsViewing}" VerticalAlignment="Center"/>
                      <TextBox Text="{Binding Password}" IsVisible="{Binding IsEditing}" Height="34" Watermark="Password"/>

                      <Button Grid.Column="1"
                              Content="Show"
                              Margin="8,0,0,0"
                              Command="{Binding DataContext.TogglePasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                    </Grid>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button Content="Fav"
                              IsVisible="{Binding IsViewing}"
                              Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>

                      <Button Content="Edit"
                              IsVisible="{Binding IsViewing}"
                              Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>

                      <Button Content="Delete"
                              IsVisible="{Binding IsViewing}"
                              Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>

                      <Button Content="Save"
                              IsVisible="{Binding IsEditing}"
                              Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>

                      <Button Content="Cancel"
                              IsVisible="{Binding IsEditing}"
                              Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="5"
                                Margin="70,8,0,0"
                                Spacing="4">
                      <TextBlock Text="{Binding UrlDisplay}" IsVisible="{Binding IsViewing}" TextWrapping="Wrap"/>
                      <TextBox Text="{Binding Url}" IsVisible="{Binding IsEditing}" Height="34" Watermark="URL"/>

                      <TextBlock Text="{Binding NotesDisplay}" IsVisible="{Binding IsViewing}" TextWrapping="Wrap"/>
                      <TextBox Text="{Binding Notes}" IsVisible="{Binding IsEditing}" Height="60" Watermark="Notes" AcceptsReturn="True" TextWrapping="Wrap"/>

                      <TextBlock Text="{Binding TwoFaNoteDisplay}" IsVisible="{Binding IsViewing}" TextWrapping="Wrap"/>
                      <TextBox Text="{Binding TwoFaNote}" IsVisible="{Binding IsEditing}" Height="60" Watermark="2FA note" AcceptsReturn="True" TextWrapping="Wrap"/>

                      <TextBlock Text="{Binding TotpStatus}" IsVisible="{Binding IsViewing}" TextWrapping="Wrap"/>
                      <TextBox Text="{Binding TotpSecret}" IsVisible="{Binding IsEditing}" Height="34" Watermark="TOTP secret or otpauth URI"/>

                      <Button Content="Copy OTP"
                              IsVisible="{Binding CanCopyTotp}"
                              Command="{Binding DataContext.CopyTotpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                    </StackPanel>

                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="Tomato" Margin="4,10,4,0" TextWrapping="Wrap"/>
      </Grid>
    </Border>

  </Grid>
</UserControl>
