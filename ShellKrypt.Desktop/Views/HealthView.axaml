<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.HealthView"
             x:DataType="vm:HealthViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Health" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="{Binding SummaryText}" Opacity="0.7"/>
          <TextBlock Text="{Binding LastCheckedDisplay}" Opacity="0.55"/>
        </StackPanel>

        <Button Grid.Column="1"
                Content="Refresh"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Top"
                Height="34"
                Padding="16,0"/>
      </Grid>

      <Border Padding="16" CornerRadius="12" BorderThickness="1">
        <UniformGrid Columns="4" Rows="1" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <TextBlock Text="Analyzed" Opacity="0.7"/>
            <TextBlock Text="{Binding AnalyzedCount}" FontSize="20" FontWeight="SemiBold"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Reused" Opacity="0.7"/>
            <TextBlock Text="{Binding ReusedCount}" FontSize="20" FontWeight="SemiBold"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Weak" Opacity="0.7"/>
            <TextBlock Text="{Binding WeakCount}" FontSize="20" FontWeight="SemiBold"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Old" Opacity="0.7"/>
            <TextBlock Text="{Binding OldCount}" FontSize="20" FontWeight="SemiBold"/>
          </StackPanel>
        </UniformGrid>
      </Border>

      <Border Padding="16" CornerRadius="12" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Issues" FontSize="18" FontWeight="SemiBold"/>

          <ItemsControl ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,4" Padding="12" CornerRadius="10" BorderThickness="1">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Severity}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Category}" Opacity="0.7"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Details}" Opacity="0.8" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Error}" Foreground="Tomato" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
