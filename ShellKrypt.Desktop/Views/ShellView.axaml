<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">

  <Grid ColumnDefinitions="256,*" Background="{StaticResource AppBackgroundBrush}">

    <Border Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0,0,1,0"
            Padding="16">
      <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Width="42"
                      Height="42"
                      CornerRadius="12"
                      Background="{StaticResource AccentBrush}">
                <TextBlock Text="SK"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="#051118"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="ShellKrypt" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding VaultSubtitle}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"
                           MaxWidth="150"/>
              </StackPanel>
            </Grid>

            <Border Classes="badge" Padding="10,6">
              <TextBlock Text="{Binding VaultName}" FontWeight="SemiBold"/>
            </Border>

            <Button Content="Lock Vault"
                    Classes="primary"
                    Command="{Binding LockCommand}"/>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock Text="Workspace" Classes="caption"/>

            <ListBox ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedNav}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemVm">
                  <Grid ColumnDefinitions="40,*" ColumnSpacing="12" Margin="2">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="11"
                            Background="{StaticResource AccentMutedBrush}">
                      <TextBlock Text="{Binding ShortCode}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 FontWeight="Bold"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="18" Margin="18">
      <Border Classes="panel" Padding="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding CurrentSectionTitle}" Classes="page-title"/>
            <TextBlock Text="{Binding CurrentSectionSubtitle}" Classes="page-subtitle" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
            <TextBlock Text="Active vault" Classes="caption" HorizontalAlignment="Right"/>
            <Border Classes="badge" Padding="12,8">
              <TextBlock Text="{Binding VaultName}" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="panel" Padding="0" ClipToBounds="True">
        <ContentControl Content="{Binding CurrentPage}"/>
      </Border>
    </Grid>
  </Grid>
</UserControl>
