<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">

  <Grid ColumnDefinitions="240,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
          <TextBlock Text="My Vault" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="Manage your passwords" Opacity="0.7"/>
          <Button Content="Lock" Command="{Binding LockCommand}" Margin="0,8,0,0"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNav}"/>
        
        <TextBlock DockPanel.Dock="Bottom" Text="Settings" Opacity="0.7" Margin="0,16,0,0"/>
      </DockPanel>
    </Border>

    <!-- Page content -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>

  </Grid>
</UserControl>