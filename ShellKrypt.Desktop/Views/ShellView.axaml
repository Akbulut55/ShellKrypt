<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">

  <Grid Background="{StaticResource AppBackgroundBrush}"
        ColumnDefinitions="256,*">
    <Border Background="{StaticResource SidebarBrush}"
            Padding="20,24"
            BorderBrush="{StaticResource WindowOutlineBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="28">
          <StackPanel Spacing="8">
            <TextBlock Text="ShellKrypt"
                       FontSize="20"
                       FontWeight="Black"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Secure Vault"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{StaticResource TextMutedBrush}"/>
          </StackPanel>

          <ListBox ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNav}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItemVm">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="10,9">
                  <Border Width="24"
                          Height="24"
                          CornerRadius="6"
                          Background="{StaticResource SurfaceRaisedBrush}">
                    <TextBlock Text="{Binding ShortCode}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="8"
                               FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}"/>
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="{Binding Title}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="18">
          <Button Content="Lock Vault"
                  Classes="primary"
                  HorizontalAlignment="Stretch"
                  Command="{Binding LockCommand}"/>

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="32"
                    Height="32"
                    CornerRadius="999"
                    Background="{StaticResource SurfaceRaisedBrush}">
              <TextBlock Text="A"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontWeight="Bold"
                         Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="Admin Session" FontSize="12" FontWeight="Bold"/>
              <TextBlock Text="0x9f...4a2b" Classes="caption"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1"
          RowDefinitions="Auto,*"
          Background="{StaticResource AppBackgroundBrush}">
      <Border Padding="24,16"
              Background="{StaticResource AppBackgroundBrush}"
              BorderBrush="{StaticResource WindowOutlineBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="256,Auto,*,Auto" ColumnSpacing="32">
          <TextBox Classes="search"
                   PlaceholderText="{Binding SearchPlaceholder}"
                   VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="28"
                      VerticalAlignment="Center">
            <TextBlock Text="All Items"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       IsVisible="{Binding !IsSettingsSelected}"/>
            <TextBlock Text="All Items"
                       Classes="page-subtitle"
                       FontWeight="SemiBold"
                       IsVisible="{Binding IsSettingsSelected}"/>
            <TextBlock Text="Favorites"
                       Classes="page-subtitle"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Recent"
                       Classes="page-subtitle"
                       FontWeight="SemiBold"/>
          </StackPanel>

          <StackPanel Grid.Column="3"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Spacing="12">
            <Button Classes="icon" Content="S"/>
            <Button Classes="icon" Content="N"/>
            <Button Content="+ Add Item"
                    Classes="primary inline"
                    IsVisible="{Binding ShowAddItemAction}"/>
            <Button Classes="icon" Content="A"/>
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1"
                      Margin="0"
                      Content="{Binding CurrentPage}"/>
    </Grid>
  </Grid>
</UserControl>
