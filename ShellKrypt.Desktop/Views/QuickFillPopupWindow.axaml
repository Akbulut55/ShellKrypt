<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
        xmlns:views="using:ShellKrypt.Desktop.Views"
        x:Class="ShellKrypt.Desktop.Views.QuickFillPopupWindow"
        x:Name="Root"
        x:CompileBindings="False"
        x:DataType="vm:QuickFillPopupViewModel"
        Icon="/Assets/main-logo.ico"
        Title="Quick Fill"
        Width="740"
        Height="680"
        MinWidth="560"
        MinHeight="520"
        CanResize="False"
        Topmost="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

  <Grid RowDefinitions="40,*"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="10"
            Margin="10,0,0,0">
        <Path Width="20"
              Height="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Fill="{StaticResource CaptionButtonHoverForegroundBrush}"
              Data="{StaticResource IconShellKryptLogo}"/>

        <TextBlock Grid.Column="1"
                   Text="{DynamicResource Loc.QuickFill.Popup.Title}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   IsHitTestVisible="False"/>

        <Grid Grid.Column="2"
              IsHitTestVisible="False"/>

        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                  <Button Classes="qf-window-caption-button"
                          Click="OnMinimizeClicked">
                    <Border Width="10"
                            Height="1.5"
                            CornerRadius="1"
                            Background="{StaticResource CaptionButtonForegroundBrush}"/>
                  </Button>

                  <Button Classes="qf-window-caption-button qf-window-caption-button-close"
                          Click="OnCloseClicked">
                    <Path Width="10"
                          Height="10"
                          Stretch="Uniform"
                          Stroke="{StaticResource CaptionButtonForegroundBrush}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          Data="M 2,2 L 8,8 M 8,2 L 2,8"/>
                  </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="14"
            Padding="18"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="12">
      <Grid RowDefinitions="Auto,*"
            RowSpacing="14">
        <Border Classes="qf-target-card"
                IsVisible="{Binding IsUnlocked}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                MinHeight="56">
            <Border Grid.Column="0"
                    Classes="qf-target-strip"/>
            <StackPanel Grid.Column="1"
                        Spacing="4"
                        Margin="14,8">
              <TextBlock Text="{DynamicResource Loc.QuickFill.Editor.TargetApplication}"
                         Classes="qf-kicker"/>
              <TextBlock Text="{Binding TargetDisplay}"
                         FontSize="17"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="2"
                    Content="{Binding MatchScopeLabel}"
                    Classes="qf-popup-secondary qf-popup-small-button"
                    Command="{Binding ToggleMatchScopeCommand}"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding IsBrowsingEntries}"/>
            <TextBlock Grid.Column="3"
                       Text="{Binding Status}"
                       Classes="page-subtitle"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="220"
                       Margin="10,0,0,0"
                       IsVisible="{Binding ShowHeaderStatus}"
                       VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <Border Classes="qf-unlock-card"
                  IsVisible="{Binding IsLocked}">
            <StackPanel Spacing="18">
              <Border Classes="qf-unlock-icon-tile">
                <Path Width="32"
                      Height="32"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Fill="{StaticResource AccentBrush}"
                      Data="{StaticResource IconShellKryptLogo}"/>
              </Border>

              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.QuickFill.Popup.LockedTitle}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center"/>
                <TextBlock Text="{DynamicResource Loc.QuickFill.Popup.LockedSubtitle}"
                           Classes="page-subtitle"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.QuickFill.Popup.TargetVault}"
                           Classes="qf-unlock-label"/>
                <ComboBox ItemsSource="{Binding VaultChoices}"
                          SelectedItem="{Binding SelectedVault, Mode=TwoWay}"
                          Classes="qf-unlock-combo"
                          HorizontalAlignment="Stretch"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.QuickFill.Popup.MasterPassword}"
                           Classes="qf-unlock-label"/>
                <Border Classes="qf-unlock-password-shell">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <TextBox Text="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="qf-unlock-input"
                             PasswordChar="*"
                             PlaceholderText="{DynamicResource Loc.Common.MasterPassword.Placeholder}"
                             IsVisible="{Binding !ShowPassword}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter"
                                    Command="{Binding UnlockCommand}"/>
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBox Text="{Binding MasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Classes="qf-unlock-input"
                             PlaceholderText="{DynamicResource Loc.Common.MasterPassword.Placeholder}"
                             IsVisible="{Binding ShowPassword}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter"
                                    Command="{Binding UnlockCommand}"/>
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Classes="qf-unlock-eye-button"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            ToolTip.Tip="{Binding PasswordVisibilityLabel}">
                      <Grid>
                        <PathIcon Data="{StaticResource IconVisibility}"
                                  Width="18"
                                  Height="18"
                                  IsVisible="{Binding !ShowPassword}"/>
                        <PathIcon Data="{StaticResource IconVisibilityOff}"
                                  Width="18"
                                  Height="18"
                                  IsVisible="{Binding ShowPassword}"/>
                      </Grid>
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>

              <Border Classes="qf-unlock-status"
                      IsVisible="{Binding HasStatus}">
                <TextBlock Text="{Binding Status}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
              </Border>

              <Button Classes="qf-unlock-primary"
                      Command="{Binding UnlockCommand}"
                      HorizontalAlignment="Stretch"
                      IsDefault="True">
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Loc.QuickFill.Button.Unlock}"
                             Foreground="{StaticResource AccentForegroundBrush}"/>
                  <TextBlock Text="-&gt;"
                             Foreground="{StaticResource AccentForegroundBrush}"
                             FontWeight="Bold"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <Grid IsVisible="{Binding HasMatches}"
                ColumnDefinitions="280,*"
                ColumnSpacing="14">
            <Border Classes="qf-panel">
              <Grid RowDefinitions="Auto,*"
                    RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                  <TextBlock Text="{DynamicResource Loc.QuickFill.Entries.Title}"
                             Classes="qf-section-title"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="1"
                          Content="{DynamicResource Loc.QuickFill.Button.NewEntry}"
                          Classes="qf-popup-secondary qf-popup-small-button"
                          Command="{Binding StartAddEntryCommand}"/>
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Matches}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickFillPopupEntryVm">
                      <Border Classes="qf-popup-row">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                ColumnSpacing="8">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TargetDisplay}"
                                       Classes="qf-mini-badge"
                                       TextTrimming="CharacterEllipsis"/>
                            <CheckBox Grid.Column="2"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      Command="{Binding DataContext.SetEntryEnabledCommand, ElementName=Root}"
                                      CommandParameter="{Binding}"
                                      VerticalAlignment="Center"/>
                            <Button Grid.Column="3"
                                    Content="X"
                                    Classes="qf-popup-secondary qf-popup-small-button"
                                    Command="{Binding DataContext.DeleteEntryRowCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"/>
                          </Grid>
                          <TextBlock Text="{Binding Category}"
                                     Classes="page-subtitle"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding FieldPreview}"
                                     Classes="page-subtitle"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="qf-panel">
              <Grid RowDefinitions="*,Auto"
                    RowSpacing="12">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Binding SelectedEntry.Name}"
                             FontSize="22"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SelectedEntry.TargetDisplay}"
                             Classes="page-subtitle"
                             TextWrapping="Wrap"/>
                  <Border Classes="qf-inner-panel">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{DynamicResource Loc.QuickFill.Fields.Title}"
                                 Classes="qf-kicker"/>
                      <TextBlock Text="{Binding SelectedEntry.FieldPreview}"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{DynamicResource Loc.QuickFill.Footer}"
                             Classes="page-subtitle"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto,Auto,Auto"
                      ColumnSpacing="10">
                  <Button Grid.Column="1"
                          Content="{DynamicResource Loc.Common.Edit}"
                          Classes="qf-popup-secondary"
                          Command="{Binding StartEditEntryCommand}"/>
                  <Button Grid.Column="2"
                          Content="{DynamicResource Loc.Common.Copy}"
                          Classes="qf-popup-secondary"
                          Command="{Binding CopySelectedCommand}"/>
                  <Button Grid.Column="3"
                          Content="{DynamicResource Loc.QuickFill.Button.Fill}"
                          Classes="qf-popup-primary"
                          IsEnabled="{Binding CanFillSelected}"
                          Command="{Binding FillSelectedCommand}"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Border Classes="qf-popup-empty"
                  IsVisible="{Binding HasNoMatches}">
            <StackPanel Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Loc.QuickFill.Popup.EmptyTitle}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextAlignment="Center"/>
              <TextBlock Text="{DynamicResource Loc.QuickFill.Popup.EmptySubtitle}"
                         Classes="page-subtitle"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="420"/>
              <Button Content="{DynamicResource Loc.QuickFill.Popup.AddEntry}"
                      Classes="qf-popup-primary"
                      Command="{Binding StartAddEntryCommand}"
                      HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>

          <Grid IsVisible="{Binding IsEditingEntry}"
                RowDefinitions="*">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <views:QuickFillEntryEditorView/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.qf-window-caption-button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource CaptionButtonForegroundBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.qf-target-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Border.qf-target-strip">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Width" Value="3"/>
      <Setter Property="CornerRadius" Value="2,0,0,2"/>
    </Style>

    <Style Selector="Button.qf-window-caption-button:pointerover">
      <Setter Property="Background" Value="{StaticResource CaptionButtonHoverBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource CaptionButtonHoverForegroundBrush}"/>
    </Style>

    <Style Selector="Button.qf-window-caption-button-close:pointerover">
      <Setter Property="Background" Value="{StaticResource CaptionButtonCloseHoverBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource CaptionButtonHoverForegroundBrush}"/>
    </Style>

    <Style Selector="Border.qf-unlock-card">
      <Setter Property="Width" Value="460"/>
      <Setter Property="MaxWidth" Value="460"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="34"/>
    </Style>

    <Style Selector="Border.qf-unlock-icon-tile">
      <Setter Property="Width" Value="66"/>
      <Setter Property="Height" Value="66"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style Selector="TextBlock.qf-unlock-label">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="ComboBox.qf-unlock-combo">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Border.qf-unlock-password-shell">
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,0,8,0"/>
    </Style>

    <Style Selector="Border.qf-unlock-password-shell:focus-within">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="TextBox.qf-unlock-input">
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.qf-unlock-input /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBox.qf-unlock-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="TextBox.qf-unlock-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.qf-unlock-eye-button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.qf-unlock-eye-button:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.qf-unlock-status">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,9"/>
    </Style>

    <Style Selector="Button.qf-unlock-primary">
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.qf-panel, Border.qf-inner-panel, Border.qf-popup-row, Border.qf-popup-field-row">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10"/>
    </Style>

    <Style Selector="Border.qf-inner-panel">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
    </Style>

    <Style Selector="Border.qf-popup-empty">
      <Setter Property="Background" Value="{StaticResource AppBackgroundSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="TextBlock.qf-kicker">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="1.8"/>
    </Style>

    <Style Selector="TextBlock.qf-section-title">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.qf-mini-badge">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Black"/>
    </Style>

    <Style Selector="Button.qf-popup-primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.qf-popup-secondary">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
    </Style>

    <Style Selector="Button.qf-popup-small-button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.qf-popup-danger">
      <Setter Property="Background" Value="{StaticResource DangerMutedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
  </Window.Styles>
</Window>
