<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellKrypt.Desktop.ViewModels"
             x:Class="ShellKrypt.Desktop.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">
  <StackPanel Margin="24" Spacing="12" Width="420">
    <TextBlock Text="ShellKrypt" FontSize="28" FontWeight="Bold"/>
    <TextBlock Text="Local-first password management platform (v1)" Opacity="0.75"/>

    <Button Content="Create Vault" Command="{Binding CreateVaultCommand}"/>
    <Button Content="Open Vault" Command="{Binding OpenVaultCommand}"/>

    <Border Margin="0,8,0,0" Padding="12" CornerRadius="8" BorderThickness="1">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
    </Border>
  </StackPanel>
</UserControl>